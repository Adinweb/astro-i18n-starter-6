  "items_count": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{count} مورد",
        "countPlural=*": "{count} مورد"
      }
    }
  ],
  "nav_about": "درباره ما",
  "nav_blog": "وبلاگ",
  "nav_features": "ویژگی‌ها",
  "nav_home": "خانه",
  "nav_pricing": "قیمت‌گذاری",
  "position_ordinal": [
    {
      "declarations": [
        "input pos",
        "local posOrdinal = pos: plural type=ordinal"
      ],
      "selectors": [
        "posOrdinal"
      ],
      "match": {
        "posOrdinal=*": "{pos}م"
      }
    }
  ]
}
