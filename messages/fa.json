{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "common_back_home": "بازگشت به خانه",
  "common_back_to_blog": "بازگشت به وبلاگ",
  "common_change_language": "تغییر زبان",
  "common_close": "بستن",
  "common_english_version_hint": "یا مشاهده این برگه به زبان انگلیسی:",
  "common_go_english_version": "رفتن به نسخه انگلیسی",
  "common_no_results": "نتیجه‌ای یافت نشد.",
  "common_not_found_desc": "برگه‌ای که به دنبال آن هستید وجود ندارد یا منتقل شده است.",
  "common_not_found_title": "برگه پیدا نشد",
  "common_press_esc": "برای بستن",
  "common_published_on": "منتشر شده در",
  "common_read_more": "ادامه مطلب",
  "common_search_placeholder": "جستجو در مقالات و برگه‌ها...",
  "common_site_title": "استرو چندزبانه",
  "common_type_to_search": "برای جستجو تایپ کنید...",
  "items_count": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{count} مورد",
        "countPlural=*": "{count} مورد"
      }
    }
  ],
  "nav_about": "درباره ما",
  "nav_blog": "وبلاگ",
  "nav_features": "ویژگی‌ها",
  "nav_home": "خانه",
  "position_ordinal": [
    {
      "declarations": [
        "input pos",
        "local posOrdinal = pos: plural type=ordinal"
      ],
      "selectors": [
        "posOrdinal"
      ],
      "match": {
        "posOrdinal=*": "{pos}م"
      }
    }
  ]
}
