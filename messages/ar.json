  "items_count": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{count} عنصر",
        "countPlural=two": "عنصران",
        "countPlural=*": "{count} عناصر"
      }
    }
  ],
  "nav_about": "من نحن",
