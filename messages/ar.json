  "nav_features": "المميزات",
  "nav_home": "الرئيسية",
  "nav_pricing": "الأسعار",
  "position_ordinal": [
    {
      "declarations": [
        "input pos",
        "local posOrdinal = pos: plural type=ordinal"
      ],
      "selectors": [
        "posOrdinal"
      ],
      "match": {
        "posOrdinal=*": "المركز {pos}"
      }
    }
  ]
}
