  "position_ordinal": [
    {
      "declarations": [
        "input pos",
        "local posOrdinal = pos: plural type=ordinal"
      ],
      "selectors": [
        "posOrdinal"
      ],
      "match": {
        "posOrdinal=*": "{pos}."
      }
    }
  ]
