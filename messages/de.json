{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "common_back_home": "Zurück zur Startseite",
  "common_back_to_blog": "Zurück zum Blog",
  "common_change_language": "Sprache ändern",
  "common_close": "Schließen",
  "common_english_version_hint": "Oder diese Seite auf Englisch ansehen:",
  "common_go_english_version": "Zur englischen Version wechseln",
  "common_no_results": "Keine Ergebnisse gefunden.",
  "common_not_found_desc": "Die gesuchte Seite existiert nicht oder wurde verschoben.",
  "common_not_found_title": "Seite nicht gefunden",
  "common_press_esc": "zum Schließen",
  "common_published_on": "Veröffentlicht am",
  "common_read_more": "Weiterlesen",
  "common_search_placeholder": "Artikel und Seiten durchsuchen...",
  "common_site_title": "Astro i18n",
  "common_type_to_search": "Tippen zum Suchen...",
  "items_count": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{count} Element",
        "countPlural=*": "{count} Elemente"
      }
    }
  ],
  "nav_about": "Über uns",
  "nav_blog": "Blog",
  "nav_features": "Funktionen",
  "nav_home": "Startseite",
  "position_ordinal": [
    {
      "declarations": [
        "input pos",
        "local posOrdinal = pos: plural type=ordinal"
      ],
      "selectors": [
        "posOrdinal"
      ],
      "match": {
        "posOrdinal=*": "{pos}."
      }
    }
  ]
}
