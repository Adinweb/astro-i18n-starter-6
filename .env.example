# Absolute public origin used for canonical URLs, sitemap, RSS, and OG metadata.
# Copy this file to .env and replace the value for production builds.
#
# A local build without SITE_URL still runs: it falls back to
# http://localhost:4321 and prints a warning. A CI or deployment build
# (CI=true) fails without it, so placeholder URLs can never be published.
SITE_URL="https://example.com"
