{
  "name": "astro-i18n-starter",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-messages.mjs && astro dev --host 0.0.0.0 --port 3000",
    "messages:compile": "node scripts/messages-compile.mjs",
    "check": "node scripts/messages-compile.mjs && astro check",
    "check:quick": "node scripts/messages-compile.mjs && tsc --noEmit && vitest run --no-isolate",
    "lint": "node scripts/messages-compile.mjs && astro check && tsc --noEmit",
    "test": "node scripts/messages-compile.mjs && vitest run",
    "build": "node scripts/messages-compile.mjs && node scripts/audit-i18n.mjs && astro build && node scripts/index-pagefind.mjs",
    "preview": "astro preview",
    "smoke": "node scripts/smoke.mjs",
    "knip": "knip",
    "assets:generate": "node scripts/generate-assets.mjs",
    "blocks:catalog": "node scripts/blocks-catalog.mjs",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','.astro','src/paraglide','.paraglide-work']) fs.rmSync(p,{recursive:true,force:true})\"",
    "block:adapt": "node scripts/block-adapt.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:add": "node scripts/i18n-add.mjs",
    "i18n:add-batch": "node scripts/i18n-add-batch.mjs",
    "i18n:sync-keys": "node scripts/i18n-sync-keys.mjs",
    "new:page": "node scripts/new-page.mjs",
    "new:post": "node scripts/new-post.mjs",
    "remove:page": "node scripts/remove-page.mjs",
    "remove:post": "node scripts/remove-post.mjs",
    "i18n:add-lang": "node scripts/add-language.mjs",
    "i18n:remove-lang": "node scripts/remove-language.mjs",
    "i18n:set-default": "node scripts/set-default-language.mjs",
    "i18n:solo": "node scripts/set-language-mode.mjs",
    "site:init": "node scripts/site-init.mjs",
    "site:apply": "node scripts/site-apply.mjs",
    "site:reset": "node scripts/site-reset.mjs",
    "studio": "node scripts/studio.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "verify:cli": "node scripts/verify-cli.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:handoff": "node scripts/doctor.mjs --handoff",
    "link:check": "node scripts/link-check.mjs",
    "content:list": "node scripts/content-list.mjs",
    "content:status": "node scripts/content-status.mjs",
    "content:new": "node scripts/content-new.mjs",
    "content:sync": "node scripts/content-sync.mjs",
    "content:enable": "node scripts/content-toggle.mjs enable",
    "content:disable": "node scripts/content-toggle.mjs disable",
    "starter:seed": "node scripts/seed-starter.mjs",
    "client:bootstrap": "node scripts/client-bootstrap.mjs",
    "upstream:check": "node scripts/upstream-check.mjs",
    "qa:browser": "node scripts/qa-browser.mjs",
    "qa:lighthouse": "node scripts/qa-lighthouse.mjs",
    "preflight": "node scripts/messages-compile.mjs && node scripts/upstream-check.mjs && node scripts/audit-i18n.mjs && node scripts/doctor.mjs && vitest run && npm run build && node scripts/smoke.mjs && node scripts/link-check.mjs",
    "preflight:full": "npm run preflight && node scripts/qa-browser.mjs && node scripts/qa-lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "~8.0.3",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@inlang/paraglide-js": "^2.26.0",
    "@tabler/icons-astro": "^3.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.7",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "lenis": "^1.3.27",
    "magic-string": "^1.4.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.1",
    "@inlang/plugin-m-function-matcher": "2.2.6",
    "@inlang/plugin-message-format": "4.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.12.0",
    "code-inspector-plugin": "^2.0.9",
    "knip": "^6.40.0",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wawoff2": "^2.0.1"
  }
}