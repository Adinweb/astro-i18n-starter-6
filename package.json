{
  "name": "astro-i18n-starter",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && astro dev",
    "messages:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && astro check",
    "lint": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && astro check && tsc --noEmit",
    "test": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && vitest run",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && node scripts/audit-i18n.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "smoke": "node scripts/smoke.mjs",
    "knip": "knip",
    "assets:generate": "node scripts/generate-assets.mjs",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','.astro','src/paraglide']) fs.rmSync(p,{recursive:true,force:true})\"",
    "block:adapt": "node scripts/block-adapt.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:add": "node scripts/i18n-add.mjs",
    "i18n:add-batch": "node scripts/i18n-add-batch.mjs",
    "new:page": "node scripts/new-page.mjs",
    "new:post": "node scripts/new-post.mjs",
    "remove:page": "node scripts/remove-page.mjs",
    "remove:post": "node scripts/remove-post.mjs",
    "i18n:add-lang": "node scripts/add-language.mjs",
    "i18n:remove-lang": "node scripts/remove-language.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "verify:cli": "node scripts/verify-cli.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "~8.0.3",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@inlang/paraglide-js": "^2.26.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "~7.3.6",
    "magic-string": "^1.4.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.12.0",
    "knip": "^6.40.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
