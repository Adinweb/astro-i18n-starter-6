{
  "site": {
    "name": "Astro i18n Starter",
    "shortName": "Astro i18n",
    "description": "A production-grade, multilingual RTL & LTR static site generator starter built with Astro v7, Tailwind CSS v4, and Paraglide JS.",
    "author": "Astro Starter Team",
    "contactEmail": "",
    "socialImage": {
      "path": "/og-default.png",
      "width": 1200,
      "height": 630
    }
  },
  "brand": {
    "defaultTheme": "system",
    "preset": "indigo",
    "fontPreset": "system",
    "rtlFontPreset": "vazirmatn",
    "socialCardMode": "branded",
    "themeColor": "#4338ca",
    "darkThemeColor": "#0f172a",
    "backgroundColor": "#f8fafc",
    "appleTouchIcon": {
      "file": "apple-touch-icon.png",
      "size": 180
    },
    "icons": [
      {
        "file": "icon-192.png",
        "size": 192,
        "purpose": "any"
      },
      {
        "file": "icon-512.png",
        "size": 512,
        "purpose": "any"
      }
    ]
  },
  "ui": {
    "ctaPage": "pricing",
    "showSearch": true,
    "showThemeToggle": true,
    "showLanguageSwitcher": true,
    "showTopLoadingBar": true,
    "stickyHeader": true,
    "navbar": {
      "initialTopOffset": 16,
      "stickyScrollThreshold": 0,
      "stickyTopOffset": 12,
      "autoBannerOffset": true,
      "manualBannerOffset": 0
    },
    "topBanner": {
      "enabled": true,
      "id": "site-announcement",
      "variant": "primary",
      "icon": "sparkles",
      "heightPx": 32,
      "badge": "",
      "badgeByLocale": {},
      "message": "",
      "messageByLocale": {},
      "ctaLabel": "",
      "ctaLabelByLocale": {},
      "ctaHref": "",
      "ctaHrefByLocale": {},
      "external": false,
      "dismissible": true,
      "excludePaths": [],
      "items": [
        {
          "id": "site-notice",
          "enabled": true,
          "variant": "hero",
          "icon": "shield",
          "heightPx": 40,
          "badge": "",
          "badgeByLocale": {},
          "message": "",
          "messageByLocale": {},
          "ctaLabel": "",
          "ctaLabelByLocale": {},
          "ctaHref": "",
          "ctaHrefByLocale": {},
          "external": false,
          "dismissible": false,
          "excludePaths": []
        },
        {
          "id": "site-announcement",
          "enabled": true,
          "variant": "primary",
          "icon": "sparkles",
          "heightPx": 32,
          "badge": "",
          "badgeByLocale": {},
          "message": "",
          "messageByLocale": {},
          "ctaLabel": "",
          "ctaLabelByLocale": {},
          "ctaHref": "",
          "ctaHrefByLocale": {},
          "external": false,
          "dismissible": true,
          "excludePaths": []
        }
      ]
    },
    "motion": {
      "revealDelayMs": 0,
      "revealDurationMs": 1600,
      "revealDistancePx": 56,
      "revealSmallDistancePx": 18,
      "revealEasing": "cubic-bezier(0.16, 1, 0.3, 1)",
      "staggerStepMs": 80,
      "rootMargin": "0px 0px -8% 0px",
      "mobileBehavior": "lightweight",
      "smoothScroll": true,
      "smoothScrollLerp": 0.125
    }
  },
  "blog": {
    "postsPerPage": 9,
    "showReadingTime": true,
    "showTableOfContents": true,
    "showRelatedPosts": true
  },
  "content": {
    "types": {
      "pages": {
        "enabled": true,
        "base": "",
        "index": false,
        "paginated": false,
        "feed": false,
        "nav": true
      },
      "blog": {
        "enabled": true,
        "base": "blog",
        "index": true,
        "paginated": true,
        "feed": true,
        "nav": true
      },
      "projects": {
        "enabled": true,
        "base": "projects",
        "index": true,
        "paginated": false,
        "feed": false,
        "nav": true
      }
    }
  },
  "cookies": {
    "enabled": true,
    "consentVersion": 1,
    "storageKey": "cookie_consent",
    "expirationDays": 180
  },
  "social": {
    "github": "https://github.com",
