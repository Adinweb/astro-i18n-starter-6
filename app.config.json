{
  "site": {
    "name": "Astro i18n Starter",
    "shortName": "Astro i18n",
    "description": "Production-grade, multi-lingual Astro v7 starter template with native RTL and LTR support.",
    "author": "Astro Starter Team",
    "socialImage": {
      "path": "/og-default.png",
      "width": 1200,
      "height": 630
    }
  },
  "brand": {
    "defaultTheme": "system",
    "themeColor": "#4338ca",
    "darkThemeColor": "#0f172a",
    "backgroundColor": "#f8fafc",
    "appleTouchIcon": {
      "file": "apple-touch-icon.png",
      "size": 180
    },
    "icons": [
      {
        "file": "icon-192.png",
        "size": 192,
        "purpose": "any"
      },
      {
        "file": "icon-512.png",
        "size": 512,
        "purpose": "any"
      }
    ]
  },
  "ui": {
    "showSearch": true,
    "showThemeToggle": true,
    "showLanguageSwitcher": true,
    "showTopLoadingBar": true,
    "stickyHeader": true
  },
  "blog": {
    "postsPerPage": 9,
    "showReadingTime": true,
    "showTableOfContents": true,
    "showRelatedPosts": true
  },
  "cookies": {
    "enabled": true,
    "consentVersion": 1,
    "storageKey": "cookie_consent",
    "expirationDays": 180
  },
  "social": {
    "github": "https://github.com",
    "twitter": ""
  },
  "api": {
    "baseUrl": "",
    "timeoutMs": 10000,
    "endpoints": {
      "contact": "/contact"
    }
  },
  "server": {
    "host": "0.0.0.0",
    "port": 3000
  }
}
