---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_LOCALE, LOCALES, LOCALE_METADATA, type Locale } from '@/i18n/locales';
import { formatYear } from '@/i18n/format';
import { localizeHref } from '@/i18n/paths';
import { getNavigation } from '@/libs/config/navigation';
import { siteConfig } from '@/libs/config/app';
import * as m from '@/paraglide/messages';

const locale: Locale = DEFAULT_LOCALE;
const siteName = siteConfig.name;

// A 404 has no translations of its own: one static document serves every
// unknown path. Language switching therefore leads to each locale's home
// page, the closest page that is guaranteed to exist. The canonical URL is
// that home page too: the 404 is served at whatever address was requested,
// and `/404` itself is not a page of the site.
const alternates = Object.fromEntries(
  LOCALES.map((loc) => [loc, localizeHref('/', loc)])
) as Record<Locale, string>;

const homeHref = localizeHref('/', locale);

// The client needs the complete navigation and locale metadata to re-render
// the page for the prefix of the requested URL. It is built from the same
// `getNavigation()` service as the layout, so adding a page never leaves the
// 404 behind.
const i18nData = Object.fromEntries(
  await Promise.all(
    LOCALES.map(async (loc) => {
      const nav = await getNavigation(loc);
      return [
        loc,
        {
          title: m.common_not_found_title({}, { locale: loc }),
          desc: m.common_not_found_desc({}, { locale: loc }),
          backHome: m.common_back_home({}, { locale: loc }),
          goEnglish: m.common_go_english_version({}, { locale: loc }),
          englishHint: m.common_english_version_hint({}, { locale: loc }),
          cta: m.common_get_started({}, { locale: loc }),
          rights: m.common_all_rights_reserved({}, { locale: loc }),
          search: m.common_search_placeholder({}, { locale: loc }),
          searchHint: m.common_type_to_search({}, { locale: loc }),
          searchEmpty: m.common_no_results({}, { locale: loc }),
          close: m.common_close({}, { locale: loc }),
          pressEsc: m.common_press_esc({}, { locale: loc }),
          changeLanguage: m.common_change_language({}, { locale: loc }),
          themeLight: m.common_theme_light({}, { locale: loc }),
          themeDark: m.common_theme_dark({}, { locale: loc }),
          year: formatYear(new Date().getFullYear(), loc),
          homeHref: nav.find((item) => item.key === 'home')?.href ?? localizeHref('/', loc),
          nav: nav.map(({ key, label, href }) => ({ key, label, href })),
          dir: LOCALE_METADATA[loc].dir,
          lang: LOCALE_METADATA[loc].htmlLang,
          fontFamily: LOCALE_METADATA[loc].fontFamily,
        },
      ];
    })
  )
);
---

<BaseLayout
  title={m.common_not_found_title({}, { locale })}
  description={m.common_not_found_desc({}, { locale })}
  locale={locale}
  url={homeHref}
  alternates={alternates}
  noindex
  noPagefind
>
  <div class="text-center py-20 px-4 max-w-xl mx-auto">
    <p class="text-7xl font-extrabold text-primary mb-4 tracking-tight">404</p>
    <h1 class="text-3xl font-bold text-fg mb-4" id="not-found-title">
      {m.common_not_found_title({}, { locale })}
    </h1>
    <p class="text-muted max-w-md mx-auto mb-8 text-base leading-relaxed" id="not-found-desc">
      {m.common_not_found_desc({}, { locale })}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        id="not-found-home-link"
        href={homeHref}
        class="cta w-full sm:w-auto"
      >
        {m.common_back_home({}, { locale })}
      </a>

      <a
        id="not-found-english-link"
        href="/"
        class="btn-secondary hidden w-full sm:w-auto"
      >
        {m.common_go_english_version({}, { locale })}
      </a>
    </div>

    <p id="not-found-english-hint" class="hidden text-xs text-muted mt-4">
      {m.common_english_version_hint({}, { locale })}
    </p>
  </div>

  <script define:vars={{ LOCALES, DEFAULT_LOCALE, i18nData, siteName }}>
    function updateNotFoundPage() {
      const pathname = window.location.pathname;
      const segments = pathname.split('/').filter(Boolean);
      const firstSegment = segments[0];
      const isKnownLocale = Boolean(
        firstSegment && LOCALES.some((locale) => locale === firstSegment)
      );
      const detectedLocale = isKnownLocale && firstSegment ? firstSegment : DEFAULT_LOCALE;
      const data = i18nData[detectedLocale] || i18nData[DEFAULT_LOCALE];

      // Update document attributes, typography & title
      document.documentElement.lang = data.lang;
      document.documentElement.dir = data.dir;
      document.documentElement.style.fontFamily = data.fontFamily;
      document.title = `${data.title} | ${siteName}`;

      // Update text nodes
      const titleEl = document.getElementById('not-found-title');
      if (titleEl) titleEl.textContent = data.title;

      const descEl = document.getElementById('not-found-desc');
      if (descEl) descEl.textContent = data.desc;

      // Update home link
      const homeLink = document.getElementById('not-found-home-link');
      if (homeLink) {
        homeLink.href = data.homeHref;
        homeLink.textContent = data.backHome;
      }

      // Shared header/footer controls are server-rendered for the default
      // locale, so re-label them for the locale detected in the URL.
      document.querySelectorAll('[data-cta-link="get-started"]').forEach((el) => {
        el.textContent = data.cta;
      });
      const rights = document.querySelector('[data-footer-rights]');
      if (rights) rights.textContent = data.rights;
      document.querySelectorAll('[data-current-year]').forEach((el) => {
        if (el instanceof HTMLElement) el.dataset.locale = detectedLocale;
        el.textContent = data.year;
      });
      const isDark = document.documentElement.dataset.theme === 'dark';
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        if (btn instanceof HTMLElement) {
          btn.dataset.labelLight = data.themeLight;
          btn.dataset.labelDark = data.themeDark;
        }
        const label = isDark ? data.themeLight : data.themeDark;
        btn.setAttribute('aria-label', label);
        btn.setAttribute('title', label);
      });
      const searchButton = document.querySelector('[data-open-search]');
      if (searchButton) {
        searchButton.setAttribute('aria-label', data.search);
        searchButton.setAttribute('title', data.search);
      }
      // The modal itself is rendered for the default locale: its placeholder,
      // empty state and the locale the fallback index filters on all have to
      // follow the language of the requested URL. Otherwise a Persian 404
      // would search the English index.
      const searchModal = document.querySelector('[data-search-modal]');
      if (searchModal instanceof HTMLElement) {
        searchModal.dataset.locale = detectedLocale;
        searchModal.dataset.placeholder = data.searchHint;
        searchModal.dataset.noResults = data.searchEmpty;
      }
      const searchTitle = document.getElementById('search-modal-title');
      if (searchTitle) searchTitle.textContent = data.search;
      const searchInput = document.getElementById('search-input');
      if (searchInput) {
        searchInput.placeholder = data.search;
        searchInput.setAttribute('aria-label', data.search);
      }
      const searchHintMessage = document.getElementById('search-placeholder-msg');
      if (searchHintMessage && searchInput && !(searchInput.value)) {
        searchHintMessage.textContent = data.searchHint;
      }
      const searchClose = document.getElementById('search-close-btn');
      if (searchClose) {
        searchClose.setAttribute('aria-label', data.close);
        searchClose.setAttribute('title', data.close);
      }
      const searchEscHint = document.getElementById('search-esc-hint');
      if (searchEscHint) searchEscHint.textContent = data.pressEsc;
      const switcherButton = document.querySelector('[data-switcher-button]');
      if (switcherButton) {
        switcherButton.setAttribute('aria-label', data.changeLanguage);
        switcherButton.setAttribute('title', data.changeLanguage);
      }
      const activeLocale = document.querySelector('[data-switcher-active]');
      if (activeLocale) activeLocale.textContent = detectedLocale;
      document.querySelectorAll('[data-switcher-link]').forEach((link) => {
        const isCurrent = link.getAttribute('data-target') === data.homeHref;
        if (isCurrent) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
        link.classList.toggle('bg-primary/10', isCurrent);
        link.classList.toggle('font-medium', isCurrent);
        link.classList.toggle('text-primary', isCurrent);
        link.classList.toggle('text-fg', !isCurrent);
        const check = link.querySelector('[data-switcher-check]');
        if (check) check.classList.toggle('hidden', !isCurrent);
      });

      // Update navigation links on 404 from the shared navigation payload.
      document.querySelectorAll('[data-brand-link]').forEach((el) => {
        el.setAttribute('href', data.homeHref);
      });
      for (const item of data.nav) {
        document.querySelectorAll(`[data-nav-link="${item.key}"]`).forEach((el) => {
          el.setAttribute('href', item.href);
          el.textContent = item.label;
        });
      }

      // Update "Go to English version of requested page" link
      const englishLink = document.getElementById('not-found-english-link');
      const englishHint = document.getElementById('not-found-english-hint');

      if (englishLink) {
        if (isKnownLocale && detectedLocale !== DEFAULT_LOCALE) {
          const restOfPath = segments.slice(1).join('/');
          const englishHref = restOfPath ? `/${restOfPath}/` : '/';
          englishLink.href = englishHref;
          englishLink.textContent = data.goEnglish;
          englishLink.classList.remove('hidden');

          if (englishHint) {
            englishHint.textContent = data.englishHint;
            englishHint.classList.remove('hidden');
          }
        } else {
          englishLink.classList.add('hidden');
          if (englishHint) englishHint.classList.add('hidden');
        }
      }

    }

    updateNotFoundPage();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateNotFoundPage, { once: true });
    }
    if (document.documentElement.dataset.notFoundBound !== 'true') {
      document.documentElement.dataset.notFoundBound = 'true';
      document.addEventListener('astro:page-load', updateNotFoundPage);
    }
  </script>
</BaseLayout>

