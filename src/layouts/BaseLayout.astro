---
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import { getLocaleMeta, type Locale } from '@/i18n/locales';
import { localizeHref } from '@/i18n/paths';
import { getNavigation } from '@/libs/config/navigation';
import { absoluteUrl, siteConfig } from '@/libs/config/app';
import * as m from '@/paraglide/messages';
import Seo from '@/components/Seo.astro';
import TopLoadingBar from '@/components/TopLoadingBar.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import SearchModal from '@/components/SearchModal.astro';
import IconButton from '@/components/IconButton.astro';
import '@/styles/global.css';
import '@/styles/prose.css';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  url: string;
  alternates: Partial<Record<Locale, string>>;
  switcherAlternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  noPagefind?: boolean;
  showSearch?: boolean;
  /**
   * Renders the page flush to the top so the fixed header floats over its hero.
   * The `hero` named slot is rendered full-bleed, outside the content column.
   */
  hero?: boolean;
  /** Artwork of the entry, already resolved by Astro's image pipeline. */
  image?: ImageMetadata;
  type?: 'website' | 'article';
  publishedTime?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** URL of the previous page of a paginated listing. */
  prevUrl?: string;
  /** URL of the next page of a paginated listing. */
  nextUrl?: string;
}

const {
  title,
  description,
  locale,
  url,
  alternates,
  switcherAlternates,
  noindex = false,
  noPagefind = false,
  showSearch = true,
  hero = false,
  image,
  type = 'website',
  publishedTime,
  schema,
  prevUrl,
  nextUrl,
} = Astro.props;

const meta = getLocaleMeta(locale);
const siteName = siteConfig.name;
const navItems = await getNavigation(locale, url);
const homeHref =
  navItems.find((item) => item.key === 'home')?.href ?? localizeHref('/', locale);
const pricingHref = navItems.find((item) => item.key === 'pricing')?.href;
const currentYear = new Date().getFullYear();

const structuredData = schema ?? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: absoluteUrl(homeHref),
  description: m.site_description({}, { locale }),
  inLanguage: meta.htmlLang,
};
---

<!doctype html>
<html
  lang={meta.htmlLang}
  dir={meta.dir}
  class="scroll-smooth scroll-pt-24"
  style={`font-family: ${meta.fontFamily};`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href={`/${siteConfig.appleTouchIcon}`} />
    <ClientRouter />
    <Seo
      title={title}
      description={description}
      locale={locale}
      url={url}
      alternates={alternates}
      siteName={siteName}
      image={image}
      type={type}
      publishedTime={publishedTime}
      schema={structuredData}
      noindex={noindex}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
    />
  </head>
  <body class="bg-bg text-fg min-h-screen flex flex-col antialiased selection:bg-primary/20">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-fg"
    >
      {m.common_skip_to_content({}, { locale })}
    </a>

    <TopLoadingBar />

    <header class="fixed inset-x-0 top-0 z-40 pt-3 sm:pt-4">
      <div class="mx-auto w-full max-w-5xl px-4 sm:px-6">
        <div
          class="glass-surface flex h-14 items-center justify-between gap-3 px-3 sm:h-16 sm:px-4"
        >
          <a
            href={homeHref}
            data-brand-link
            class="flex min-w-0 items-center gap-2 font-bold text-base tracking-tight transition-colors hover:text-primary sm:text-lg"
          >
            <span class="truncate">{siteName}</span>
          </a>

          <nav
            class="hidden items-center gap-4 text-sm font-medium md:flex lg:gap-6"
            aria-label={m.common_menu({}, { locale })}
          >
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  data-nav-link={item.key}
                  aria-current={item.active ? 'page' : undefined}
                  class:list={[
                    'transition-colors hover:text-primary',
                    item.active && 'text-primary',
                  ]}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>

          <div class="flex items-center gap-2">
            {
              showSearch && (
                <IconButton
                  icon="search"
                  size={16}
                  label={m.common_search_placeholder({}, { locale })}
                  data-open-search
                  aria-haspopup="dialog"
                />
              )
            }

            <LanguageSwitcher
              currentLocale={locale}
              alternates={switcherAlternates ?? alternates}
            />

            {
              pricingHref && (
                <a
                  href={pricingHref}
                  data-cta-link="get-started"
                  class="cta hidden h-9 text-xs lg:inline-flex"
                >
                  {m.common_get_started({}, { locale })}
                </a>
              )
            }

            <IconButton
              icon="menu"
              size={18}
              label={m.common_menu({}, { locale })}
              class="md:hidden"
              data-mobile-menu-btn
              aria-expanded="false"
              aria-controls="mobile-nav-menu"
            />
          </div>
        </div>
      </div>
    </header>

    <dialog
      id="mobile-nav-menu"
      data-mobile-menu
      class="m-0 h-dvh max-h-none w-80 max-w-[85vw] border-0 bg-surface p-0 text-fg shadow-2xl md:hidden"
      aria-label={m.common_menu({}, { locale })}
    >
      <div class="flex h-16 shrink-0 items-center justify-between gap-4 border-b border-border px-4">
        <a href={homeHref} data-brand-link class="truncate font-bold text-lg tracking-tight hover:text-primary transition-colors">
          {siteName}
        </a>
        <IconButton
          icon="close"
          size={18}
          variant="ghost"
          label={m.common_close({}, { locale })}
          data-close-menu
        />
      </div>

      <nav class="flex-1 overflow-y-auto overscroll-contain px-4 py-4 text-sm font-medium">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              data-nav-link={item.key}
              aria-current={item.active ? 'page' : undefined}
              class:list={[
                'block rounded-md px-3 py-2.5 hover:bg-surface-hover hover:text-primary transition-colors',
                item.active && 'text-primary',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      {
        pricingHref && (
          <div class="shrink-0 border-t border-border p-4">
            <a
              href={pricingHref}
              data-cta-link="get-started"
              class="cta h-10 w-full"
            >
              {m.common_get_started({}, { locale })}
            </a>
          </div>
        )
      }
    </dialog>

    <main
      id="main-content"
      tabindex="-1"
      data-pagefind-body={noPagefind ? undefined : true}
      data-pagefind-ignore={noPagefind ? true : undefined}
      class:list={[
        'flex-1 w-full',
        hero ? 'pt-0' : 'pt-20 sm:pt-24',
      ]}
    >
      {/* Full-bleed hero: rendered outside the content column so it spans the viewport. */}
      <slot name="hero" />

      <div
        class:list={[
          'mx-auto w-full max-w-5xl px-4 pb-12 sm:px-6 md:pb-16',
          hero && 'pt-10 sm:pt-12',
        ]}
      >
        <slot />
      </div>
    </main>

    <footer class="border-t border-border bg-surface mt-auto py-8">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted">
        <div id="footer-rights">
          © <span data-current-year>{currentYear}</span> {siteName}.
          <span data-footer-rights>{m.common_all_rights_reserved({}, { locale })}</span>
        </div>
        <nav class="flex flex-wrap items-center gap-4" aria-label={m.common_menu({}, { locale })}>
          {
            navItems.map((item) => (
              <a
                href={item.href}
                data-nav-link={item.key}
                aria-current={item.active ? 'page' : undefined}
                class="hover:underline"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </footer>

    {showSearch && <SearchModal locale={locale} />}

    <style>
      [data-mobile-menu] {
        inset-block: 0;
        inset-inline-start: 0;
        inset-inline-end: auto;
        margin: 0;
        height: 100dvh;
        max-height: none;
        width: 20rem;
        max-width: 85vw;
      }

      [data-mobile-menu]::backdrop {
        background: rgb(0 0 0 / 0.5);
      }

      :where(a, button, input, select, textarea):focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>

    <script>
      function updateYear() {
        document.querySelectorAll<HTMLElement>('[data-current-year]').forEach((el) => {
          el.textContent = String(new Date().getFullYear());
        });
      }

      function setupMobileMenu() {
        const btn = document.querySelector<HTMLButtonElement>('[data-mobile-menu-btn]');
        const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
        const closeBtn = document.querySelector<HTMLButtonElement>('[data-close-menu]');
        if (!btn || !dialog || btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';

        const close = () => {
          if (dialog.open) dialog.close();
        };

        btn.addEventListener('click', () => {
          if (!dialog.open) dialog.showModal();
          btn.setAttribute('aria-expanded', 'true');
        });

        closeBtn?.addEventListener('click', close);
        dialog.addEventListener('close', () => {
          btn.setAttribute('aria-expanded', 'false');
        });
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) close();
          if ((event.target as HTMLElement)?.closest('a')) close();
        });
      }

      if (document.documentElement.dataset.baseLayoutBound !== 'true') {
        document.documentElement.dataset.baseLayoutBound = 'true';
        document.addEventListener('astro:page-load', () => {
          updateYear();
          setupMobileMenu();
        });
        document.addEventListener('astro:before-preparation', () => {
          const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
          if (dialog?.open) dialog.close();
        });
      }

      updateYear();
      setupMobileMenu();
    </script>
  </body>
</html>
