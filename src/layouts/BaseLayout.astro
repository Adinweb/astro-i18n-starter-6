---
import { ClientRouter } from 'astro:transitions';
import { getLocaleMeta, type Locale, DEFAULT_LOCALE } from '@/i18n/locales';
import { getPageUrl } from '@/libs/content/service';
import * as m from '@/paraglide/messages';
import Seo from '@/components/Seo.astro';
import TopLoadingBar from '@/components/TopLoadingBar.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import SearchModal from '@/components/SearchModal.astro';
import Icon from '@/components/Icon.astro';
import '@/styles/global.css';
import '@/styles/prose.css';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  url: string;
  alternates: Record<Locale, string>;
}

const { title, description, locale, url, alternates } = Astro.props;
const meta = getLocaleMeta(locale);

const homeHref = await getPageUrl('home', locale);
const aboutHref = await getPageUrl('about', locale);
const featuresHref = await getPageUrl('features', locale);
const pricingHref = await getPageUrl('pricing', locale);
const blogHref = locale === DEFAULT_LOCALE ? '/blog' : `/${locale}/blog`;
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <ClientRouter />
    <Seo
      title={title}
      description={description}
      locale={locale}
      url={url}
      alternates={alternates}
    />
  </head>
  <body class="bg-bg text-fg min-h-screen flex flex-col antialiased selection:bg-primary/20">
    <TopLoadingBar />

    <header class="sticky top-0 z-40 w-full border-b border-border bg-surface/80 backdrop-blur-md">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <a href={homeHref} data-brand-link class="font-bold text-lg tracking-tight hover:text-primary transition-colors flex items-center gap-2">
          <span>{m.common_site_title({}, { locale })}</span>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
          <a href={homeHref} data-nav-link="home" class="hover:text-primary transition-colors">
            {m.nav_home({}, { locale })}
          </a>
          <a href={aboutHref} data-nav-link="about" class="hover:text-primary transition-colors">
            {m.nav_about({}, { locale })}
          </a>
          <a href={featuresHref} data-nav-link="features" class="hover:text-primary transition-colors">
            {m.nav_features({}, { locale })}
          </a>
          <a href={pricingHref} data-nav-link="pricing" class="hover:text-primary transition-colors">
            {m.nav_pricing({}, { locale })}
          </a>
          <a href={blogHref} data-nav-link="blog" class="hover:text-primary transition-colors">
            {m.nav_blog({}, { locale })}
          </a>
        </nav>

        <div class="flex items-center gap-2">
          
          

          <button
            type="button"
            data-open-search
            class="flex h-8 w-8 items-center justify-center rounded-md border border-border bg-surface hover:bg-surface-hover text-muted hover:text-fg transition-colors cursor-pointer"
            aria-label={m.common_search_placeholder({}, { locale })}
            title={m.common_search_placeholder({}, { locale })}
          >
            <Icon name="search" size={15} />
          </button>

          <LanguageSwitcher currentLocale={locale} alternates={alternates} />
<a
            href={pricingHref}
            data-cta-link="get-started"
            class="hidden h-8 items-center rounded-md bg-primary px-3.5 text-xs font-semibold text-primary-fg transition-opacity hover:opacity-90 sm:inline-flex"
          >
            {m.common_get_started({}, { locale })}
          </a>          
          <button
            type="button"
            data-mobile-menu-btn
            class="flex h-8 w-8 items-center justify-center rounded-md border border-border bg-surface hover:bg-surface-hover text-muted hover:text-fg transition-colors cursor-pointer md:hidden"
            aria-label={m.common_menu({}, { locale })}
            aria-expanded="false"
            aria-controls="mobile-nav-menu"
          >
            <Icon name="menu" size={16} />
          </button>
        </div>
      </div>

    </header>

    <!-- Mobile Navigation Drawer (fixed overlay + slide-in panel, rendered outside <header> so backdrop-blur doesn't trap fixed positioning) -->
    <div
      data-mobile-menu-overlay
      class="pointer-events-none fixed inset-0 z-50 bg-black/50 opacity-0 transition-opacity duration-300 md:hidden"
      aria-hidden="true"
    ></div>
    <aside
      id="mobile-nav-menu"
      data-mobile-menu
      inert
      class="invisible fixed top-0 bottom-0 start-0 z-50 flex w-80 max-w-[85vw] flex-col bg-surface shadow-2xl transition-transform duration-300 ease-out ltr:-translate-x-full rtl:translate-x-full md:hidden"
      role="dialog"
      aria-modal="true"
      aria-label={m.common_menu({}, { locale })}
    >
      <div class="flex h-16 shrink-0 items-center justify-between gap-4 border-b border-border px-4">
        <a href={homeHref} data-brand-link class="truncate font-bold text-lg tracking-tight hover:text-primary transition-colors">
          {m.common_site_title({}, { locale })}
        </a>
        <button
          type="button"
          data-close-menu
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-border bg-surface hover:bg-surface-hover text-muted hover:text-fg transition-colors cursor-pointer"
          aria-label={m.common_close({}, { locale })}
        >
          <Icon name="close" size={16} />
        </button>
      </div>

      <nav class="flex-1 overflow-y-auto overscroll-contain px-4 py-4 text-sm font-medium">
        <a href={homeHref} data-nav-link="home" class="block rounded-md px-3 py-2.5 hover:bg-surface-hover hover:text-primary transition-colors">
          {m.nav_home({}, { locale })}
        </a>
        <a href={aboutHref} data-nav-link="about" class="block rounded-md px-3 py-2.5 hover:bg-surface-hover hover:text-primary transition-colors">
          {m.nav_about({}, { locale })}
        </a>
        <a href={featuresHref} data-nav-link="features" class="block rounded-md px-3 py-2.5 hover:bg-surface-hover hover:text-primary transition-colors">
          {m.nav_features({}, { locale })}
        </a>
        <a href={pricingHref} data-nav-link="pricing" class="block rounded-md px-3 py-2.5 hover:bg-surface-hover hover:text-primary transition-colors">
          {m.nav_pricing({}, { locale })}
        </a>
        <a href={blogHref} data-nav-link="blog" class="block rounded-md px-3 py-2.5 hover:bg-surface-hover hover:text-primary transition-colors">
          {m.nav_blog({}, { locale })}
        </a>
      </nav>

      <div class="shrink-0 border-t border-border p-4">
        <a
          href={pricingHref}
          data-cta-link="get-started"
          class="flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-fg transition-opacity hover:opacity-90"
        >
          {m.common_get_started({}, { locale })}
        </a>
      </div>
    </aside>

    <main data-pagefind-body class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 py-8 md:py-12">
      <slot />
    </main>

    <footer class="border-t border-border bg-surface mt-auto py-8">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted">
        <div>
          © {new Date().getFullYear()} {m.common_site_title({}, { locale })}. {m.common_all_rights_reserved({}, { locale })}
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <a href={homeHref} data-nav-link="home" class="hover:underline">{m.nav_home({}, { locale })}</a>
          <a href={aboutHref} data-nav-link="about" class="hover:underline">{m.nav_about({}, { locale })}</a>
          <a href={featuresHref} data-nav-link="features" class="hover:underline">{m.nav_features({}, { locale })}</a>
          <a href={pricingHref} data-nav-link="pricing" class="hover:underline">{m.nav_pricing({}, { locale })}</a>
          <a href={blogHref} data-nav-link="blog" class="hover:underline">{m.nav_blog({}, { locale })}</a>
        </div>
      </div>
    </footer>

    <SearchModal locale={locale} />

    <script>
      function setupMobileMenu() {
        const btn = document.querySelector<HTMLButtonElement>('[data-mobile-menu-btn]');
        const overlay = document.querySelector<HTMLElement>('[data-mobile-menu-overlay]');
        const drawer = document.querySelector<HTMLElement>('[data-mobile-menu]');
        const closeBtn = document.querySelector<HTMLButtonElement>('[data-close-menu]');
        if (!btn || !overlay || !drawer || btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';

        const DRAWER_CLOSED = ['ltr:-translate-x-full', 'rtl:translate-x-full', 'invisible'];
        const OVERLAY_CLOSED = ['opacity-0', 'pointer-events-none'];

        function openMenu() {
          drawer!.classList.remove(...DRAWER_CLOSED);
          drawer!.removeAttribute('inert');
          overlay!.classList.remove(...OVERLAY_CLOSED);
          btn!.setAttribute('aria-expanded', 'true');
          document.documentElement.style.overflow = 'hidden';
          closeBtn?.focus({ preventScroll: true });
        }

        function closeMenu() {
          if (drawer!.classList.contains('invisible')) return;
          drawer!.classList.add(...DRAWER_CLOSED);
          drawer!.setAttribute('inert', '');
          overlay!.classList.add(...OVERLAY_CLOSED);
          btn!.setAttribute('aria-expanded', 'false');
          document.documentElement.style.overflow = '';
        }

        btn.addEventListener('click', () => {
          if (drawer!.classList.contains('invisible')) openMenu();
          else closeMenu();
        });

        closeBtn?.addEventListener('click', closeMenu);

        // Close when clicking outside the drawer (on the overlay).
        overlay.addEventListener('click', closeMenu);

        // Close on link navigation inside the drawer.
        drawer.addEventListener('click', (e) => {
          if ((e.target as HTMLElement)?.closest('a')) closeMenu();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeMenu();
        });

        // Never leave a stale open drawer across client-side transitions.
        document.addEventListener('astro:before-preparation', closeMenu);
      }

      setupMobileMenu();
      document.addEventListener('astro:page-load', setupMobileMenu);
    </script>
  </body>
</html>
