---
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import { getLocaleMeta, LOCALES, LOCALE_METADATA, type Locale } from '@/i18n/locales';
import { formatYear } from '@/i18n/format';
import { getHomeHref, getPageUrl } from '@/libs/content/service';
import { getNavigationSlots } from '@/libs/config/navigation';
import { absoluteUrl, BUSINESS_CONFIG, siteConfig, SOCIAL_CONFIG } from '@/libs/config/app';
import { buildBrandThemeCss } from '@/libs/config/theme';
import { buildOrganizationSchema } from '@/libs/content/schema';
import { resolveLocalizedSiteName } from '@/libs/content/seo';
import type { SocialCardContext } from '@/libs/content/social';
import * as m from '@/paraglide/messages';
import Seo from '@/components/Seo.astro';
import SiteTopBanner from '@/components/SiteTopBanner.astro';
import TopLoadingBar from '@/components/TopLoadingBar.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import SearchModal from '@/components/SearchModal.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import AnalyticsScripts from '@/components/AnalyticsScripts.astro';
import QuickContactWidget from '@/components/QuickContactWidget.astro';
import IconButton from '@/components/ui/IconButton.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import DrawerMenuNode from '@/components/DrawerMenuNode.astro';
import HorizontalNavItem from '@/components/HorizontalNavItem.astro';
import FooterMenuNode from '@/components/FooterMenuNode.astro';
import DrawerSearch from '@/components/DrawerSearch.astro';
import LayoutHooks from '@client/LayoutHooks.astro';
import 'virtual:brand-fonts';
import '@/styles/global.css';
import '@/styles/prose.css';
import '@client/styles.css';

const DevThemePreview = import.meta.env.DEV
  ? (await import('@/components/DevThemePreview.astro')).default
  : null;

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  url: string;
  /**
   * URL that decides which navigation entry renders as current. Defaults to
   * `url`; the 404 document publishes the home page as its canonical but is
   * not itself a page of the site, so it passes `null` and highlights nothing.
   */
  activeUrl?: string | null;
  alternates: Partial<Record<Locale, string>>;
  switcherAlternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  noPagefind?: boolean;
  showSearch?: boolean;
  /**
   * Renders the page flush to the top so the fixed header floats over its hero.
   * The `hero` named slot is rendered full-bleed, outside the content column.
   */
  hero?: boolean;
  /**
   * Removes top header clearance without rendering the `hero` slot so custom
   * full-bleed page sections can sit directly beneath the floating header.
   */
  flushTop?: boolean;
  /**
   * Renders `<slot />` directly inside `<main>` without a `.layout-container`
   * wrapper so custom pages can compose arbitrary full-bleed bands.
   */
  canvas?: boolean;
  /** Artwork of the entry, already resolved by Astro's image pipeline. */
  image?: ImageMetadata;
  /** Route context used for branded OpenGraph card generation. */
  ogContext?: SocialCardContext;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** URL of the previous page of a paginated listing. */
  prevUrl?: string;
  /** URL of the next page of a paginated listing. */
  nextUrl?: string;
}

const {
  title,
  description,
  locale,
  url,
  activeUrl,
  alternates,
  switcherAlternates,
  noindex = false,
  noPagefind = false,
  showSearch = true,
  hero = false,
  flushTop = false,
  canvas = false,
  image,
  ogContext,
  type = 'website',
  publishedTime,
  modifiedTime,
  schema,
  prevUrl,
  nextUrl,
} = Astro.props;

const meta = getLocaleMeta(locale);
const siteName = resolveLocalizedSiteName(siteConfig, locale, m.site_name({}, { locale }));
const brandThemeCss = buildBrandThemeCss(siteConfig);
const showLanguageSwitcher = siteConfig.ui.showLanguageSwitcher && LOCALES.length > 1;
const { header: headerNav, drawer: drawerNav, footer: footerNav, legal: legalNav } =
  await getNavigationSlots(locale, activeUrl === undefined ? url : (activeUrl ?? ''));
const homeHref = await getHomeHref(locale);
// The call to action points at the content group configured in `ui.ctaPage`
// instead of a hardcoded page: a site without a pricing page keeps its CTA,
// and pointing it at e.g. `contact` is one line of configuration.
const ctaHref = await getPageUrl(siteConfig.ui.ctaPage, locale);
const privacyHref = legalNav.find((item) => item.key === 'privacy')?.href;
const termsHref = legalNav.find((item) => item.key === 'terms')?.href;
const currentYear = new Date().getFullYear();
const effectiveShowSearch = showSearch && siteConfig.ui.showSearch;
const effectiveShowCookies = siteConfig.cookies.enabled;
const navbarConfig = siteConfig.ui.navbar;
const motionConfig = siteConfig.ui.motion;
const stickyHeaderEnabled = siteConfig.ui.stickyHeader;
const effectiveManualBannerOffset = navbarConfig.autoBannerOffset ? 0 : navbarConfig.manualBannerOffset;
const rootStyle = [
  `font-family: ${meta.fontFamily}`,
  `--navbar-initial-top: ${navbarConfig.initialTopOffset}px`,
  `--navbar-sticky-top: ${navbarConfig.stickyTopOffset}px`,
  `--navbar-manual-banner-offset: ${effectiveManualBannerOffset}px`,
  `--top-banner-height: ${effectiveManualBannerOffset}px`,
  `--trig-reveal-delay: ${motionConfig.revealDelayMs}ms`,
  `--trig-duration: ${motionConfig.revealDurationMs}ms`,
  `--trig-ease: ${motionConfig.revealEasing}`,
  `--trig-distance: ${motionConfig.revealDistancePx}px`,
  `--trig-distance-sm: ${motionConfig.revealSmallDistancePx}px`,
].join('; ');

const brandLogo = siteConfig.logo;
const hasLightLogo = Boolean(brandLogo?.light?.trim());
const hasDarkLogo = Boolean(brandLogo?.dark?.trim());
const hasAnyLogo = hasLightLogo || hasDarkLogo;
const logoAlt = brandLogo?.alt?.trim() || siteName;
const showBrandText = !hasAnyLogo || brandLogo?.showText !== false;
const shouldSyncBrandLogoAlt = !showBrandText && !brandLogo?.alt?.trim();
const logoAbsoluteUrl = brandLogo?.light?.trim()
  ? absoluteUrl(brandLogo.light.trim())
  : absoluteUrl(`/${siteConfig.icons[0]?.file ?? 'icon-512.png'}`);

const structuredData = schema ?? [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: absoluteUrl(homeHref),
    description: m.site_description({}, { locale }),
    inLanguage: meta.htmlLang,
  },
  buildOrganizationSchema({
    name: siteName,
    url: absoluteUrl(homeHref),
    description: m.site_description({}, { locale }),
    email: siteConfig.contactEmail || undefined,
    logoUrl: logoAbsoluteUrl,
    inLanguage: meta.htmlLang,
    business: BUSINESS_CONFIG,
    social: SOCIAL_CONFIG,
  }),
];
---

<!doctype html>
<html
  lang={meta.htmlLang}
  dir={meta.dir}
  data-default-theme={siteConfig.defaultTheme}
  data-consent-key={siteConfig.cookies.storageKey}
  data-consent-version={String(siteConfig.cookies.consentVersion)}
  style={rootStyle}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="theme-color"
      content={siteConfig.themeColor}
      data-light-color={siteConfig.themeColor}
      data-dark-color={siteConfig.darkThemeColor}
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        if (typeof document !== 'undefined') {
          document.addEventListener('astro:after-swap', function () {
            document.documentElement.classList.add('js');
          });
        }
        if (typeof window !== 'undefined' && 'onscrollend' in window) {
          try {
            delete window.onscrollend;
          } catch (_) {}
        }
        function resolveTheme() {
          try {
            var stored = window.localStorage.getItem('theme');
            if (stored === 'dark' || stored === 'light') return stored;
          } catch (_) {}
          var fallback = document.documentElement.dataset.defaultTheme || 'system';
          if (fallback === 'dark' || fallback === 'light') return fallback;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        function resolveConsentSnapshot() {
          var key = document.documentElement.dataset.consentKey || 'cookie_consent';
          var expectedVer = Number(document.documentElement.dataset.consentVersion || '1');
          var emptySnapshot = {
            state: 'undecided',
            preferences: 'false',
            analytics: 'false',
            marketing: 'false',
          };
          function parseValidRaw(raw) {
            if (!raw) return null;
            try {
              var parsed = JSON.parse(raw);
              if (
                parsed &&
                parsed.version === expectedVer &&
                parsed.categories &&
                parsed.categories.necessary === true &&
                parsed.expiresAt &&
                Date.parse(parsed.expiresAt) > Date.now()
              ) {
                return {
                  state: 'decided',
                  preferences: String(Boolean(parsed.categories.preferences)),
                  analytics: String(Boolean(parsed.categories.analytics)),
                  marketing: String(Boolean(parsed.categories.marketing)),
                };
              }
              return null;
            } catch (_) {
              return null;
            }
          }
          try {
            var fromStorage = parseValidRaw(window.localStorage.getItem(key));
            if (fromStorage) return fromStorage;
          } catch (_) {}
          try {
            var pairs = (document.cookie || '').split(';');
            for (var i = 0; i < pairs.length; i++) {
              var eq = pairs[i].indexOf('=');
              if (eq > 0 && pairs[i].slice(0, eq).trim() === key) {
                var val = decodeURIComponent(pairs[i].slice(eq + 1).trim());
                var fromCookie = parseValidRaw(val);
                if (fromCookie) return fromCookie;
              }
            }
          } catch (_) {}
          return emptySnapshot;
        }
        function resolveMotion() {
          try {
            var stored = window.localStorage.getItem('motion');
            if (stored === 'reduced' || stored === 'full') return stored;
          } catch (_) {}
          return window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'reduced' : 'full';
        }
        function applyToDocument(doc, theme, consent, motion) {
          doc.documentElement.classList.add('js');
          doc.documentElement.dataset.theme = theme;
          doc.documentElement.dataset.consentState = consent.state;
          doc.documentElement.dataset.consentPreferences = consent.preferences;
          doc.documentElement.dataset.consentAnalytics = consent.analytics;
          doc.documentElement.dataset.consentMarketing = consent.marketing;
          doc.documentElement.dataset.motion = motion;
          var meta = doc.querySelector('meta[name="theme-color"]');
          if (meta) {
            var next = theme === 'dark' ? meta.dataset.darkColor : meta.dataset.lightColor;
            if (next) meta.setAttribute('content', next);
          }
        }
        applyToDocument(document, resolveTheme(), resolveConsentSnapshot(), resolveMotion());
        if (document.documentElement.dataset.themeSwapBound !== 'true') {
          document.documentElement.dataset.themeSwapBound = 'true';
          document.addEventListener('astro:before-swap', function (event) {
            var ds = document.documentElement.dataset;
            var current = ds.theme || resolveTheme();
            var fallbackConsent = resolveConsentSnapshot();
            var currentConsent = {
              state: ds.consentState || fallbackConsent.state,
              preferences: ds.consentPreferences || fallbackConsent.preferences,
              analytics: ds.consentAnalytics || fallbackConsent.analytics,
              marketing: ds.consentMarketing || fallbackConsent.marketing,
            };
            var currentMotion = resolveMotion();
            applyToDocument(event.newDocument, current, currentConsent, currentMotion);
          });
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href={`/${siteConfig.appleTouchIcon}`} />
    <ClientRouter />
    <script is:inline src="/chronotrig.min.js"></script>
    {brandThemeCss && <style is:inline set:html={brandThemeCss} />}
    <Seo
      title={title}
      description={description}
      locale={locale}
      url={url}
      alternates={alternates}
      siteName={siteName}
      image={image}
      ogContext={ogContext}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      schema={structuredData}
      noindex={noindex}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
    />
    <LayoutHooks slot="head" locale={locale} url={url} />
  </head>
  <body
    data-copy-label={m.common_copy_code({}, { locale })}
    data-copied-label={m.common_copied({}, { locale })}
    class="relative bg-bg text-fg min-h-screen flex flex-col antialiased selection:bg-primary/20"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-fg"
    >
      {m.common_skip_to_content({}, { locale })}
    </a>

    {siteConfig.ui.showTopLoadingBar && <TopLoadingBar />}

    <div
      data-site-top-banner-region
      aria-label={m.site_top_banner_region_label({}, { locale })}
      class="relative z-[45] w-full print:hidden"
    >
      <SiteTopBanner locale={locale} url={url} />
      <LayoutHooks slot="top-banner" locale={locale} url={url} />
    </div>
    <script is:inline>
      (function () {
        var DATE_ONLY_RE = /^\d{4}-\d{2}-\d{2}$/;
        function parseBound(value, bound) {
          if (!value) return null;
          var trimmed = String(value).trim();
          if (!trimmed) return null;
          var target = DATE_ONLY_RE.test(trimmed)
            ? bound === 'start'
              ? trimmed + 'T00:00:00.000Z'
              : trimmed + 'T23:59:59.999Z'
            : trimmed;
          var ms = Date.parse(target);
          return isFinite(ms) ? ms : null;
        }
        try {
          var nowMs = Date.now();
          document.querySelectorAll('[data-site-top-banner]').forEach(function (el) {
            var startMs = parseBound(el.getAttribute('data-starts-at'), 'start');
            var endMs = parseBound(el.getAttribute('data-ends-at'), 'end');
            if ((startMs !== null && nowMs < startMs) || (endMs !== null && nowMs >= endMs)) {
              el.hidden = true;
              return;
            }
            if (el.getAttribute('data-dismissible') !== 'true') {
              el.hidden = false;
              return;
            }
            var id = el.getAttribute('data-top-banner-id') || 'site-announcement';
            var mode = el.getAttribute('data-dismiss-mode') === 'persistent' ? 'persistent' : 'session';
            var version = Number(el.getAttribute('data-dismiss-version') || '1') || 1;
            var ttlDays = Number(el.getAttribute('data-dismiss-ttl-days') || '0') || 0;
            var key = 'top-banner-dismissed:' + id;
            var store = mode === 'persistent' ? window.localStorage : window.sessionStorage;
            var raw = store.getItem(key);
            if (!raw) {
              el.hidden = false;
              return;
            }
            if (raw === 'true' && mode === 'session' && version === 1) {
              el.hidden = true;
              return;
            }
            try {
              var parsed = JSON.parse(raw);
              if (parsed.version !== version) {
                store.removeItem(key);
                el.hidden = false;
                return;
              }
              if (mode === 'persistent' && ttlDays > 0) {
                var elapsed = nowMs - Number(parsed.dismissedAt || 0);
                if (!isFinite(elapsed) || elapsed >= ttlDays * 86400000) {
                  store.removeItem(key);
                  el.hidden = false;
                  return;
                }
              }
              el.hidden = true;
            } catch (_) {
              el.hidden = false;
            }
          });
        } catch (_) {}
      })();
    </script>

    <div
      data-header-anchor
      class:list={['z-40 w-full', navbarConfig.autoBannerOffset ? 'relative' : 'static']}
    >
      <header
        data-site-header
        data-sticky-enabled={stickyHeaderEnabled ? 'true' : 'false'}
        data-initial-top={String(navbarConfig.initialTopOffset)}
        data-sticky-threshold={String(navbarConfig.stickyScrollThreshold)}
        data-sticky-top={String(navbarConfig.stickyTopOffset)}
        data-auto-banner-offset={navbarConfig.autoBannerOffset ? 'true' : 'false'}
        data-manual-banner-offset={String(navbarConfig.manualBannerOffset)}
        data-header-stuck="false"
        class="site-header z-40"
      >
      <div class="layout-container">
        <div
          class="glass-surface flex h-14 items-center justify-between gap-3 px-3 sm:h-16 sm:px-4 rounded-full"
        >
          <a
            href={homeHref}
            data-brand-link
            class="flex min-w-0 items-center gap-2 font-bold text-base tracking-tight transition-colors hover:text-primary sm:text-lg"
          >
            {
              hasLightLogo && brandLogo && (
                <img
                  src={brandLogo.light}
                  alt={showBrandText ? '' : logoAlt}
                  width={brandLogo.width}
                  height={brandLogo.height}
                  class="brand-logo-light h-7 w-auto shrink-0 object-contain sm:h-8"
                  data-brand-logo={shouldSyncBrandLogoAlt ? 'true' : undefined}
                  data-has-dark={hasDarkLogo ? 'true' : undefined}
                  decoding="async"
                />
              )
            }
            {
              hasDarkLogo && brandLogo && (
                <img
                  src={brandLogo.dark}
                  alt={showBrandText ? '' : logoAlt}
                  width={brandLogo.width}
                  height={brandLogo.height}
                  class="brand-logo-dark h-7 w-auto shrink-0 object-contain sm:h-8"
                  data-brand-logo={shouldSyncBrandLogoAlt ? 'true' : undefined}
                  decoding="async"
                />
              )
            }
            {showBrandText && <span data-brand-text class="truncate">{siteName}</span>}
            <LayoutHooks slot="brand-badge" locale={locale} url={url} />
          </a>

          <nav
            class="hidden items-center gap-3 text-xs font-medium lg:flex xl:gap-5 xl:text-sm"
            aria-label={m.common_menu({}, { locale })}
          >
            {headerNav.map((item) => <HorizontalNavItem item={item} activeUnderline />)}
          </nav>

          <div class="flex items-center gap-2">
            {
              effectiveShowSearch && (
                <>
                  <IconButton
                    icon="search"
                    size={16}
                    label={m.common_search_placeholder({}, { locale })}
                    data-open-search
                    aria-haspopup="dialog"
                    class="hidden lg:inline-flex"
                  />
                  <IconButton
                    icon="search"
                    size={16}
                    label={m.common_search_placeholder({}, { locale })}
                    data-mobile-search-btn
                    aria-haspopup="dialog"
                    class="lg:hidden"
                  />
                </>
              )
            }

            <div class="hidden lg:flex items-center gap-2">
              {siteConfig.ui.showThemeToggle && <ThemeToggle locale={locale} />}

              {
                showLanguageSwitcher && (
                  <LanguageSwitcher
                    currentLocale={locale}
                    alternates={switcherAlternates ?? alternates}
                  />
                )
              }

              {
                ctaHref && (
                  <Button
                    href={ctaHref}
                    size="sm"
                    data-cta-link="get-started"
                  >
                    {m.common_get_started({}, { locale })}
                  </Button>
                )
              }
            </div>

            <LayoutHooks slot="header-actions" locale={locale} url={url} />

            <IconButton
              icon="menu"
              size={18}
              label={m.common_menu({}, { locale })}
              class="lg:hidden"
              data-mobile-menu-btn
              aria-expanded="false"
              aria-controls="mobile-nav-menu"
            />
          </div>
        </div>
      </div>
      </header>
    </div>

    <!-- Mobile Drawer Overlay -->
    <div
      id="mobile-nav-menu"
      data-mobile-menu
      class="fixed inset-0 z-50 overflow-hidden pointer-events-none lg:hidden"
      role="dialog"
      aria-modal="true"
      aria-label={m.common_menu({}, { locale })}
    >
      <!-- Backdrop with blur -->
      <div
        data-mobile-backdrop
        class="fixed inset-0 bg-scrim backdrop-blur-xs"
        aria-hidden="true"
      ></div>

      <!-- Drawer Panel with independent scrolling -->
      <aside
        data-mobile-panel
        data-lenis-prevent
        inert
        class="fixed inset-y-0 start-0 flex h-full w-84 max-w-[85vw] flex-col bg-surface text-fg shadow-2xl pointer-events-auto sm:w-96"
      >
        <!-- Drawer Header -->
        <div class="flex h-16 shrink-0 items-center justify-between gap-4 border-b border-border px-4 bg-surface">
          <a
            href={homeHref}
            data-brand-link
            class="flex min-w-0 items-center gap-2 font-bold text-lg tracking-tight hover:text-primary transition-colors"
          >
            {
              hasLightLogo && brandLogo && (
                <img
                  src={brandLogo.light}
                  alt={showBrandText ? '' : logoAlt}
                  width={brandLogo.width}
                  height={brandLogo.height}
                  class="brand-logo-light h-7 w-auto shrink-0 object-contain"
                  data-brand-logo={shouldSyncBrandLogoAlt ? 'true' : undefined}
                  data-has-dark={hasDarkLogo ? 'true' : undefined}
                  decoding="async"
                />
              )
            }
            {
              hasDarkLogo && brandLogo && (
                <img
                  src={brandLogo.dark}
                  alt={showBrandText ? '' : logoAlt}
                  width={brandLogo.width}
                  height={brandLogo.height}
                  class="brand-logo-dark h-7 w-auto shrink-0 object-contain"
                  data-brand-logo={shouldSyncBrandLogoAlt ? 'true' : undefined}
                  decoding="async"
                />
              )
            }
            {showBrandText && <span data-brand-text class="truncate">{siteName}</span>}
          </a>
          <IconButton
            icon="close"
            size={18}
            variant="ghost"
            label={m.common_close({}, { locale })}
            data-close-menu
          />
        </div>

        <!-- Two Tabs: Navigation & Search (only rendered when search is enabled) -->
        {
          effectiveShowSearch && (
            <div class="flex border-b border-border bg-surface shrink-0" role="tablist">
              <button
                type="button"
                role="tab"
                id="drawer-tab-btn-nav"
                data-drawer-tab="nav"
                aria-selected="true"
                aria-controls="drawer-panel-nav"
                class="flex flex-1 items-center justify-center gap-2 border-b-2 border-primary py-3 text-sm font-semibold text-primary transition-colors cursor-pointer"
              >
                <Icon name="menu" size={15} />
                <span data-drawer-tab-label="nav">{m.drawer_tab_nav({}, { locale })}</span>
              </button>
              <button
                type="button"
                role="tab"
                id="drawer-tab-btn-search"
                data-drawer-tab="search"
                aria-selected="false"
                aria-controls="drawer-panel-search"
                class="flex flex-1 items-center justify-center gap-2 border-b-2 border-transparent py-3 text-sm font-medium text-muted hover:text-fg transition-colors cursor-pointer"
              >
                <Icon name="search" size={15} />
                <span data-drawer-tab-label="search">{m.drawer_tab_search({}, { locale })}</span>
              </button>
            </div>
          )
        }

        <!-- Scrollable Content with its own scroll capability -->
        <div class="flex-1 overflow-hidden flex flex-col min-h-0 bg-surface">
          <!-- Panel 1: Navigation with inline nested list, dedicated language section, and controls -->
          <div
            id="drawer-panel-nav"
            role={effectiveShowSearch ? 'tabpanel' : undefined}
            aria-labelledby={effectiveShowSearch ? 'drawer-tab-btn-nav' : undefined}
            data-drawer-panel="nav"
            class="flex-1 overflow-y-auto overscroll-contain px-4 py-4 space-y-6 text-sm"
          >
            <!--
              Navigation Links: one continuous tree.

              A branch is a normal row of the same family as a link (icon tile +
              label), and its children hang below it on a guide rule that runs
              from the parent tile's centre. No separate card, border or heading,
              so the submenu does not read as an unrelated block inside the menu.
            -->
            <nav class="space-y-1 font-medium" aria-label={m.common_menu({}, { locale })}>
              {drawerNav.map((item) => <DrawerMenuNode item={item} depth={0} />)}
            </nav>

            <!-- Dedicated Languages Section (NO popups!) -->
            {
              showLanguageSwitcher && (
                <div class="pt-4 border-t border-border space-y-2.5">
                  <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-muted">
                    <Icon name="globe" size={14} />
                    <span data-drawer-lang-heading>{m.common_change_language({}, { locale })}</span>
                  </div>
                  <div class="grid grid-cols-2 gap-2" data-drawer-language-section>
                    {
                      LOCALES.map((loc) => {
                        const meta = LOCALE_METADATA[loc];
                        const targetUrl = (switcherAlternates ?? alternates)[loc];
                        const isCurrent = loc === locale;
                        if (!targetUrl) {
                          return (
                            <span class="flex items-center justify-between rounded-lg border border-border/50 px-3 py-2 text-xs text-muted opacity-40 cursor-not-allowed">
                              <span>{meta.name}</span>
                              <span lang="en" dir="ltr" class="text-[10px] uppercase">{loc}</span>
                            </span>
                          );
                        }
                        return (
                          <a
                            href={targetUrl}
                            data-drawer-lang-link
                            data-target={targetUrl}
                            aria-current={isCurrent ? 'true' : undefined}
                            class:list={[
                              'flex items-center justify-between rounded-lg border px-3 py-2 text-xs transition-colors cursor-pointer',
                              isCurrent
                                ? 'border-primary bg-primary text-primary-fg font-semibold shadow-xs'
                                : 'border-border bg-bg/50 hover:bg-surface-hover hover:border-primary/50 text-fg',
                            ]}
                          >
                            <span class="truncate">{meta.name}</span>
                            <div class="flex items-center gap-1">
                              <span lang="en" dir="ltr" class:list={['text-[10px] uppercase', isCurrent ? 'opacity-90' : 'opacity-60']} data-drawer-lang-code>{loc}</span>
                              <span data-drawer-lang-check class:list={['shrink-0', !isCurrent && 'hidden']}>
                                <Icon name="check" size={12} class="shrink-0" />
                              </span>
                            </div>
                          </a>
                        );
                      })
                    }
                  </div>
                </div>
              )
            }

            <!-- Dedicated Theme Toggle Section -->
            {
              siteConfig.ui.showThemeToggle && (
                <div class="pt-4 border-t border-border flex items-center justify-between gap-3">
                  <span data-drawer-theme-label class="text-xs font-semibold uppercase tracking-wider text-muted">
                    {m.common_theme_toggle({}, { locale })}
                  </span>
                  <ThemeToggle locale={locale} />
                </div>
              )
            }

            {
              effectiveShowCookies && (
                <div class="pt-4 border-t border-border">
                  <button
                    type="button"
                    data-open-cookie-settings
                    aria-haspopup="dialog"
                    class="flex w-full items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-xs font-medium text-muted transition-colors hover:bg-surface-hover hover:text-fg cursor-pointer"
                  >
                    <span class="inline-flex items-center gap-2">
                      <Icon name="shield" size={14} />
                      <span data-cookie-trigger-label>{m.cookie_settings_trigger({}, { locale })}</span>
                    </span>
                    <Icon name="chevron-right" size={13} class="rtl:rotate-180 opacity-60" />
                  </button>
                </div>
              )
            }

            <!-- Get Started CTA -->
            {
              ctaHref && (
                <div class="pt-2 pb-2">
                  <Button href={ctaHref} block data-cta-link="get-started">
                    {m.common_get_started({}, { locale })}
                  </Button>
                </div>
              )
            }
          </div>

          <!-- Panel 2: Search Tab Panel with its own scrolling -->
          {
            effectiveShowSearch && (
              <div
                id="drawer-panel-search"
                role="tabpanel"
                aria-labelledby="drawer-tab-btn-search"
                data-drawer-panel="search"
                class="hidden flex-1 overflow-hidden"
              >
                <DrawerSearch locale={locale} />
              </div>
            )
          }
        </div>
      </aside>
    </div>

    <main
      id="main-content"
      tabindex="-1"
      data-pagefind-body={noPagefind ? undefined : true}
      data-pagefind-ignore={noPagefind ? true : undefined}
      class:list={[
        'flex-1 w-full',
        hero || flushTop ? 'pt-0' : 'main-header-clearance',
      ]}
    >
      {/* Full-bleed hero: rendered outside the content column so it spans the viewport. */}
      {hero && <slot name="hero" />}

      {
        canvas ? (
          <slot />
        ) : (
          <div
            class:list={[
              'layout-container pb-12 md:pb-16',
              hero && 'pt-10 sm:pt-12',
            ]}
          >
            <slot />
          </div>
        )
      }
    </main>

    <footer class="border-t border-border bg-surface mt-auto pt-12 pb-8">
      <div class="layout-container">
        <LayoutHooks slot="footer-top" locale={locale} url={url} />
        <!-- Multi-Column Footer Navigation Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 pb-10 border-b border-border/80">
          <!-- Column 1: Brand & Tagline -->
          <div class="space-y-3 sm:col-span-2 md:col-span-1">
            <a
              href={homeHref}
              data-brand-link
              class="inline-flex items-center gap-2 font-bold text-base tracking-tight hover:text-primary transition-colors"
            >
              {
                hasLightLogo && brandLogo && (
                  <img
                    src={brandLogo.light}
                    alt={showBrandText ? '' : logoAlt}
                    width={brandLogo.width}
                    height={brandLogo.height}
                    class="brand-logo-light h-7 w-auto shrink-0 object-contain"
                    data-brand-logo={shouldSyncBrandLogoAlt ? 'true' : undefined}
                    data-has-dark={hasDarkLogo ? 'true' : undefined}
                    decoding="async"
                  />
                )
              }
              {
                hasDarkLogo && brandLogo && (
                  <img
                    src={brandLogo.dark}
                    alt={showBrandText ? '' : logoAlt}
                    width={brandLogo.width}
                    height={brandLogo.height}
                    class="brand-logo-dark h-7 w-auto shrink-0 object-contain"
                    data-brand-logo={shouldSyncBrandLogoAlt ? 'true' : undefined}
                    decoding="async"
                  />
                )
              }
              {showBrandText && <span data-brand-text>{siteName}</span>}
            </a>
            <p data-footer-tagline class="text-xs text-muted leading-relaxed max-w-xs">
              {m.site_description({}, { locale })}
            </p>
          </div>

          <!-- Columns 2, 3, 4: Dynamic Navigation Columns -->
          {
            footerNav.map((col) => (
              <div class="space-y-3">
                <span
                  data-footer-col={col.key}
                  class="block text-xs font-semibold uppercase tracking-wider text-muted"
                >
                  {col.title}
                </span>
                <ul class="space-y-2 text-xs">
                  {col.items.map((item) => (
                    <FooterMenuNode item={item} />
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <!-- Bottom Bar: Rights & Legal Links -->
        <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted">
          <div id="footer-rights">
            © <span data-current-year data-locale={locale}>{formatYear(currentYear, locale)}</span> {siteName}.
            <span data-footer-rights>{m.common_all_rights_reserved({}, { locale })}</span>
          </div>

          {
            (legalNav.length > 0 || effectiveShowCookies) && (
              <nav class="flex flex-wrap items-center gap-4 text-xs" aria-label={m.footer_col_legal({}, { locale })}>
                {legalNav.map((item) => (
                  <a
                    href={item.href}
                    data-nav-link={item.key}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                    class="hover:underline transition-colors hover:text-fg"
                  >
                    {item.label}
                  </a>
                ))}
                {effectiveShowCookies && (
                  <button
                    type="button"
                    data-open-cookie-settings
                    aria-haspopup="dialog"
                    class="hover:underline transition-colors hover:text-fg cursor-pointer"
                  >
                    <span data-cookie-trigger-label>{m.cookie_settings_trigger({}, { locale })}</span>
                  </button>
                )}
              </nav>
            )
          }
        </div>
        <LayoutHooks slot="footer-bottom" locale={locale} url={url} />
      </div>
    </footer>

    {effectiveShowSearch && <SearchModal locale={locale} />}
    <QuickContactWidget locale={locale} />
    {
      effectiveShowCookies && (
        <CookieConsent locale={locale} privacyHref={privacyHref} termsHref={termsHref} />
      )
    }
    <AnalyticsScripts />
    {DevThemePreview && <DevThemePreview locale={locale} />}

    <!--
      Icons a script has to place later. The code-copy button is built at
      runtime and shows two states; its markup is rendered here by `Icon` and
      cloned, so client code never carries a second copy of the SVG paths.
    -->
    <template data-icon-template="code-copy">
      <Icon name="copy" size={14} class="code-copy-copy" />
      <Icon name="check" size={14} class="code-copy-check" />
    </template>

    <style>
      :where(a, button, input, select, textarea):focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }
    </style>

    <script>
      import { formatYear } from '@/i18n/format';
      import '@/scripts/lenis';
      import '@/scripts/navbar';
      import '@/scripts/chronotrig';

      function updateYear() {
        const year = new Date().getFullYear();
        document.querySelectorAll<HTMLElement>('[data-current-year]').forEach((el) => {
          const activeLocale = el.dataset.locale || document.documentElement.lang || 'en';
          el.textContent = formatYear(year, activeLocale);
        });
      }

      function setupDesktopDropdowns() {
        const bindMenuUnit = (
          wrapper: HTMLElement,
          triggerSelector: string,
          menuSelector: string
        ) => {
          if (wrapper.dataset.bound === 'true') return;
          wrapper.dataset.bound = 'true';

          const trigger = wrapper.querySelector<HTMLButtonElement>(triggerSelector);
          const menu = wrapper.querySelector<HTMLElement>(menuSelector);
          if (!trigger || !menu) return;

          const setOpen = (open: boolean) => {
            trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (open) {
              delete menu.dataset.forceClosed;
            }
          };

          wrapper.addEventListener('mouseenter', () => setOpen(true));
          wrapper.addEventListener('mouseleave', () => {
            delete menu.dataset.forceClosed;
            trigger.setAttribute('aria-expanded', 'false');
          });

          wrapper.addEventListener('focusin', () => {
            if (menu.dataset.forceClosed !== 'true') {
              setOpen(true);
            }
          });
          wrapper.addEventListener('focusout', (event) => {
            const next = event.relatedTarget as Node | null;
            if (!next || !wrapper.contains(next)) {
              delete menu.dataset.forceClosed;
              trigger.setAttribute('aria-expanded', 'false');
            }
          });

          trigger.addEventListener('click', () => {
            const currentlyClosed =
              menu.dataset.forceClosed === 'true' ||
              trigger.getAttribute('aria-expanded') !== 'true';
            if (currentlyClosed) {
              setOpen(true);
            } else {
              menu.dataset.forceClosed = 'true';
              trigger.setAttribute('aria-expanded', 'false');
            }
          });

          wrapper.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
              event.stopPropagation();
              menu.dataset.forceClosed = 'true';
              trigger.setAttribute('aria-expanded', 'false');
              trigger.focus();
            } else if (event.key === 'ArrowDown' && document.activeElement === trigger) {
              event.preventDefault();
              setOpen(true);
              const firstItem = menu.querySelector<HTMLElement>('a[href], button');
              firstItem?.focus();
            }
          });
        };

        document.querySelectorAll<HTMLElement>('[data-dropdown-item]').forEach((item) => {
          bindMenuUnit(item, '[data-dropdown-trigger]', '[data-dropdown-menu]');
        });
        document.querySelectorAll<HTMLElement>('[data-subdropdown-item]').forEach((item) => {
          bindMenuUnit(item, '[data-subdropdown-trigger]', '[data-subdropdown-menu]');
        });
      }

      function setupDisclosureTriggers() {
        document.querySelectorAll<HTMLButtonElement>('[data-disclosure-trigger]').forEach((btn) => {
          if (btn.dataset.bound === 'true') return;
          btn.dataset.bound = 'true';
          btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('aria-controls');
            const panel = targetId ? document.getElementById(targetId) : null;
            if (!panel) return;
            const nextOpen = btn.getAttribute('aria-expanded') !== 'true';
            btn.setAttribute('aria-expanded', nextOpen ? 'true' : 'false');
            panel.hidden = !nextOpen;
          });
        });
      }

      function setupMobileMenu() {
        const menuBtn = document.querySelector<HTMLButtonElement>('[data-mobile-menu-btn]');
        const mobileSearchBtn = document.querySelector<HTMLButtonElement>('[data-mobile-search-btn]');
        const drawer = document.querySelector<HTMLElement>('[data-mobile-menu]');
        if (!drawer || drawer.dataset.bound === 'true') return;
        drawer.dataset.bound = 'true';

        const abortController = new AbortController();
        document.addEventListener(
          'astro:before-swap',
          () => abortController.abort(),
          { once: true }
        );

        const backdrop = drawer.querySelector<HTMLElement>('[data-mobile-backdrop]');
        const panel = drawer.querySelector<HTMLElement>('[data-mobile-panel]');
        const closeBtn = drawer.querySelector<HTMLButtonElement>('[data-close-menu]');
        let lastFocused: HTMLElement | null = null;

        const setBackgroundInert = (active: boolean) => {
          document
            .querySelectorAll<HTMLElement>(
              '[data-site-top-banner-region], header, main, footer, [data-search-modal], [data-cookie-root]'
            )
            .forEach((el) => {
              el.inert = active;
            });
        };

        const getFocusableInPanel = (): HTMLElement[] => {
          if (!panel) return [];
          const selector =
            'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
          return [...panel.querySelectorAll<HTMLElement>(selector)].filter(
            (el) => !el.closest('.hidden, [hidden]') && el.getClientRects().length > 0
          );
        };

        function switchTab(targetTab: 'nav' | 'search') {
          const tabNav = drawer?.querySelector<HTMLButtonElement>('[data-drawer-tab="nav"]');
          const tabSearch = drawer?.querySelector<HTMLButtonElement>('[data-drawer-tab="search"]');
          const panelNav = drawer?.querySelector<HTMLElement>('[data-drawer-panel="nav"]');
          const panelSearch = drawer?.querySelector<HTMLElement>('[data-drawer-panel="search"]');
          const isNav = targetTab === 'nav' || !tabSearch || !panelSearch;

          if (tabNav && tabSearch && panelNav && panelSearch) {
            tabNav.setAttribute('aria-selected', isNav ? 'true' : 'false');
            tabNav.classList.toggle('border-primary', isNav);
            tabNav.classList.toggle('text-primary', isNav);
            tabNav.classList.toggle('font-semibold', isNav);
            tabNav.classList.toggle('border-transparent', !isNav);
            tabNav.classList.toggle('text-muted', !isNav);

            tabSearch.setAttribute('aria-selected', !isNav ? 'true' : 'false');
            tabSearch.classList.toggle('border-primary', !isNav);
            tabSearch.classList.toggle('text-primary', !isNav);
            tabSearch.classList.toggle('font-semibold', !isNav);
            tabSearch.classList.toggle('border-transparent', isNav);
            tabSearch.classList.toggle('text-muted', isNav);

            panelNav.classList.toggle('hidden', !isNav);
            panelSearch.classList.toggle('hidden', isNav);

            if (!isNav) {
              const searchInput = panelSearch.querySelector<HTMLInputElement>('[data-drawer-search-input]');
              setTimeout(() => searchInput?.focus(), 320);
            }
          }
        }

        const open = (tab: 'nav' | 'search' = 'nav') => {
          if (drawer.classList.contains('is-open')) {
            switchTab(tab);
            return;
          }

          lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
          switchTab(tab);
          menuBtn?.setAttribute('aria-expanded', 'true');
          document.documentElement.style.overflow = 'hidden';
          document.body.style.overflow = 'hidden';
          setBackgroundInert(true);
          if (panel) panel.inert = false;
          drawer.classList.add('is-open');

          if (tab !== 'search') {
            requestAnimationFrame(() => closeBtn?.focus());
          }
        };

        const close = ({ restoreFocus = true }: { restoreFocus?: boolean } = {}) => {
          if (!drawer.classList.contains('is-open')) return;

          menuBtn?.setAttribute('aria-expanded', 'false');
          document.documentElement.style.overflow = '';
          document.body.style.overflow = '';
          setBackgroundInert(false);
          if (panel) panel.inert = true;
          drawer.classList.remove('is-open');

          if (restoreFocus) {
            const target = lastFocused && lastFocused.isConnected ? lastFocused : menuBtn;
            target?.focus();
          }
          lastFocused = null;
        };

        menuBtn?.addEventListener('click', () => open('nav'));
        mobileSearchBtn?.addEventListener('click', () => open('search'));
        closeBtn?.addEventListener('click', () => close());
        backdrop?.addEventListener('click', () => close());

        document.addEventListener(
          'keydown',
          (event) => {
            if (!drawer.classList.contains('is-open')) return;
            if (event.key === 'Escape') {
              event.preventDefault();
              close();
              return;
            }
            if (event.key === 'Tab') {
              const focusables = getFocusableInPanel();
              if (focusables.length === 0) {
                event.preventDefault();
                return;
              }
              const first = focusables[0];
              const last = focusables[focusables.length - 1];
              const active = document.activeElement as HTMLElement | null;
              if (event.shiftKey && (!active || active === first || !panel?.contains(active))) {
                event.preventDefault();
                last.focus();
              } else if (!event.shiftKey && (!active || active === last || !panel?.contains(active))) {
                event.preventDefault();
                first.focus();
              }
            }
          },
          { signal: abortController.signal }
        );

        const desktopMq = window.matchMedia('(min-width: 1024px)');
        desktopMq.addEventListener(
          'change',
          (event) => {
            if (event.matches) close({ restoreFocus: false });
          },
          { signal: abortController.signal }
        );

        document.addEventListener(
          'app:close-drawer',
          () => close({ restoreFocus: false }),
          { signal: abortController.signal }
        );

        drawer.querySelectorAll<HTMLButtonElement>('[data-drawer-tab]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const tabName = btn.dataset.drawerTab === 'search' ? 'search' : 'nav';
            switchTab(tabName);
          });
        });

        drawer.querySelectorAll<HTMLAnchorElement>('[data-drawer-lang-link]').forEach((link) => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const target = link.getAttribute('data-target') || link.href;
            if (target) {
              close({ restoreFocus: false });
              window.location.assign(target);
            }
          });
        });

        drawer.querySelectorAll<HTMLAnchorElement>('a[href]:not([data-drawer-lang-link])').forEach((link) => {
          link.addEventListener('click', () => {
            close({ restoreFocus: false });
          });
        });
      }

      function setupCodeCopyButtons() {
        const copyLabel = document.body.dataset.copyLabel || 'Copy code';
        const copiedLabel = document.body.dataset.copiedLabel || 'Copied!';
        const iconTemplate = document.querySelector<HTMLTemplateElement>(
          'template[data-icon-template="code-copy"]'
        );

        document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
          if (pre.dataset.copyBound === 'true') return;
          pre.dataset.copyBound = 'true';

          const wrapper = document.createElement('div');
          wrapper.className = 'code-block-wrapper';
          pre.parentNode?.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-copy-btn';
          btn.setAttribute('data-pagefind-ignore', 'true');
          btn.setAttribute('aria-label', copyLabel);
          btn.title = copyLabel;

          if (iconTemplate) btn.append(iconTemplate.content.cloneNode(true));

          let resetTimer = 0;
          btn.addEventListener('click', async () => {
            const source = (pre.querySelector('code') ?? pre).textContent ?? '';
            try {
              await navigator.clipboard.writeText(source);
              window.clearTimeout(resetTimer);
              btn.dataset.copied = 'true';
              btn.setAttribute('aria-label', copiedLabel);
              btn.title = copiedLabel;
              resetTimer = window.setTimeout(() => {
                delete btn.dataset.copied;
                btn.setAttribute('aria-label', copyLabel);
                btn.title = copyLabel;
              }, 1800);
            } catch {
              // Clipboard API may be unavailable in non-secure contexts; fail silently.
            }
          });

          wrapper.appendChild(btn);
        });
      }

      if (document.documentElement.dataset.baseLayoutBound !== 'true') {
        document.documentElement.dataset.baseLayoutBound = 'true';
        document.addEventListener('astro:page-load', () => {
          updateYear();
          setupDesktopDropdowns();
          setupDisclosureTriggers();
          setupMobileMenu();
          setupCodeCopyButtons();
        });
        document.addEventListener('astro:before-preparation', () => {
          document.dispatchEvent(new CustomEvent('app:close-drawer'));
        });
      }

      updateYear();
      setupDesktopDropdowns();
      setupDisclosureTriggers();
      setupMobileMenu();
      setupCodeCopyButtons();
    </script>
  </body>
</html>
