---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import type { Locale } from '@/i18n/locales';
import { formatDate, formatNumber } from '@/i18n/format';
import { getReadingTime } from '@/libs/content/blog';
import { getCategoryLabel, getTagLabel } from '@/libs/content/taxonomy';
import * as m from '@/paraglide/messages';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: Locale;
  href: string;
  /** Loads the cover eagerly; use only for the first card above the fold. */
  priority?: boolean;
}

const { post, locale, href, priority = false } = Astro.props;

const { title, description, image, categories, tags, publishedAt } = post.data;
// `image` is the metadata Astro resolved from the entry's frontmatter.
const cover = image;
/**
 * Renditions offered to the browser. The card is at most ~310px wide, so the
 * list covers 1x and 2x of that. It never asks for more than the source has
 * and always contains the source width itself, so a small cover is served at
 * its native size instead of being scaled up.
 */
const coverWidths = cover
  ? [...new Set([320, 480, 640, 800, cover.width])]
      .filter((width) => width <= cover.width)
      .sort((a, b) => a - b)
  : [];
const category = categories[0];
const formattedDate = formatDate(publishedAt, locale, 'short');
const readingTime = getReadingTime(post.body);
const visibleTags = tags.slice(0, 2);
const hiddenTagCount = tags.length - visibleTags.length;
---

<article
  class="reveal group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-xs transition duration-200 hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-lg focus-within:border-primary/60 focus-within:ring-2 focus-within:ring-primary/30"
  data-reveal="up"
  data-post-card
  data-categories={categories.join(' ')}
  data-tags={tags.join(' ')}
>
  <div class="relative aspect-[16/9] overflow-hidden bg-linear-to-br from-primary/20 via-surface-hover to-accent/15">
    {
      cover ? (
        <Image
          src={cover}
          alt=""
          widths={coverWidths}
          sizes="(min-width: 1024px) 310px, (min-width: 640px) 50vw, 100vw"
          format="webp"
          quality={75}
          layout="constrained"
          loading={priority ? 'eager' : 'lazy'}
          decoding={priority ? 'sync' : 'async'}
          fetchpriority={priority ? 'high' : 'auto'}
          class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-primary/40">
          <Icon name="globe" size={44} />
        </div>
      )
    }
    {category && (
      <span class="hero-badge absolute bottom-3 start-3">
        {getCategoryLabel(category, locale)}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col gap-2.5 p-5">
    <h2 class="line-clamp-2 text-lg font-bold leading-snug tracking-tight text-fg">
      <a
        href={href}
        class="transition-colors after:absolute after:inset-0 hover:text-primary focus-visible:outline-none"
      >
        {title}
      </a>
    </h2>

    {description && <p class="line-clamp-2 text-sm leading-relaxed text-muted">{description}</p>}

    {
      visibleTags.length > 0 && (
        <ul class="flex flex-wrap items-center gap-1.5 text-[11px] text-muted">
          {visibleTags.map((tag) => (
            <li class="chip px-2 py-0.5 text-[11px]">
              {getTagLabel(tag, locale)}
            </li>
          ))}
          {hiddenTagCount > 0 && (
            <li class="chip px-2 py-0.5 text-[11px]">
              +{formatNumber(hiddenTagCount, locale)}
            </li>
          )}
        </ul>
      )
    }

    <div class="mt-auto flex flex-wrap items-center gap-x-2 gap-y-1 pt-2 text-xs text-muted">
      <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
      <span aria-hidden="true">·</span>
      <span>{m.blog_read_time({ count: formatNumber(readingTime, locale) }, { locale })}</span>
    </div>
  </div>
</article>
