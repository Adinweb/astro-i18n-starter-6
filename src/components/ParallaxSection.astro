---
/**
 * Composable section / card block with a ChronoTrig scroll-driven parallax
 * background image. Supports full-bleed bands (`variant="full"`) and rounded
 * contained cards (`variant="card"` or `contained`), RTL-safe scrims, reduced
 * motion / print flattening, and Paraglide-localized defaults.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '@/components/Button.astro';
import PageSection from '@/components/PageSection.astro';
import type { Locale } from '@/i18n/locales';
import { DEFAULT_HERO_IMAGE } from '@/libs/config/app';
import { getHomeHref, getPageUrl } from '@/libs/content/service';
import { resolveComponentLocale } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

export interface ParallaxAction {
  label: string;
  href: string;
  icon?: string;
  external?: boolean;
}

interface Props {
  id?: string;
  locale?: Locale | string;
  image?: ImageMetadata;
  imageAlt?: string;
  eyebrow?: string | null;
  title?: string;
  description?: string | null;
  primaryCta?: ParallaxAction | null;
  secondaryCta?: ParallaxAction | null;
  variant?: 'full' | 'card';
  align?: 'start' | 'center';
  speed?: 'subtle' | 'medium' | 'deep';
  height?: 'sm' | 'md' | 'lg';
  overlay?: 'gradient' | 'dark' | 'subtle';
  blur?: boolean;
  priority?: boolean;
  contained?: boolean;
  surface?: 'default' | 'surface' | 'subtle';
  spacing?: 'none' | 'sm' | 'md' | 'lg';
}

const {
  id,
  locale,
  image,
  imageAlt = '',
  eyebrow,
  title,
  description,
  primaryCta,
  secondaryCta,
  variant = 'full',
  align = 'start',
  speed = 'medium',
  height = 'md',
  overlay = 'gradient',
  blur = false,
  priority = false,
  contained = false,
  surface = 'default',
  spacing = 'md',
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = title === undefined;

const [featuresHref, componentsHref, homeHref] =
  usingDefaults && (primaryCta === undefined || secondaryCta === undefined)
    ? await Promise.all([
        getPageUrl('features', activeLocale),
        getPageUrl('components', activeLocale),
        getHomeHref(activeLocale),
      ])
    : [null, null, ''];

const resolvedEyebrow =
  eyebrow === null
    ? undefined
    : (eyebrow ??
      (usingDefaults ? m.block_parallax_eyebrow({}, { locale: activeLocale }) : undefined));
const resolvedTitle = title ?? m.block_parallax_heading({}, { locale: activeLocale });
const resolvedDescription =
  description === null
    ? undefined
    : (description ??
      (usingDefaults ? m.block_parallax_desc({}, { locale: activeLocale }) : undefined));
const resolvedPrimaryCta =
  primaryCta === null
    ? undefined
    : (primaryCta ??
      (usingDefaults
        ? {
            label: m.block_parallax_cta_primary({}, { locale: activeLocale }),
            href: componentsHref ?? featuresHref ?? homeHref,
            icon: 'arrow-right',
          }
        : undefined));
const resolvedSecondaryCta =
  secondaryCta === null
    ? undefined
    : (secondaryCta ??
      (usingDefaults && featuresHref
        ? {
            label: m.block_parallax_cta_secondary({}, { locale: activeLocale }),
            href: featuresHref,
          }
        : undefined));

const background = image ?? DEFAULT_HERO_IMAGE;
const isCard = contained || variant === 'card';
const isCentered = align === 'center';
const hasSlot = Astro.slots.has('default');

const widths = [
  ...new Set([480, 768, 1024, 1280, 1920, 2560, background.width]),
]
  .filter((width) => width <= background.width)
  .sort((a, b) => a - b);

const HEIGHT_CLASSES = {
  sm: isCard ? 'min-h-[16rem] py-10 sm:min-h-[19rem] sm:py-12' : 'min-h-[18rem] py-12 sm:min-h-[21rem] sm:py-16',
  md: isCard ? 'min-h-[21rem] py-12 sm:min-h-[25rem] sm:py-16' : 'min-h-[24rem] py-16 sm:min-h-[29rem] sm:py-24',
  lg: isCard ? 'min-h-[26rem] py-14 sm:min-h-[30rem] sm:py-20' : 'min-h-[30rem] py-20 sm:min-h-[36rem] sm:py-28',
} as const;
---

<PageSection
  id={id}
  surface={surface}
  spacing={contained || variant === 'full' ? 'none' : spacing}
  bleed={contained || variant === 'full'}
  class={contained ? 'not-prose my-10' : undefined}
>
  <div
    data-parallax-stage
    data-parallax-speed={speed}
    class:list={[
      'not-prose relative isolate overflow-hidden bg-hero-base text-hero-fg print:bg-bg print:text-fg',
      isCard
        ? 'rounded-3xl border border-hero-fg/15 shadow-lg print:border-border print:shadow-none'
        : 'border-y border-hero-fg/10 print:border-border',
    ]}
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 overflow-hidden rounded-[inherit] [transform:translateZ(0)] print:hidden"
    >
      <div data-parallax-media>
        <Image
          src={background}
          alt={imageAlt}
          widths={widths}
          sizes={isCard ? '(min-width: 1280px) 1200px, 100vw' : '100vw'}
          format="webp"
          quality={75}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          class:list={[
            'h-full w-full object-cover',
            blur && 'blur-sm',
          ]}
        />
      </div>

      {
        overlay === 'dark' ? (
          <>
            <div class="absolute inset-0 bg-hero-base/50" />
            <div class="absolute inset-0 bg-linear-to-t from-hero-base/70 via-transparent to-hero-base/25" />
          </>
        ) : overlay === 'subtle' ? (
          <>
            <div class="absolute inset-0 bg-hero-base/15" />
            <div class="absolute inset-0 bg-linear-to-t from-hero-base/65 via-hero-base/20 to-transparent" />
          </>
        ) : (
          <>
            <div class="absolute inset-0 bg-hero-base/20" />
            <div class="absolute inset-0 bg-linear-to-t from-hero-base/75 from-5% via-hero-base/35 via-50% to-hero-base/15" />
            {!isCentered && (
              <div class="absolute inset-0 bg-linear-to-r from-hero-base/85 from-10% via-hero-base/45 via-55% to-transparent rtl:bg-linear-to-l" />
            )}
          </>
        )
      }
    </div>

    <div
      class:list={[
        'relative flex flex-col justify-center',
        isCard ? 'px-6 sm:px-10 lg:px-14' : 'layout-container',
        HEIGHT_CLASSES[height],
      ]}
    >
      <div
        class:list={[
          isCentered ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl text-start',
        ]}
        data-trig-stagger
        data-trig-stagger-mode="linear"
        data-trig-stagger-delay="0.08"
        data-trig-once="true"
      >
        {
          resolvedEyebrow && (
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent print:text-primary rtl:tracking-normal">
              {resolvedEyebrow}
            </p>
          )
        }

        <h2
          class="fadeInUpSm mt-2 text-2xl font-bold tracking-tight text-hero-fg text-balance print:text-fg sm:text-3xl lg:text-4xl"
          data-trig
          data-trig-once="true"
        >
          {resolvedTitle}
        </h2>

        {
          resolvedDescription && (
            <p
              class:list={[
                'mt-4 text-base leading-relaxed text-hero-fg/90 text-pretty print:text-muted sm:text-lg',
                isCentered && 'mx-auto max-w-2xl',
              ]}
            >
              {resolvedDescription}
            </p>
          )
        }

        {
          (resolvedPrimaryCta || resolvedSecondaryCta) && (
            <div
              class:list={[
                'mt-7 flex flex-wrap items-center gap-3 print:hidden',
                isCentered ? 'justify-center' : 'justify-start',
              ]}
            >
              {resolvedPrimaryCta && (
                <Button
                  href={resolvedPrimaryCta.href}
                  variant="primary"
                  size="lg"
                  glow
                  icon={resolvedPrimaryCta.icon ?? 'arrow-right'}
                  external={resolvedPrimaryCta.external}
                >
                  {resolvedPrimaryCta.label}
                </Button>
              )}

              {resolvedSecondaryCta && (
                <Button
                  href={resolvedSecondaryCta.href}
                  variant="hero"
                  size="lg"
                  external={resolvedSecondaryCta.external}
                >
                  {resolvedSecondaryCta.label}
                </Button>
              )}
            </div>
          )
        }
      </div>

      {
        hasSlot && (
          <div class="mt-8 w-full">
            <slot />
          </div>
        )
      }
    </div>
  </div>
</PageSection>

<script>
  const SPEED_AMPLITUDE_PX: Record<string, number> = {
    subtle: 76,
    medium: 135,
    deep: 195,
  };
  const SMOOTH_LAMBDA = 24;

  let cleanupParallax: (() => void) | null = null;

  interface ParallaxEntry {
    stage: HTMLElement;
    media: HTMLElement;
    amplitude: number;
    currentY: number;
    targetY: number;
    lastWrittenY: number;
    initialized: boolean;
    isVisible: boolean;
  }

  function getNow(): number {
    return typeof performance !== 'undefined' ? performance.now() : Date.now();
  }

  function isMotionReduced(): boolean {
    const explicit = document.documentElement.dataset.motion;
    if (explicit === 'reduced') {
      return true;
    }

    const mobileDisabled =
      typeof window.chronoTrig?.getMobileBehavior === 'function' &&
      typeof window.chronoTrig?.isMobile === 'function' &&
      window.chronoTrig.getMobileBehavior() === 'disable' &&
      window.chronoTrig.isMobile();

    if (mobileDisabled) {
      return true;
    }

    if (explicit === 'full') {
      return false;
    }

    if (document.body.classList.contains('chronotrig-mobile-disabled')) {
      return true;
    }

    try {
      return Boolean(window.chronoTrig?.isDisabled?.());
    } catch {
      return false;
    }
  }

  function clamp(min: number, max: number, value: number): number {
    return Math.max(min, Math.min(max, value));
  }

  function destroyParallaxStages(): void {
    cleanupParallax?.();
    cleanupParallax = null;
  }

  function initParallaxStages(): void {
    destroyParallaxStages();

    const stageNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax-stage]'));
    if (stageNodes.length === 0) return;

    const hasIO = typeof IntersectionObserver === 'function';

    const entries = stageNodes
      .map((stage): ParallaxEntry | null => {
        const media = stage.querySelector<HTMLElement>('[data-parallax-media]');
        if (!media) return null;
        const speedKey = stage.dataset.parallaxSpeed ?? 'medium';
        const amplitude = SPEED_AMPLITUDE_PX[speedKey] ?? SPEED_AMPLITUDE_PX.medium;
        stage.dataset.parallaxActive = hasIO ? 'false' : 'true';
        return {
          stage,
          media,
          amplitude,
          currentY: 0,
          targetY: 0,
          lastWrittenY: Number.NaN,
          initialized: false,
          isVisible: !hasIO,
        };
      })
      .filter((item): item is ParallaxEntry => item !== null);

    if (entries.length === 0) return;

    const entryMap = new Map<HTMLElement, ParallaxEntry>(entries.map((e) => [e.stage, e]));

    let rafId = 0;
    let snapRafId = 0;
    let lastStepTime = 0;
    let hasPendingMotion = false;

    const resetAll = () => {
      hasPendingMotion = false;
      for (const entry of entries) {
        entry.currentY = 0;
        entry.targetY = 0;
        entry.stage.dataset.parallaxActive = 'false';
        if (!entry.initialized || entry.lastWrittenY !== 0) {
          entry.media.style.setProperty('--parallax-y', '0px');
          entry.lastWrittenY = 0;
          entry.initialized = true;
        }
      }
    };

    const step = (now: number, snap: boolean): boolean => {
      if (isMotionReduced()) {
        resetAll();
        lastStepTime = Math.max(lastStepTime, now);
        return true;
      }

      if (!snap && lastStepTime !== 0 && now - lastStepTime < 2) {
        return !hasPendingMotion;
      }

      const dt = lastStepTime > 0 ? clamp(0.001, 0.05, (now - lastStepTime) / 1000) : 1 / 60;
      lastStepTime = Math.max(lastStepTime, now);
      const alpha = snap ? 1 : 1 - Math.exp(-SMOOTH_LAMBDA * dt);

      const vh = window.innerHeight || document.documentElement.clientHeight || 800;
      let pending = false;

      for (const entry of entries) {
        // Never call getBoundingClientRect() on off-screen stages during scroll ticks
        if (!snap && !entry.isVisible) {
          continue;
        }

        const rect = entry.stage.getBoundingClientRect();
        if (rect.height <= 0) {
          continue;
        }

        const stageCenter = rect.top + rect.height * 0.5;
        const halfTravel = Math.max(1, (vh + rect.height) * 0.5);
        const normalized = clamp(-1, 1, (vh * 0.5 - stageCenter) / halfTravel);
        // Never exceed the 38% CSS overscan buffer + 1.06 scale inside the stage container
        const safeAmplitude = Math.min(entry.amplitude, Math.max(40, rect.height * 0.37));
        const targetY = normalized * safeAmplitude;
        entry.targetY = targetY;

        const diff = targetY - entry.currentY;
        const nextY = snap || Math.abs(diff) <= 0.15 ? targetY : entry.currentY + diff * alpha;
        entry.currentY = nextY;

        if (!entry.initialized || Math.abs(nextY - entry.lastWrittenY) >= 0.05) {
          entry.media.style.setProperty('--parallax-y', `${nextY.toFixed(2)}px`);
          entry.lastWrittenY = nextY;
          entry.initialized = true;
        }

        if (Math.abs(targetY - nextY) > 0.15) {
          pending = true;
        }
      }

      hasPendingMotion = pending;
      return !pending;
    };

    const tick = (frameTime?: number) => {
      rafId = 0;
      const now = typeof frameTime === 'number' ? frameTime : getNow();
      const settled = step(now, false);
      if (!settled) {
        rafId = requestAnimationFrame(tick);
      }
    };

    const onScrollTick = () => {
      if (!isMotionReduced() && !entries.some((e) => e.isVisible)) {
        return;
      }
      const settled = step(getNow(), false);
      if (!settled && rafId === 0) {
        rafId = requestAnimationFrame(tick);
      }
    };

    const scheduleSnap = () => {
      if (snapRafId !== 0) return;
      snapRafId = requestAnimationFrame((frameTime) => {
        snapRafId = 0;
        const now = typeof frameTime === 'number' ? frameTime : getNow();
        step(now, true);
      });
    };

    const onMotionChange = () => {
      step(getNow(), true);
    };

    const intersectionObserver = hasIO
      ? new IntersectionObserver(
          (ioEntries) => {
            let becameVisible = false;
            const reduced = isMotionReduced();
            for (const ioEntry of ioEntries) {
              const entry = entryMap.get(ioEntry.target as HTMLElement);
              if (!entry) continue;
              const wasVisible = entry.isVisible;
              entry.isVisible = ioEntry.isIntersecting;
              entry.stage.dataset.parallaxActive = ioEntry.isIntersecting && !reduced ? 'true' : 'false';
              if (ioEntry.isIntersecting && !wasVisible) {
                becameVisible = true;
              }
            }
            if (becameVisible) {
              step(getNow(), true);
            }
          },
          {
            root: null,
            rootMargin: '180px 0px 180px 0px',
            threshold: 0,
          }
        )
      : null;

    if (intersectionObserver) {
      for (const entry of entries) {
        intersectionObserver.observe(entry.stage);
      }
    }

    // Initial synchronous snap across all stages (pre-clamps off-screen stages cleanly) + next-frame paint alignment
    step(getNow(), true);
    scheduleSnap();

    const unsubscribeChronoTrig = window.chronoTrig?.subscribe?.(onScrollTick);
    window.addEventListener('lenis:scroll', onScrollTick);
    window.addEventListener('scroll', onScrollTick, { passive: true });
    window.addEventListener('resize', scheduleSnap, { passive: true });
    window.addEventListener('load', scheduleSnap, { passive: true });

    const resizeObserver =
      typeof ResizeObserver !== 'undefined'
        ? new ResizeObserver(() => {
            scheduleSnap();
          })
        : null;

    if (resizeObserver) {
      for (const entry of entries) {
        resizeObserver.observe(entry.stage);
      }
    }

    const observer = new MutationObserver(() => {
      onMotionChange();
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-motion'],
    });
    observer.observe(document.body, {
      attributes: true,
      attributeFilter: ['class'],
    });

    cleanupParallax = () => {
      if (rafId !== 0) {
        cancelAnimationFrame(rafId);
        rafId = 0;
      }
      if (snapRafId !== 0) {
        cancelAnimationFrame(snapRafId);
        snapRafId = 0;
      }
      unsubscribeChronoTrig?.();
      window.removeEventListener('lenis:scroll', onScrollTick);
      window.removeEventListener('scroll', onScrollTick);
      window.removeEventListener('resize', scheduleSnap);
      window.removeEventListener('load', scheduleSnap);
      intersectionObserver?.disconnect();
      resizeObserver?.disconnect();
      observer.disconnect();
    };
  }

  document.addEventListener('astro:before-swap', destroyParallaxStages);
  document.addEventListener('astro:page-load', initParallaxStages);
  initParallaxStages();
</script>
