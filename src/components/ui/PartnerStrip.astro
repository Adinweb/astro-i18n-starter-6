---
/**
 * Monochrome or pill partner logo strip usable inside hero footers, bars, or landing bands.
 */
import Icon from '@/components/ui/Icon.astro';
import type { HeroPartnerPill } from '@/libs/ui/types';

interface Props {
  items: readonly HeroPartnerPill[];
  variant?: 'logos' | 'pills' | 'bar';
  barTone?: 'accent' | 'primary' | 'surface';
  surface?: 'default' | 'hero';
  class?: string;
}

const {
  items,
  variant = 'logos',
  barTone = 'accent',
  surface = 'default',
  class: className,
} = Astro.props;

const isHero = surface === 'hero';
---

{
  items.length > 0 && (
    variant === 'bar' ? (
      <div
        class:list={[
          'relative border-y py-5 sm:py-6 print:border-border print:bg-surface print:text-fg',
          barTone === 'accent'
            ? 'border-accent/30 bg-accent text-hero-base'
            : barTone === 'primary'
              ? 'border-primary/30 bg-primary text-primary-fg'
              : isHero
                ? 'border-hero-fg/15 bg-hero-fg/10 text-hero-fg'
                : 'border-border bg-surface text-fg',
          className,
        ]}
      >
        <div class="layout-container flex flex-wrap items-center justify-center gap-x-10 gap-y-4 sm:justify-between">
          {items.map((partner) => (
            <div class="inline-flex items-center gap-2 text-xs font-extrabold tracking-widest uppercase opacity-85 transition-opacity hover:opacity-100 sm:text-sm">
              {partner.icon && <Icon name={partner.icon} size={18} class="shrink-0" />}
              <span>{partner.name}</span>
            </div>
          ))}
        </div>
      </div>
    ) : variant === 'pills' ? (
      <div
        class:list={['mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-2.5 sm:gap-3', className]}
        data-trig-stagger
        data-trig-stagger-mode="center"
        data-trig-stagger-delay="0.04"
        data-trig-once="true"
      >
        {items.map((partner) => (
          <div
            data-trig
            data-trig-once="true"
            class:list={[
              'inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-xs font-semibold',
              isHero
                ? 'border-hero-fg/15 bg-hero-fg/10 text-hero-fg/90 print:border-border print:bg-surface print:text-fg'
                : 'border-border bg-surface text-muted shadow-xs',
            ]}
          >
            <Icon
              name={partner.icon ?? 'sparkles'}
              size={14}
              class={isHero ? 'text-accent print:text-primary' : 'text-primary'}
            />
            <span>{partner.name}</span>
          </div>
        ))}
      </div>
    ) : (
      <ul
        class:list={['mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-x-8 gap-y-4', className]}
        data-trig-stagger
        data-trig-stagger-mode="center"
        data-trig-stagger-delay="0.04"
        data-trig-once="true"
      >
        {items.map((partner) => (
          <li
            data-trig
            data-trig-once="true"
            class:list={[
              'inline-flex items-center gap-2 text-xs font-bold tracking-wide sm:text-sm',
              isHero ? 'text-hero-fg/75 print:text-muted' : 'text-muted',
            ]}
          >
            <Icon
              name={partner.icon ?? 'building'}
              size={16}
              class={isHero ? 'text-accent print:text-primary' : 'text-primary'}
            />
            <span>{partner.name}</span>
          </li>
        ))}
      </ul>
    )
  )
}
