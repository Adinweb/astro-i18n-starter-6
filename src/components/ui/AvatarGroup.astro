---
/**
 * Overlapping avatar stack with optional star rating and localized trust label.
 */
import ResponsiveImage from '@/components/ui/ResponsiveImage.astro';
import RatingStars from '@/components/ui/RatingStars.astro';
import { formatNumber } from '@/i18n/format';
import type { Locale } from '@/i18n/locales';
import type { ContentImage } from '@/libs/content/media';
import { getInitials } from '@/libs/ui/initials';
import { resolveComponentLocale } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

export interface AvatarItem {
  name: string;
  image?: ContentImage;
  alt?: string;
}

interface Props {
  locale?: Locale | string;
  items?: readonly AvatarItem[];
  extraCount?: number;
  label?: string | null;
  rating?: number | null;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  locale,
  items,
  extraCount,
  label,
  rating = 5,
  size = 'md',
  class: className,
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = items === undefined;

const resolvedItems: readonly AvatarItem[] = items ?? [
  { name: m.block_team_1_name({}, { locale: activeLocale }) },
  { name: m.block_team_2_name({}, { locale: activeLocale }) },
  { name: m.block_team_3_name({}, { locale: activeLocale }) },
  { name: m.block_team_4_name({}, { locale: activeLocale }) },
];

const resolvedExtraCount = extraCount ?? (usingDefaults ? 24 : undefined);
const resolvedLabel =
  label === null
    ? undefined
    : (label ?? (usingDefaults ? m.block_avatar_trust_label({}, { locale: activeLocale }) : undefined));

const SIZES = {
  sm: 'size-8 text-[11px]',
  md: 'size-10 text-xs',
  lg: 'size-12 text-sm',
} as const;

const ratingValue =
  rating !== null && rating !== undefined ? Math.min(5, Math.max(1, Math.round(rating))) : null;
---

<div class:list={['not-prose inline-flex flex-wrap items-center gap-3.5', className]}>
  <div class="flex items-center">
    {
      resolvedItems.map((person, idx) => (
        <span
          title={person.name}
          class:list={[
            'relative inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full border border-border bg-surface font-bold text-primary ring-2 ring-bg',
            idx > 0 && '-ms-2.5',
            SIZES[size],
          ]}
        >
          {person.image ? (
            <ResponsiveImage
              src={person.image}
              alt={person.alt ?? person.name}
              widths={[80, 120]}
              sizes="48px"
              class="h-full w-full object-cover"
            />
          ) : (
            <span aria-hidden="true">{getInitials(person.name)}</span>
          )}
        </span>
      ))
    }

    {
      resolvedExtraCount !== undefined && resolvedExtraCount > 0 && (
        <span
          class:list={[
            'relative -ms-2.5 inline-flex shrink-0 items-center justify-center rounded-full border border-primary/30 bg-primary/10 font-bold tabular-nums text-primary ring-2 ring-bg',
            SIZES[size],
          ]}
        >
          +{formatNumber(resolvedExtraCount, activeLocale)}
        </span>
      )
    }
  </div>

  {
    (ratingValue !== null || resolvedLabel) && (
      <div class="min-w-0">
        {ratingValue !== null && <RatingStars rating={ratingValue} size={14} locale={activeLocale} />}
        {resolvedLabel && (
          <p class:list={['text-xs font-medium text-muted', ratingValue !== null && 'mt-0.5']}>
            {resolvedLabel}
          </p>
        )}
      </div>
    )
  }
</div>
