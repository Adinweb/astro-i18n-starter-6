---
/**
 * Embedded Preview Navigation Bar for standalone PrebuiltUI-style Hero Sections.
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import IconBox from '@/components/ui/IconBox.astro';
import type { Locale } from '@/i18n/locales';
import { getBlogIndexHref, getHomeHref, getPageUrl } from '@/libs/content/service';
import { getContentType, getContentTypeIndexHref } from '@/libs/content/types';
import { resolveComponentLocale } from '@/libs/ui/locale';
import type { HeroCtaAction } from '@/libs/ui/types';
import * as m from '@/paraglide/messages';

export interface HeroPreviewNavLink {
  label: string;
  href: string;
}

export type HeroPreviewNavVariant = 'minimal' | 'pill' | 'bordered' | 'dashed' | 'dropdown';

interface Props {
  locale?: Locale | string;
  surface?: 'default' | 'hero' | 'surface' | 'subtle';
  variant?: HeroPreviewNavVariant;
  brand?: string;
  links?: readonly HeroPreviewNavLink[];
  dropdownLabel?: string;
  dropdownItems?: readonly HeroPreviewNavLink[];
  cta?: HeroCtaAction | null;
  secondaryCta?: HeroCtaAction | null;
  compact?: boolean;
  class?: string;
}

const {
  locale,
  surface = 'default',
  variant = 'pill',
  brand,
  links,
  dropdownLabel,
  dropdownItems,
  cta,
  secondaryCta,
  compact = false,
  class: className,
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const [featuresHref, pricingHref, componentsHref, homeHref] = await Promise.all([
  getPageUrl('features', activeLocale),
  getPageUrl('pricing', activeLocale),
  getPageUrl('components', activeLocale),
  getHomeHref(activeLocale),
]);

const blogHref = getBlogIndexHref(activeLocale);
const projectsType = getContentType('projects');
const projectsHref = projectsType.enabled
  ? getContentTypeIndexHref('projects', activeLocale)
  : homeHref;

const resolvedLinks: readonly HeroPreviewNavLink[] = links ?? [
  { label: m.nav_home({}, { locale: activeLocale }), href: homeHref },
  { label: m.block_breadcrumbs_2({}, { locale: activeLocale }), href: componentsHref ?? homeHref },
  { label: m.nav_projects({}, { locale: activeLocale }), href: projectsHref },
  { label: m.nav_blog({}, { locale: activeLocale }), href: blogHref },
];

const resolvedDropdownItems: readonly HeroPreviewNavLink[] = dropdownItems ?? [
  { label: m.block_hero_nav_page_1({}, { locale: activeLocale }), href: componentsHref ?? homeHref },
  { label: m.block_hero_nav_page_2({}, { locale: activeLocale }), href: featuresHref ?? homeHref },
  { label: m.block_hero_nav_page_3({}, { locale: activeLocale }), href: pricingHref ?? homeHref },
];

const resolvedBrand = brand ?? m.block_hero_nav_brand({}, { locale: activeLocale });
const resolvedDropdownLabel = dropdownLabel ?? m.block_hero_nav_pages({}, { locale: activeLocale });
const resolvedCta =
  cta === null
    ? undefined
    : cta ?? {
        label: m.block_hero_nav_cta({}, { locale: activeLocale }),
        href: featuresHref ?? homeHref,
      };

const isHeroSurface = surface === 'hero';
const ariaLabel = m.block_hero_nav_aria({}, { locale: activeLocale });

const wrapperClass =
  variant === 'pill'
    ? 'mx-auto max-w-4xl rounded-full border px-4 py-2 sm:px-5'
    : variant === 'bordered'
      ? 'border-b pb-3.5'
      : variant === 'dashed'
        ? 'border-b border-dashed pb-3.5'
        : variant === 'dropdown'
          ? 'rounded-2xl border px-4 py-2.5 sm:px-5'
          : 'pb-2';
const dropdownMenuId =
  variant === 'dropdown' ? `hero-nav-menu-${crypto.randomUUID().slice(0, 6)}` : undefined;
---

<div
  role="region"
  aria-label={ariaLabel}
  class:list={[
    'relative z-20 flex flex-wrap items-center justify-between gap-3',
    compact ? 'mb-7 sm:mb-9' : 'mb-10 sm:mb-12',
    wrapperClass,
    variant === 'pill' || variant === 'dropdown'
      ? isHeroSurface
        ? 'border-hero-fg/15 bg-hero-fg/10 text-hero-fg print:border-border print:bg-surface print:text-fg'
        : 'border-border bg-surface text-fg shadow-xs'
      : isHeroSurface
        ? 'border-hero-fg/15 text-hero-fg print:border-border print:text-fg'
        : 'border-border text-fg',
    className,
  ]}
>
  <a
    href={homeHref}
    class="inline-flex items-center gap-2 text-xs font-bold tracking-tight transition-opacity hover:opacity-85 sm:text-sm"
  >
    {isHeroSurface ? (
      <IconBox icon="sparkles" size="xs" radius="lg" tone="accent" />
    ) : (
      <IconBox icon="sparkles" size="xs" radius="lg" tone="primary" class="bg-primary text-primary-fg" />
    )}
    <span>{resolvedBrand}</span>
  </a>

  <div class="hidden flex-wrap items-center gap-5 text-xs font-medium md:flex">
    {resolvedLinks.slice(0, variant === 'dropdown' ? 2 : 4).map((item) => (
      <a
        href={item.href}
        class:list={[
          'transition-colors',
          isHeroSurface
            ? 'text-hero-fg/80 hover:text-hero-fg print:text-muted print:hover:text-fg'
            : 'text-muted hover:text-fg',
        ]}
      >
        {item.label}
      </a>
    ))}

    {variant === 'dropdown' && (
      <div class="relative" data-hero-nav-dropdown>
        <button
          type="button"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls={dropdownMenuId}
          data-hero-nav-trigger
          class:list={[
            'inline-flex cursor-pointer items-center gap-1 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-md',
            isHeroSurface
              ? 'text-hero-fg/85 hover:text-hero-fg print:text-muted print:hover:text-fg'
              : 'text-muted hover:text-fg',
          ]}
        >
          <span>{resolvedDropdownLabel}</span>
          <Icon
            name="chevron-down"
            size={13}
            data-hero-nav-chevron
            class="transition-transform duration-200 [[data-motion=reduced]_&]:transition-none"
          />
        </button>

        <div
          id={dropdownMenuId}
          role="menu"
          hidden
          data-hero-nav-menu
          class="absolute start-0 top-full z-30 min-w-44 pt-2"
        >
          <div class="rounded-xl border border-border bg-surface p-1.5 text-fg shadow-xl">
            {resolvedDropdownItems.map((sub) => (
              <a
                href={sub.href}
                role="menuitem"
                data-hero-nav-item
                class="flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-xs font-medium text-fg transition-colors hover:bg-surface-hover hover:text-primary focus-visible:bg-surface-hover focus-visible:text-primary focus-visible:outline-none"
              >
                <span>{sub.label}</span>
                <Icon name="chevron-right" size={12} class="opacity-60 rtl:rotate-180" />
              </a>
            ))}
          </div>
        </div>
      </div>
    )}

    {variant === 'dropdown' &&
      resolvedLinks.slice(2, 4).map((item) => (
        <a
          href={item.href}
          class:list={[
            'transition-colors',
            isHeroSurface
              ? 'text-hero-fg/80 hover:text-hero-fg print:text-muted print:hover:text-fg'
              : 'text-muted hover:text-fg',
          ]}
        >
          {item.label}
        </a>
      ))}
  </div>

  {(secondaryCta || resolvedCta) && (
    <div class="flex items-center gap-2 print:hidden">
      {secondaryCta && (
        <Button
          href={secondaryCta.href}
          variant={isHeroSurface ? 'hero' : 'ghost'}
          size="sm"
          external={secondaryCta.external}
        >
          {secondaryCta.label}
        </Button>
      )}
      {resolvedCta && (
        <Button
          href={resolvedCta.href}
          variant={isHeroSurface ? 'hero' : 'primary'}
          size="sm"
          icon={resolvedCta.icon}
          external={resolvedCta.external}
        >
          {resolvedCta.label}
        </Button>
      )}
    </div>
  )}
</div>

<script>
  function closeHeroNavDropdown(root: HTMLElement, restoreFocus = false) {
    const trigger = root.querySelector<HTMLButtonElement>('[data-hero-nav-trigger]');
    const menu = root.querySelector<HTMLElement>('[data-hero-nav-menu]');
    const chevron = root.querySelector<HTMLElement>('[data-hero-nav-chevron]');
    if (!trigger || !menu || menu.hidden) return;
    menu.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
    chevron?.classList.remove('rotate-180');
    if (restoreFocus) trigger.focus();
  }

  function bindGlobalHeroNavListeners() {
    if (document.documentElement.dataset.heroNavDropdownGlobal === 'true') return;
    document.documentElement.dataset.heroNavDropdownGlobal = 'true';

    document.addEventListener('click', (event) => {
      const target = event.target as Node | null;
      document.querySelectorAll<HTMLElement>('[data-hero-nav-dropdown]').forEach((root) => {
        if (!target || !root.contains(target)) closeHeroNavDropdown(root, false);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      document.querySelectorAll<HTMLElement>('[data-hero-nav-dropdown]').forEach((root) => {
        const menu = root.querySelector<HTMLElement>('[data-hero-nav-menu]');
        if (menu && !menu.hidden) {
          closeHeroNavDropdown(root, root.contains(document.activeElement));
        }
      });
    });
  }

  function initHeroPreviewNavDropdowns() {
    bindGlobalHeroNavListeners();
    const supportsHover =
      typeof window !== 'undefined' && window.matchMedia?.('(hover: hover)')?.matches;

    document.querySelectorAll<HTMLElement>('[data-hero-nav-dropdown]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const trigger = root.querySelector<HTMLButtonElement>('[data-hero-nav-trigger]');
      const menu = root.querySelector<HTMLElement>('[data-hero-nav-menu]');
      const chevron = root.querySelector<HTMLElement>('[data-hero-nav-chevron]');
      const items = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-nav-item]'));
      if (!trigger || !menu) return;

      const setOpen = (open: boolean, focusFirst = false) => {
        if (open) {
          document.querySelectorAll<HTMLElement>('[data-hero-nav-dropdown]').forEach((other) => {
            if (other !== root) closeHeroNavDropdown(other, false);
          });
        }
        menu.hidden = !open;
        trigger.setAttribute('aria-expanded', String(open));
        chevron?.classList.toggle('rotate-180', open);
        if (open && focusFirst && items.length > 0) {
          items[0]?.focus();
        }
      };

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        setOpen(!isOpen, false);
      });

      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          setOpen(true, true);
        }
      });

      if (supportsHover) {
        root.addEventListener('mouseenter', () => setOpen(true, false));
        root.addEventListener('mouseleave', () => setOpen(false, false));
      }

      items.forEach((item, idx) => {
        item.addEventListener('click', () => setOpen(false, false));
        item.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            items[(idx + 1) % items.length]?.focus();
          } else if (event.key === 'ArrowUp') {
            event.preventDefault();
            items[(idx - 1 + items.length) % items.length]?.focus();
          } else if (event.key === 'Home') {
            event.preventDefault();
            items[0]?.focus();
          } else if (event.key === 'End') {
            event.preventDefault();
            items[items.length - 1]?.focus();
          }
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initHeroPreviewNavDropdowns);
  initHeroPreviewNavDropdowns();
</script>
