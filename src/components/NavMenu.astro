---
import type { Locale } from '@/i18n/locales';
import type { NavDisplayMode } from '@/libs/config/app';
import { getMenuById } from '@/libs/config/navigation';
import { resolveComponentLocale } from '@/libs/ui/locale';
import HorizontalNavItem from '@/components/HorizontalNavItem.astro';
import FooterMenuNode from '@/components/FooterMenuNode.astro';

interface Props {
  menuId: string;
  currentUrl?: string;
  locale?: Locale | string;
  displayMode?: NavDisplayMode;
  orientation?: 'horizontal' | 'vertical';
  showTitle?: boolean;
  class?: string;
}

const {
  menuId,
  currentUrl,
  locale: rawLocale,
  displayMode,
  orientation = 'vertical',
  showTitle = false,
  class: className,
} = Astro.props;

const locale = resolveComponentLocale(rawLocale, Astro.url.pathname);
const resolvedUrl = currentUrl ?? Astro.url.pathname;
const menu = await getMenuById(
  menuId,
  locale,
  resolvedUrl,
  displayMode ? { menuDisplayMode: displayMode } : {}
);
---

{
  menu && menu.items.length > 0 && (
    <nav
      aria-label={menu.title}
      data-nav-menu={menu.id}
      data-nav-display-mode={menu.displayMode}
      class:list={[className]}
    >
      {showTitle && menu.title && (
        <div class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted">
          {menu.title}
        </div>
      )}

      {orientation === 'horizontal' ? (
        <div class="flex flex-wrap items-center gap-4 text-sm font-medium">
          {menu.items.map((item) => (
            <HorizontalNavItem item={item} />
          ))}
        </div>
      ) : (
        <ul class="space-y-2 text-sm">
          {menu.items.map((item) => (
            <FooterMenuNode item={item} />
          ))}
        </ul>
      )}
    </nav>
  )
}
