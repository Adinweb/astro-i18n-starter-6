---
/**
 * Shared editorial section header (`eyebrow`, `<h2>`, `subheading`) used across
 * composable landing and marketing blocks to enforce DRY typography and rhythm.
 */
interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  align?: 'start' | 'center';
  class?: string;
}

const { eyebrow, heading, subheading, align = 'start', class: className } = Astro.props;
const hasContent = Boolean(eyebrow || heading || subheading);
---

{
  hasContent && (
    <div
      class:list={[
        'max-w-3xl',
        align === 'center' && 'mx-auto text-center',
        className,
      ]}
      data-trig-stagger
      data-trig-stagger-mode="linear"
      data-trig-stagger-delay="0.08"
      data-trig-once="true"
    >
      {eyebrow && <p class="section-kicker">{eyebrow}</p>}
      {heading && (
        <h2
          class:list={[
            'text-2xl font-bold tracking-tight text-fg sm:text-3xl text-balance',
            eyebrow && 'mt-2',
          ]}
        >
          {heading}
        </h2>
      )}
      {subheading && (
        <p class="mt-3 text-base leading-relaxed text-muted text-pretty">
          {subheading}
        </p>
      )}
    </div>
  )
}
