---
/**
 * Quantitative proof strip separating key metrics by clean hairline rules.
 * Numerals format automatically via `formatNumber` when `count` is provided
 * and render with `tabular-nums` alignment.
 */
import PageSection from '@/components/PageSection.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import StatTile from '@/components/ui/StatTile.astro';
import type { Locale } from '@/i18n/locales';
import { resolveComponentLocale, resolveOptionalHeader } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

export interface StatItem {
  value?: string;
  count?: number;
  prefix?: string;
  suffix?: string;
  label: string;
  context?: string;
}

interface Props {
  id?: string;
  eyebrow?: string | null;
  heading?: string | null;
  items?: readonly StatItem[];
  locale?: Locale | string;
  contained?: boolean;
  surface?: 'default' | 'surface' | 'subtle';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  id,
  eyebrow,
  heading,
  items,
  locale,
  contained = false,
  surface = 'surface',
  spacing = 'md',
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = items === undefined;

const resolvedEyebrow = resolveOptionalHeader(
  eyebrow,
  usingDefaults,
  m.block_stats_eyebrow({}, { locale: activeLocale })
);
const resolvedHeading = resolveOptionalHeader(
  heading,
  usingDefaults,
  m.block_stats_heading({}, { locale: activeLocale })
);

const resolvedItems: readonly StatItem[] = items ?? [
  {
    count: 35,
    suffix: '+',
    label: m.block_stats_1_label({}, { locale: activeLocale }),
    context: m.block_stats_1_context({}, { locale: activeLocale }),
  },
  {
    count: 6,
    label: m.block_stats_2_label({}, { locale: activeLocale }),
    context: m.block_stats_2_context({}, { locale: activeLocale }),
  },
  {
    count: 100,
    suffix: '%',
    label: m.block_stats_3_label({}, { locale: activeLocale }),
    context: m.block_stats_3_context({}, { locale: activeLocale }),
  },
  {
    count: 0,
    label: m.block_stats_4_label({}, { locale: activeLocale }),
    context: m.block_stats_4_context({}, { locale: activeLocale }),
  },
];

const gridColsClass =
  resolvedItems.length <= 2
    ? 'sm:grid-cols-2'
    : resolvedItems.length === 3
      ? 'sm:grid-cols-3'
      : 'sm:grid-cols-2 lg:grid-cols-4';
---

<PageSection
  id={id}
  surface={contained ? 'default' : surface}
  spacing={contained ? 'sm' : spacing}
  bleed={contained}
  borderTop
  borderBottom
  class={contained ? 'not-prose my-10' : undefined}
>
  <SectionHeader
    eyebrow={resolvedEyebrow}
    heading={resolvedHeading}
    class={resolvedEyebrow || resolvedHeading ? 'mb-8' : undefined}
  />

  <div
    class:list={['grid gap-8', gridColsClass]}
    data-trig-stagger
    data-trig-stagger-mode="center"
    data-trig-stagger-delay="0.06"
    data-trig-once="true"
  >
    {
      resolvedItems.map((item) => (
        <div
          data-trig
          data-trig-once="true"
          class="border-t border-border pt-4 sm:border-t-0 sm:border-s sm:pt-0 sm:ps-6 sm:first:border-s-0 sm:first:ps-0"
        >
          <StatTile
            variant="divider"
            accent
            label={item.label}
            value={item.value}
            count={item.count}
            prefix={item.prefix}
            suffix={item.suffix}
            context={item.context ?? null}
            locale={activeLocale}
            class="border-none! p-0!"
          />
        </div>
      ))
    }
  </div>
</PageSection>
