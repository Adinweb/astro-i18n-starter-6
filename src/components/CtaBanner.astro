---
/**
 * Focused closing conversion banner inspired by PrebuiltUI CTA sections.
 * Supports optional overrides with full Paraglide defaults in active locale.
 */
import Button from '@/components/Button.astro';
import PageSection from '@/components/PageSection.astro';
import type { Locale } from '@/i18n/locales';
import { getHomeHref, getPageUrl } from '@/libs/content/service';
import { getContentType, getContentTypeIndexHref } from '@/libs/content/types';
import { resolveComponentLocale } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

export interface CtaAction {
  label: string;
  href: string;
  icon?: string;
  external?: boolean;
}

interface Props {
  id?: string;
  locale?: Locale | string;
  eyebrow?: string | null;
  title?: string;
  description?: string | null;
  primaryCta?: CtaAction | null;
  secondaryCta?: CtaAction | null;
  contained?: boolean;
  surface?: 'hero' | 'surface';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  id,
  locale,
  eyebrow,
  title,
  description,
  primaryCta,
  secondaryCta,
  contained = false,
  surface = 'hero',
  spacing = 'md',
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = title === undefined;

const [pricingHref, homeHref] =
  primaryCta === undefined || (usingDefaults && secondaryCta === undefined)
    ? await Promise.all([getPageUrl('pricing', activeLocale), getHomeHref(activeLocale)])
    : [null, ''];

const projectsType = getContentType('projects');
const projectsHref = projectsType.enabled
  ? getContentTypeIndexHref('projects', activeLocale)
  : homeHref;

const resolvedEyebrow =
  eyebrow === null
    ? undefined
    : (eyebrow ?? (usingDefaults ? m.home_badge({}, { locale: activeLocale }) : undefined));
const resolvedTitle = title ?? m.home_cta_title({}, { locale: activeLocale });
const resolvedDescription =
  description === null
    ? undefined
    : (description ?? (usingDefaults ? m.home_cta_desc({}, { locale: activeLocale }) : undefined));
const resolvedPrimaryCta =
  primaryCta === null
    ? undefined
    : (primaryCta ?? {
        label: m.home_cta_primary({}, { locale: activeLocale }),
        href: pricingHref ?? homeHref,
        icon: 'arrow-right',
      });
const resolvedSecondaryCta =
  secondaryCta === null
    ? undefined
    : (secondaryCta ??
      (usingDefaults
        ? {
            label: m.home_cta_secondary({}, { locale: activeLocale }),
            href: projectsHref,
          }
        : undefined));

const isHero = surface === 'hero';
---

<PageSection
  id={id}
  spacing={contained ? 'none' : spacing}
  bleed={contained}
  class={contained ? 'not-prose my-10' : undefined}
>
  <div
    data-trig
    data-trig-once="true"
    class:list={[
      'zoomIn relative isolate overflow-hidden rounded-3xl border px-6 py-10 sm:px-10 sm:py-14 lg:px-14',
      isHero
        ? 'border-hero-fg/15 bg-hero-base text-hero-fg print:border-border print:bg-bg print:text-fg'
        : 'border-border bg-surface text-fg',
    ]}
  >
    {
      isHero && (
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 print:hidden">
          <div class="absolute -bottom-32 end-[-4rem] size-80 rounded-full bg-primary/25 blur-3xl" />
          <div class="absolute -top-32 start-[-4rem] size-72 rounded-full bg-accent/20 blur-3xl" />
        </div>
      )
    }

    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-3xl">
        {
          resolvedEyebrow && (
            <p
              class:list={[
                'text-xs font-semibold uppercase tracking-[0.14em] rtl:tracking-normal',
                isHero ? 'text-accent print:text-primary' : 'text-primary',
              ]}
            >
              {resolvedEyebrow}
            </p>
          )
        }

        <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl lg:text-4xl text-balance">
          {resolvedTitle}
        </h2>

        {
          resolvedDescription && (
            <p
              class:list={[
                'mt-3 text-base leading-relaxed text-pretty',
                isHero ? 'text-hero-fg/85 print:text-muted' : 'text-muted',
              ]}
            >
              {resolvedDescription}
            </p>
          )
        }
      </div>

      {
        (resolvedPrimaryCta || resolvedSecondaryCta) && (
          <div class="flex shrink-0 flex-wrap items-center gap-3 print:hidden">
            {resolvedPrimaryCta && (
              <Button
                href={resolvedPrimaryCta.href}
                variant="primary"
                size="lg"
                icon={resolvedPrimaryCta.icon ?? 'arrow-right'}
                external={resolvedPrimaryCta.external}
              >
                {resolvedPrimaryCta.label}
              </Button>
            )}

            {resolvedSecondaryCta && (
              <Button
                href={resolvedSecondaryCta.href}
                variant={isHero ? 'hero' : 'secondary'}
                size="lg"
                external={resolvedSecondaryCta.external}
              >
                {resolvedSecondaryCta.label}
              </Button>
            )}
          </div>
        )
      }
    </div>
  </div>
</PageSection>
