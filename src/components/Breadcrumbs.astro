---
/**
 * Reusable accessible breadcrumbs navigation inspired by PrebuiltUI breadcrumbs.
 * Supports `chevron` or `slash` separators, RTL chevron rotation (`rtl:rotate-180`),
 * optional home icon on the first crumb, OKLCH tokens, and Paraglide defaults.
 */
import Icon from '@/components/Icon.astro';
import type { Locale } from '@/i18n/locales';
import { getHomeHref, getPageUrl } from '@/libs/content/service';
import { resolveComponentLocale } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

export interface BreadcrumbItem {
  label: string;
  href?: string;
  icon?: string;
}

interface Props {
  items?: readonly BreadcrumbItem[];
  locale?: Locale | string;
  separator?: 'chevron' | 'slash';
  showHomeIcon?: boolean;
  surface?: 'default' | 'hero';
  size?: 'xs' | 'sm';
  align?: 'start' | 'center';
  compact?: boolean;
  truncateLast?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  items,
  locale,
  separator = 'chevron',
  showHomeIcon = true,
  surface = 'default',
  size = 'sm',
  align = 'start',
  compact = false,
  truncateLast = false,
  ariaLabel,
  class: className,
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const resolvedLabel = ariaLabel ?? m.common_breadcrumbs({}, { locale: activeLocale });

let resolvedItems: readonly BreadcrumbItem[];
if (items) {
  resolvedItems = items;
} else {
  const [homeHref, componentsHref] = await Promise.all([
    getHomeHref(activeLocale),
    getPageUrl('components', activeLocale),
  ]);
  resolvedItems = [
    {
      label: m.block_breadcrumbs_1({}, { locale: activeLocale }),
      href: homeHref,
      icon: 'home',
    },
    {
      label: m.block_breadcrumbs_2({}, { locale: activeLocale }),
      href: componentsHref ?? homeHref,
    },
    {
      label: m.block_breadcrumbs_3({}, { locale: activeLocale }),
    },
  ];
}

const isHero = surface === 'hero';
const listClass = [
  'inline-flex flex-wrap items-center',
  compact ? 'gap-1' : 'gap-1.5',
  size === 'xs' ? 'text-xs' : 'text-sm',
  isHero
    ? 'rounded-xl border border-hero-fg/20 bg-scrim/60 px-2.5 py-1 text-hero-fg/90 backdrop-blur-md'
    : 'text-muted',
];
const chevronSize = size === 'xs' ? 12 : 14;
const itemIconSize = size === 'xs' ? 13 : 14;
---

<nav
  aria-label={resolvedLabel}
  class:list={['not-prose', align === 'center' && 'flex justify-center', className]}
>
  <ol class:list={listClass}>
    {
      resolvedItems.map((item, idx) => {
        const isLast = idx === resolvedItems.length - 1;
        const iconName = item.icon ?? (idx === 0 && showHomeIcon ? 'home' : undefined);
        return (
          <li class="inline-flex items-center gap-1.5">
            {idx > 0 && (
              <span
                aria-hidden="true"
                class:list={[
                  'inline-flex items-center',
                  isHero ? 'text-hero-fg/60' : 'text-muted/65',
                ]}
              >
                {separator === 'slash' ? (
                  <span class="px-0.5 text-xs select-none">/</span>
                ) : (
                  <Icon name="chevron-right" size={chevronSize} class="rtl:rotate-180" />
                )}
              </span>
            )}
            {item.href && !isLast ? (
              <a
                href={item.href}
                class:list={[
                  'inline-flex items-center gap-1.5 font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
                  compact ? 'rounded-md px-1.5 py-0.5' : 'rounded-lg px-2 py-1',
                  isHero
                    ? 'text-hero-fg/85 hover:bg-hero-fg/15 hover:text-hero-fg'
                    : 'text-muted hover:bg-surface-hover hover:text-fg',
                ]}
              >
                {iconName && <Icon name={iconName} size={itemIconSize} class="shrink-0" />}
                <span>{item.label}</span>
              </a>
            ) : (
              <span
                aria-current={isLast ? 'page' : undefined}
                class:list={[
                  'inline-flex items-center gap-1.5',
                  compact ? 'rounded-md px-2 py-0.5' : 'rounded-lg px-2.5 py-1',
                  isLast
                    ? isHero
                      ? 'bg-hero-fg/15 font-semibold text-hero-fg'
                      : 'border border-border/70 bg-surface font-semibold text-fg'
                    : isHero
                      ? 'text-hero-fg/85'
                      : 'text-muted',
                  isLast && truncateLast && 'max-w-xs truncate',
                ]}
              >
                {iconName && <Icon name={iconName} size={itemIconSize} class="shrink-0" />}
                <span class:list={[isLast && truncateLast && 'truncate']}>{item.label}</span>
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
