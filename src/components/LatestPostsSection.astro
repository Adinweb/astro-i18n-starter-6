---
/**
 * Composable latest blog posts section inspired by PrebuiltUI blog sections.
 * Automatically queries published `blog` entries in the active locale when
 * `items` is omitted (honoring `content.types.blog.enabled`), or renders custom
 * `items` directly. Reuses `<PostCard headingTag="h3" />` for DRY layout parity.
 */
import { getCollection } from 'astro:content';
import Button from '@/components/Button.astro';
import PageSection from '@/components/PageSection.astro';
import PostCard from '@/components/PostCard.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { formatDate } from '@/i18n/format';
import type { Locale } from '@/i18n/locales';
import { getSortedLocaleEntries } from '@/libs/content/entries';
import { getBlogIndexHref, getBlogPostHref } from '@/libs/content/service';
import { getContentType } from '@/libs/content/types';
import { resolveComponentLocale, resolveOptionalHeader } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

export interface BlogPreviewItem {
  title: string;
  description?: string;
  href: string;
  category?: string;
  date?: Date | string;
}

interface Props {
  id?: string;
  locale?: Locale | string;
  eyebrow?: string | null;
  heading?: string | null;
  subheading?: string | null;
  limit?: number;
  category?: string;
  items?: readonly BlogPreviewItem[];
  viewAllHref?: string | null;
  viewAllLabel?: string;
  contained?: boolean;
  surface?: 'default' | 'surface' | 'subtle';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  id,
  locale,
  eyebrow,
  heading,
  subheading,
  limit = 3,
  category,
  items,
  viewAllHref,
  viewAllLabel,
  contained = false,
  surface = 'default',
  spacing = 'md',
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingCustomItems = items !== undefined;
const blogEnabled = getContentType('blog').enabled;

const rawPosts =
  !usingCustomItems && blogEnabled
    ? getSortedLocaleEntries(await getCollection('blog'), activeLocale)
        .filter((post) => !category || post.data.categories.includes(category))
        .slice(0, limit)
    : [];

const resolvedEyebrow = resolveOptionalHeader(
  eyebrow,
  true,
  m.block_posts_eyebrow({}, { locale: activeLocale })
);
const resolvedHeading = resolveOptionalHeader(
  heading,
  true,
  m.block_posts_heading({}, { locale: activeLocale })
);
const resolvedSubheading = resolveOptionalHeader(
  subheading,
  true,
  m.block_posts_subheading({}, { locale: activeLocale })
);

const resolvedViewAllHref =
  viewAllHref === null
    ? undefined
    : (viewAllHref ?? (blogEnabled ? getBlogIndexHref(activeLocale) : undefined));
const resolvedViewAllLabel =
  viewAllLabel ?? m.block_posts_view_all({}, { locale: activeLocale });

const hasItems = usingCustomItems ? items.length > 0 : rawPosts.length > 0;
const cardSurface = !contained && surface === 'surface' ? 'bg-bg' : 'bg-surface';
---

{
  hasItems && (
    <PageSection
      id={id}
      surface={contained ? 'default' : surface}
      spacing={contained ? 'none' : spacing}
      bleed={contained}
      class={contained ? 'not-prose my-10' : undefined}
    >
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeader
          eyebrow={resolvedEyebrow}
          heading={resolvedHeading}
          subheading={resolvedSubheading}
        />

        {resolvedViewAllHref && (
          <Button
            href={resolvedViewAllHref}
            variant="secondary"
            size="md"
            icon="arrow-right"
            class="self-start sm:self-auto print:hidden"
          >
            {resolvedViewAllLabel}
          </Button>
        )}
      </div>

      <div
        class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
        data-trig-stagger
        data-trig-stagger-delay="0.06"
      >
        {usingCustomItems
          ? items.map((item) => {
              const formatted =
                item.date instanceof Date
                  ? formatDate(item.date, activeLocale, 'short')
                  : item.date;
              return (
                <article
                  data-trig
                  class:list={[
                    'group relative flex flex-col justify-between rounded-2xl border border-border p-6 shadow-xs transition duration-200 hover:-translate-y-0.5 hover:border-primary/45 hover:shadow-md',
                    cardSurface,
                  ]}
                >
                  <div>
                    {item.category && (
                      <span class="chip px-2.5 py-0.5 text-[11px]">{item.category}</span>
                    )}
                    <h3 class="mt-3 text-lg font-bold leading-snug tracking-tight text-fg">
                      <a
                        href={item.href}
                        class="transition-colors after:absolute after:inset-0 hover:text-primary focus-visible:outline-none"
                      >
                        {item.title}
                      </a>
                    </h3>
                    {item.description && (
                      <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">
                        {item.description}
                      </p>
                    )}
                  </div>
                  {formatted && (
                    <p class="mt-5 border-t border-border pt-3 text-xs text-muted">
                      {formatted}
                    </p>
                  )}
                </article>
              );
            })
          : rawPosts.map((post) => (
              <PostCard
                post={post}
                locale={activeLocale}
                href={getBlogPostHref(post.data.slug, activeLocale)}
                headingTag="h3"
              />
            ))}
      </div>
    </PageSection>
  )
}
