import IconFilter from '@tabler/icons-astro/dist/esm/icons/filter.mjs';
import IconFolder from '@tabler/icons-astro/dist/esm/icons/folder.mjs';
import IconHeart from '@tabler/icons-astro/dist/esm/icons/heart.mjs';
import IconHome from '@tabler/icons-astro/dist/esm/icons/home.mjs';
import IconInfoCircle from '@tabler/icons-astro/dist/esm/icons/info-circle.mjs';
import IconLayoutGrid from '@tabler/icons-astro/dist/esm/icons/layout-grid.mjs';
import IconLock from '@tabler/icons-astro/dist/esm/icons/lock.mjs';
import IconMail from '@tabler/icons-astro/dist/esm/icons/mail.mjs';
import IconMap from '@tabler/icons-astro/dist/esm/icons/map.mjs';
import IconMapPin from '@tabler/icons-astro/dist/esm/icons/map-pin.mjs';
import IconMenu2 from '@tabler/icons-astro/dist/esm/icons/menu-2.mjs';
import IconMinus from '@tabler/icons-astro/dist/esm/icons/minus.mjs';
import IconMoon from '@tabler/icons-astro/dist/esm/icons/moon.mjs';
import IconNews from '@tabler/icons-astro/dist/esm/icons/news.mjs';
import IconPalette from '@tabler/icons-astro/dist/esm/icons/palette.mjs';
import IconPhone from '@tabler/icons-astro/dist/esm/icons/phone.mjs';
import IconPhoto from '@tabler/icons-astro/dist/esm/icons/photo.mjs';
import IconQuote from '@tabler/icons-astro/dist/esm/icons/quote.mjs';
import IconRefresh from '@tabler/icons-astro/dist/esm/icons/refresh.mjs';
import IconRocket from '@tabler/icons-astro/dist/esm/icons/rocket.mjs';
import IconSearch from '@tabler/icons-astro/dist/esm/icons/search.mjs';
import IconShare from '@tabler/icons-astro/dist/esm/icons/share.mjs';
import IconShieldCheck from '@tabler/icons-astro/dist/esm/icons/shield-check.mjs';
import IconShoppingBag from '@tabler/icons-astro/dist/esm/icons/shopping-bag.mjs';
import IconSparkles from '@tabler/icons-astro/dist/esm/icons/sparkles.mjs';
import IconStack2 from '@tabler/icons-astro/dist/esm/icons/stack-2.mjs';
import IconStarFilled from '@tabler/icons-astro/dist/esm/icons/star-filled.mjs';
import IconStar from '@tabler/icons-astro/dist/esm/icons/star.mjs';
import IconSun from '@tabler/icons-astro/dist/esm/icons/sun.mjs';
import IconTag from '@tabler/icons-astro/dist/esm/icons/tag.mjs';
import IconUser from '@tabler/icons-astro/dist/esm/icons/user.mjs';
import IconUsers from '@tabler/icons-astro/dist/esm/icons/users.mjs';
import IconWand from '@tabler/icons-astro/dist/esm/icons/wand.mjs';
import IconWorld from '@tabler/icons-astro/dist/esm/icons/world.mjs';
import IconX from '@tabler/icons-astro/dist/esm/icons/x.mjs';
import type { TablerIcon } from '@tabler/icons-astro/dist/esm/icons/*.mjs';
import ClientIcons from '@client/ClientIcons.astro';
import {
  isClientIconName,
  resolveCoreIconName,
  type CoreIconName,
} from '@/libs/ui/icons';

const CORE_ICONS: Record<CoreIconName, TablerIcon> = {
  search: IconSearch,
  globe: IconWorld,
  close: IconX,
  check: IconCheck,
  menu: IconMenu2,
  'chevron-left': IconChevronLeft,
  'chevron-right': IconChevronRight,
  'chevron-down': IconChevronDown,
  sun: IconSun,
  moon: IconMoon,
  copy: IconCopy,
  'external-link': IconExternalLink,
  'arrow-right': IconArrowRight,
  shield: IconShieldCheck,
  mail: IconMail,
  layers: IconStack2,
  home: IconHome,
  info: IconInfoCircle,
  sparkles: IconSparkles,
  tag: IconTag,
  newspaper: IconNews,
  folder: IconFolder,
  compass: IconCompass,
  palette: IconPalette,
  'book-open': IconBook2,
  star: IconStar,
  'star-filled': IconStarFilled,
  quote: IconQuote,
  users: IconUsers,
  building: IconBuilding,
  file: IconFile,
  'alert-circle': IconAlertCircle,
  'alert-triangle': IconAlertTriangle,
  'circle-check': IconCircleCheck,
  bell: IconBell,
  bolt: IconBolt,
  clock: IconClock,
  'map-pin': IconMapPin,
  phone: IconPhone,
  rocket: IconRocket,
  code: IconCode,
  award: IconAward,
  'layout-grid': IconLayoutGrid,
  calendar: IconCalendar,
  photo: IconPhoto,
  minus: IconMinus,
  eye: IconEye,
  'eye-off': IconEyeOff,
  'shopping-bag': IconShoppingBag,
  heart: IconHeart,
  share: IconShare,
  'chevron-up': IconChevronUp,
  'dots-vertical': IconDotsVertical,
  lock: IconLock,
  user: IconUser,
  'adjustments-horizontal': IconAdjustmentsHorizontal,
  'brand-github': IconBrandGithub,
  'brand-x': IconBrandX,
  'brand-linkedin': IconBrandLinkedin,
  'brand-instagram': IconBrandInstagram,
  'brand-telegram': IconBrandTelegram,
  'brand-whatsapp': IconBrandWhatsapp,
  filter: IconFilter,
  map: IconMap,
  refresh: IconRefresh,
  wand: IconWand,
};

interface Props {
  /** Semantic name from `SITE_ICONS`; an unknown string falls back to `file`. */
  name: string;
  /** Width and height in pixels (or any CSS length). */
  size?: number | string;
  /** Extra classes; directional icons receive `rtl:rotate-180` from the caller. */
  class?: string;
  'aria-hidden'?: boolean | 'true' | 'false';
  'aria-label'?: string;
}

const {
  name,
  size = 20,
  class: className = '',
  'aria-hidden': ariaHidden = true,
  'aria-label': ariaLabel,
} = Astro.props;

const isClient = isClientIconName(name);
const IconComponent = isClient ? undefined : CORE_ICONS[resolveCoreIconName(name)];
---

{
  isClient ? (
    <ClientIcons
      name={name}
      size={size}
      class={className}
      aria-hidden={ariaHidden}
      aria-label={ariaLabel}
    />
  ) : (
    IconComponent && (
      <IconComponent
        size={size}
        class={className}
        aria-hidden={ariaLabel ? undefined : ariaHidden}
        aria-label={ariaLabel}
        role={ariaLabel ? 'img' : 'presentation'}
      />
    )
  )
}
