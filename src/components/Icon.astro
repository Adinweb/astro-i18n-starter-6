import IconChevronLeft from '@tabler/icons-astro/dist/esm/icons/chevron-left.mjs';
import IconChevronRight from '@tabler/icons-astro/dist/esm/icons/chevron-right.mjs';
import IconChevronUp from '@tabler/icons-astro/dist/esm/icons/chevron-up.mjs';
import IconCircleCheck from '@tabler/icons-astro/dist/esm/icons/circle-check.mjs';
import IconClock from '@tabler/icons-astro/dist/esm/icons/clock.mjs';
import IconCode from '@tabler/icons-astro/dist/esm/icons/code.mjs';
import IconCompass from '@tabler/icons-astro/dist/esm/icons/compass.mjs';
import IconCopy from '@tabler/icons-astro/dist/esm/icons/copy.mjs';
import IconDotsVertical from '@tabler/icons-astro/dist/esm/icons/dots-vertical.mjs';
