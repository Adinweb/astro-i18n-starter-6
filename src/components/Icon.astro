---
/**
 * The site's icon renderer.
 *
 * Every icon comes from `@tabler/icons-astro` (MIT) and is referenced by a
 * semantic name from `src/libs/ui/icons.ts` (`home`, `shield`, `chevron-left`,
 * …) instead of a vendor component name, so replacing the icon set stays a
 * one-file change.
 *
 * Why per-icon imports instead of the package barrel: `import { IconSun } from
 * '@tabler/icons-astro'` re-exports the entire 6,258-module set, and Vite has to
 * load every one of them before tree-shaking discards the unused icons — it
 * still produces the same HTML, but costs ≈ +2–7 s on every build here (measured
 * 5.0–9.8 s against 3.2–3.9 s with per-icon imports). Importing the individual
 * `dist/esm/icons/*` modules (typed in `src/types/tabler-icons-astro.d.ts`) keeps
 * the build graph to the icons this file lists and nothing else.
 *
 * Icons render inline: one request less than a sprite, no empty `<use>` tiles
 * while a sprite loads, and a newly added icon can never be hidden by a cached
 * sprite. Icons that appear later (pager chevrons, code-copy state) are cloned
 * from a server-rendered `<template>`, and the theme toggle renders both glyphs
 * for CSS to choose between, so client code never carries SVG paths of its own.
 */
import IconAdjustmentsHorizontal from '@tabler/icons-astro/dist/esm/icons/adjustments-horizontal.mjs';
import IconAlertCircle from '@tabler/icons-astro/dist/esm/icons/alert-circle.mjs';
import IconAlertTriangle from '@tabler/icons-astro/dist/esm/icons/alert-triangle.mjs';
