---
/**
 * Composable newsletter / lead-capture banner inspired by PrebuiltUI CTA and
 * newsletter sections. Pure-SSG: posts directly to external APIs configured
 * via `api.endpoints.newsletter` + `api.baseUrl`, `PUBLIC_NEWSLETTER_API_URL`,
 * or explicit component props. Renders a static fallback (`mailto:` or clear
 * unavailable status) instead of an unsubmittable form when unconfigured.
 */
import PageSection from '@/components/PageSection.astro';
import Button from '@/components/ui/Button.astro';
import FormFallbackCard from '@/components/ui/FormFallbackCard.astro';
import FormFeedbackBox from '@/components/ui/FormFeedbackBox.astro';
import { type Locale } from '@/i18n/locales';
import { localizeHref } from '@/i18n/paths';
import { resolveFormEndpoint, resolvePostSubmitRedirect } from '@/libs/api/client';
import { API_CONFIG, siteConfig } from '@/libs/config/app';
import { resolveComponentLocale } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

interface Props {
  id?: string;
  locale?: Locale | string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  baseUrl?: string;
  endpoint?: string;
  timeoutMs?: number;
  source?: string;
  /** Optional safe redirect URL (path or https:// URL) navigated after successful subscription. */
  redirectTo?: string;
  contained?: boolean;
  surface?: 'default' | 'surface' | 'subtle';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  id,
  locale,
  eyebrow,
  title,
  subtitle,
  baseUrl,
  endpoint,
  timeoutMs,
  source = 'newsletter-banner',
  redirectTo,
  contained = false,
  surface = 'surface',
  spacing = 'md',
} = Astro.props;

const activeLocale: Locale = resolveComponentLocale(locale, Astro.url.pathname);
const effectiveProvider = API_CONFIG.provider;
const effectiveBaseUrl = baseUrl ?? API_CONFIG.baseUrl;
const effectiveEndpoint = endpoint ?? API_CONFIG.endpoints.newsletter ?? '';
const effectiveAccessKey = API_CONFIG.accessKey;
const resolvedEndpoint =
  effectiveProvider === 'web3forms' || Boolean(effectiveEndpoint)
    ? resolveFormEndpoint(effectiveProvider, effectiveEndpoint, effectiveBaseUrl, effectiveAccessKey)
    : null;
const isConfigured = resolvedEndpoint !== null;
const effectiveTimeout = timeoutMs ?? API_CONFIG.timeoutMs;
const safeRawRedirect = resolvePostSubmitRedirect(redirectTo ?? API_CONFIG.redirects?.newsletter);
const resolvedRedirectTo = safeRawRedirect
  ? safeRawRedirect.startsWith('/')
    ? localizeHref(safeRawRedirect, activeLocale)
    : safeRawRedirect
  : '';

const emailHref = siteConfig.contactEmail ? `mailto:${siteConfig.contactEmail}` : null;

const copy = {
  kicker: eyebrow ?? m.newsletter_kicker({}, { locale: activeLocale }),
  title: title ?? m.newsletter_title({}, { locale: activeLocale }),
  subtitle: subtitle ?? m.newsletter_subtitle({}, { locale: activeLocale }),
  emailLabel: m.newsletter_email_label({}, { locale: activeLocale }),
  emailPlaceholder: m.newsletter_email_placeholder({}, { locale: activeLocale }),
  submit: m.newsletter_submit({}, { locale: activeLocale }),
  submitting: m.newsletter_submitting({}, { locale: activeLocale }),
  successTitle: m.newsletter_success_title({}, { locale: activeLocale }),
  successDesc: m.newsletter_success_desc({}, { locale: activeLocale }),
  errEmail: m.newsletter_error_email({}, { locale: activeLocale }),
  errTimeout: m.newsletter_error_timeout({}, { locale: activeLocale }),
  errHttp: m.newsletter_error_http({}, { locale: activeLocale }),
  errNetwork: m.newsletter_error_network({}, { locale: activeLocale }),
  errUnconfigured: m.newsletter_error_unconfigured({}, { locale: activeLocale }),
  fallbackDesc: m.newsletter_fallback_desc({}, { locale: activeLocale }),
  fallbackCta: m.newsletter_fallback_cta({}, { locale: activeLocale }),
  unavailableDesc: m.newsletter_unavailable_desc({}, { locale: activeLocale }),
  devNotice: m.newsletter_unconfigured_notice({}, { locale: activeLocale }),
};

const cardSurface = !contained && surface === 'surface' ? 'bg-bg' : 'bg-surface';
const emailInputId = `${id ?? `newsletter-${crypto.randomUUID().slice(0, 6)}`}-email-${activeLocale}`;
---

<PageSection
  id={id}
  surface={contained ? 'default' : surface}
  spacing={contained ? 'none' : spacing}
  bleed={contained}
  class={contained ? 'not-prose my-10' : undefined}
>
  <div
    data-newsletter-banner
    data-trig
    data-trig-once="true"
    class:list={[
      'fadeInUpSm rounded-3xl border border-border p-6 sm:p-8 lg:p-10',
      cardSurface,
    ]}
  >
    <div class="grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
      <div class="lg:col-span-6">
        <p class="section-kicker">{copy.kicker}</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-fg sm:text-3xl text-balance">
          {copy.title}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base text-pretty">
          {copy.subtitle}
        </p>
      </div>

      <div class="lg:col-span-6">
        {
          !isConfigured && (
            <FormFallbackCard
              emailHref={emailHref}
              fallbackDesc={copy.fallbackDesc}
              fallbackCta={copy.fallbackCta}
              unavailableDesc={copy.unavailableDesc}
              devNotice={copy.devNotice}
              layout="inline"
            />
          )
        }

        {
          isConfigured && (
            <form
              data-newsletter-form-el
              data-locale={activeLocale}
              data-provider={effectiveProvider}
              data-base-url={effectiveBaseUrl}
              data-endpoint={effectiveEndpoint}
              data-access-key={effectiveAccessKey}
              data-timeout-ms={String(effectiveTimeout)}
              data-source={source}
              data-redirect-to={resolvedRedirectTo || undefined}
              data-label-submit={copy.submit}
              data-label-submitting={copy.submitting}
              data-msg-success-title={copy.successTitle}
              data-msg-success-desc={copy.successDesc}
              data-err-validation={copy.errEmail}
              data-err-unconfigured={copy.errUnconfigured}
              data-err-timeout={copy.errTimeout}
              data-err-http={copy.errHttp}
              data-err-network={copy.errNetwork}
              novalidate
              class="space-y-3"
            >
              <div
                aria-hidden="true"
                class="pointer-events-none absolute -z-10 h-0 w-0 overflow-hidden opacity-0"
              >
                <input
                  type="text"
                  name="company_website"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>

              <label
                for={emailInputId}
                class="block text-xs font-semibold text-fg"
              >
                {copy.emailLabel}
              </label>

              <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                <input
                  id={emailInputId}
                  name="email"
                  type="email"
                  dir="ltr"
                  required
                  autocomplete="email"
                  placeholder={copy.emailPlaceholder}
                  class="min-w-0 flex-1 rounded-full border border-border bg-surface px-4 py-2.5 text-start text-sm text-fg placeholder:text-muted focus:border-primary focus:outline-none aria-[invalid=true]:border-error rtl:text-end"
                />

                <Button
                  type="submit"
                  variant="primary"
                  size="lg"
                  icon="arrow-right"
                  data-newsletter-submit
                  class="shrink-0"
                >
                  <span data-newsletter-submit-label>{copy.submit}</span>
                </Button>
              </div>

              <FormFeedbackBox kind="newsletter" />
            </form>
          )
        }
      </div>
    </div>
  </div>
</PageSection>

<script>
  import {
    submitNewsletterSubscription,
    type FormProvider,
    type NewsletterSubscriptionPayload,
  } from '@/libs/api/client';
  import {
    finalizeFormSuccess,
    readFormErrorMessages,
    renderFormFeedback,
    setFormSubmitting,
    type FeedbackElements,
  } from '@/libs/api/form-dom';

  function initNewsletterForms() {
    const forms = document.querySelectorAll<HTMLFormElement>('[data-newsletter-form-el]');

    forms.forEach((form) => {
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
      const submitBtn = form.querySelector<HTMLButtonElement>('[data-newsletter-submit]');
      const submitLabel = form.querySelector<HTMLElement>('[data-newsletter-submit-label]');
      const feedback: FeedbackElements = {
        box: form.querySelector<HTMLElement>('[data-newsletter-feedback]'),
        title: form.querySelector<HTMLElement>('[data-newsletter-feedback-title]'),
        body: form.querySelector<HTMLElement>('[data-newsletter-feedback-body]'),
      };
      const errorMessages = readFormErrorMessages(form.dataset);

      emailInput?.addEventListener('input', () => {
        emailInput.removeAttribute('aria-invalid');
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!submitBtn || submitBtn.disabled) return;

        const formData = new FormData(form);
        const honeypot = String(formData.get('company_website') ?? '');
        const payload: NewsletterSubscriptionPayload = {
          email: String(formData.get('email') ?? ''),
          locale: form.dataset.locale ?? 'en',
          source: form.dataset.source,
          honeypot,
        };

        setFormSubmitting(
          submitBtn,
          submitLabel,
          true,
          form.dataset.labelSubmit,
          form.dataset.labelSubmitting
        );

        const timeoutMs = Number.parseInt(form.dataset.timeoutMs ?? '10000', 10);
        const provider = (form.dataset.provider as FormProvider | undefined) ?? 'custom';
        const result = await submitNewsletterSubscription(payload, {
          provider,
          baseUrl: form.dataset.baseUrl ?? '',
          endpoint: form.dataset.endpoint ?? '',
          accessKey: form.dataset.accessKey ?? '',
          timeoutMs: Number.isFinite(timeoutMs) ? timeoutMs : 10000,
        });

        setFormSubmitting(
          submitBtn,
          submitLabel,
          false,
          form.dataset.labelSubmit,
          form.dataset.labelSubmitting
        );

        if (result.ok) {
          finalizeFormSuccess({
            form,
            kind: 'newsletter',
            locale: payload.locale,
            provider,
            source: payload.source,
            honeypot,
            feedback,
            feedbackPadding: 'p-3.5',
            onReset: () => emailInput?.removeAttribute('aria-invalid'),
          });
          return;
        }

        if (result.errorCode === 'validation') {
          emailInput?.setAttribute('aria-invalid', 'true');
          emailInput?.focus();
        }

        renderFormFeedback(feedback, 'error', errorMessages[result.errorCode] ?? '', '', 'p-3.5');
      });
    });
  }

  document.addEventListener('astro:page-load', initNewsletterForms);
  initNewsletterForms();
</script>
