---
import Button from '@/components/ui/Button.astro';
import FormFallbackCard from '@/components/ui/FormFallbackCard.astro';
import FormFeedbackBox from '@/components/ui/FormFeedbackBox.astro';
import UiInput from '@/components/ui/UiInput.astro';
import { DEFAULT_LOCALE, type Locale } from '@/i18n/locales';
import { localizeHref } from '@/i18n/paths';
import { resolveFormEndpoint, resolvePostSubmitRedirect } from '@/libs/api/client';
import { API_CONFIG, siteConfig } from '@/libs/config/app';
import * as m from '@/paraglide/messages';

interface Props {
  id?: string;
  locale: Locale;
  /** Omit outer section wrapper and left-hand intro column when composed inside `ContactSplitSection`. */
  embedded?: boolean;
  /** Optional safe redirect URL (path or https:// URL) navigated after successful submission. */
  redirectTo?: string;
}

const { id, locale, embedded = false, redirectTo } = Astro.props;

const resolvedEndpoint = resolveFormEndpoint(
  API_CONFIG.provider,
  API_CONFIG.endpoints.contact,
  API_CONFIG.baseUrl,
  API_CONFIG.accessKey
);
const isConfigured = resolvedEndpoint !== null;
const turnstileSiteKey = API_CONFIG.turnstileSiteKey.trim();
const safeRawRedirect = resolvePostSubmitRedirect(redirectTo ?? API_CONFIG.redirects?.contact);
const resolvedRedirectTo = safeRawRedirect
  ? safeRawRedirect.startsWith('/')
    ? localizeHref(safeRawRedirect, locale)
    : safeRawRedirect
  : '';

// Two audiences read this component. A visitor gets a form or a mailto button,
// never an environment variable name; the developer note below is rendered in
// development only, where it is actually useful.
const emailHref = siteConfig.contactEmail ? `mailto:${siteConfig.contactEmail}` : null;

const copy = {
  kicker: m.contact_kicker({}, { locale }),
  title: m.contact_title({}, { locale }),
  subtitle: m.contact_subtitle({}, { locale }),
  nameLabel: m.contact_name_label({}, { locale }),
  namePlaceholder: m.contact_name_placeholder({}, { locale }),
  emailLabel: m.contact_email_label({}, { locale }),
  emailPlaceholder: m.contact_email_placeholder({}, { locale }),
  topicLabel: m.contact_topic_label({}, { locale }),
  topicGeneral: m.contact_topic_general({}, { locale }),
  topicArchitecture: m.contact_topic_architecture({}, { locale }),
  topicEnterprise: m.contact_topic_enterprise({}, { locale }),
  messageLabel: m.contact_message_label({}, { locale }),
  messagePlaceholder: m.contact_message_placeholder({}, { locale }),
  submit: m.contact_submit({}, { locale }),
  submitting: m.contact_submitting({}, { locale }),
  successTitle: m.contact_success_title({}, { locale }),
  successDesc: m.contact_success_desc({}, { locale }),
  errValidation: m.contact_error_validation({}, { locale }),
  errTurnstile: m.contact_error_turnstile({}, { locale }),
  errName: m.contact_error_name({}, { locale }),
  errEmail: m.contact_error_email({}, { locale }),
  errTopic: m.contact_error_topic({}, { locale }),
  errMessage: m.contact_error_message({}, { locale }),
  errTimeout: m.contact_error_timeout({}, { locale }),
  errHttp: m.contact_error_http({}, { locale }),
  errNetwork: m.contact_error_network({}, { locale }),
  errUnconfigured: m.contact_error_unconfigured({}, { locale }),
  fallbackDesc: m.contact_fallback_desc({}, { locale }),
  fallbackCta: m.contact_fallback_cta({}, { locale }),
  unavailableDesc: m.contact_unavailable_desc({}, { locale }),
  devNotice: m.contact_unconfigured_notice({}, { locale }),
};

const topicOptions = API_CONFIG.topics?.length
  ? API_CONFIG.topics.map((topic) => ({
      value: topic.value,
      label:
        topic.labels?.[locale] ??
        topic.labels?.[DEFAULT_LOCALE] ??
        topic.label ??
        topic.value,
    }))
  : [
      { value: 'architecture', label: copy.topicArchitecture },
      { value: 'enterprise', label: copy.topicEnterprise },
      { value: 'general', label: copy.topicGeneral },
    ];
---

<section
  id={id ?? (embedded ? undefined : 'contact-inquiry')}
  data-contact-form
  class:list={[
    'not-prose',
    !embedded && 'mt-14 scroll-mt-28 rounded-2xl border border-border bg-surface p-6 sm:p-8 lg:p-10',
  ]}
>
  <div class:list={[!embedded && 'grid gap-8 lg:grid-cols-12 lg:gap-12']}>
    {
      !embedded && (
        <div class="lg:col-span-5">
          <p class="section-kicker">{copy.kicker}</p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-fg sm:text-3xl">
            {copy.title}
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">
            {copy.subtitle}
          </p>
        </div>
      )
    }

    <div class:list={[!embedded && 'lg:col-span-7']}>
      {
        !isConfigured && (
          <FormFallbackCard
            emailHref={emailHref}
            fallbackDesc={copy.fallbackDesc}
            fallbackCta={copy.fallbackCta}
            unavailableDesc={copy.unavailableDesc}
            devNotice={copy.devNotice}
            layout="stacked"
          />
        )
      }

      {
        isConfigured && (
      <form
        data-contact-form-el
        data-locale={locale}
        data-provider={API_CONFIG.provider}
        data-base-url={API_CONFIG.baseUrl}
        data-endpoint={API_CONFIG.endpoints.contact}
        data-access-key={API_CONFIG.accessKey}
        data-turnstile-site-key={turnstileSiteKey}
        data-timeout-ms={String(API_CONFIG.timeoutMs)}
        data-redirect-to={resolvedRedirectTo || undefined}
        data-label-submit={copy.submit}
        data-label-submitting={copy.submitting}
        data-msg-success-title={copy.successTitle}
        data-msg-success-desc={copy.successDesc}
        data-err-validation={copy.errValidation}
        data-err-turnstile={copy.errTurnstile}
        data-err-name={copy.errName}
        data-err-email={copy.errEmail}
        data-err-topic={copy.errTopic}
        data-err-message={copy.errMessage}
        data-err-unconfigured={copy.errUnconfigured}
        data-err-timeout={copy.errTimeout}
        data-err-http={copy.errHttp}
        data-err-network={copy.errNetwork}
        novalidate
        class="space-y-5"
      >
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -z-10 h-0 w-0 overflow-hidden opacity-0"
        >
          <input
            type="text"
            name="company_website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <UiInput
            id={`contact-name-${locale}`}
            name="name"
            locale={locale}
            type="text"
            label={copy.nameLabel}
            placeholder={copy.namePlaceholder}
            helper={null}
            required
            showRequiredMark={false}
            minlength={2}
            autocomplete="name"
            errorId={`contact-name-error-${locale}`}
            fieldErrorName="name"
          />

          <UiInput
            id={`contact-email-${locale}`}
            name="email"
            locale={locale}
            type="email"
            label={copy.emailLabel}
            placeholder={copy.emailPlaceholder}
            helper={null}
            required
            showRequiredMark={false}
            autocomplete="email"
            errorId={`contact-email-error-${locale}`}
            fieldErrorName="email"
          />
        </div>

        <div>
          <label
            for={`contact-topic-${locale}`}
            class="block text-xs font-semibold text-fg"
          >
            {copy.topicLabel}
          </label>
          <select
            id={`contact-topic-${locale}`}
            name="topic"
            class="mt-1.5 w-full rounded-xl border border-border bg-bg px-3.5 py-2.5 text-sm text-fg shadow-xs transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 aria-[invalid=true]:border-error"
          >
            {topicOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
          <p
            id={`contact-topic-error-${locale}`}
            data-field-error="topic"
            hidden
            class="mt-1.5 text-xs text-error"
          ></p>
        </div>

        <UiInput
          id={`contact-message-${locale}`}
          name="message"
          locale={locale}
          type="textarea"
          rows={4}
          label={copy.messageLabel}
          placeholder={copy.messagePlaceholder}
          helper={null}
          required
          showRequiredMark={false}
          minlength={10}
          errorId={`contact-message-error-${locale}`}
          fieldErrorName="message"
        />

        {turnstileSiteKey && (
          <div data-turnstile-container class="min-h-[65px]" />
        )}

        <FormFeedbackBox kind="contact" />

        <div class="flex items-center justify-end pt-1">
          <Button
            type="submit"
            variant="primary"
            size="lg"
            icon="arrow-right"
            data-contact-submit
          >
            <span data-contact-submit-label>{copy.submit}</span>
          </Button>
        </div>
      </form>
        )
      }
    </div>
  </div>
</section>

<script>
  import {
    getInvalidContactFields,
    submitContactInquiry,
    type ContactInquiryPayload,
    type FormProvider,
  } from '@/libs/api/client';
  import {
    ensureTurnstileLoaded,
    finalizeFormSuccess,
    readFormErrorMessages,
    renderFormFeedback,
    setFormSubmitting,
    type FeedbackElements,
    type TurnstileApi,
  } from '@/libs/api/form-dom';

  function initContactForms() {
    const forms = document.querySelectorAll<HTMLFormElement>('[data-contact-form-el]');

    forms.forEach((form) => {
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      const submitBtn = form.querySelector<HTMLButtonElement>('[data-contact-submit]');
      const submitLabel = form.querySelector<HTMLElement>('[data-contact-submit-label]');
      const feedback: FeedbackElements = {
        box: form.querySelector<HTMLElement>('[data-contact-feedback]'),
        title: form.querySelector<HTMLElement>('[data-contact-feedback-title]'),
        body: form.querySelector<HTMLElement>('[data-contact-feedback-body]'),
      };
      const turnstileContainer = form.querySelector<HTMLElement>('[data-turnstile-container]');
      const turnstileSiteKey = form.dataset.turnstileSiteKey?.trim() ?? '';
      let turnstileWidgetId: string | null = null;
      let turnstileToken = '';

      if (turnstileSiteKey && turnstileContainer) {
        ensureTurnstileLoaded().then((api) => {
          if (!api || !turnstileContainer.isConnected || turnstileWidgetId !== null) return;
          const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
          turnstileWidgetId = api.render(turnstileContainer, {
            sitekey: turnstileSiteKey,
            theme,
            language: form.dataset.locale ?? 'auto',
            callback: (token: string) => {
              turnstileToken = token;
            },
            'expired-callback': () => {
              turnstileToken = '';
            },
          });
        });
      }

      const fieldNames = ['name', 'email', 'topic', 'message'] as const;
      const errorMessages = readFormErrorMessages(form.dataset);

      const fieldErrorMessages: Record<(typeof fieldNames)[number], string> = {
        name: form.dataset.errName ?? '',
        email: form.dataset.errEmail ?? '',
        topic: form.dataset.errTopic ?? '',
        message: form.dataset.errMessage ?? '',
      };

      const clearFieldError = (name: string) => {
        const el = form.querySelector<HTMLElement>(`[name="${name}"]`);
        el?.removeAttribute('aria-invalid');
        el?.removeAttribute('aria-describedby');
        const errEl = form.querySelector<HTMLElement>(`[data-field-error="${name}"]`);
        if (errEl) {
          errEl.hidden = true;
          errEl.textContent = '';
        }
      };

      const clearInvalidState = () => {
        for (const name of fieldNames) {
          clearFieldError(name);
        }
      };

      const handleFieldEdit = (event: Event) => {
        const target = event.target as HTMLElement | null;
        const fieldName = target?.getAttribute('name');
        if (fieldName && target?.hasAttribute('aria-invalid')) {
          clearFieldError(fieldName);
        }
      };

      form.addEventListener('input', handleFieldEdit);
      form.addEventListener('change', handleFieldEdit);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!submitBtn || submitBtn.disabled) return;

        const formData = new FormData(form);
        const honeypot = String(formData.get('company_website') ?? '');
        const winTurnstile = (window as unknown as { turnstile?: TurnstileApi }).turnstile;
        const resolvedToken =
          turnstileToken ||
          (turnstileWidgetId !== null ? winTurnstile?.getResponse(turnstileWidgetId) ?? '' : '') ||
          String(formData.get('cf-turnstile-response') ?? '');

        const payload: ContactInquiryPayload = {
          name: String(formData.get('name') ?? ''),
          email: String(formData.get('email') ?? ''),
          topic: String(formData.get('topic') ?? 'general'),
          message: String(formData.get('message') ?? ''),
          locale: form.dataset.locale ?? 'en',
          honeypot,
          ...(resolvedToken ? { turnstileToken: resolvedToken } : {}),
        };

        if (!honeypot.trim()) {
          const invalidFields = getInvalidContactFields(payload);
          clearInvalidState();
          if (invalidFields.length > 0) {
            let firstInvalid: HTMLElement | null = null;
            for (const fieldName of invalidFields) {
              const el = form.querySelector<HTMLElement>(`[name="${fieldName}"]`);
              const errEl = form.querySelector<HTMLElement>(`[data-field-error="${fieldName}"]`);
              if (el) {
                el.setAttribute('aria-invalid', 'true');
                if (errEl && fieldErrorMessages[fieldName]) {
                  errEl.textContent = fieldErrorMessages[fieldName];
                  errEl.hidden = false;
                  if (errEl.id) el.setAttribute('aria-describedby', errEl.id);
                }
                if (!firstInvalid) firstInvalid = el;
              }
            }
            renderFormFeedback(feedback, 'error', errorMessages.validation, '');
            firstInvalid?.focus();
            return;
          }
        }

        setFormSubmitting(
          submitBtn,
          submitLabel,
          true,
          form.dataset.labelSubmit,
          form.dataset.labelSubmitting
        );

        const timeoutMs = Number.parseInt(form.dataset.timeoutMs ?? '10000', 10);
        const provider = (form.dataset.provider as FormProvider | undefined) ?? 'custom';
        const result = await submitContactInquiry(payload, {
          provider,
          baseUrl: form.dataset.baseUrl ?? '',
          endpoint: form.dataset.endpoint ?? '/contact',
          accessKey: form.dataset.accessKey ?? '',
          requireTurnstile: Boolean(turnstileSiteKey),
          timeoutMs: Number.isFinite(timeoutMs) ? timeoutMs : 10000,
        });

        setFormSubmitting(
          submitBtn,
          submitLabel,
          false,
          form.dataset.labelSubmit,
          form.dataset.labelSubmitting
        );

        if (result.ok) {
          finalizeFormSuccess({
            form,
            kind: 'contact',
            locale: payload.locale,
            provider,
            honeypot,
            feedback,
            onReset: () => {
              clearInvalidState();
              turnstileToken = '';
              if (turnstileWidgetId !== null) winTurnstile?.reset(turnstileWidgetId);
            },
          });
          return;
        }

        renderFormFeedback(feedback, 'error', errorMessages[result.errorCode] ?? '', '');
      });
    });
  }

  document.addEventListener('astro:page-load', initContactForms);
  initContactForms();
</script>
