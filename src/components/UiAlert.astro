---
/**
 * Reusable notification / callout alert inspired by PrebuiltUI alert cards.
 * Uses semantic OKLCH status roles paired with explicit Tabler icons and
 * optional dismiss control (`<IconButton>` + idempotent `dataset.bound`).
 * Follows starter rules: crisp full borders (no thick physical side bars) and
 * 100% localized defaults.
 */
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import IconButton from '@/components/IconButton.astro';
import type { Locale } from '@/i18n/locales';
import { resolveComponentLocale } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

export type AlertVariant = 'info' | 'success' | 'warning' | 'error' | 'neutral';

export interface AlertAction {
  label: string;
  href: string;
  icon?: string;
  external?: boolean;
}

interface Props {
  id?: string;
  locale?: Locale | string;
  variant?: AlertVariant;
  title?: string;
  description?: string | null;
  icon?: string;
  action?: AlertAction;
  dismissible?: boolean;
  class?: string;
}

const {
  id,
  locale,
  variant = 'info',
  title,
  description,
  icon,
  action,
  dismissible = false,
  class: className,
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = title === undefined && description === undefined;

const resolvedTitle = title ?? m.block_alert_default_title({}, { locale: activeLocale });
const resolvedDescription =
  description === null
    ? undefined
    : (description ?? (usingDefaults ? m.block_alert_default_desc({}, { locale: activeLocale }) : undefined));
const dismissLabel = m.block_alert_dismiss({}, { locale: activeLocale });

const VARIANTS: Record<AlertVariant, { container: string; badge: string; defaultIcon: string }> = {
  info: {
    container: 'border-info/30 bg-info/10 text-fg',
    badge: 'bg-info/15 text-info',
    defaultIcon: 'info',
  },
  success: {
    container: 'border-success/30 bg-success/10 text-fg',
    badge: 'bg-success/15 text-success',
    defaultIcon: 'circle-check',
  },
  warning: {
    container: 'border-warning/40 bg-warning/15 text-fg',
    badge: 'bg-warning/25 text-fg',
    defaultIcon: 'alert-triangle',
  },
  error: {
    container: 'border-error/30 bg-error/10 text-fg',
    badge: 'bg-error/15 text-error',
    defaultIcon: 'alert-circle',
  },
  neutral: {
    container: 'border-border bg-surface text-fg',
    badge: 'bg-surface-hover text-muted',
    defaultIcon: 'bell',
  },
};

const style = VARIANTS[variant];
const resolvedIcon = icon ?? style.defaultIcon;
const roleAttr = variant === 'error' || variant === 'warning' ? 'alert' : 'status';
---

<div
  id={id}
  role={roleAttr}
  data-ui-alert
  data-trig
  class:list={[
    'not-prose relative flex items-start gap-3.5 rounded-2xl border p-4 sm:p-5',
    style.container,
    className,
  ]}
>
  <span
    aria-hidden="true"
    class:list={[
      'inline-flex size-9 shrink-0 items-center justify-center rounded-xl',
      style.badge,
    ]}
  >
    <Icon name={resolvedIcon} size={18} />
  </span>

  <div class="min-w-0 flex-1">
    <p class="text-sm font-bold text-fg">{resolvedTitle}</p>
    {
      resolvedDescription && (
        <p class="mt-1 text-sm leading-relaxed text-muted">{resolvedDescription}</p>
      )
    }
    <slot />
    {
      action && (
        <div class="mt-3 print:hidden">
          <Button
            href={action.href}
            variant="secondary"
            size="sm"
            icon={action.icon ?? 'arrow-right'}
            external={action.external}
          >
            {action.label}
          </Button>
        </div>
      )
    }
  </div>

  {
    dismissible && (
      <IconButton
        icon="close"
        label={dismissLabel}
        size={16}
        data-ui-alert-close
        class="shrink-0 print:hidden"
      />
    )
  }
</div>

{
  dismissible && (
    <script>
      function initUiAlerts() {
        const alerts = document.querySelectorAll<HTMLElement>('[data-ui-alert]');
        alerts.forEach((alertEl) => {
          const closeBtn = alertEl.querySelector<HTMLButtonElement>('[data-ui-alert-close]');
          if (!closeBtn || closeBtn.dataset.bound === 'true') return;
          closeBtn.dataset.bound = 'true';

          closeBtn.addEventListener('click', () => {
            alertEl.hidden = true;
          });
        });
      }

      document.addEventListener('astro:page-load', initUiAlerts);
      initUiAlerts();
    </script>
  )
}
