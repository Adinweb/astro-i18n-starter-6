---
/**
 * Accessible native `<details>` FAQ accordion with optional FAQPage JSON-LD.
 * Uses CSS logical spacing and standard chevron-down icon rotation.
 */
import PageSection from '@/components/PageSection.astro';
import Icon from '@/components/Icon.astro';
import { buildFaqSchema, type FaqItem } from '@/libs/content/faq';

interface Props {
  id?: string;
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  items: readonly FaqItem[];
  emitSchema?: boolean;
  surface?: 'default' | 'surface' | 'subtle';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  id,
  eyebrow,
  heading,
  subheading,
  items,
  emitSchema = false,
  surface = 'default',
  spacing = 'md',
} = Astro.props;

const cardBg = surface === 'surface' ? 'bg-bg' : 'bg-surface';
const faqJsonLd =
  emitSchema && items.length > 0
    ? JSON.stringify(buildFaqSchema(items)).replace(/</g, '\\u003c')
    : undefined;
---

<PageSection id={id} surface={surface} spacing={spacing}>
  <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
    {
      (eyebrow || heading || subheading) && (
        <div class="lg:col-span-5" data-trig>
          {eyebrow && <p class="section-kicker">{eyebrow}</p>}
          {heading && (
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-fg sm:text-3xl text-balance">
              {heading}
            </h2>
          )}
          {subheading && (
            <p class="mt-3 text-base leading-relaxed text-muted text-pretty">
              {subheading}
            </p>
          )}
        </div>
      )
    }

    <div
      class:list={[
        'space-y-3',
        eyebrow || heading || subheading ? 'lg:col-span-7' : 'lg:col-span-12 max-w-3xl',
      ]}
      data-trig
    >
      {
        items.map((item) => (
          <details
            class:list={[
              'group rounded-2xl border border-border transition-colors open:border-primary/40',
              cardBg,
            ]}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-start text-sm font-semibold text-fg transition-colors hover:text-primary sm:px-6 sm:text-base">
              <span>{item.question}</span>
              <Icon
                name="chevron-down"
                size={18}
                class="shrink-0 text-muted transition-transform duration-200 group-open:rotate-180 group-open:text-primary"
              />
            </summary>
            <div class="border-t border-border/70 px-5 py-4 text-sm leading-relaxed text-muted sm:px-6">
              {item.answer}
            </div>
          </details>
        ))
      }
    </div>
  </div>

  {faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} is:inline />}
</PageSection>
