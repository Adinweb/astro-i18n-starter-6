---
/**
 * Composable asymmetric split hero band for `container: "canvas"` landing pages.
 *
 * Uses logical CSS properties only so LTR and RTL reading flows mirror
 * seamlessly. Emits exactly one `<h1>` element for the page.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '@/components/Button.astro';

interface CtaAction {
  label: string;
  href: string;
  icon?: string;
  external?: boolean;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  primaryCta?: CtaAction;
  secondaryCta?: CtaAction;
  trustNote?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  surface?: 'default' | 'hero' | 'subtle';
}

const {
  id,
  eyebrow,
  title,
  description,
  primaryCta,
  secondaryCta,
  trustNote,
  image,
  imageAlt = '',
  surface = 'default',
} = Astro.props;

const hasMedia = Boolean(image) || Astro.slots.has('media');
const isHeroSurface = surface === 'hero';
---

<section
  id={id}
  class:list={[
    'relative isolate overflow-hidden pt-28 pb-14 sm:pt-36 sm:pb-20 lg:pt-40 lg:pb-24',
    id && 'scroll-mt-24',
    isHeroSurface
      ? 'bg-hero-base text-hero-fg print:bg-bg print:text-fg'
      : surface === 'subtle'
        ? 'border-b border-border bg-surface/60 text-fg'
        : 'border-b border-border bg-bg text-fg',
  ]}
>
  {
    isHeroSurface && (
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 print:hidden">
        <div class="absolute -top-40 end-[-6rem] size-[28rem] rounded-full bg-primary/25 blur-3xl" />
        <div class="absolute -bottom-44 start-[-8rem] size-[24rem] rounded-full bg-accent/20 blur-3xl" />
      </div>
    )
  }

  <div class="layout-container">
    <div class:list={[hasMedia ? 'grid items-center gap-10 lg:grid-cols-12 lg:gap-12' : 'max-w-3xl']}>
      <div class:list={[hasMedia && 'lg:col-span-6']} data-trig>
        {
          eyebrow && (
            <p
              class:list={[
                'text-xs font-semibold uppercase tracking-[0.14em] rtl:tracking-normal',
                isHeroSurface ? 'text-accent print:text-primary' : 'text-primary',
              ]}
            >
              {eyebrow}
            </p>
          )
        }

        <h1
          class="mt-3 text-[clamp(2.25rem,4vw,3.75rem)] font-extrabold leading-[1.08] tracking-tight text-balance"
        >
          {title}
        </h1>

        {
          description && (
            <p
              class:list={[
                'mt-5 max-w-xl text-base leading-relaxed text-pretty sm:text-lg',
                isHeroSurface ? 'text-hero-fg/88 print:text-muted' : 'text-muted',
              ]}
            >
              {description}
            </p>
          )
        }

        {
          (primaryCta || secondaryCta) && (
            <div class="mt-8 flex flex-wrap items-center gap-3 print:hidden">
              {primaryCta && (
                <Button
                  href={primaryCta.href}
                  variant="primary"
                  size="lg"
                  icon={primaryCta.icon ?? 'arrow-right'}
                  external={primaryCta.external}
                >
                  {primaryCta.label}
                </Button>
              )}
              {secondaryCta && (
                <Button
                  href={secondaryCta.href}
                  variant={isHeroSurface ? 'hero' : 'secondary'}
                  size="lg"
                  external={secondaryCta.external}
                >
                  {secondaryCta.label}
                </Button>
              )}
            </div>
          )
        }

        {
          trustNote && (
            <p
              class:list={[
                'mt-4 text-xs leading-relaxed',
                isHeroSurface ? 'text-hero-fg/75 print:text-muted' : 'text-muted',
              ]}
            >
              {trustNote}
            </p>
          )
        }
      </div>

      {
        hasMedia && (
          <div class="lg:col-span-6" data-trig data-trig-delay="0.12">
            {Astro.slots.has('media') ? (
              <slot name="media" />
            ) : (
              image && (
                <div
                  class:list={[
                    'overflow-hidden rounded-2xl border shadow-floating',
                    isHeroSurface ? 'border-hero-fg/15 bg-hero-base/40' : 'border-border bg-surface',
                  ]}
                >
                  <Image
                    src={image}
                    alt={imageAlt}
                    widths={[640, 960, 1280]}
                    sizes="(min-width: 1024px) 46vw, 94vw"
                    class="aspect-[16/10] w-full object-cover"
                    loading="eager"
                    fetchpriority="high"
                  />
                </div>
              )
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
