---
/**
 * Composable asymmetric split hero band composed from shared UI primitives:
 * `<BackdropLayer>`, `<TopBanner>`, `<HeroPreviewNav>`, `<AvatarGroup>`,
 * `<AnnouncementPill>`, `<HeroHeadline>`, `<Button>`, `<IconBox>`, `<Card>`,
 * and `<HeroParallaxLayer>`.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AnnouncementPill from '@/components/ui/AnnouncementPill.astro';
import AvatarGroup, { type AvatarItem } from '@/components/ui/AvatarGroup.astro';
import BackdropLayer from '@/components/ui/BackdropLayer.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import HeroHeadline from '@/components/ui/HeroHeadline.astro';
import HeroParallaxLayer, {
  type HeroParallaxOverlay,
  type HeroParallaxSpeed,
} from '@/components/ui/HeroParallaxLayer.astro';
import HeroPreviewNav, {
  type HeroPreviewNavLink,
  type HeroPreviewNavVariant,
} from '@/components/ui/HeroPreviewNav.astro';
import Icon from '@/components/ui/Icon.astro';
import IconBox from '@/components/ui/IconBox.astro';
import TopBanner from '@/components/ui/TopBanner.astro';
import type { Locale } from '@/i18n/locales';
import { DEFAULT_HERO_IMAGE } from '@/libs/config/app';
import { getHomeHref, getPageUrl } from '@/libs/content/service';
import { resolveComponentLocale } from '@/libs/ui/locale';
import type { HeroAnnouncement, HeroCtaAction, HeroTopBanner } from '@/libs/ui/types';
import * as m from '@/paraglide/messages';

export type { HeroCtaAction };
export type HeroSplitAnnouncement = HeroAnnouncement;

export interface HeroSplitFeature {
  icon?: string;
  label: string;
}

export interface HeroSplitMediaStat {
  value: string;
  label: string;
  icon?: string;
}

interface Props {
  id?: string;
  locale?: Locale | string;
  surface?: 'default' | 'hero' | 'surface' | 'subtle';
  backdrop?: 'none' | 'glow' | 'grid' | 'dots' | 'wash' | 'noise' | 'net';
  parallaxImage?: ImageMetadata | null;
  parallaxAlt?: string;
  parallaxSpeed?: HeroParallaxSpeed;
  parallaxOverlay?: HeroParallaxOverlay;
  topBanner?: HeroTopBanner | null;
  showPreviewNav?: boolean;
  previewNavVariant?: HeroPreviewNavVariant;
  previewBrand?: string;
  previewLinks?: readonly HeroPreviewNavLink[];
  previewCta?: HeroCtaAction | null;
  announcement?: HeroSplitAnnouncement | null;
  showAvatarPill?: boolean;
  avatarItems?: readonly AvatarItem[];
  avatarCount?: number;
  avatarLabel?: string;
  showAvatarGroup?: boolean;
  avatarRating?: number | null;
  eyebrow?: string | null;
  title?: string;
  titleAccent?: string | null;
  description?: string | null;
  primaryCta?: HeroCtaAction | null;
  secondaryCta?: HeroCtaAction | null;
  showInlineSubscribe?: boolean;
  subscribePlaceholder?: string;
  subscribeSubmitLabel?: string;
  featuresRow?: readonly HeroSplitFeature[] | null;
  trustNote?: string | null;
  image?: ImageMetadata | null;
  imageAlt?: string;
  mediaStatsOverlay?: readonly HeroSplitMediaStat[] | null;
  flipColumns?: boolean;
  edgeBleedFrame?: boolean;
  headingTag?: 'h1' | 'h2';
  compact?: boolean;
}

const {
  id,
  locale,
  surface = 'default',
  backdrop,
  parallaxImage = null,
  parallaxAlt = '',
  parallaxSpeed = 'medium',
  parallaxOverlay = 'hero',
  topBanner = null,
  showPreviewNav = false,
  previewNavVariant = 'minimal',
  previewBrand,
  previewLinks,
  previewCta,
  announcement = null,
  showAvatarPill = false,
  avatarItems,
  avatarCount,
  avatarLabel,
  showAvatarGroup = false,
  avatarRating = 5,
  eyebrow,
  title,
  titleAccent = null,
  description,
  primaryCta,
  secondaryCta,
  showInlineSubscribe = false,
  subscribePlaceholder,
  subscribeSubmitLabel,
  featuresRow = null,
  trustNote,
  image,
  imageAlt = '',
  mediaStatsOverlay = null,
  flipColumns = false,
  edgeBleedFrame = false,
  headingTag = 'h1',
  compact = false,
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = title === undefined;

const [featuresHref, pricingHref, homeHref] =
  usingDefaults && (primaryCta === undefined || secondaryCta === undefined)
    ? await Promise.all([
        getPageUrl('features', activeLocale),
        getPageUrl('pricing', activeLocale),
        getHomeHref(activeLocale),
      ])
    : [null, null, ''];

const resolvedEyebrow =
  eyebrow === null
    ? undefined
    : eyebrow ?? (usingDefaults ? m.block_hero_eyebrow({}, { locale: activeLocale }) : undefined);
const resolvedTitle = title ?? m.block_hero_title({}, { locale: activeLocale });
const resolvedTitleAccent = titleAccent === null ? undefined : titleAccent;
const resolvedDescription =
  description === null
    ? undefined
    : description ?? (usingDefaults ? m.block_hero_desc({}, { locale: activeLocale }) : undefined);
const resolvedPrimaryCta =
  primaryCta === null
    ? undefined
    : primaryCta ??
      (usingDefaults
        ? {
            label: m.block_hero_primary_cta({}, { locale: activeLocale }),
            href: featuresHref ?? homeHref,
            icon: 'arrow-right',
          }
        : undefined);
const resolvedSecondaryCta =
  secondaryCta === null
    ? undefined
    : secondaryCta ??
      (usingDefaults
        ? {
            label: m.block_hero_secondary_cta({}, { locale: activeLocale }),
            href: pricingHref ?? homeHref,
          }
        : undefined);
const resolvedTrustNote =
  trustNote === null
    ? undefined
    : trustNote ?? (usingDefaults ? m.block_hero_trust({}, { locale: activeLocale }) : undefined);

const resolvedImage =
  image === null ? undefined : image ?? (usingDefaults ? DEFAULT_HERO_IMAGE : undefined);
const hasMedia = Boolean(resolvedImage) || Astro.slots.has('media');
const hasParallax = Boolean(parallaxImage);
const isHeroSurface = hasParallax || surface === 'hero';
const effectiveNavSurface = hasParallax ? 'hero' : surface;
const resolvedBackdrop = backdrop ?? (isHeroSurface ? 'glow' : 'none');

const subInputId = showInlineSubscribe ? `${id ?? 'hero-split'}-sub-${crypto.randomUUID().slice(0, 6)}-${activeLocale}` : '';
const subEmailLabel = m.block_hero_sub_email_label({}, { locale: activeLocale });
const subPlaceholder = subscribePlaceholder ?? m.block_hero_sub_email_placeholder({}, { locale: activeLocale });
const subSubmit = subscribeSubmitLabel ?? m.block_hero_sub_submit({}, { locale: activeLocale });
const subInvalidMsg = m.block_hero_sub_invalid({}, { locale: activeLocale });
const subOkMsg = m.block_hero_sub_preview_ok({}, { locale: activeLocale });
---

<section
  id={id}
  class:list={[
    'hero-split-band relative isolate overflow-hidden',
    compact
      ? showPreviewNav
        ? 'rounded-3xl py-8 sm:py-12'
        : 'rounded-3xl py-10 sm:py-14'
      : showPreviewNav
        ? 'pt-10 pb-14 sm:pt-14 sm:pb-20 lg:pb-24'
        : 'pt-28 pb-14 sm:pt-36 sm:pb-20 lg:pt-40 lg:pb-24',
    topBanner && 'pt-0!',
    id && 'scroll-mt-24',
    isHeroSurface
      ? 'bg-hero-base text-hero-fg print:bg-bg print:text-fg'
      : surface === 'surface'
        ? 'border border-border bg-surface text-fg'
        : surface === 'subtle'
          ? 'border border-border bg-surface/60 text-fg'
          : 'border-b border-border bg-bg text-fg',
  ]}
  data-hero-surface={isHeroSurface ? 'hero' : 'standard'}
>
  {
    parallaxImage && (
      <HeroParallaxLayer
        locale={activeLocale}
        image={parallaxImage}
        alt={parallaxAlt || resolvedTitle}
        speed={parallaxSpeed}
        overlay={parallaxOverlay}
        priority={!compact}
      />
    )
  }

  <BackdropLayer backdrop={resolvedBackdrop} surface={isHeroSurface ? 'hero' : 'default'} />

  {
    topBanner && (
      <TopBanner
        badge={topBanner.badge}
        label={topBanner.label}
        href={topBanner.href}
        ctaLabel={topBanner.ctaLabel ?? resolvedPrimaryCta?.label}
        surface={isHeroSurface ? 'hero' : 'default'}
        locale={activeLocale}
        class="mb-8 print:hidden"
      />
    )
  }

  <div class="layout-container">
    {
      showPreviewNav && (
        <HeroPreviewNav
          locale={activeLocale}
          surface={effectiveNavSurface}
          variant={previewNavVariant}
          brand={previewBrand}
          links={previewLinks}
          cta={previewCta}
          compact={compact}
        />
      )
    }

    <div class:list={[hasMedia ? 'grid items-center gap-10 lg:grid-cols-12 lg:gap-12' : 'max-w-3xl']}>
      <div
        class:list={[hasMedia && 'lg:col-span-6', hasMedia && flipColumns && 'lg:order-last']}
        data-trig-stagger
        data-trig-stagger-mode="linear"
        data-trig-stagger-delay="0.05"
        data-trig-once="true"
      >
        {
          showAvatarPill && (
            <div class="mb-5 flex flex-wrap justify-start">
              <div
                class:list={[
                  'inline-flex flex-wrap items-center gap-3 rounded-full border px-3.5 py-1.5',
                  isHeroSurface
                    ? 'border-hero-fg/15 bg-hero-fg/10 text-hero-fg print:border-border print:bg-surface print:text-fg'
                    : 'border-border bg-surface text-fg shadow-xs',
                ]}
              >
                <AvatarGroup
                  locale={activeLocale}
                  items={avatarItems}
                  extraCount={avatarCount}
                  label={avatarLabel}
                  rating={null}
                  size="sm"
                />
              </div>
            </div>
          )
        }

        {
          announcement && (
            <AnnouncementPill
              badge={announcement.badge}
              label={announcement.label}
              href={announcement.href}
              surface={isHeroSurface ? 'hero' : 'default'}
              align="start"
              locale={activeLocale}
              class="mb-5"
            />
          )
        }

        {
          resolvedEyebrow && (
            <p
              class:list={[
                'text-xs font-semibold uppercase tracking-[0.14em] rtl:tracking-normal',
                isHeroSurface ? 'text-accent print:text-primary' : 'text-primary',
              ]}
            >
              {resolvedEyebrow}
            </p>
          )
        }

        <HeroHeadline
          headingTag={headingTag}
          lead={resolvedTitle}
          accent={resolvedTitleAccent}
          size="split"
          surface={isHeroSurface ? 'hero' : 'default'}
          class="mt-3"
        />

        {
          resolvedDescription && (
            <p
              class:list={[
                'mt-5 max-w-xl text-base leading-relaxed text-pretty sm:text-lg',
                isHeroSurface ? 'text-hero-fg/88 print:text-muted' : 'text-muted',
              ]}
            >
              {resolvedDescription}
            </p>
          )
        }

        {
          showInlineSubscribe ? (
            <div data-hero-split-sub-root class="mt-7 max-w-md print:hidden">
              <form
                data-hero-split-sub-form
                data-err-invalid={subInvalidMsg}
                data-msg-ok={subOkMsg}
                novalidate
                class:list={[
                  'flex flex-col gap-2 rounded-2xl border p-1.5 shadow-sm sm:flex-row sm:items-center sm:rounded-full',
                  isHeroSurface
                    ? 'border-hero-fg/20 bg-hero-fg/10 print:border-border print:bg-surface'
                    : 'border-border bg-surface',
                ]}
              >
                <label for={subInputId} class="sr-only">
                  {subEmailLabel}
                </label>
                <div class="flex min-w-0 flex-1 items-center gap-2 ps-3">
                  <Icon
                    name="mail"
                    size={16}
                    class:list={['shrink-0', isHeroSurface ? 'text-hero-fg/70' : 'text-muted']}
                  />
                  <input
                    id={subInputId}
                    name="email"
                    type="email"
                    dir="ltr"
                    required
                    autocomplete="email"
                    placeholder={subPlaceholder}
                    class:list={[
                      'min-w-0 flex-1 bg-transparent py-2 pe-2 text-start text-sm focus:outline-none rtl:text-end',
                      isHeroSurface
                        ? 'text-hero-fg placeholder:text-hero-fg/55 print:text-fg print:placeholder:text-muted'
                        : 'text-fg placeholder:text-muted/75',
                    ]}
                  />
                </div>
                <Button type="submit" variant="primary" size="md" icon="arrow-right" class="shrink-0">
                  {subSubmit}
                </Button>
              </form>
              <p
                data-hero-split-sub-feedback
                role="status"
                aria-live="polite"
                hidden
                class="mt-2.5 rounded-xl border px-3.5 py-2 text-xs font-medium leading-relaxed"
              ></p>
            </div>
          ) : (
            (resolvedPrimaryCta || resolvedSecondaryCta) && (
              <div class="mt-8 flex flex-wrap items-center gap-3 print:hidden">
                {resolvedPrimaryCta && (
                  <Button
                    href={resolvedPrimaryCta.href}
                    variant={resolvedPrimaryCta.variant ?? 'primary'}
                    size="lg"
                    icon={resolvedPrimaryCta.icon ?? 'arrow-right'}
                    external={resolvedPrimaryCta.external}
                  >
                    {resolvedPrimaryCta.label}
                  </Button>
                )}
                {resolvedSecondaryCta && (
                  <Button
                    href={resolvedSecondaryCta.href}
                    variant={resolvedSecondaryCta.variant ?? (isHeroSurface ? 'hero' : 'secondary')}
                    size="lg"
                    icon={resolvedSecondaryCta.icon}
                    external={resolvedSecondaryCta.external}
                  >
                    {resolvedSecondaryCta.label}
                  </Button>
                )}
              </div>
            )
          )
        }

        {
          showAvatarGroup && (
            <div class="mt-7">
              <AvatarGroup
                locale={activeLocale}
                items={avatarItems}
                extraCount={avatarCount}
                label={avatarLabel}
                rating={avatarRating}
                size="sm"
                class={isHeroSurface ? '[&_p]:text-hero-fg/80 print:[&_p]:text-muted' : undefined}
              />
            </div>
          )
        }

        {
          featuresRow && featuresRow.length > 0 && (
            <ul
              class:list={[
                'mt-8 grid gap-3 border-t pt-6 sm:grid-cols-3',
                isHeroSurface ? 'border-hero-fg/15 print:border-border' : 'border-border',
              ]}
            >
              {featuresRow.map((feat) => (
                <li class="flex items-center gap-2 text-xs font-medium">
                  <IconBox
                    icon={feat.icon ?? 'circle-check'}
                    size="xs"
                    radius="lg"
                    tone={isHeroSurface ? 'hero' : 'primary'}
                    iconSize={15}
                  />
                  <span class={isHeroSurface ? 'text-hero-fg/85 print:text-fg' : 'text-fg'}>
                    {feat.label}
                  </span>
                </li>
              ))}
            </ul>
          )
        }

        {
          resolvedTrustNote && (
            <p
              class:list={[
                'mt-4 text-xs leading-relaxed',
                isHeroSurface ? 'text-hero-fg/75 print:text-muted' : 'text-muted',
              ]}
            >
              {resolvedTrustNote}
            </p>
          )
        }
      </div>

      {
        hasMedia && (
          <div
            class:list={['lg:col-span-6 trig-delay-100', flipColumns && 'lg:order-first']}
            data-trig
            data-trig-direction={flipColumns ? 'start' : 'end'}
            data-trig-once="true"
          >
            {Astro.slots.has('media') ? (
              <slot name="media" />
            ) : (
              resolvedImage && (
                <div class="relative">
                  <div
                    class:list={[
                      'overflow-hidden border shadow-floating',
                      edgeBleedFrame
                        ? 'rounded-2xl bg-hero-base/95 p-3 sm:p-4 lg:-me-10 lg:rounded-e-none lg:rounded-s-3xl print:me-0 print:rounded-2xl print:bg-surface'
                        : 'rounded-2xl',
                      isHeroSurface
                        ? 'border-hero-fg/15 bg-hero-base/40 print:border-border print:bg-surface'
                        : edgeBleedFrame
                          ? 'border-border/80'
                          : 'border-border bg-surface',
                    ]}
                  >
                    <Image
                      src={resolvedImage}
                      alt={imageAlt || resolvedTitle}
                      widths={[640, 960, 1280]}
                      sizes="(min-width: 1024px) 46vw, 94vw"
                      class:list={[
                        'w-full object-cover',
                        edgeBleedFrame ? 'aspect-[16/10] rounded-xl lg:rounded-e-none lg:rounded-s-2xl' : 'aspect-[16/10]',
                      ]}
                      loading={compact ? 'lazy' : 'eager'}
                      fetchpriority={compact ? undefined : 'high'}
                    />
                  </div>

                  {mediaStatsOverlay && mediaStatsOverlay.length > 0 && (
                    <div
                      class:list={[
                        'mt-3 grid gap-2.5 sm:grid-cols-2 lg:absolute lg:inset-x-4 lg:bottom-4 lg:mt-0',
                        edgeBleedFrame && 'lg:me-8',
                      ]}
                    >
                      {mediaStatsOverlay.map((item) => (
                        <Card
                          variant="glass"
                          padding="xs"
                          radius="xl"
                          class="glass-surface flex items-center gap-3 px-3.5 py-2.5 text-start shadow-md"
                        >
                          {item.icon && (
                            <IconBox
                              icon={item.icon}
                              size="xs"
                              radius="lg"
                              tone="primary"
                              iconSize={16}
                            />
                          )}
                          <div class="min-w-0">
                            <p class="truncate text-sm font-extrabold tabular-nums text-fg">{item.value}</p>
                            <p class="truncate text-[11px] font-medium text-muted">{item.label}</p>
                          </div>
                        </Card>
                      ))}
                    </div>
                  )}
                </div>
              )
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  function initHeroSplitSubscribe() {
    document.querySelectorAll<HTMLElement>('[data-hero-split-sub-root]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const form = root.querySelector<HTMLFormElement>('[data-hero-split-sub-form]');
      const input = root.querySelector<HTMLInputElement>('input[name="email"]');
      const feedback = root.querySelector<HTMLElement>('[data-hero-split-sub-feedback]');
      if (!form || !input || !feedback) return;

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      input.addEventListener('input', () => {
        input.removeAttribute('aria-invalid');
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const email = input.value.trim();
        if (!emailPattern.test(email)) {
          input.setAttribute('aria-invalid', 'true');
          input.focus();
          feedback.hidden = false;
          feedback.className =
            'mt-2.5 rounded-xl border border-error/35 bg-error/10 px-3.5 py-2 text-xs font-medium leading-relaxed text-fg';
          feedback.textContent = form.dataset.errInvalid ?? '';
          return;
        }

        form.reset();
        input.removeAttribute('aria-invalid');
        feedback.hidden = false;
        feedback.className =
          'mt-2.5 rounded-xl border border-success/35 bg-success/10 px-3.5 py-2 text-xs font-medium leading-relaxed text-fg';
        feedback.textContent = form.dataset.msgOk ?? '';
      });
    });
  }

  document.addEventListener('astro:page-load', initHeroSplitSubscribe);
  initHeroSplitSubscribe();
</script>
