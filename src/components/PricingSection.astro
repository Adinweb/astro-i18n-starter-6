---
/**
 * Composable pricing tier cards inspired by PrebuiltUI pricing sections,
 * authored in the starter's OKLCH semantic tokens, CSS logical properties,
 * `Button` / `Icon` primitives, Paraglide labels, and ChronoTrig staggers.
 *
 * Works both on full-bleed `container: "canvas"` pages (`contained = false`,
 * wrapped in `<PageSection>`) and inside `container: "contained"` prose pages
 * (`contained = true`, skipping nested `.layout-container` gutters).
 */
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import PageSection from '@/components/PageSection.astro';
import { formatNumber } from '@/i18n/format';
import { DEFAULT_LOCALE, isLocale, type Locale } from '@/i18n/locales';
import * as m from '@/paraglide/messages';

export interface PricingTierCta {
  label: string;
  href?: string;
  icon?: string;
  external?: boolean;
}

export interface PricingTier {
  eyebrow?: string;
  name: string;
  price?: string;
  amount?: number;
  currencyPrefix?: string;
  currencySuffix?: string;
  period?: string;
  description?: string;
  features: readonly string[];
  cta: PricingTierCta;
  featured?: boolean;
  badge?: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  tiers: readonly PricingTier[];
  locale?: Locale | string;
  contained?: boolean;
  surface?: 'default' | 'surface' | 'subtle';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  id,
  eyebrow,
  heading,
  subheading,
  tiers,
  locale = DEFAULT_LOCALE,
  contained = false,
  surface = 'default',
  spacing = 'md',
} = Astro.props;

const activeLocale: Locale = isLocale(locale) ? locale : DEFAULT_LOCALE;
const recommendedLabel = m.pricing_recommended({}, { locale: activeLocale });
const cardSurface = !contained && surface === 'surface' ? 'bg-bg' : 'bg-surface';

const gridColsClass =
  tiers.length === 2
    ? 'md:grid-cols-2'
    : tiers.length >= 4
      ? 'md:grid-cols-2 xl:grid-cols-4'
      : 'lg:grid-cols-3';
---

{
  contained ? (
    <section id={id} class:list={['not-prose my-10', id && 'scroll-mt-28']}>
      {(eyebrow || heading || subheading) && (
        <div class="mb-8 max-w-2xl" data-trig>
          {eyebrow && <p class="section-kicker">{eyebrow}</p>}
          {heading && (
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-fg sm:text-3xl text-balance">
              {heading}
            </h2>
          )}
          {subheading && (
            <p class="mt-3 text-base leading-relaxed text-muted text-pretty">
              {subheading}
            </p>
          )}
        </div>
      )}

      <div
        class:list={['grid gap-6', gridColsClass]}
        data-trig-stagger
        data-trig-stagger-delay="0.08"
      >
        {tiers.map((tier) => {
          const badgeText = tier.badge ?? (tier.featured ? recommendedLabel : undefined);
          const displayPrice =
            tier.price ??
            `${tier.currencyPrefix ?? ''}${tier.amount !== undefined ? formatNumber(tier.amount, activeLocale) : ''}${tier.currencySuffix ?? ''}`;
          return (
            <article
              data-trig
              class:list={[
                'flex flex-col justify-between rounded-2xl border p-6 transition duration-200 hover:-translate-y-0.5 hover:shadow-md sm:p-7',
                cardSurface,
                tier.featured
                  ? 'border-primary/60 ring-1 ring-primary/20 shadow-xs hover:border-primary'
                  : 'border-border hover:border-primary/40',
              ]}
            >
              <div>
                <div class="flex items-start justify-between gap-3">
                  <div>
                    {tier.eyebrow && (
                      <p class="section-kicker tabular-nums">{tier.eyebrow}</p>
                    )}
                    <h3 class:list={['text-xl font-bold text-fg', tier.eyebrow && 'mt-2']}>
                      {tier.name}
                    </h3>
                  </div>

                  {badgeText && (
                    <span class="inline-flex shrink-0 items-center rounded-full border border-primary/25 bg-primary/10 px-2.5 py-0.5 text-[11px] font-semibold text-primary">
                      {badgeText}
                    </span>
                  )}
                </div>

                {(displayPrice || tier.period) && (
                  <p class="mt-4 flex flex-wrap items-baseline gap-1.5 text-3xl font-extrabold tracking-tight tabular-nums text-fg">
                    <span>{displayPrice}</span>
                    {tier.period && (
                      <span class="text-sm font-normal text-muted">{tier.period}</span>
                    )}
                  </p>
                )}

                {tier.description && (
                  <p class="mt-3 text-sm leading-relaxed text-muted">{tier.description}</p>
                )}

                <ul class="mt-6 space-y-2.5 border-t border-border pt-5 text-sm text-fg">
                  {tier.features.map((feature) => (
                    <li class="flex items-start gap-2.5">
                      <span
                        class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary"
                        aria-hidden="true"
                      >
                        <Icon name="check" size={13} />
                      </span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <Button
                href={tier.cta.href}
                variant={tier.featured ? 'primary' : 'secondary'}
                size="lg"
                block
                icon={tier.cta.icon}
                external={tier.cta.external}
                class="mt-8 print:hidden"
              >
                {tier.cta.label}
              </Button>
            </article>
          );
        })}
      </div>
    </section>
  ) : (
    <PageSection id={id} surface={surface} spacing={spacing}>
      {(eyebrow || heading || subheading) && (
        <div class="max-w-2xl" data-trig>
          {eyebrow && <p class="section-kicker">{eyebrow}</p>}
          {heading && (
            <h2 class="mt-2 text-2xl font-bold tracking-tight text-fg sm:text-3xl text-balance">
              {heading}
            </h2>
          )}
          {subheading && (
            <p class="mt-3 text-base leading-relaxed text-muted text-pretty">
              {subheading}
            </p>
          )}
        </div>
      )}

      <div
        class:list={[
          'grid gap-6',
          (eyebrow || heading || subheading) && 'mt-8',
          gridColsClass,
        ]}
        data-trig-stagger
        data-trig-stagger-delay="0.08"
      >
        {tiers.map((tier) => {
          const badgeText = tier.badge ?? (tier.featured ? recommendedLabel : undefined);
          const displayPrice =
            tier.price ??
            `${tier.currencyPrefix ?? ''}${tier.amount !== undefined ? formatNumber(tier.amount, activeLocale) : ''}${tier.currencySuffix ?? ''}`;
          return (
            <article
              data-trig
              class:list={[
                'flex flex-col justify-between rounded-2xl border p-6 transition duration-200 hover:-translate-y-0.5 hover:shadow-md sm:p-7',
                cardSurface,
                tier.featured
                  ? 'border-primary/60 ring-1 ring-primary/20 shadow-xs hover:border-primary'
                  : 'border-border hover:border-primary/40',
              ]}
            >
              <div>
                <div class="flex items-start justify-between gap-3">
                  <div>
                    {tier.eyebrow && (
                      <p class="section-kicker tabular-nums">{tier.eyebrow}</p>
                    )}
                    <h3 class:list={['text-xl font-bold text-fg', tier.eyebrow && 'mt-2']}>
                      {tier.name}
                    </h3>
                  </div>

                  {badgeText && (
                    <span class="inline-flex shrink-0 items-center rounded-full border border-primary/25 bg-primary/10 px-2.5 py-0.5 text-[11px] font-semibold text-primary">
                      {badgeText}
                    </span>
                  )}
                </div>

                {(displayPrice || tier.period) && (
                  <p class="mt-4 flex flex-wrap items-baseline gap-1.5 text-3xl font-extrabold tracking-tight tabular-nums text-fg">
                    <span>{displayPrice}</span>
                    {tier.period && (
                      <span class="text-sm font-normal text-muted">{tier.period}</span>
                    )}
                  </p>
                )}

                {tier.description && (
                  <p class="mt-3 text-sm leading-relaxed text-muted">{tier.description}</p>
                )}

                <ul class="mt-6 space-y-2.5 border-t border-border pt-5 text-sm text-fg">
                  {tier.features.map((feature) => (
                    <li class="flex items-start gap-2.5">
                      <span
                        class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary"
                        aria-hidden="true"
                      >
                        <Icon name="check" size={13} />
                      </span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <Button
                href={tier.cta.href}
                variant={tier.featured ? 'primary' : 'secondary'}
                size="lg"
                block
                icon={tier.cta.icon}
                external={tier.cta.external}
                class="mt-8 print:hidden"
              >
                {tier.cta.label}
              </Button>
            </article>
          );
        })}
      </div>
    </PageSection>
  )
}
