---
/**
 * Composable capability / feature Bento grid for client landing pages.
 *
 * Automatically switches between an asymmetric 6-column Bento layout when any
 * card sets `wide: true` and a clean symmetric grid when all cards match weight.
 */
import PageSection from '@/components/PageSection.astro';
import Icon from '@/components/Icon.astro';
import { formatNumber } from '@/i18n/format';
import type { Locale } from '@/i18n/locales';

export interface BentoItem {
  title: string;
  description: string;
  icon?: string;
  indexLabel?: string;
  href?: string;
  wide?: boolean;
}

interface Props {
  id?: string;
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  items: readonly BentoItem[];
  locale?: Locale | string;
  numbered?: boolean;
  surface?: 'default' | 'surface' | 'subtle';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  id,
  eyebrow,
  heading,
  subheading,
  items,
  locale = 'en',
  numbered = true,
  surface = 'default',
  spacing = 'md',
} = Astro.props;

const hasAsymmetric = items.some((item) => item.wide);
const cardSurface = surface === 'surface' ? 'bg-bg' : 'bg-surface';
---

<PageSection id={id} surface={surface} spacing={spacing}>
  {
    (eyebrow || heading || subheading) && (
      <div class="max-w-2xl" data-trig>
        {eyebrow && <p class="section-kicker">{eyebrow}</p>}
        {heading && (
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-fg sm:text-3xl text-balance">
            {heading}
          </h2>
        )}
        {subheading && (
          <p class="mt-3 text-base leading-relaxed text-muted text-pretty">
            {subheading}
          </p>
        )}
      </div>
    )
  }

  <div
    class:list={[
      'mt-8 grid grid-cols-1 gap-5',
      hasAsymmetric ? 'md:grid-cols-6' : 'sm:grid-cols-2 lg:grid-cols-3',
    ]}
    data-trig-stagger
    data-trig-stagger-delay="0.06"
  >
    {
      items.map((item, idx) => {
        const displayIndex = item.indexLabel ?? (numbered ? formatNumber(idx + 1, locale) : null);
        return (
          <article
            data-trig
            class:list={[
              'group relative flex flex-col justify-between rounded-2xl border border-border p-6 transition duration-200 hover:-translate-y-0.5 hover:border-primary/45 hover:shadow-md sm:p-7',
              cardSurface,
              hasAsymmetric && (item.wide ? 'md:col-span-4' : 'md:col-span-2'),
            ]}
          >
            <div>
              <div class="flex items-center justify-between gap-3">
                {item.icon ? (
                  <span
                    class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl border border-border bg-surface-hover/70 text-primary"
                    aria-hidden="true"
                  >
                    <Icon name={item.icon} size={20} />
                  </span>
                ) : (
                  <span />
                )}

                {displayIndex && (
                  <span class="text-xs font-semibold tabular-nums text-muted">
                    {displayIndex}
                  </span>
                )}
              </div>

              <h3 class="mt-5 text-lg font-bold tracking-tight text-fg">
                {item.href ? (
                  <a
                    href={item.href}
                    class="transition-colors after:absolute after:inset-0 hover:text-primary focus-visible:outline-none"
                  >
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </h3>

              <p class="mt-2 text-sm leading-relaxed text-muted">
                {item.description}
              </p>
            </div>

            {item.href && (
              <span
                aria-hidden="true"
                class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-primary"
              >
                <Icon
                  name="arrow-right"
                  size={15}
                  class="transition-transform duration-200 group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5"
                />
              </span>
            )}
          </article>
        );
      })
    }
  </div>
</PageSection>
