---
/**
 * Privacy-first & consent-gated analytics loader
 * (`GA4`, `Google Tag Manager`, `Plausible`, `Umami`, `Microsoft Clarity`).
 *
 * - GA4, GTM, and Microsoft Clarity ALWAYS emit inert `<script type="text/plain" data-cookie-category="analytics">`
 *   tags inside a `transition:persist` container so TDDDG § 25 / GDPR CookieConsent controls
 *   activation & teardown without duplicating third-party SDKs across `<ClientRouter />` navigations.
 * - Optional Google Consent Mode v2 (`analytics.consentMode: true`) pushes `default` denied signals
 *   locally (zero network traffic) and syncs `update` signals whenever consent changes.
 * - Truly cookieless Plausible/Umami can optionally run without the consent banner when
 *   `analytics.allowCookielessWithoutBanner: true` is explicitly configured.
 */
import { ANALYTICS_CONFIG } from '@/libs/config/app';

const ga4Id = (ANALYTICS_CONFIG.ga4Id || '').trim();
const gtmId = (ANALYTICS_CONFIG.gtmId || '').trim();
const plausibleDomain = (ANALYTICS_CONFIG.plausibleDomain || '').trim();
const plausibleSrc = (ANALYTICS_CONFIG.plausibleSrc || 'https://plausible.io/js/script.js').trim();
const umamiWebsiteId = (ANALYTICS_CONFIG.umamiWebsiteId || '').trim();
const umamiSrc = (ANALYTICS_CONFIG.umamiSrc || '').trim();
const clarityId = (ANALYTICS_CONFIG.clarityId || '').trim();
const consentMode = Boolean(ANALYTICS_CONFIG.consentMode);
const requireConsent = ANALYTICS_CONFIG.requireConsent !== false;
const allowCookielessWithoutBanner = Boolean(ANALYTICS_CONFIG.allowCookielessWithoutBanner);

const hasCookielessProvider = Boolean(plausibleDomain || (umamiWebsiteId && umamiSrc));
const hasAnyProvider = Boolean(ga4Id || gtmId || hasCookielessProvider || clarityId);
const canDirectLoad = !requireConsent;
const canDirectCookieless = canDirectLoad || allowCookielessWithoutBanner;

const consentModeDefaultSnippet =
  requireConsent && consentMode && (ga4Id || gtmId)
    ? `window.dataLayer=window.dataLayer||[];window.gtag=window.gtag||function(){window.dataLayer.push(arguments);};window.gtag('consent','default',{analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',functionality_storage:'denied',wait_for_update:500});`
    : '';

const consentModeSyncSnippet =
  requireConsent && consentMode && (ga4Id || gtmId)
    ? `(function(){var d=document.documentElement.dataset;if(typeof window.gtag==='function'){window.gtag('consent','update',{analytics_storage:d.consentAnalytics==='true'?'granted':'denied',ad_storage:d.consentMarketing==='true'?'granted':'denied',ad_user_data:d.consentMarketing==='true'?'granted':'denied',ad_personalization:d.consentMarketing==='true'?'granted':'denied',functionality_storage:d.consentPreferences==='true'?'granted':'denied'});}})();`
    : '';

const ga4InitSnippet = ga4Id
  ? `window.dataLayer=window.dataLayer||[];window.gtag=window.gtag||function(){window.dataLayer.push(arguments);};window.gtag('js',new Date());window.gtag('config',${JSON.stringify(ga4Id)});`
  : '';

const gtmInitSnippet = gtmId
  ? `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;j.setAttribute('data-cookie-managed-category','analytics');if(f&&f.parentNode){f.parentNode.insertBefore(j,f);}else{d.head.appendChild(j);}})(window,document,'script','dataLayer',${JSON.stringify(gtmId)});`
  : '';

const clarityInitSnippet = clarityId
  ? `(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments);};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;t.setAttribute("data-cookie-managed-category","analytics");y=l.getElementsByTagName(r)[0];if(y&&y.parentNode){y.parentNode.insertBefore(t,y);}else{l.head.appendChild(t);}})(window,document,"clarity","script",${JSON.stringify(clarityId)});`
  : '';
---

{
  hasAnyProvider && (
    <div
      data-analytics-gatekeeper
      data-ga4-id={ga4Id || undefined}
      data-gtm-id={gtmId || undefined}
      data-consent-mode={requireConsent && consentMode ? 'true' : undefined}
      data-require-consent={requireConsent ? 'true' : 'false'}
      data-cookieless-open={canDirectCookieless && hasCookielessProvider ? 'true' : undefined}
      transition:persist="analytics-gatekeeper"
      hidden
    >
      {consentModeDefaultSnippet && <script is:inline set:html={consentModeDefaultSnippet} />}
      {consentModeSyncSnippet && (
        <script
          is:inline
          type="text/plain"
          data-cookie-category="analytics"
          data-cookie-id="consent-mode-sync"
          set:html={consentModeSyncSnippet}
        />
      )}

      {ga4Id &&
        (canDirectLoad ? (
          <>
            <script
              is:inline
              async
              id="ga4-gtag-sdk"
              src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga4Id)}`}
            />
            <script is:inline id="ga4-gtag-init" set:html={ga4InitSnippet} />
          </>
        ) : (
          <>
            <script
              is:inline
              type="text/plain"
              data-cookie-category="analytics"
              data-cookie-id="ga4-gtag-sdk"
              data-cookie-async="true"
              data-cookie-src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga4Id)}`}
            />
            <script
              is:inline
              type="text/plain"
              data-cookie-category="analytics"
              data-cookie-id="ga4-gtag-init"
              set:html={ga4InitSnippet}
            />
          </>
        ))}

      {gtmId &&
        (canDirectLoad ? (
          <script is:inline id="gtm-sdk" set:html={gtmInitSnippet} />
        ) : (
          <script
            is:inline
            type="text/plain"
            data-cookie-category="analytics"
            data-cookie-id="gtm-sdk"
            set:html={gtmInitSnippet}
          />
        ))}

      {plausibleDomain &&
        (canDirectCookieless ? (
          <script
            is:inline
            defer
            id="plausible-analytics-sdk"
            src={plausibleSrc}
            data-domain={plausibleDomain}
          />
        ) : (
          <script
            is:inline
            type="text/plain"
            data-cookie-category="analytics"
            data-cookie-id="plausible-analytics-sdk"
            data-cookie-defer="true"
            data-cookie-src={plausibleSrc}
            data-domain={plausibleDomain}
          />
        ))}

      {umamiWebsiteId &&
        umamiSrc &&
        (canDirectCookieless ? (
          <script
            is:inline
            defer
            id="umami-analytics-sdk"
            src={umamiSrc}
            data-website-id={umamiWebsiteId}
          />
        ) : (
          <script
            is:inline
            type="text/plain"
            data-cookie-category="analytics"
            data-cookie-id="umami-analytics-sdk"
            data-cookie-defer="true"
            data-cookie-src={umamiSrc}
            data-website-id={umamiWebsiteId}
          />
        ))}

      {clarityId &&
        (canDirectLoad ? (
          <script is:inline id="ms-clarity-sdk" set:html={clarityInitSnippet} />
        ) : (
          <script
            is:inline
            type="text/plain"
            data-cookie-category="analytics"
            data-cookie-id="ms-clarity-sdk"
            set:html={clarityInitSnippet}
          />
        ))}
    </div>
  )
}

<script>
  import { CONSENT_CHANGE_EVENT } from '@/libs/cookies/manager';

  let lastTrackedUrl = '';

  type AnalyticsWindow = Window & {
    dataLayer?: unknown[];
    gtag?: (...args: unknown[]) => void;
    plausible?: (eventName: string, opts?: Record<string, unknown>) => void;
    umami?: { track?: () => void };
  };

  function syncGoogleConsentMode() {
    const gatekeeper = document.querySelector<HTMLElement>('[data-analytics-gatekeeper]');
    if (gatekeeper?.dataset.consentMode !== 'true') return;

    const win = window as AnalyticsWindow;
    if (typeof win.gtag !== 'function') return;

    const rootData = document.documentElement.dataset;
    const analytics = rootData.consentAnalytics === 'true' ? 'granted' : 'denied';
    const marketing = rootData.consentMarketing === 'true' ? 'granted' : 'denied';
    const preferences = rootData.consentPreferences === 'true' ? 'granted' : 'denied';

    win.gtag('consent', 'update', {
      analytics_storage: analytics,
      ad_storage: marketing,
      ad_user_data: marketing,
      ad_personalization: marketing,
      functionality_storage: preferences,
    });
  }

  function trackSoftNavigation() {
    syncGoogleConsentMode();

    const gatekeeper = document.querySelector<HTMLElement>('[data-analytics-gatekeeper]');
    const directOpen = gatekeeper?.dataset.requireConsent === 'false';
    const analyticsAllowed = directOpen || document.documentElement.dataset.consentAnalytics === 'true';
    const cookielessOpen = directOpen || gatekeeper?.dataset.cookielessOpen === 'true';

    if (!analyticsAllowed && !cookielessOpen) {
      lastTrackedUrl = '';
      return;
    }

    const currentUrl = window.location.pathname + window.location.search;
    if (!lastTrackedUrl) {
      // First load is already tracked when provider scripts bootstrap cleanly.
      lastTrackedUrl = currentUrl;
      return;
    }
    if (currentUrl === lastTrackedUrl) return;
    lastTrackedUrl = currentUrl;

    const ga4Id = gatekeeper?.dataset.ga4Id;
    const gtmId = gatekeeper?.dataset.gtmId;
    const win = window as AnalyticsWindow;

    if (analyticsAllowed) {
      if (ga4Id && typeof win.gtag === 'function') {
        win.gtag('event', 'page_view', {
          page_path: currentUrl,
          page_location: window.location.href,
          page_title: document.title,
        });
      } else if (gtmId && Array.isArray(win.dataLayer)) {
        win.dataLayer.push({
          event: 'page_view',
          page_path: currentUrl,
          page_location: window.location.href,
          page_title: document.title,
        });
      }
    }

    if (analyticsAllowed || cookielessOpen) {
      if (typeof win.plausible === 'function') {
        win.plausible('pageview');
      }
      if (win.umami && typeof win.umami.track === 'function') {
        win.umami.track();
      }
    }
  }

  if (document.documentElement.dataset.analyticsSpaBound !== 'true') {
    document.documentElement.dataset.analyticsSpaBound = 'true';
    document.addEventListener('astro:page-load', trackSoftNavigation);
    document.addEventListener(CONSENT_CHANGE_EVENT, () => {
      syncGoogleConsentMode();
      const gatekeeper = document.querySelector<HTMLElement>('[data-analytics-gatekeeper]');
      const directOpen = gatekeeper?.dataset.requireConsent === 'false';
      const cookielessOpen = directOpen || gatekeeper?.dataset.cookielessOpen === 'true';
      const analyticsAllowed = directOpen || document.documentElement.dataset.consentAnalytics === 'true';
      if (!analyticsAllowed && !cookielessOpen) {
        lastTrackedUrl = '';
      } else if (!lastTrackedUrl) {
        lastTrackedUrl = window.location.pathname + window.location.search;
      }
    });
  }

  trackSoftNavigation();
</script>
