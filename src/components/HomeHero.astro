---
/**
 * Home hero band — the downloaded marketing block, rebuilt to this starter's
 * rules instead of pasted in.
 *
 * What changed from the original Tailwind snippet, and why:
 *
 *  - Physical offsets (`pl-4 … xl:pl-32`) became `.layout-container`, the one
 *    place the standard desktop width and inline gutters are defined.
 *  - Hardcoded colours (`#BE945A`, `#1D1919`, `orange-200`, `zinc-600`) became
 *    the hero roles (`bg-hero-base`, `text-hero-fg`, `text-accent`) that
 *    `src/styles/global.css` owns, so the band follows the theme and keeps its
 *    contrast in light, dark and print.
 *  - The hand-rolled buttons became `<Button>` (`variant` + `size`): both
 *    controls navigate, so the component renders them as links, not
 *    `<button>`s.
 *  - Five inline SVGs (including a duplicated `clipPath` id) became sprite
 *    icons rendered by `<Icon>`.
 *  - Every string moved into the dictionaries (`home_hero_*`), and the copy
 *    points at real pages instead of a mortgage product.
 *  - Logical properties only (`ps-*`, `border-s`, `end-*`) plus
 *    `rtl:rotate-180` on the arrow, so the band mirrors in Persian.
 *  - Reveals use `data-trig` / `data-trig-stagger`, and print flattens the band
 *    to a light surface with no decorative layers.
 */
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import { HERO_TITLE_ID } from '@/libs/config/app';
import type { Locale } from '@/i18n/locales';
import * as m from '@/paraglide/messages';

interface Props {
  locale: Locale;
  /** Page description of the entry, rendered under the headline. */
  description?: string;
  primaryHref: string;
  secondaryHref?: string;
  /** Three short proofs shown along the bottom of the band. */
  highlights: readonly {
    key: string;
    icon: string;
    title: string;
    description: string;
  }[];
}

const { locale, description, primaryHref, secondaryHref, highlights } = Astro.props;
---

<section
  aria-labelledby={HERO_TITLE_ID}
  class="relative isolate overflow-hidden bg-hero-base text-hero-fg print:bg-bg print:text-fg"
>
  <!-- Atmosphere: two soft brand glows instead of a flat black panel. -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 print:hidden">
    <div class="absolute -top-40 end-[-6rem] size-[30rem] rounded-full bg-primary/25 blur-3xl">
    </div>
    <div class="absolute -bottom-48 start-[-8rem] size-[26rem] rounded-full bg-accent/20 blur-3xl">
    </div>
  </div>

  <div
    class="layout-container flex flex-col justify-end pb-14 pt-28 sm:pb-18 sm:pt-36 lg:pb-20 lg:pt-40"
  >
    <div class="max-w-3xl" data-trig>
      <p class="hero-badge print:border-border print:text-fg">
        <Icon name="shield" size={14} class="me-1.5" />
        {m.home_hero_kicker({}, { locale })}
      </p>

      <h1
        id={HERO_TITLE_ID}
        class="mt-6 text-balance text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl"
      >
        {m.home_hero_title_lead({}, { locale })}{' '}
        <!--
          The band is dark in both themes, so the gradient may only use roles
          that stay bright: `accent` (6.9:1 on the band) and the hero
          foreground (18:1). Ending on `primary` measured 3.0:1 in light mode —
          the bare minimum for large text, and the tail of the phrase sat on it.
        -->
        <span
          class="bg-linear-to-r from-accent to-hero-fg bg-clip-text text-transparent print:bg-none print:text-fg"
        >
          {m.home_hero_title_accent({}, { locale })}
        </span>
      </h1>

      {
        description && (
          <p class="mt-5 max-w-xl text-pretty text-base leading-relaxed text-hero-fg/90 sm:text-lg print:text-muted">
            {description}
          </p>
        )
      }

      <div class="mt-8 flex flex-wrap items-center gap-3 print:hidden">
        <Button href={primaryHref} variant="primary" size="lg" icon="arrow-right">
          {m.common_get_started({}, { locale })}
        </Button>
        {
          secondaryHref && (
            <Button href={secondaryHref} variant="hero" size="lg">
              {m.nav_blog({}, { locale })}
            </Button>
          )
        }
      </div>
    </div>

    <ul
      class="mt-12 flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8 lg:mt-16"
      data-trig-stagger
      data-trig-stagger-delay="0.08"
    >
      {
        highlights.map((item) => (
          <li
            class="flex items-center gap-3.5 sm:border-s sm:border-hero-fg/15 sm:ps-8 sm:first:border-s-0 sm:first:ps-0"
            data-trig
          >
            <span
              class="flex size-12 shrink-0 items-center justify-center rounded-full border border-hero-fg/15 bg-hero-fg/10 text-accent"
              aria-hidden="true"
            >
              <Icon name={item.icon} size={22} />
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold">{item.title}</span>
              <span class="mt-1 block text-xs leading-relaxed text-hero-fg/80">
                {item.description}
              </span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
