---
/**
 * Home hero band — composed from `@/components/ui/*` primitives (`BackdropLayer`,
 * `HeroHeadline`, `Button`, `Icon`, `IconBox`) with OKLCH semantic roles and
 * CSS logical properties so the band adapts across themes, light/dark, print, and RTL.
 */
import BackdropLayer from '@/components/ui/BackdropLayer.astro';
import Button from '@/components/ui/Button.astro';
import HeroHeadline from '@/components/ui/HeroHeadline.astro';
import Icon from '@/components/ui/Icon.astro';
import IconBox from '@/components/ui/IconBox.astro';
import { HERO_TITLE_ID } from '@/libs/config/app';
import type { Locale } from '@/i18n/locales';
import * as m from '@/paraglide/messages';

interface Props {
  locale: Locale;
  /** Page description of the entry, rendered under the headline. */
  description?: string;
  primaryHref: string;
  secondaryHref?: string;
  /** Three short proofs shown along the bottom of the band. */
  highlights: readonly {
    key: string;
    icon: string;
    title: string;
    description: string;
  }[];
  headingTag?: 'h1' | 'h2';
  compact?: boolean;
}

const {
  locale,
  description,
  primaryHref,
  secondaryHref,
  highlights,
  headingTag = 'h1',
  compact = false,
} = Astro.props;
const titleId = headingTag === 'h1' ? HERO_TITLE_ID : undefined;
---

<section
  aria-labelledby={titleId}
  class:list={[
    'relative isolate overflow-hidden bg-hero-base text-hero-fg print:bg-bg print:text-fg',
    compact && 'rounded-3xl',
  ]}
>
  <BackdropLayer backdrop="glow" surface="hero" />

  <div
    class:list={[
      'layout-container flex flex-col justify-end',
      compact
        ? 'py-10 sm:py-12'
        : 'pb-14 pt-28 sm:pb-18 sm:pt-36 lg:pb-20 lg:pt-40',
    ]}
  >
    <div
      class="max-w-4xl"
      data-trig-stagger
      data-trig-stagger-mode="linear"
      data-trig-stagger-delay="0.05"
      data-trig-once="true"
    >
      <p class="hero-badge print:border-border print:text-fg">
        <Icon name="shield" size={14} class="me-1.5" />
        {m.home_hero_kicker({}, { locale })}
      </p>

      <HeroHeadline
        headingTag={headingTag}
        id={titleId}
        lead={m.home_hero_title_lead({}, { locale })}
        accent={m.home_hero_title_accent({}, { locale })}
        surface="hero"
        class="mt-6"
      />

      {
        description && (
          <p class="mt-5 max-w-2xl text-pretty text-base leading-relaxed text-hero-fg/90 sm:text-lg print:text-muted">
            {description}
          </p>
        )
      }

      <div class="mt-8 flex flex-wrap items-center gap-3 print:hidden">
        <Button href={primaryHref} variant="primary" size="lg" icon="arrow-right">
          {m.common_get_started({}, { locale })}
        </Button>
        {
          secondaryHref && (
            <Button href={secondaryHref} variant="hero" size="lg">
              {m.nav_blog({}, { locale })}
            </Button>
          )
        }
      </div>
    </div>

    <ul
      class="mt-12 flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8 lg:mt-16"
      data-trig-stagger
      data-trig-stagger-mode="linear"
      data-trig-stagger-delay="0.05"
      data-trig-once="true"
    >
      {
        highlights.map((item) => (
          <li
            class="flex items-center gap-3.5 sm:border-s sm:border-hero-fg/15 sm:ps-8 sm:first:border-s-0 sm:first:ps-0"
            data-trig
            data-trig-once="true"
          >
            <IconBox icon={item.icon} size="lg" radius="full" tone="hero" />
            <span class="min-w-0">
              <span class="block text-sm font-semibold">{item.title}</span>
              <span class="mt-1 block text-xs leading-relaxed text-hero-fg/80">
                {item.description}
              </span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
