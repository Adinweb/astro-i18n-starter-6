---
/**
 * Composable multi-purpose card grid inspired by PrebuiltUI card & e-commerce
 * showcase grids. Supports optional `<Image>` covers or crisp semantic icon
 * frames, category badges, meta tags, action links, and full Paraglide defaults.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@/components/Icon.astro';
import PageSection from '@/components/PageSection.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import type { Locale } from '@/i18n/locales';
import { getHomeHref, getPageUrl } from '@/libs/content/service';
import { resolveComponentLocale, resolveOptionalHeader } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

export interface FeatureCardItem {
  title: string;
  description: string;
  badge?: string;
  icon?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  tags?: readonly string[];
  href?: string;
  ctaLabel?: string;
  external?: boolean;
}

interface Props {
  id?: string;
  locale?: Locale | string;
  eyebrow?: string | null;
  heading?: string | null;
  subheading?: string | null;
  items?: readonly FeatureCardItem[];
  columns?: 2 | 3 | 4;
  aspect?: '16/9' | '4/3';
  contained?: boolean;
  surface?: 'default' | 'surface' | 'subtle';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  id,
  locale,
  eyebrow,
  heading,
  subheading,
  items,
  columns = 3,
  aspect = '16/9',
  contained = false,
  surface = 'default',
  spacing = 'md',
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = items === undefined;

const resolvedEyebrow = resolveOptionalHeader(
  eyebrow,
  usingDefaults,
  m.block_cards_eyebrow({}, { locale: activeLocale })
);
const resolvedHeading = resolveOptionalHeader(
  heading,
  usingDefaults,
  m.block_cards_heading({}, { locale: activeLocale })
);
const resolvedSubheading = resolveOptionalHeader(
  subheading,
  usingDefaults,
  m.block_cards_subheading({}, { locale: activeLocale })
);

const defaultCtaLabel = m.block_cards_cta({}, { locale: activeLocale });

let resolvedItems: readonly FeatureCardItem[];
if (items) {
  resolvedItems = items;
} else {
  const [featuresHref, homeHref] = await Promise.all([
    getPageUrl('features', activeLocale),
    getHomeHref(activeLocale),
  ]);
  const fallbackHref = featuresHref ?? homeHref;
  resolvedItems = [
    {
      badge: m.block_cards_1_badge({}, { locale: activeLocale }),
      title: m.block_cards_1_title({}, { locale: activeLocale }),
      description: m.block_cards_1_desc({}, { locale: activeLocale }),
      icon: 'layers',
      href: fallbackHref,
      ctaLabel: defaultCtaLabel,
    },
    {
      badge: m.block_cards_2_badge({}, { locale: activeLocale }),
      title: m.block_cards_2_title({}, { locale: activeLocale }),
      description: m.block_cards_2_desc({}, { locale: activeLocale }),
      icon: 'palette',
      href: featuresHref ? `${featuresHref}#design` : homeHref,
      ctaLabel: defaultCtaLabel,
    },
    {
      badge: m.block_cards_3_badge({}, { locale: activeLocale }),
      title: m.block_cards_3_title({}, { locale: activeLocale }),
      description: m.block_cards_3_desc({}, { locale: activeLocale }),
      icon: 'globe',
      href: featuresHref ? `${featuresHref}#rtl` : homeHref,
      ctaLabel: defaultCtaLabel,
    },
  ];
}

const hasHeader = Boolean(resolvedEyebrow || resolvedHeading || resolvedSubheading);
const cardSurface = !contained && surface === 'surface' ? 'bg-bg' : 'bg-surface';
const gridColsClass =
  columns === 2
    ? 'sm:grid-cols-2'
    : columns === 4
      ? 'sm:grid-cols-2 xl:grid-cols-4'
      : 'md:grid-cols-2 lg:grid-cols-3';
const aspectClass = aspect === '4/3' ? 'aspect-[4/3]' : 'aspect-[16/9]';
---

<PageSection
  id={id}
  surface={contained ? 'default' : surface}
  spacing={contained ? 'none' : spacing}
  bleed={contained}
  class={contained ? 'not-prose my-10' : undefined}
>
  <SectionHeader
    eyebrow={resolvedEyebrow}
    heading={resolvedHeading}
    subheading={resolvedSubheading}
  />

  <div
    class:list={['grid gap-6', hasHeader && 'mt-8', gridColsClass]}
    data-trig-stagger
    data-trig-stagger-mode="linear"
    data-trig-stagger-delay="0.06"
    data-trig-once="true"
  >
    {
      resolvedItems.map((item) => {
        const isExternal = item.external ?? (item.href ? /^https?:\/\//i.test(item.href) : false);
        return (
          <article
            data-trig
            class:list={[
              'group relative flex flex-col overflow-hidden rounded-2xl border border-border shadow-xs transition duration-200 hover:-translate-y-0.5 hover:border-primary/45 hover:shadow-md',
              cardSurface,
            ]}
          >
            <div
              class:list={[
                'relative overflow-hidden border-b border-border bg-linear-to-br rtl:bg-linear-to-bl from-primary/14 via-surface-hover/65 to-accent/14',
                aspectClass,
              ]}
            >
              {item.image ? (
                <Image
                  src={item.image}
                  alt={item.imageAlt ?? item.title}
                  widths={[400, 720]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 94vw"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                />
              ) : (
                <div class="flex h-full items-center justify-center text-primary">
                  <span class="inline-flex size-14 items-center justify-center rounded-2xl border border-primary/25 bg-surface shadow-xs">
                    <Icon name={item.icon ?? 'layout-grid'} size={26} />
                  </span>
                </div>
              )}

              {item.badge && (
                <span class="hero-badge absolute bottom-3 start-3">
                  {item.badge}
                </span>
              )}
            </div>

            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <h3 class="text-lg font-bold tracking-tight text-fg">
                {item.href ? (
                  <a
                    href={item.href}
                    target={isExternal ? '_blank' : undefined}
                    rel={isExternal ? 'noreferrer noopener' : undefined}
                    class="transition-colors after:absolute after:inset-0 hover:text-primary focus-visible:outline-none"
                  >
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </h3>

              <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>

              {item.tags && item.tags.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-1.5">
                  {item.tags.map((tag) => (
                    <li class="chip px-2.5 py-0.5 text-[11px]">{tag}</li>
                  ))}
                </ul>
              )}

              {item.href && (
                <span
                  aria-hidden="true"
                  class="mt-auto inline-flex items-center gap-1.5 pt-4 text-xs font-semibold text-primary"
                >
                  <span>{item.ctaLabel ?? defaultCtaLabel}</span>
                  <Icon
                    name="arrow-right"
                    size={15}
                    class="transition-transform duration-200 group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5"
                  />
                </span>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</PageSection>
