---
/**
 * Centered & Editorial Hero Section adapted from PrebuiltUI hero-section archetypes:
 * - Light Hero Section with Grid Effect
 * - Hero with Dashed Container Rails & Feature Cards
 * - Hero with Rounded Floating Navbar & Arch-Top Showcase Image
 * - Hero with Embedded Navbar, Inline Tag & Gradient Wash
 *
 * Combines `<slot name="prelude">`, optional `<HeroPreviewNav>`, announcement pill or
 * `<AvatarGroup />`, OKLCH gradient headline, `<Button>` CTAs, and optional feature cards,
 * partner pills, or bottom arch/rounded photography.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import AvatarGroup, { type AvatarItem } from '@/components/AvatarGroup.astro';
import Button from '@/components/Button.astro';
import HeroParallaxLayer, {
  type HeroParallaxOverlay,
  type HeroParallaxSpeed,
} from '@/components/HeroParallaxLayer.astro';
import HeroPreviewNav, {
  type HeroPreviewNavLink,
  type HeroPreviewNavVariant,
} from '@/components/HeroPreviewNav.astro';
import Icon from '@/components/Icon.astro';
import type { HeroCtaAction } from '@/components/LandingHeroSplit.astro';
import type { Locale } from '@/i18n/locales';
import { getHomeHref, getPageUrl } from '@/libs/content/service';
import { resolveComponentLocale } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

export interface HeroFeatureCard {
  icon?: string;
  title: string;
  description: string;
}

export interface HeroPartnerPill {
  icon?: string;
  name: string;
}

export interface HeroAnnouncement {
  badge?: string;
  label: string;
  href?: string;
  ctaLabel?: string;
  pulse?: boolean;
}

export interface HeroTopBanner {
  badge?: string;
  label: string;
  href?: string;
  ctaLabel?: string;
}

interface Props {
  id?: string;
  locale?: Locale | string;
  surface?: 'default' | 'hero' | 'surface' | 'subtle';
  backdrop?: 'glow' | 'grid' | 'dots' | 'orbital' | 'wash' | 'noise' | 'net' | 'none';
  framedRails?: 'none' | 'dashed' | 'solid';
  parallaxImage?: ImageMetadata | null;
  parallaxAlt?: string;
  parallaxSpeed?: HeroParallaxSpeed;
  parallaxOverlay?: HeroParallaxOverlay;
  topBanner?: HeroTopBanner | null;
  showPreviewNav?: boolean;
  previewNavVariant?: HeroPreviewNavVariant;
  previewBrand?: string;
  previewLinks?: readonly HeroPreviewNavLink[];
  previewCta?: HeroCtaAction | null;
  announcement?: HeroAnnouncement | null;
  showAvatarPill?: boolean;
  avatarItems?: readonly AvatarItem[];
  avatarCount?: number;
  avatarLabel?: string;
  eyebrow?: string | null;
  titleLead?: string;
  titleAccent?: string | null;
  description?: string | null;
  primaryCta?: HeroCtaAction | null;
  secondaryCta?: HeroCtaAction | null;
  trustNote?: string | null;
  featureCards?: readonly HeroFeatureCard[] | null;
  partnerPills?: readonly HeroPartnerPill[] | null;
  partnerLogos?: readonly HeroPartnerPill[] | null;
  bottomImage?: ImageMetadata | null;
  bottomImageAlt?: string;
  bottomImageStyle?: 'rounded' | 'arch';
  headingTag?: 'h1' | 'h2';
  compact?: boolean;
}

const {
  id,
  locale,
  surface = 'default',
  backdrop = 'glow',
  framedRails = 'none',
  parallaxImage = null,
  parallaxAlt = '',
  parallaxSpeed = 'medium',
  parallaxOverlay = 'hero',
  topBanner = null,
  showPreviewNav = false,
  previewNavVariant = 'pill',
  previewBrand,
  previewLinks,
  previewCta,
  announcement,
  showAvatarPill = false,
  avatarItems,
  avatarCount,
  avatarLabel,
  eyebrow,
  titleLead,
  titleAccent,
  description,
  primaryCta,
  secondaryCta,
  trustNote,
  featureCards,
  partnerPills,
  partnerLogos = null,
  bottomImage,
  bottomImageAlt = '',
  bottomImageStyle = 'rounded',
  headingTag = 'h1',
  compact = false,
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = titleLead === undefined;

const [featuresHref, pricingHref, homeHref] =
  usingDefaults && (primaryCta === undefined || secondaryCta === undefined)
    ? await Promise.all([
        getPageUrl('features', activeLocale),
        getPageUrl('pricing', activeLocale),
        getHomeHref(activeLocale),
      ])
    : [null, null, ''];

const resolvedAnnouncement =
  announcement === null
    ? undefined
    : announcement ??
      (!showAvatarPill && usingDefaults
        ? {
            badge: m.block_hero_centered_badge({}, { locale: activeLocale }),
            label: m.block_hero_centered_announcement({}, { locale: activeLocale }),
            href: featuresHref ?? undefined,
            pulse: true,
          }
        : undefined);

const resolvedEyebrow =
  eyebrow === null
    ? undefined
    : eyebrow ??
      (!resolvedAnnouncement && !showAvatarPill && usingDefaults
        ? m.block_hero_eyebrow({}, { locale: activeLocale })
        : undefined);

const resolvedTitleLead =
  titleLead ?? m.block_hero_centered_title_lead({}, { locale: activeLocale });
const resolvedTitleAccent =
  titleAccent === null
    ? undefined
    : titleAccent ??
      (usingDefaults ? m.block_hero_centered_title_accent({}, { locale: activeLocale }) : undefined);
const resolvedDescription =
  description === null
    ? undefined
    : description ??
      (usingDefaults ? m.block_hero_centered_desc({}, { locale: activeLocale }) : undefined);

const resolvedPrimaryCta =
  primaryCta === null
    ? undefined
    : primaryCta ??
      (usingDefaults
        ? {
            label: m.block_hero_primary_cta({}, { locale: activeLocale }),
            href: featuresHref ?? homeHref,
            icon: 'arrow-right',
          }
        : undefined);

const resolvedSecondaryCta =
  secondaryCta === null
    ? undefined
    : secondaryCta ??
      (usingDefaults
        ? {
            label: m.block_hero_secondary_cta({}, { locale: activeLocale }),
            href: pricingHref ?? homeHref,
          }
        : undefined);

const resolvedTrustNote = trustNote === null ? undefined : trustNote;
const resolvedFeatureCards = featureCards === null ? undefined : featureCards;
const resolvedPartnerPills = partnerPills === null ? undefined : partnerPills;
const resolvedPartnerLogos = partnerLogos === null ? undefined : partnerLogos;

const hasParallax = Boolean(parallaxImage);
const isHeroSurface = hasParallax || surface === 'hero';
const effectiveNavSurface = hasParallax ? 'hero' : surface;
const hasPrelude = Astro.slots.has('prelude');
const hasFooterSlot = Astro.slots.has('footer');
const isBottomCroppedArch = Boolean(bottomImage && bottomImageStyle === 'arch');
---

<section
  id={id}
  class:list={[
    'hero-centered-band relative isolate overflow-hidden',
    compact
      ? showPreviewNav
        ? isBottomCroppedArch
          ? 'rounded-3xl pt-8 pb-0 sm:pt-10'
          : 'rounded-3xl py-8 sm:py-12'
        : isBottomCroppedArch
          ? 'rounded-3xl pt-10 pb-0 sm:pt-14'
          : 'rounded-3xl py-10 sm:py-14'
      : showPreviewNav
        ? isBottomCroppedArch
          ? 'pt-10 pb-0 sm:pt-14'
          : 'pt-10 pb-14 sm:pt-14 sm:pb-20 lg:pb-24'
        : isBottomCroppedArch
          ? 'pt-28 pb-0 sm:pt-36 lg:pt-40'
          : 'pt-28 pb-14 sm:pt-36 sm:pb-20 lg:pt-40 lg:pb-24',
    topBanner && 'pt-0!',
    id && 'scroll-mt-24',
    isHeroSurface
      ? 'bg-hero-base text-hero-fg print:bg-bg print:text-fg'
      : surface === 'surface'
        ? 'border border-border bg-surface text-fg'
        : surface === 'subtle'
          ? 'border border-border bg-surface/60 text-fg'
          : 'border-b border-border bg-bg text-fg',
  ]}
  data-backdrop={backdrop}
  data-hero-surface={isHeroSurface ? 'hero' : 'standard'}
>
  {
    parallaxImage && (
      <HeroParallaxLayer
        locale={activeLocale}
        image={parallaxImage}
        alt={parallaxAlt || resolvedTitleLead}
        speed={parallaxSpeed}
        overlay={parallaxOverlay}
        priority={!compact}
      />
    )
  }

  {
    backdrop !== 'none' && (
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden print:hidden">
        {(backdrop === 'grid' || backdrop === 'dots' || backdrop === 'noise' || backdrop === 'net') && (
          <div
            class:list={[
              'hero-pattern-layer absolute inset-0',
              backdrop === 'dots'
                ? 'is-dots'
                : backdrop === 'noise'
                  ? 'is-noise'
                  : backdrop === 'net'
                    ? 'is-net'
                    : 'is-grid',
            ]}
          />
        )}
        {backdrop === 'wash' && <div class="hero-wash-layer absolute inset-0" />}
        {backdrop === 'orbital' && (
          <div class="absolute inset-0 flex items-center justify-center">
            <div
              class:list={[
                'size-[26rem] rounded-full border sm:size-[38rem]',
                isHeroSurface ? 'border-hero-fg/12' : 'border-border/70',
              ]}
            />
            <div
              class:list={[
                'absolute size-[18rem] rounded-full border sm:size-[26rem]',
                isHeroSurface ? 'border-accent/25' : 'border-primary/20',
              ]}
            />
            <div
              class:list={[
                'absolute size-[11rem] rounded-full border border-dashed sm:size-[15rem]',
                isHeroSurface ? 'border-hero-fg/15' : 'border-primary/25',
              ]}
            />
          </div>
        )}
        <div
          class:list={[
            'hero-glow-primary absolute -top-40 end-[-6rem] size-[28rem] rounded-full',
            !isHeroSurface && 'opacity-50',
          ]}
        />
        <div
          class:list={[
            'hero-glow-accent absolute -bottom-44 start-[-8rem] size-[24rem] rounded-full',
            !isHeroSurface && 'opacity-45',
          ]}
        />
      </div>
    )
  }

  {
    topBanner && (
      <div
        class:list={[
          'mb-8 border-b px-4 py-2.5 text-center text-xs font-medium print:hidden',
          isHeroSurface
            ? 'border-hero-fg/15 bg-hero-fg/10 text-hero-fg'
            : 'border-border bg-primary/10 text-fg',
        ]}
      >
        <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-2">
          {topBanner.badge && (
            <span
              class:list={[
                'rounded-full px-2.5 py-0.5 text-[11px] font-bold',
                isHeroSurface ? 'bg-accent text-hero-base' : 'bg-primary text-primary-fg',
              ]}
            >
              {topBanner.badge}
            </span>
          )}
          <span>{topBanner.label}</span>
          {topBanner.href && (
            <a
              href={topBanner.href}
              class:list={[
                'inline-flex items-center gap-1 font-bold underline underline-offset-4 transition-opacity hover:opacity-80',
                isHeroSurface ? 'text-accent' : 'text-primary',
              ]}
            >
              <span>{topBanner.ctaLabel ?? resolvedPrimaryCta?.label}</span>
              <Icon name="arrow-right" size={12} class="rtl:rotate-180" />
            </a>
          )}
        </div>
      </div>
    )
  }

  <div class="layout-container">
    <div
      class:list={[
        framedRails !== 'none' && 'mx-auto max-w-5xl border-s border-e px-5 py-6 sm:px-10 sm:py-8',
        framedRails === 'dashed' && 'border-dashed',
        framedRails !== 'none' && (isHeroSurface ? 'border-hero-fg/15 print:border-border' : 'border-border'),
      ]}
    >
      {
        showPreviewNav && (
          <HeroPreviewNav
            locale={activeLocale}
            surface={effectiveNavSurface}
            variant={previewNavVariant}
            brand={previewBrand}
            links={previewLinks}
            cta={previewCta}
            compact={compact}
          />
        )
      }

      {
        hasPrelude && (
          <div class="mb-6 flex justify-center print:mb-4">
            <slot name="prelude" />
          </div>
        )
      }

      <div
        class="mx-auto max-w-3xl text-center"
        data-trig-stagger
        data-trig-stagger-mode="linear"
        data-trig-stagger-delay="0.05"
        data-trig-once="true"
      >
        {
          showAvatarPill && (
            <div class="mb-6 flex justify-center">
              <div
                class:list={[
                  'inline-flex flex-wrap items-center gap-3 rounded-full border px-4 py-1.5',
                  isHeroSurface
                    ? 'border-hero-fg/15 bg-hero-fg/10 text-hero-fg print:border-border print:bg-surface print:text-fg'
                    : 'border-border bg-surface text-fg shadow-xs',
                ]}
              >
                <AvatarGroup
                  locale={activeLocale}
                  items={avatarItems}
                  extraCount={avatarCount}
                  label={avatarLabel}
                  rating={null}
                  size="sm"
                />
              </div>
            </div>
          )
        }

        {
          resolvedAnnouncement && (
            <div class="mb-6 flex justify-center">
              {resolvedAnnouncement.href ? (
                <a
                  href={resolvedAnnouncement.href}
                  class:list={[
                    'group inline-flex max-w-full flex-wrap items-center justify-center gap-2 rounded-full border p-1 pe-3.5 text-xs font-medium transition-colors',
                    isHeroSurface
                      ? 'border-hero-fg/20 bg-hero-fg/10 text-hero-fg/90 hover:border-hero-fg/35 hover:bg-hero-fg/15 print:border-border print:bg-surface print:text-fg'
                      : 'border-border bg-surface text-muted shadow-xs hover:border-primary/45 hover:text-fg',
                  ]}
                >
                  {resolvedAnnouncement.badge && (
                    <span
                      class:list={[
                        'inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11px] font-semibold',
                        isHeroSurface
                          ? 'bg-accent text-hero-base print:bg-primary print:text-primary-fg'
                          : 'bg-primary text-primary-fg',
                      ]}
                    >
                      {resolvedAnnouncement.pulse && <Icon name="sparkles" size={11} class="shrink-0" />}
                      {resolvedAnnouncement.badge}
                    </span>
                  )}
                  <span class="truncate ps-1.5">{resolvedAnnouncement.label}</span>
                  {resolvedAnnouncement.ctaLabel ? (
                    <span
                      class:list={[
                        'inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11px] font-semibold transition-colors',
                        isHeroSurface
                          ? 'bg-hero-fg/15 text-hero-fg print:bg-surface-hover print:text-fg'
                          : 'bg-surface-hover text-fg group-hover:bg-primary group-hover:text-primary-fg',
                      ]}
                    >
                      <span>{resolvedAnnouncement.ctaLabel}</span>
                      <Icon name="arrow-right" size={11} class="shrink-0 rtl:rotate-180" />
                    </span>
                  ) : (
                    <Icon
                      name="chevron-right"
                      size={14}
                      class="shrink-0 opacity-75 transition-transform duration-200 group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5"
                    />
                  )}
                </a>
              ) : (
                <span
                  class:list={[
                    'inline-flex max-w-full flex-wrap items-center justify-center gap-2 rounded-full border px-3 py-1 text-xs font-medium',
                    isHeroSurface
                      ? 'border-hero-fg/20 bg-hero-fg/10 text-hero-fg/90 print:border-border print:bg-surface print:text-fg'
                      : 'border-border bg-surface text-muted shadow-xs',
                  ]}
                >
                  {resolvedAnnouncement.badge && (
                    <span
                      class:list={[
                        'inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11px] font-semibold',
                        isHeroSurface
                          ? 'bg-accent text-hero-base print:bg-primary print:text-primary-fg'
                          : 'bg-primary text-primary-fg',
                      ]}
                    >
                      {resolvedAnnouncement.pulse && <Icon name="sparkles" size={11} class="shrink-0" />}
                      {resolvedAnnouncement.badge}
                    </span>
                  )}
                  <span>{resolvedAnnouncement.label}</span>
                </span>
              )}
            </div>
          )
        }

        {
          resolvedEyebrow && (
            <p
              class:list={[
                'text-xs font-semibold uppercase tracking-[0.14em] rtl:tracking-normal',
                isHeroSurface ? 'text-accent print:text-primary' : 'text-primary',
              ]}
            >
              {resolvedEyebrow}
            </p>
          )
        }

        {
          headingTag === 'h2' ? (
            <h2 class="mt-2 text-3xl font-extrabold leading-[1.1] tracking-tight text-balance sm:text-4xl lg:text-5xl">
              {resolvedTitleLead}
              {resolvedTitleAccent && (
                <>
                  {' '}
                  <span
                    class:list={[
                      'bg-clip-text text-transparent print:bg-none print:text-fg rtl:bg-linear-l',
                      isHeroSurface
                        ? 'bg-linear-to-r from-accent to-hero-fg'
                        : 'bg-linear-to-r from-primary to-secondary',
                    ]}
                  >
                    {resolvedTitleAccent}
                  </span>
                </>
              )}
            </h2>
          ) : (
            <h1 class="mt-2 text-[clamp(2.25rem,4.6vw,4.15rem)] font-extrabold leading-[1.08] tracking-tight text-balance">
              {resolvedTitleLead}
              {resolvedTitleAccent && (
                <>
                  {' '}
                  <span
                    class:list={[
                      'bg-clip-text text-transparent print:bg-none print:text-fg rtl:bg-linear-l',
                      isHeroSurface
                        ? 'bg-linear-to-r from-accent to-hero-fg'
                        : 'bg-linear-to-r from-primary to-secondary',
                    ]}
                  >
                    {resolvedTitleAccent}
                  </span>
                </>
              )}
            </h1>
          )
        }

        {
          resolvedDescription && (
            <p
              class:list={[
                'mx-auto mt-5 max-w-2xl text-base leading-relaxed text-pretty sm:text-lg',
                isHeroSurface ? 'text-hero-fg/88 print:text-muted' : 'text-muted',
              ]}
            >
              {resolvedDescription}
            </p>
          )
        }

        {
          (resolvedPrimaryCta || resolvedSecondaryCta) && (
            <div class="mt-8 flex flex-wrap items-center justify-center gap-3 print:hidden">
              {resolvedPrimaryCta && (
                <Button
                  href={resolvedPrimaryCta.href}
                  variant={resolvedPrimaryCta.variant ?? 'primary'}
                  size="lg"
                  glow
                  icon={resolvedPrimaryCta.icon ?? 'arrow-right'}
                  external={resolvedPrimaryCta.external}
                >
                  {resolvedPrimaryCta.label}
                </Button>
              )}
              {resolvedSecondaryCta && (
                <Button
                  href={resolvedSecondaryCta.href}
                  variant={resolvedSecondaryCta.variant ?? (isHeroSurface ? 'hero' : 'secondary')}
                  size="lg"
                  icon={resolvedSecondaryCta.icon}
                  external={resolvedSecondaryCta.external}
                >
                  {resolvedSecondaryCta.label}
                </Button>
              )}
            </div>
          )
        }

        {
          resolvedTrustNote && (
            <p
              class:list={[
                'mt-5 text-xs leading-relaxed',
                isHeroSurface ? 'text-hero-fg/75 print:text-muted' : 'text-muted',
              ]}
            >
              {resolvedTrustNote}
            </p>
          )
        }
      </div>

      {
        resolvedFeatureCards && resolvedFeatureCards.length > 0 && (
          <ul
            class="mx-auto mt-12 grid max-w-5xl gap-4 sm:grid-cols-3"
            data-trig-stagger
            data-trig-stagger-mode="linear"
            data-trig-stagger-delay="0.05"
            data-trig-once="true"
          >
            {resolvedFeatureCards.map((card) => (
              <li data-trig data-trig-once="true">
                <div
                  class:list={[
                    'h-full rounded-2xl border p-5 text-start transition-colors duration-200',
                    isHeroSurface
                      ? 'border-hero-fg/15 bg-hero-fg/5 hover:border-hero-fg/30 print:border-border print:bg-surface'
                      : 'border-border bg-surface/90 shadow-xs hover:border-primary/40',
                  ]}
                >
                  <span
                    class:list={[
                      'inline-flex size-10 items-center justify-center rounded-xl',
                      isHeroSurface
                        ? 'bg-hero-fg/10 text-accent print:bg-primary/10 print:text-primary'
                        : 'bg-primary/10 text-primary',
                    ]}
                    aria-hidden="true"
                  >
                    <Icon name={card.icon ?? 'sparkles'} size={18} />
                  </span>
                  <p class="mt-3.5 text-sm font-bold">{card.title}</p>
                  <p
                    class:list={[
                      'mt-1.5 text-xs leading-relaxed',
                      isHeroSurface ? 'text-hero-fg/80 print:text-muted' : 'text-muted',
                    ]}
                  >
                    {card.description}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        )
      }

      {
        resolvedPartnerPills && resolvedPartnerPills.length > 0 && (
          <ul
            class="mx-auto mt-10 flex max-w-4xl flex-wrap items-center justify-center gap-2.5"
            data-trig-stagger
            data-trig-stagger-mode="center"
            data-trig-stagger-delay="0.04"
            data-trig-once="true"
          >
            {resolvedPartnerPills.map((pill) => (
              <li
                data-trig
                data-trig-once="true"
                class:list={[
                  'inline-flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-xs font-semibold',
                  isHeroSurface
                    ? 'border-hero-fg/15 bg-hero-fg/10 text-hero-fg/90 print:border-border print:bg-surface print:text-fg'
                    : 'border-border bg-surface text-fg shadow-xs',
                ]}
              >
                <Icon
                  name={pill.icon ?? 'building'}
                  size={14}
                  class={isHeroSurface ? 'text-accent print:text-primary' : 'text-primary'}
                />
                <span>{pill.name}</span>
              </li>
            ))}
          </ul>
        )
      }

      {
        resolvedPartnerLogos && resolvedPartnerLogos.length > 0 && (
          <ul
            class="mx-auto mt-10 flex max-w-4xl flex-wrap items-center justify-center gap-x-8 gap-y-4"
            data-trig-stagger
            data-trig-stagger-mode="center"
            data-trig-stagger-delay="0.04"
            data-trig-once="true"
          >
            {resolvedPartnerLogos.map((partner) => (
              <li
                data-trig
                data-trig-once="true"
                class:list={[
                  'inline-flex items-center gap-2 text-xs font-bold tracking-wide sm:text-sm',
                  isHeroSurface ? 'text-hero-fg/75 print:text-muted' : 'text-muted',
                ]}
              >
                <Icon
                  name={partner.icon ?? 'building'}
                  size={16}
                  class={isHeroSurface ? 'text-accent print:text-primary' : 'text-primary'}
                />
                <span>{partner.name}</span>
              </li>
            ))}
          </ul>
        )
      }

      {
        bottomImage && (
          <div class="mx-auto mt-10 max-w-5xl trig-delay-150" data-trig data-trig-once="true">
            <div
              class:list={[
                'overflow-hidden border shadow-floating',
                bottomImageStyle === 'arch'
                  ? 'rounded-t-[2.75rem] rounded-b-none border-b-0'
                  : 'rounded-2xl',
                isHeroSurface
                  ? 'border-hero-fg/20 bg-hero-base/50 print:border-border print:bg-surface'
                  : 'border-border bg-surface',
              ]}
            >
              <Image
                src={bottomImage}
                alt={bottomImageAlt || resolvedTitleLead}
                widths={[720, 1080, 1440]}
                sizes="(min-width: 1024px) 62rem, 94vw"
                class="aspect-[16/7] w-full object-cover"
                loading={compact ? 'lazy' : 'eager'}
              />
            </div>
          </div>
        )
      }

      {
        hasFooterSlot && (
          <div class="mt-10">
            <slot name="footer" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero-pattern-layer.is-grid {
    background-image:
      linear-gradient(to right, color-mix(in oklch, var(--color-border) 60%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklch, var(--color-border) 60%, transparent) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 75% 70% at 50% 42%, black 20%, transparent 100%);
  }

