---
import type { ImageMetadata } from 'astro';
import { absoluteUrl, siteConfig } from '@/libs/config/app';
import { getRssFeedHref } from '@/libs/content/service';
import { getSocialCard } from '@/libs/content/social';
import { DEFAULT_LOCALE, LOCALES, getLocaleMeta, getOgLocale, type Locale } from '@/i18n/locales';
import * as m from '@/paraglide/messages';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  url: string;
  alternates: Partial<Record<Locale, string>>;
  siteName?: string;
  /** Artwork of the entry, already resolved by Astro's image pipeline. */
  image?: ImageMetadata;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** URL of the previous page of a paginated listing. */
  prevUrl?: string;
  /** URL of the next page of a paginated listing. */
  nextUrl?: string;
}

const {
  title,
  description,
  locale,
  url,
  alternates,
  siteName = siteConfig.name,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  schema,
  noindex = false,
  prevUrl,
  nextUrl,
} = Astro.props;

const resolvedDescription = description || m.site_description({}, { locale });
const localeMeta = getLocaleMeta(locale);
const feedUrl = absoluteUrl(getRssFeedHref(locale));
const canonicalUrl = absoluteUrl(url);
const defaultAlternate = alternates[DEFAULT_LOCALE];
const xDefaultUrl = absoluteUrl(defaultAlternate ?? url);

// The page's own artwork becomes a social card, cropped and encoded by
// Astro's image pipeline. Pages without artwork get the site card.
const socialImage = await getSocialCard(image);
const imageUrl = socialImage.url;

const alternateHrefs = Object.entries(alternates)
  .filter(([, href]) => Boolean(href))
  .map(([loc, href]) => [loc, absoluteUrl(href!)] as const);

const ogLocales = LOCALES.filter((loc) => loc !== locale)
  .filter((loc) => Boolean(alternates[loc]))
  .map((loc) => getOgLocale(loc));

const jsonLd = schema
  ? JSON.stringify(schema).replace(/</g, '\\u003c')
  : undefined;
---

<title>{title} | {siteName}</title>
<meta name="description" content={resolvedDescription} />
<link rel="canonical" href={canonicalUrl} />
{prevUrl && <link rel="prev" href={absoluteUrl(prevUrl)} />}
{nextUrl && <link rel="next" href={absoluteUrl(nextUrl)} />}
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${siteName} — ${localeMeta.name}`}
  href={feedUrl}
/>
{noindex && <meta name="robots" content="noindex, nofollow" />}

{/* Hreflang: one entry per available translation + x-default. */}
{
  alternateHrefs.map(([loc, href]) => (
    <link rel="alternate" hreflang={loc} href={href} />
  ))
}
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={getOgLocale(locale)} />
{ogLocales.map((loc) => <meta property="og:locale:alternate" content={loc} />)}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={String(socialImage.width)} />
<meta property="og:image:height" content={String(socialImage.height)} />
<meta property="og:image:alt" content={title} />
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={imageUrl} />

{jsonLd && <script type="application/ld+json" set:html={jsonLd} is:inline />}
