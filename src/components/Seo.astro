---
import type { ImageMetadata } from 'astro';
import { siteConfig } from '@/libs/config/site';
import { getSocialImage } from '@/libs/content/social';
import { DEFAULT_LOCALE, LOCALES, getOgLocale, type Locale } from '@/i18n/locales';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  url: string;
  alternates: Partial<Record<Locale, string>>;
  siteName?: string;
  /** Artwork of the entry, already resolved by Astro's image pipeline. */
  image?: ImageMetadata;
  type?: 'website' | 'article';
  publishedTime?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** URL of the previous page of a paginated listing. */
  prevUrl?: string;
  /** URL of the next page of a paginated listing. */
  nextUrl?: string;
}

const {
  title,
  description = siteConfig.description,
  locale,
  url,
  alternates,
  siteName = siteConfig.name,
  image,
  type = 'website',
  publishedTime,
  schema,
  noindex = false,
  prevUrl,
  nextUrl,
} = Astro.props;

const canonicalUrl = new URL(url, siteConfig.url).href;
const defaultAlternate = alternates[DEFAULT_LOCALE];
const xDefaultUrl = new URL(defaultAlternate ?? url, siteConfig.url).href;

// The page's own artwork becomes a social card, cropped and encoded by
// Astro's image pipeline. Pages without artwork fall back to the site card.
const socialImage = await getSocialImage(image);
const imageUrl = socialImage?.url ?? new URL(siteConfig.ogImage, siteConfig.url).href;
const imageSize = socialImage ?? {
  width: siteConfig.ogImageWidth,
  height: siteConfig.ogImageHeight,
};

const alternateHrefs = Object.entries(alternates)
  .filter(([, href]) => Boolean(href))
  .map(([loc, href]) => [loc, new URL(href!, siteConfig.url).href] as const);

const ogLocales = LOCALES.filter((loc) => loc !== locale)
  .filter((loc) => Boolean(alternates[loc]))
  .map((loc) => getOgLocale(loc));

const jsonLd = schema
  ? JSON.stringify(schema).replace(/</g, '\\u003c')
  : undefined;
---

<title>{title} | {siteName}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{prevUrl && <link rel="prev" href={new URL(prevUrl, siteConfig.url).href} />}
{nextUrl && <link rel="next" href={new URL(nextUrl, siteConfig.url).href} />}
<link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href={new URL('/rss.xml', siteConfig.url).href} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{/* Hreflang: one entry per available translation + x-default. */}
{
  alternateHrefs.map(([loc, href]) => (
    <link rel="alternate" hreflang={loc} href={href} />
  ))
}
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={getOgLocale(locale)} />
{ogLocales.map((loc) => <meta property="og:locale:alternate" content={loc} />)}
<meta property="og:image" content={imageUrl} />
{
  imageSize && (
    <>
      <meta property="og:image:width" content={String(imageSize.width)} />
      <meta property="og:image:height" content={String(imageSize.height)} />
    </>
  )
}
<meta property="og:image:alt" content={title} />
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{jsonLd && <script type="application/ld+json" set:html={jsonLd} is:inline />}
