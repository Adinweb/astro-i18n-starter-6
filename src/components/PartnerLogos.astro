---
/**
 * Composable partner / client trust strip inspired by PrebuiltUI logo clouds.
 * Renders clean emblem/image tiles without raw inline SVG blobs, preserving
 * WCAG contrast, logical alignment, and localized default tiles in LTR and RTL.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@/components/Icon.astro';
import PageSection from '@/components/PageSection.astro';
import type { Locale } from '@/i18n/locales';
import { resolveComponentLocale, resolveOptionalHeader } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

export interface PartnerLogoItem {
  name: string;
  tagline?: string;
  href?: string;
  external?: boolean;
  icon?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

interface Props {
  id?: string;
  locale?: Locale | string;
  eyebrow?: string | null;
  heading?: string | null;
  items?: readonly PartnerLogoItem[];
  columns?: 4 | 5 | 6;
  contained?: boolean;
  surface?: 'default' | 'surface' | 'subtle';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  id,
  locale,
  eyebrow,
  heading,
  items,
  columns = 5,
  contained = false,
  surface = 'subtle',
  spacing = 'sm',
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = items === undefined;

const resolvedEyebrow = resolveOptionalHeader(
  eyebrow,
  usingDefaults,
  m.block_partners_eyebrow({}, { locale: activeLocale })
);
const resolvedHeading = resolveOptionalHeader(
  heading,
  usingDefaults,
  m.block_partners_heading({}, { locale: activeLocale })
);

const resolvedItems: readonly PartnerLogoItem[] = items ?? [
  {
    name: m.block_partners_1_name({}, { locale: activeLocale }),
    tagline: m.block_partners_1_tag({}, { locale: activeLocale }),
    icon: 'globe',
  },
  {
    name: m.block_partners_2_name({}, { locale: activeLocale }),
    tagline: m.block_partners_2_tag({}, { locale: activeLocale }),
    icon: 'palette',
  },
  {
    name: m.block_partners_3_name({}, { locale: activeLocale }),
    tagline: m.block_partners_3_tag({}, { locale: activeLocale }),
    icon: 'bolt',
  },
  {
    name: m.block_partners_4_name({}, { locale: activeLocale }),
    tagline: m.block_partners_4_tag({}, { locale: activeLocale }),
    icon: 'building',
  },
  {
    name: m.block_partners_5_name({}, { locale: activeLocale }),
    tagline: m.block_partners_5_tag({}, { locale: activeLocale }),
    icon: 'compass',
  },
];

const cardSurface = !contained && surface === 'surface' ? 'bg-bg' : 'bg-surface';
const gridColsClass =
  columns === 4
    ? 'grid-cols-2 sm:grid-cols-4'
    : columns === 6
      ? 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-6'
      : 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-5';
---

<PageSection
  id={id}
  surface={contained ? 'default' : surface}
  spacing={contained ? 'sm' : spacing}
  bleed={contained}
  borderTop
  borderBottom
  class={contained ? 'not-prose my-10' : undefined}
>
  {
    (resolvedEyebrow || resolvedHeading) && (
      <div class="mb-6 text-center" data-trig>
        {resolvedEyebrow && <p class="section-kicker">{resolvedEyebrow}</p>}
        {resolvedHeading && (
          <h2 class="mt-1.5 text-lg font-bold tracking-tight text-fg sm:text-xl text-balance">
            {resolvedHeading}
          </h2>
        )}
      </div>
    )
  }

  <ul
    class:list={['grid gap-3 sm:gap-4', gridColsClass]}
    data-trig-stagger
    data-trig-stagger-mode="center"
    data-trig-stagger-delay="0.04"
    data-trig-once="true"
  >
    {
      resolvedItems.map((item) => {
        const isExternal = item.external ?? (item.href ? /^https?:\/\//i.test(item.href) : false);
        return (
          <li data-trig>
            {item.href ? (
              <a
                href={item.href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noreferrer noopener' : undefined}
                class:list={[
                  'group flex h-full min-h-20 flex-col items-center justify-center rounded-2xl border border-border px-4 py-3 text-center transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-xs',
                  cardSurface,
                ]}
              >
                {item.image ? (
                  <Image
                    src={item.image}
                    alt={item.imageAlt ?? item.name}
                    widths={[160, 320]}
                    sizes="140px"
                    class="max-h-8 w-auto object-contain opacity-80 transition-opacity group-hover:opacity-100"
                  />
                ) : (
                  <span class="inline-flex items-center gap-2 text-sm font-bold tracking-tight text-fg transition-colors group-hover:text-primary">
                    <Icon name={item.icon ?? 'building'} size={17} class="shrink-0 text-primary" />
                    <span>{item.name}</span>
                  </span>
                )}
                {item.tagline && (
                  <span class="mt-1 text-[11px] text-muted">{item.tagline}</span>
                )}
              </a>
            ) : (
              <div
                class:list={[
                  'flex h-full min-h-20 flex-col items-center justify-center rounded-2xl border border-border px-4 py-3 text-center',
                  cardSurface,
                ]}
              >
                {item.image ? (
                  <Image
                    src={item.image}
                    alt={item.imageAlt ?? item.name}
                    widths={[160, 320]}
                    sizes="140px"
                    class="max-h-8 w-auto object-contain opacity-85"
                  />
                ) : (
                  <span class="inline-flex items-center gap-2 text-sm font-bold tracking-tight text-fg">
                    <Icon name={item.icon ?? 'building'} size={17} class="shrink-0 text-primary" />
                    <span>{item.name}</span>
                  </span>
                )}
                {item.tagline && (
                  <span class="mt-1 text-[11px] text-muted">{item.tagline}</span>
                )}
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
</PageSection>
