---
interface Props {
  /** HTML element tag to render. */
  as?: keyof HTMLElementTagNameMap;
  /** Logical direction of the entrance animation (`start`/`end` mirror automatically in RTL). */
  direction?: 'up' | 'down' | 'start' | 'end' | 'scale';
  /** Optional manual delay in milliseconds. */
  delay?: 50 | 100 | 150 | 200 | 250 | 300 | 400 | 500;
  /** Extra classes merged onto the element. */
  class?: string;
  /** Any other attribute (`id`, `data-*`, `aria-*`, …) is forwarded verbatim. */
  [key: string]: unknown;
}

const {
  as: Tag = 'div',
  direction = 'up',
  delay,
  class: className = '',
  ...rest
} = Astro.props;
---

<Tag
  class:list={['reveal', className]}
  data-reveal={direction}
  data-delay={delay !== undefined ? String(delay) : undefined}
  {...rest}
>
  <slot />
</Tag>
