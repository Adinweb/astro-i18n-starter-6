---
/**
 * Composable visual gallery / portfolio showcase inspired by PrebuiltUI image
 * gallery sections. Supports optional category filtering, accessible `<dialog>`
 * preview modal (`enableLightbox`), ChronoTrig reveal refreshes, optimized `<Image>`
 * crops with starter fallback, and localized defaults.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PageSection from '@/components/PageSection.astro';
import Icon from '@/components/ui/Icon.astro';
import IconButton from '@/components/ui/IconButton.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import type { Locale } from '@/i18n/locales';
import { DEFAULT_HERO_IMAGE } from '@/libs/config/app';
import { resolveComponentLocale, resolveOptionalHeader } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

export interface GalleryItem {
  title: string;
  caption?: string;
  category?: string;
  image?: ImageMetadata;
  alt?: string;
}

interface Props {
  id?: string;
  locale?: Locale | string;
  eyebrow?: string | null;
  heading?: string | null;
  subheading?: string | null;
  items?: readonly GalleryItem[];
  columns?: 2 | 3 | 4;
  enableFilter?: boolean;
  enableLightbox?: boolean;
  contained?: boolean;
  surface?: 'default' | 'surface' | 'subtle';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  id,
  locale,
  eyebrow,
  heading,
  subheading,
  items,
  columns = 3,
  enableFilter = true,
  enableLightbox = true,
  contained = false,
  surface = 'surface',
  spacing = 'md',
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = items === undefined;

const resolvedEyebrow = resolveOptionalHeader(
  eyebrow,
  usingDefaults,
  m.block_gallery_eyebrow({}, { locale: activeLocale })
);
const resolvedHeading = resolveOptionalHeader(
  heading,
  usingDefaults,
  m.block_gallery_heading({}, { locale: activeLocale })
);
const resolvedSubheading = resolveOptionalHeader(
  subheading,
  usingDefaults,
  m.block_gallery_subheading({}, { locale: activeLocale })
);

const resolvedItems: readonly GalleryItem[] = items ?? [
  {
    title: m.block_gallery_1_title({}, { locale: activeLocale }),
    caption: m.block_gallery_1_caption({}, { locale: activeLocale }),
    category: m.block_gallery_1_cat({}, { locale: activeLocale }),
    image: DEFAULT_HERO_IMAGE,
  },
  {
    title: m.block_gallery_2_title({}, { locale: activeLocale }),
    caption: m.block_gallery_2_caption({}, { locale: activeLocale }),
    category: m.block_gallery_2_cat({}, { locale: activeLocale }),
    image: DEFAULT_HERO_IMAGE,
  },
  {
    title: m.block_gallery_3_title({}, { locale: activeLocale }),
    caption: m.block_gallery_3_caption({}, { locale: activeLocale }),
    category: m.block_gallery_3_cat({}, { locale: activeLocale }),
    image: DEFAULT_HERO_IMAGE,
  },
];

const categories = [...new Set(resolvedItems.map((i) => i.category).filter(Boolean))] as string[];
const showFilters = enableFilter && categories.length > 1;
const allLabel = m.block_gallery_all({}, { locale: activeLocale });
const closeLabel = m.common_close({}, { locale: activeLocale });
const dialogTitleId = `${id ?? `gallery-${crypto.randomUUID().slice(0, 6)}`}-dialog-title`;

const hasHeader = Boolean(resolvedEyebrow || resolvedHeading || resolvedSubheading);
const cardSurface = !contained && surface === 'surface' ? 'bg-bg' : 'bg-surface';
const gridColsClass =
  columns === 2
    ? 'sm:grid-cols-2'
    : columns === 4
      ? 'sm:grid-cols-2 xl:grid-cols-4'
      : 'md:grid-cols-2 lg:grid-cols-3';
---

<PageSection
  id={id}
  surface={contained ? 'default' : surface}
  spacing={contained ? 'none' : spacing}
  bleed={contained}
  class={contained ? 'not-prose my-10' : undefined}
>
  <div data-gallery-section data-locale={activeLocale}>
    <div class:list={[(hasHeader || showFilters) && 'flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between']}>
      <SectionHeader
        eyebrow={resolvedEyebrow}
        heading={resolvedHeading}
        subheading={resolvedSubheading}
      />

      {
        showFilters && (
          <div class="flex flex-wrap items-center gap-2 print:hidden" data-trig data-trig-once="true">
            <button
              type="button"
              data-gallery-filter="__all__"
              aria-pressed="true"
              class="chip cursor-pointer border-primary bg-primary px-3.5 py-1.5 text-xs font-semibold text-primary-fg shadow-xs"
            >
              {allLabel}
            </button>
            {categories.map((cat) => (
              <button
                type="button"
                data-gallery-filter={cat}
                aria-pressed="false"
                class="chip cursor-pointer px-3.5 py-1.5 text-xs font-semibold"
              >
                {cat}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div
      data-gallery-grid
      class:list={['grid gap-5', (hasHeader || showFilters) && 'mt-8', gridColsClass]}
      data-trig-stagger
      data-trig-stagger-delay="0.06"
      data-trig-once="true"
    >
      {
        resolvedItems.map((item) => {
          const previewImage = item.image ?? DEFAULT_HERO_IMAGE;
          return (
            <figure
              data-trig
              data-trig-once="true"
              data-gallery-card
              data-category={item.category ?? ''}
              class="flex"
            >
              <div
                class:list={[
                  'group flex w-full flex-col overflow-hidden rounded-2xl border border-border shadow-xs transition duration-200 hover:-translate-y-0.5 hover:border-primary/45 hover:shadow-md',
                  cardSurface,
                ]}
              >
                <div class="relative aspect-[16/10] overflow-hidden bg-surface-hover/50">
                  {item.image ? (
                    <Image
                      src={previewImage}
                      alt={item.alt ?? item.title}
                      widths={[480, 800]}
                      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 94vw"
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                      data-gallery-img
                    />
                  ) : (
                    <div class="flex h-full items-center justify-center bg-linear-to-br rtl:bg-linear-to-bl from-primary/15 via-surface-hover to-accent/15 text-primary">
                      <Icon name="photo" size={36} />
                    </div>
                  )}

                  {item.category && (
                    <span class="hero-badge absolute bottom-3 start-3">
                      {item.category}
                    </span>
                  )}

                  {enableLightbox && item.image && (
                    <IconButton
                      variant="glass"
                      icon="external-link"
                      size={16}
                      label={m.block_gallery_preview_aria(
                        { title: item.title },
                        { locale: activeLocale }
                      )}
                      data-gallery-open
                      data-title={item.title}
                      data-caption={item.caption ?? ''}
                      class="absolute top-3 end-3 print:hidden"
                    />
                  )}
                </div>

                <figcaption class="p-4 sm:p-5">
                  <p class="text-base font-bold tracking-tight text-fg">{item.title}</p>
                  {item.caption && (
                    <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.caption}</p>
                  )}
                </figcaption>
              </div>
            </figure>
          );
        })
      }
    </div>

    {
      enableLightbox && (
        <dialog
          data-gallery-dialog
          data-lenis-prevent
          aria-labelledby={dialogTitleId}
          class="m-auto w-[min(92vw,56rem)] overflow-hidden rounded-3xl border border-border bg-surface p-0 text-fg shadow-floating backdrop:bg-scrim backdrop:backdrop-blur-xs"
        >
          <div class="flex items-center justify-between gap-4 border-b border-border px-5 py-3.5 sm:px-6">
            <p id={dialogTitleId} data-dialog-title class="truncate text-base font-bold text-fg" />
            <IconButton
              icon="close"
              label={closeLabel}
              size={18}
              data-gallery-close
            />
          </div>
          <div class="bg-bg p-3 sm:p-5">
            <div data-dialog-stage class="relative overflow-hidden rounded-2xl touch-pan-y">
              <img
                data-dialog-img
                src=""
                alt=""
                class="max-h-[68vh] w-full rounded-2xl object-contain select-none"
              />
            </div>

            <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
              <p data-dialog-caption class="min-w-0 flex-1 text-sm leading-relaxed text-muted" />
              <div data-dialog-nav class="flex shrink-0 items-center gap-2 print:hidden">
                <IconButton
                  label={m.block_gallery_prev({}, { locale: activeLocale })}
                  data-gallery-prev
                  class="shrink-0"
                >
                  <Icon name="chevron-left" size={16} class="rtl:rotate-180" />
                </IconButton>
                <span
                  data-dialog-counter
                  data-counter-template={m.block_gallery_slide_status(
                    { current: '__CURRENT__', total: '__TOTAL__' },
                    { locale: activeLocale }
                  )}
                  class="min-w-[3.5rem] text-center text-xs font-semibold tabular-nums text-muted"
                />
                <IconButton
                  label={m.block_gallery_next({}, { locale: activeLocale })}
                  data-gallery-next
                  class="shrink-0"
                >
                  <Icon name="chevron-right" size={16} class="rtl:rotate-180" />
                </IconButton>
              </div>
            </div>
          </div>
        </dialog>
      )
    }
  </div>
</PageSection>

<script>
  import { formatNumber } from '@/i18n/format';
  import { replayStaggerGrid } from '@/scripts/chronotrig';

  function initImageGalleries() {
    const sections = document.querySelectorAll<HTMLElement>('[data-gallery-section]');

    sections.forEach((section) => {
      if (section.dataset.bound === 'true') return;
      section.dataset.bound = 'true';

      const locale = section.dataset.locale || document.documentElement.lang || 'en';
      const filterBtns = Array.from(
        section.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]')
      );
      const grid = section.querySelector<HTMLElement>('[data-gallery-grid]');
      const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-gallery-card]'));

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selected = btn.dataset.galleryFilter ?? '__all__';

          filterBtns.forEach((b) => {
            const active = b === btn;
            b.setAttribute('aria-pressed', String(active));
            b.classList.toggle('border-primary', active);
            b.classList.toggle('bg-primary', active);
            b.classList.toggle('text-primary-fg', active);
            b.classList.toggle('shadow-xs', active);
          });

          let visibilityChanged = false;
          cards.forEach((card) => {
            const cat = card.dataset.category ?? '';
            const nextHidden = selected !== '__all__' && cat !== selected;
            if (card.hidden !== nextHidden) visibilityChanged = true;
            card.hidden = nextHidden;
          });

          if (grid && visibilityChanged) {
            replayStaggerGrid(grid);
          }
        });
      });

      const dialog = section.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
      const dialogStage = section.querySelector<HTMLElement>('[data-dialog-stage]');
      const dialogImg = section.querySelector<HTMLImageElement>('[data-dialog-img]');
      const dialogTitle = section.querySelector<HTMLElement>('[data-dialog-title]');
      const dialogCaption = section.querySelector<HTMLElement>('[data-dialog-caption]');
      const dialogNav = section.querySelector<HTMLElement>('[data-dialog-nav]');
      const dialogCounter = section.querySelector<HTMLElement>('[data-dialog-counter]');
      const prevBtn = section.querySelector<HTMLButtonElement>('[data-gallery-prev]');
      const nextBtn = section.querySelector<HTMLButtonElement>('[data-gallery-next]');
      const closeBtn = section.querySelector<HTMLButtonElement>('[data-gallery-close]');

      if (dialog && dialogImg && dialogTitle && dialogCaption) {
        const allOpeners = Array.from(
          section.querySelectorAll<HTMLButtonElement>('[data-gallery-open]')
        );
        let activeSlides: HTMLButtonElement[] = [];
        let activeIndex = 0;

        const getVisibleSlides = (): HTMLButtonElement[] =>
          allOpeners.filter((btn) => {
            const card = btn.closest<HTMLElement>('[data-gallery-card]');
            return card ? !card.hidden : true;
          });

        const showSlide = (index: number) => {
          if (activeSlides.length === 0) return;
          const total = activeSlides.length;
          activeIndex = ((index % total) + total) % total;
          const btn = activeSlides[activeIndex];
          if (!btn) return;
          const card = btn.closest('[data-gallery-card]');
          const img = card?.querySelector<HTMLImageElement>('[data-gallery-img]');
          if (!img) return;

          dialogImg.src = img.currentSrc || img.src;
          dialogImg.alt = img.alt || btn.dataset.title || '';
          dialogTitle.textContent = btn.dataset.title ?? '';

          const caption = btn.dataset.caption ?? '';
          dialogCaption.textContent = caption;
          dialogCaption.hidden = caption === '';

          const multi = total > 1;
          if (dialogNav) dialogNav.hidden = !multi;
          if (prevBtn) prevBtn.disabled = !multi;
          if (nextBtn) nextBtn.disabled = !multi;
          if (dialogCounter) {
            const tpl = dialogCounter.dataset.counterTemplate || '__CURRENT__ / __TOTAL__';
            dialogCounter.textContent = tpl
              .replace('__CURRENT__', formatNumber(activeIndex + 1, locale))
              .replace('__TOTAL__', formatNumber(total, locale));
          }
        };

        allOpeners.forEach((btn) => {
          btn.addEventListener('click', () => {
            activeSlides = getVisibleSlides();
            const foundIdx = activeSlides.indexOf(btn);
            activeIndex = foundIdx >= 0 ? foundIdx : 0;
            showSlide(activeIndex);
            dialog.showModal();
          });
        });

        prevBtn?.addEventListener('click', () => showSlide(activeIndex - 1));
        nextBtn?.addEventListener('click', () => showSlide(activeIndex + 1));

        dialog.addEventListener('keydown', (event) => {
          if (!dialog.open || activeSlides.length <= 1) return;
          const isRtl =
            getComputedStyle(dialog).direction === 'rtl' ||
            document.documentElement.dir === 'rtl';
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            showSlide(isRtl ? activeIndex - 1 : activeIndex + 1);
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            showSlide(isRtl ? activeIndex + 1 : activeIndex - 1);
          }
        });

        let pointerStartX: number | null = null;
        let pointerStartY: number | null = null;
        dialogStage?.addEventListener('pointerdown', (event) => {
          if (!event.isPrimary) return;
          pointerStartX = event.clientX;
          pointerStartY = event.clientY;
        });
        dialogStage?.addEventListener('pointerup', (event) => {
          if (pointerStartX === null || pointerStartY === null || activeSlides.length <= 1) {
            pointerStartX = null;
            pointerStartY = null;
            return;
          }
          const dx = event.clientX - pointerStartX;
          const dy = event.clientY - pointerStartY;
          pointerStartX = null;
          pointerStartY = null;

          if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
            const isRtl =
              getComputedStyle(dialog).direction === 'rtl' ||
              document.documentElement.dir === 'rtl';
            if (dx < 0) {
              showSlide(isRtl ? activeIndex - 1 : activeIndex + 1);
            } else {
              showSlide(isRtl ? activeIndex + 1 : activeIndex - 1);
            }
          }
        });
        dialogStage?.addEventListener('pointercancel', () => {
          pointerStartX = null;
          pointerStartY = null;
        });

        closeBtn?.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });
      }
    });
  }

  document.addEventListener('astro:page-load', initImageGalleries);
  initImageGalleries();
</script>
