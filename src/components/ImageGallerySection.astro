---
/**
 * Composable visual gallery / portfolio showcase inspired by PrebuiltUI image
 * gallery sections. Supports optional category filtering, accessible `<dialog>`
 * preview modal (`enableLightbox`), ChronoTrig reveal refreshes, optimized `<Image>`
 * crops with starter fallback, and localized defaults.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@/components/Icon.astro';
import IconButton from '@/components/IconButton.astro';
import PageSection from '@/components/PageSection.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import type { Locale } from '@/i18n/locales';
import { DEFAULT_HERO_IMAGE } from '@/libs/config/app';
import { resolveComponentLocale, resolveOptionalHeader } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

export interface GalleryItem {
  title: string;
  caption?: string;
  category?: string;
  image?: ImageMetadata;
  alt?: string;
}

interface Props {
  id?: string;
  locale?: Locale | string;
  eyebrow?: string | null;
  heading?: string | null;
  subheading?: string | null;
  items?: readonly GalleryItem[];
  columns?: 2 | 3 | 4;
  enableFilter?: boolean;
  enableLightbox?: boolean;
  contained?: boolean;
  surface?: 'default' | 'surface' | 'subtle';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  id,
  locale,
  eyebrow,
  heading,
  subheading,
  items,
  columns = 3,
  enableFilter = true,
  enableLightbox = true,
  contained = false,
  surface = 'surface',
  spacing = 'md',
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = items === undefined;

const resolvedEyebrow = resolveOptionalHeader(
  eyebrow,
  usingDefaults,
  m.block_gallery_eyebrow({}, { locale: activeLocale })
);
const resolvedHeading = resolveOptionalHeader(
  heading,
  usingDefaults,
  m.block_gallery_heading({}, { locale: activeLocale })
);
const resolvedSubheading = resolveOptionalHeader(
  subheading,
  usingDefaults,
  m.block_gallery_subheading({}, { locale: activeLocale })
);

const resolvedItems: readonly GalleryItem[] = items ?? [
  {
    title: m.block_gallery_1_title({}, { locale: activeLocale }),
    caption: m.block_gallery_1_caption({}, { locale: activeLocale }),
    category: m.block_gallery_1_cat({}, { locale: activeLocale }),
    image: DEFAULT_HERO_IMAGE,
  },
  {
    title: m.block_gallery_2_title({}, { locale: activeLocale }),
    caption: m.block_gallery_2_caption({}, { locale: activeLocale }),
    category: m.block_gallery_2_cat({}, { locale: activeLocale }),
    image: DEFAULT_HERO_IMAGE,
  },
  {
    title: m.block_gallery_3_title({}, { locale: activeLocale }),
    caption: m.block_gallery_3_caption({}, { locale: activeLocale }),
    category: m.block_gallery_3_cat({}, { locale: activeLocale }),
    image: DEFAULT_HERO_IMAGE,
  },
];

const categories = [...new Set(resolvedItems.map((i) => i.category).filter(Boolean))] as string[];
const showFilters = enableFilter && categories.length > 1;
const allLabel = m.block_gallery_all({}, { locale: activeLocale });
const closeLabel = m.common_close({}, { locale: activeLocale });
const dialogTitleId = `${id ?? `gallery-${crypto.randomUUID().slice(0, 6)}`}-dialog-title`;

const hasHeader = Boolean(resolvedEyebrow || resolvedHeading || resolvedSubheading);
const cardSurface = !contained && surface === 'surface' ? 'bg-bg' : 'bg-surface';
const gridColsClass =
  columns === 2
    ? 'sm:grid-cols-2'
    : columns === 4
      ? 'sm:grid-cols-2 xl:grid-cols-4'
      : 'md:grid-cols-2 lg:grid-cols-3';
---

<PageSection
  id={id}
  surface={contained ? 'default' : surface}
  spacing={contained ? 'none' : spacing}
  bleed={contained}
  class={contained ? 'not-prose my-10' : undefined}
>
  <div data-gallery-section>
    <div class:list={[(hasHeader || showFilters) && 'flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between']}>
      <SectionHeader
        eyebrow={resolvedEyebrow}
        heading={resolvedHeading}
        subheading={resolvedSubheading}
      />

      {
        showFilters && (
          <div class="flex flex-wrap items-center gap-2 print:hidden" data-trig>
            <button
              type="button"
              data-gallery-filter="__all__"
              aria-pressed="true"
              class="chip cursor-pointer border-primary bg-primary px-3.5 py-1.5 text-xs font-semibold text-primary-fg shadow-xs"
            >
              {allLabel}
            </button>
            {categories.map((cat) => (
              <button
                type="button"
                data-gallery-filter={cat}
                aria-pressed="false"
                class="chip cursor-pointer px-3.5 py-1.5 text-xs font-semibold"
              >
                {cat}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div
      data-gallery-grid
      class:list={['grid gap-5', (hasHeader || showFilters) && 'mt-8', gridColsClass]}
      data-trig-stagger
      data-trig-stagger-delay="0.06"
    >
      {
        resolvedItems.map((item) => {
          const previewImage = item.image ?? DEFAULT_HERO_IMAGE;
          return (
            <figure
              data-trig
              data-gallery-card
              data-category={item.category ?? ''}
              class:list={[
                'group overflow-hidden rounded-2xl border border-border shadow-xs transition duration-200 hover:-translate-y-0.5 hover:border-primary/45 hover:shadow-md',
                cardSurface,
              ]}
            >
              <div class="relative aspect-[16/10] overflow-hidden bg-surface-hover/50">
                {item.image ? (
                  <Image
                    src={previewImage}
                    alt={item.alt ?? item.title}
                    widths={[480, 800]}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 94vw"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                    data-gallery-img
                  />
                ) : (
                  <div class="flex h-full items-center justify-center bg-linear-to-br rtl:bg-linear-to-bl from-primary/15 via-surface-hover to-accent/15 text-primary">
                    <Icon name="photo" size={36} />
                  </div>
                )}

                {item.category && (
                  <span class="hero-badge absolute bottom-3 start-3">
                    {item.category}
                  </span>
                )}

                {enableLightbox && item.image && (
                  <IconButton
                    variant="glass"
                    icon="external-link"
                    size={16}
                    label={m.block_gallery_preview_aria(
                      { title: item.title },
                      { locale: activeLocale }
                    )}
                    data-gallery-open
                    data-title={item.title}
                    data-caption={item.caption ?? ''}
                    class="absolute top-3 end-3 print:hidden"
                  />
                )}
              </div>

              <figcaption class="p-4 sm:p-5">
                <p class="text-base font-bold tracking-tight text-fg">{item.title}</p>
                {item.caption && (
                  <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.caption}</p>
                )}
              </figcaption>
            </figure>
          );
        })
      }
    </div>

    {
      enableLightbox && (
        <dialog
          data-gallery-dialog
          data-lenis-prevent
          aria-labelledby={dialogTitleId}
          class="m-auto w-[min(92vw,56rem)] overflow-hidden rounded-3xl border border-border bg-surface p-0 text-fg shadow-floating backdrop:bg-scrim backdrop:backdrop-blur-xs"
        >
          <div class="flex items-center justify-between gap-4 border-b border-border px-5 py-3.5 sm:px-6">
            <p id={dialogTitleId} data-dialog-title class="truncate text-base font-bold text-fg" />
            <IconButton
              icon="close"
              label={closeLabel}
              size={18}
              data-gallery-close
            />
          </div>
          <div class="bg-bg p-3 sm:p-5">
            <img
              data-dialog-img
              src=""
              alt=""
              class="max-h-[70vh] w-full rounded-2xl object-contain"
            />
            <p data-dialog-caption class="mt-3 text-sm leading-relaxed text-muted" />
          </div>
        </dialog>
      )
    }
  </div>
</PageSection>

<script>
  import { refreshChronoTrig } from '@/scripts/chronotrig';

  function initImageGalleries() {
    const sections = document.querySelectorAll<HTMLElement>('[data-gallery-section]');

    sections.forEach((section) => {
      if (section.dataset.bound === 'true') return;
      section.dataset.bound = 'true';

      const filterBtns = Array.from(
        section.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]')
      );
      const grid = section.querySelector<HTMLElement>('[data-gallery-grid]');
      const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-gallery-card]'));

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selected = btn.dataset.galleryFilter ?? '__all__';

          filterBtns.forEach((b) => {
            const active = b === btn;
            b.setAttribute('aria-pressed', String(active));
            b.classList.toggle('border-primary', active);
            b.classList.toggle('bg-primary', active);
            b.classList.toggle('text-primary-fg', active);
            b.classList.toggle('shadow-xs', active);
          });

          cards.forEach((card) => {
            const cat = card.dataset.category ?? '';
            card.hidden = selected !== '__all__' && cat !== selected;
          });

          if (grid && typeof window.chronoTrig !== 'undefined') {
            grid.classList.remove('trig-stagger-active');
            cards.forEach((card) =>
              card.classList.remove('trig', 'trig-up', 'trig-down', 'trig-stagger-active')
            );
            void grid.offsetHeight;
          }
          refreshChronoTrig();
        });
      });

      const dialog = section.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
      const dialogImg = section.querySelector<HTMLImageElement>('[data-dialog-img]');
      const dialogTitle = section.querySelector<HTMLElement>('[data-dialog-title]');
      const dialogCaption = section.querySelector<HTMLElement>('[data-dialog-caption]');
      const closeBtn = section.querySelector<HTMLButtonElement>('[data-gallery-close]');

      if (dialog && dialogImg && dialogTitle && dialogCaption) {
        const openers = section.querySelectorAll<HTMLButtonElement>('[data-gallery-open]');
        openers.forEach((btn) => {
          btn.addEventListener('click', () => {
            const card = btn.closest('[data-gallery-card]');
            const img = card?.querySelector<HTMLImageElement>('[data-gallery-img]');
            if (!img) return;
            dialogImg.src = img.currentSrc || img.src;
            dialogImg.alt = img.alt || btn.dataset.title || '';
            dialogTitle.textContent = btn.dataset.title ?? '';
            const caption = btn.dataset.caption ?? '';
            dialogCaption.textContent = caption;
            dialogCaption.hidden = caption === '';
            dialog.showModal();
          });
        });

        closeBtn?.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });
      }
    });
  }

  document.addEventListener('astro:page-load', initImageGalleries);
  initImageGalleries();
</script>
