---
// TopLoadingBar: persistent ClientRouter transition progress bar.
// The bar intentionally keeps a left-to-right fill inside dir="ltr" so the
// progress direction is identical in RTL and LTR documents.
---

<div dir="ltr"
  id="nprogress"
  transition:persist="top-loading-bar"
  aria-hidden="true"
></div>

<style is:global>
  #nprogress {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: 100%;
    height: 3px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
    z-index: 999999;
    opacity: 0;
    pointer-events: none;
  }

  #nprogress.loading {
    opacity: 1;
  }

  #nprogress.done {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    #nprogress {
      /* No width animation: the bar still appears and completes, but only
         fades, so reduced-motion users get the same state feedback. */
      transition: opacity 0.1s linear;
    }
  }
</style>

<script>
  const TRICKLE_INTERVAL_MS = 180;
  const HIDE_DELAY_MS = 280;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let trickleTimer: number | null = null;
  let hideTimer: number | null = null;
  let progress = 0;
  let isActive = false;

  function clearTimers() {
    if (trickleTimer !== null) {
      clearInterval(trickleTimer);
      trickleTimer = null;
    }
    if (hideTimer !== null) {
      clearTimeout(hideTimer);
      hideTimer = null;
    }
  }

  /**
   * Reveals the bar immediately. Navigation feedback is state, not decoration,
   * so it is shown even when reduced motion is requested — the bar is simply
   * static at a fixed progress instead of trickling.
   */
  function start() {
    clearTimers();
    progress = 0;

    const el = document.getElementById('nprogress');
    if (!el) return;

    el.classList.remove('done');
    el.classList.add('loading');
    el.style.opacity = '1';
    el.style.transform = `scaleX(${prefersReducedMotion ? 0.35 : 0.08})`;
    isActive = true;

    if (prefersReducedMotion) return;

    trickleTimer = window.setInterval(() => {
      const remaining = 90 - progress;
      progress = Math.min(progress + Math.random() * Math.max(remaining * 0.12, 1), 90);
      el.style.transform = `scaleX(${progress / 100})`;
    }, TRICKLE_INTERVAL_MS);
  }

  function finish() {
    // `astro:after-preparation` and `astro:page-load` both report completion;
    // only the first one owns the hide timer, the repeat must not cancel it.
    if (!isActive) return;
    clearTimers();
    isActive = false;

    const bar = document.getElementById('nprogress');
    if (!bar) return;

    bar.classList.add('done');
    bar.style.transform = 'scaleX(1)';

    // Keep the completed state on screen briefly, so a navigation that resolves
    // in a few milliseconds still reads as feedback instead of a flicker.
    hideTimer = window.setTimeout(() => {
      hideTimer = null;
      reset();
    }, HIDE_DELAY_MS);
  }

  /**
   * Puts the bar back into its hidden state.
   *
   * Used when the page is being put into the back/forward cache: the timers are
   * frozen together with the page, so a bar that was left in its "done" state
   * would greet the visitor with a full-width stripe the moment the page is
   * restored.
   */
  function reset() {
    clearTimers();
    isActive = false;
    progress = 0;

    const bar = document.getElementById('nprogress');
    if (!bar) return;

    bar.classList.remove('loading', 'done');
    bar.style.transform = 'scaleX(0)';
    bar.style.opacity = '0';
  }

  if (document.documentElement.dataset.topLoadingBarBound !== 'true') {
    document.documentElement.dataset.topLoadingBarBound = 'true';
    document.addEventListener('astro:before-preparation', start);
    document.addEventListener('astro:after-preparation', finish);
    document.addEventListener('astro:page-load', finish);
    // `pagehide` also fires when the page enters the back/forward cache, where
    // the bar must not be left in a visible state.
    window.addEventListener('pagehide', reset);
  }
</script>