---
// TopLoadingBar: RTL-aware, persistent ClientRouter transition progress bar
---

<div dir="ltr"
  id="nprogress"
  transition:persist="top-loading-bar"
  aria-hidden="true"
></div>

<style is:global>
  #nprogress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: #0969da;
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.5 ease, opacity .3s ease;
    z-index: 999999;
    opacity: 0;
    pointer-events: none;
  }
  #nprogress.loading {
    opacity: 1;
  }
  #nprogress.done {
    transform: scaleX(1);
  }
</style>

<script>
  const THRESHOLD = 5; // ms – bar only shows if navigation takes longer than this
  const TRICKLE_INTERVAL = 10;

  let showTimer: number | null = null;
  let trickleTimer: number | null = null;
  let progress = 0;
  let isActive = false;

  const bar = () => document.getElementById("nprogress")!;

  function start() {
    // Cancel any previous timers
    if (showTimer) clearTimeout(showTimer);
    if (trickleTimer) clearInterval(trickleTimer);

    progress = 0;
    isActive = false;

    // Fake debounce: only show the bar after THRESHOLD ms
    showTimer = window.setTimeout(() => {
      isActive = true;
      const el = bar();
      el.classList.add("loading");
      el.classList.remove("done");
      el.style.opacity = "1";
      el.style.transform = "scaleX(0.02)"; // tiny initial progress

      // Realistic trickle
      trickleTimer = window.setInterval(() => {
        // Slow down as we get closer to 90%
        const remaining = 90 - progress;
        const increment = Math.random() * Math.max(remaining * 0.15, 1.5);
        progress = Math.min(progress + increment, 90);
        el.style.transform = `scaleX(${progress / 100})`;
      }, TRICKLE_INTERVAL);
    }, THRESHOLD);
  }

  function finish() {
    if (showTimer) {
      clearTimeout(showTimer);
      showTimer = null;
    }
    if (trickleTimer) {
      clearInterval(trickleTimer);
      trickleTimer = null;
    }

    // If the bar never appeared (fast navigation), do nothing
    if (!isActive) return;

    const el = bar();
    el.classList.add("done");
    el.style.transform = "scaleX(1)";

    // Let the completion animation play, then reset
    setTimeout(() => {
      el.classList.remove("loading", "done");
      el.style.transform = "scaleX(0)";
      el.style.opacity = "0";
      isActive = false;
      progress = 0;
    }, 320);
  }

  document.addEventListener("astro:before-preparation", start);
  document.addEventListener("astro:after-preparation", finish);
</script>