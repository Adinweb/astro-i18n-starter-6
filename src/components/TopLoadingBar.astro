---
// TopLoadingBar: persistent ClientRouter transition progress bar.
// The bar intentionally keeps a left-to-right fill inside dir="ltr" so the
// progress direction is identical in RTL and LTR documents.
---

<div dir="ltr"
  id="nprogress"
  transition:persist="top-loading-bar"
  aria-hidden="true"
></div>

<style is:global>
  #nprogress {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: 100%;
    height: 3px;
    background: var(--color-primary, #4338ca);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
    z-index: 999999;
    opacity: 0;
    pointer-events: none;
  }

  #nprogress.loading {
    opacity: 1;
  }

  #nprogress.done {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    #nprogress {
      transition: opacity 0.1s linear;
    }
  }
</style>

<script>
  const SHOW_DELAY_MS = 120;
  const TRICKLE_INTERVAL_MS = 180;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let showTimer: number | null = null;
  let trickleTimer: number | null = null;
  let progress = 0;
  let isActive = false;

  function clearTimers() {
    if (showTimer !== null) {
      clearTimeout(showTimer);
      showTimer = null;
    }
    if (trickleTimer !== null) {
      clearInterval(trickleTimer);
      trickleTimer = null;
    }
  }

  function start() {
    clearTimers();
    isActive = false;
    progress = 0;

    const el = document.getElementById('nprogress');
    if (!el) return;
    el.classList.remove('loading', 'done');
    el.style.transform = 'scaleX(0)';
    el.style.opacity = '0';

    if (prefersReducedMotion) return;

    showTimer = window.setTimeout(() => {
      showTimer = null;
      const bar = document.getElementById('nprogress');
      if (!bar) return;

      isActive = true;
      bar.classList.add('loading');
      bar.style.opacity = '1';
      bar.style.transform = 'scaleX(0.08)';

      trickleTimer = window.setInterval(() => {
        const remaining = 90 - progress;
        progress = Math.min(progress + Math.random() * Math.max(remaining * 0.12, 1), 90);
        bar.style.transform = `scaleX(${progress / 100})`;
      }, TRICKLE_INTERVAL_MS);
    }, SHOW_DELAY_MS);
  }

  function finish() {
    clearTimers();

    if (!isActive) return;
    isActive = false;

    const bar = document.getElementById('nprogress');
    if (!bar) return;

    bar.classList.add('done');
    bar.style.transform = 'scaleX(1)';

    window.setTimeout(() => {
      bar.classList.remove('loading', 'done');
      bar.style.transform = 'scaleX(0)';
      bar.style.opacity = '0';
      progress = 0;
    }, prefersReducedMotion ? 0 : 280);
  }

  if (document.documentElement.dataset.topLoadingBarBound !== 'true') {
    document.documentElement.dataset.topLoadingBarBound = 'true';
    document.addEventListener('astro:before-preparation', start);
    document.addEventListener('astro:after-preparation', finish);
    document.addEventListener('astro:page-load', finish);
    window.addEventListener('pagehide', finish);
  }
</script>