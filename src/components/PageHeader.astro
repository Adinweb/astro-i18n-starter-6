---
/**
 * Clean typographic page header (`hero: "minimal"`) without a blurred background
 * photograph band. Composable via `PageView.astro` frontmatter (`hero: "minimal"`)
 * or imported directly inside custom MDX / Astro pages.
 */
import Icon from '@/components/Icon.astro';
import type { Locale } from '@/i18n/locales';
import { HERO_TITLE_ID } from '@/libs/config/app';
import type { BreadcrumbItem } from '@/libs/content/service';
import * as m from '@/paraglide/messages';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  breadcrumbs?: BreadcrumbItem[];
  kicker?: string;
  align?: 'start' | 'center';
  class?: string;
}

const {
  title,
  description,
  locale,
  breadcrumbs = [],
  kicker,
  align = 'start',
  class: className,
} = Astro.props;

const isCentered = align === 'center';
---

<header
  aria-labelledby={HERO_TITLE_ID}
  data-page-header
  data-trig
  class:list={[
    'border-b border-border pb-8 sm:pb-10',
    isCentered && 'text-center',
    className,
  ]}
>
  {
    breadcrumbs.length > 1 && (
      <nav
        aria-label={m.common_breadcrumbs({}, { locale })}
        class:list={[
          'mb-4 flex flex-wrap items-center gap-1.5 text-xs text-muted print:hidden',
          isCentered && 'justify-center',
        ]}
      >
        {breadcrumbs.map((crumb, index) => {
          const isLast = index === breadcrumbs.length - 1;
          return (
            <>
              {index > 0 && (
                <Icon
                  name="chevron-right"
                  size={12}
                  class="shrink-0 opacity-50 rtl:rotate-180"
                />
              )}
              {isLast ? (
                <span class="font-medium text-fg" aria-current="page">
                  {crumb.label}
                </span>
              ) : (
                <a
                  href={crumb.href}
                  class="transition-colors hover:text-primary"
                >
                  {crumb.label}
                </a>
              )}
            </>
          );
        })}
      </nav>
    )
  }

  {
    kicker ? (
      <p class="section-kicker mb-3">{kicker}</p>
    ) : (
      <span
        class:list={[
          'mb-4 block h-1 w-10 rounded-full bg-primary',
          isCentered && 'mx-auto',
        ]}
        aria-hidden="true"
      />
    )
  }

  <h1
    id={HERO_TITLE_ID}
    class="text-balance text-3xl font-extrabold leading-[1.12] tracking-tight text-fg sm:text-4xl lg:text-5xl"
  >
    {title}
  </h1>

  {
    description && (
      <p
        class:list={[
          'mt-4 max-w-3xl text-pretty text-base leading-relaxed text-muted sm:text-lg',
          isCentered && 'mx-auto',
        ]}
      >
        {description}
      </p>
    )
  }

  <slot />
</header>
