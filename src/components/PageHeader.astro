---
/**
 * Clean typographic page header (`hero: "minimal"`) without a blurred background
 * photograph band. Composable via `PageView.astro` frontmatter (`hero: "minimal"`)
 * or imported directly inside custom MDX / Astro pages.
 */
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import type { Locale } from '@/i18n/locales';
import { HERO_TITLE_ID } from '@/libs/config/app';
import type { BreadcrumbItem } from '@/libs/content/service';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  breadcrumbs?: BreadcrumbItem[];
  kicker?: string;
  align?: 'start' | 'center';
  headingTag?: 'h1' | 'h2';
  class?: string;
}

const {
  title,
  description,
  locale,
  breadcrumbs = [],
  kicker,
  align = 'start',
  headingTag = 'h1',
  class: className,
} = Astro.props;

const isCentered = align === 'center';
const titleId = headingTag === 'h1' ? HERO_TITLE_ID : undefined;
---

<header
  aria-labelledby={titleId}
  data-page-header
  data-trig-stagger
  data-trig-stagger-mode="linear"
  data-trig-stagger-delay="0.1"
  data-trig-once="true"
  class:list={[
    'border-b border-border pb-8 sm:pb-10',
    isCentered && 'text-center',
    className,
  ]}
>
  {
    breadcrumbs.length > 1 && (
      <Breadcrumbs
        items={breadcrumbs}
        locale={locale}
        separator="chevron"
        showHomeIcon={true}
        size="sm"
        align={align}
        class="mb-4 print:hidden"
      />
    )
  }

  {
    kicker ? (
      <p class="section-kicker mb-3">{kicker}</p>
    ) : (
      <span
        class:list={[
          'mb-4 block h-1 w-10 rounded-full bg-primary',
          isCentered && 'mx-auto',
        ]}
        aria-hidden="true"
      />
    )
  }

  {
    headingTag === 'h2' ? (
      <h2 class="text-balance text-3xl font-extrabold leading-[1.12] tracking-tight text-fg sm:text-4xl lg:text-5xl">
        {title}
      </h2>
    ) : (
      <h1
        id={titleId}
        class="text-balance text-3xl font-extrabold leading-[1.12] tracking-tight text-fg sm:text-4xl lg:text-5xl"
      >
        {title}
      </h1>
    )
  }

  {
    description && (
      <p
        class:list={[
          'mt-4 max-w-4xl text-pretty text-base leading-relaxed text-muted sm:text-lg',
          isCentered && 'mx-auto',
        ]}
      >
        {description}
      </p>
    )
  }

  <slot />
</header>
