---
/**
 * Inner content for the hero band of a blog post: breadcrumbs, category links,
 * the post heading, its description and the publication meta row.
 *
 * The heading and description come from the shared `HeroCopy`, so a post and a
 * page never drift apart typographically. Rendered inside `PageHero`'s default
 * slot, on top of the section's background image.
 */
import HeroCopy from '@/components/HeroCopy.astro';
import { getBlogIndexHref, type BreadcrumbItem } from '@/libs/content/service';
import { buildBlogFilterQuery, getReadingTime } from '@/libs/content/blog';
import { getCategoryLabel } from '@/libs/content/taxonomy';
import type { Locale } from '@/i18n/config';
import * as m from '@/paraglide/messages';

interface Props {
  /** Rendered as the hero's single `<h1>`. */
  title: string;
  description?: string;
  locale: Locale;
  categories: string[];
  author?: string;
  /** Raw markdown body, used to derive the reading time. */
  body?: string;
  publishedAt: Date;
  breadcrumbs: BreadcrumbItem[];
}

const {
  title,
  description,
  locale,
  categories,
  author,
  body,
  publishedAt,
  breadcrumbs,
} = Astro.props;

const blogIndexHref = getBlogIndexHref(locale);
const categoryHref = (category: string) =>
  `${blogIndexHref}${buildBlogFilterQuery({ category, tags: [] })}`;

const formattedDate = publishedAt.toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const readingTime = getReadingTime(body);
---

<HeroCopy title={title} description={description} size="post">
  <Fragment slot="prelude">
    <nav aria-label={m.common_breadcrumbs({}, { locale })}>
      <ol class="flex flex-wrap items-center gap-2 text-xs text-white/90 drop-shadow-[0_1px_8px_rgb(0_0_0/0.5)]">
        {
          breadcrumbs.map((crumb, index) => (
            <li class="flex items-center gap-2">
              {index > 0 && <span aria-hidden="true">/</span>}
              {index === breadcrumbs.length - 1 ? (
                <span class="max-w-xs truncate font-medium text-white">{crumb.label}</span>
              ) : (
                <a href={crumb.href} class="transition-colors hover:text-white">
                  {crumb.label}
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    {
      categories.length > 0 && (
        <ul class="mt-4 flex flex-wrap items-center gap-2">
          {categories.map((category) => (
            <li>
              <a
                href={categoryHref(category)}
                class="inline-flex items-center rounded-full border border-white/25 bg-white/15 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-white backdrop-blur-sm transition-colors hover:bg-white/25"
              >
                {getCategoryLabel(category, locale)}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </Fragment>

  <div slot="default" class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/90 drop-shadow-[0_1px_8px_rgb(0_0_0/0.5)]">
    <span>{m.common_published_on({}, { locale })}</span>
    <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
    <span aria-hidden="true">·</span>
    <span>{m.blog_read_time({ count: readingTime }, { locale })}</span>
    {
      author && (
        <>
          <span aria-hidden="true">·</span>
          <span>{author}</span>
        </>
      )
    }
  </div>
</HeroCopy>
