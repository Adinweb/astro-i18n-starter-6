---
import * as m from '@/paraglide/messages';
import Icon from '@/components/Icon.astro';
import IconButton from '@/components/IconButton.astro';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<dialog
  id="search-dialog"
  data-search-modal
  data-locale={locale}
  data-no-results={m.common_no_results({}, { locale })}
  data-placeholder={m.common_type_to_search({}, { locale })}
  aria-labelledby="search-modal-title"
  class="m-auto w-[calc(100%-2rem)] max-w-xl overflow-hidden rounded-xl border border-border bg-surface p-0 text-fg shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-xs"
>
  <div class="flex max-h-[70vh] flex-col">
    <h2 id="search-modal-title" class="sr-only">
      {m.common_search_placeholder({}, { locale })}
    </h2>

    <div class="flex items-center gap-3 border-b border-border px-4 py-3">
      <Icon name="search" size={20} class="shrink-0 text-muted" />
      <input
        id="search-input"
        type="search"
        placeholder={m.common_search_placeholder({}, { locale })}
        class="w-full bg-transparent text-base text-fg placeholder:text-muted focus:outline-none"
        autocomplete="off"
        aria-label={m.common_search_placeholder({}, { locale })}
      />
      <IconButton
        id="search-close-btn"
        icon="close"
        size={18}
        variant="ghost"
        label={m.common_close({}, { locale })}
      />
    </div>

    <div
      id="search-results"
      class="flex min-h-30 flex-col gap-2 overflow-y-auto p-4"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      <p class="py-6 text-center text-sm text-muted" id="search-placeholder-msg">
        {m.common_type_to_search({}, { locale })}
      </p>
    </div>

    <div class="flex items-center justify-between border-t border-border bg-bg/50 px-4 py-2 text-xs text-muted">
      <span>
        <kbd class="rounded border border-border bg-surface px-1.5 py-0.5">ESC</kbd>
        {m.common_press_esc({}, { locale })}
      </span>
      <span><kbd class="rounded border border-border bg-surface px-1.5 py-0.5">⌘K</kbd></span>
    </div>
  </div>
</dialog>

<script>
  interface SearchItem {
    title: string;
    description: string;
    url: string;
    locale: string;
  }

  let searchData: SearchItem[] = [];
  let isFetchingDevIndex = false;
  let pagefindPromise: Promise<any> | null = null;
  let searchTimeout: ReturnType<typeof setTimeout> | null = null;
  let searchRequestId = 0;

  function getDialog() {
    return document.querySelector<HTMLDialogElement>('[data-search-modal]');
  }

  function getResults() {
    return document.getElementById('search-results');
  }

  function setMessage(text: string) {
    const container = getResults();
    if (!container) return;
    container.replaceChildren();
    const message = document.createElement('p');
    message.className = 'py-6 text-center text-sm text-muted';
    message.textContent = text;
    container.append(message);
  }

  function createResultLink(href: string, title: string, excerpt: string) {
    const link = document.createElement('a');
    link.href = href;
    link.className =
      'block rounded-lg border border-transparent p-3 transition-colors hover:border-border hover:bg-surface-hover';

    const heading = document.createElement('div');
    heading.className = 'text-sm font-medium text-fg';
    heading.textContent = title;
    link.append(heading);

    if (excerpt) {
      const description = document.createElement('p');
      description.className = 'mt-1 line-clamp-2 text-xs text-muted';
      description.textContent = excerpt;
      link.append(description);
    }

    return link;
  }

  /** Pagefind excerpts contain markup; keep only the text for safe DOM rendering. */
  function plainText(html: string) {
    const container = document.createElement('div');
    container.innerHTML = html;
    return container.textContent ?? '';
  }

  async function getPagefindInstance() {
    if (!pagefindPromise) {
      const pagefindUrl = '/pagefind/pagefind.js';
      pagefindPromise = (async () => {
        const mod = await import(/* @vite-ignore */ pagefindUrl);
        await mod.init();
        return mod;
      })().catch((error) => {
        pagefindPromise = null;
        throw error;
      });
    }
    return pagefindPromise;
  }

  function resetSearch(dialog: HTMLDialogElement) {
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    if (input) input.value = '';
    setMessage(dialog.dataset.placeholder || 'Type to search...');
  }

  function setupSearch() {
    const dialog = getDialog();
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const closeBtn = document.getElementById('search-close-btn');
    const resultsContainer = getResults();

    if (!dialog || !input || !resultsContainer) return;
    if (dialog.dataset.bound === 'true') return;

    const modal: HTMLDialogElement = dialog;
    const searchInput: HTMLInputElement = input;
    const resultsEl: HTMLElement = resultsContainer;
    modal.dataset.bound = 'true';

    closeBtn?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (event) => {
      // The dialog element itself is only the backdrop area outside the panel.
      if (event.target === modal) modal.close();
    });
    modal.addEventListener('close', () => resetSearch(modal));
    modal.addEventListener('cancel', () => resetSearch(modal));

    resultsEl.addEventListener('click', (event) => {
      if ((event.target as HTMLElement)?.closest('a')) modal.close();
    });

    async function performSearch(query: string) {
      const activeLocale = modal.dataset.locale || 'en';
      const requestId = ++searchRequestId;

      if (!query.trim()) {
        setMessage(modal.dataset.placeholder || 'Type to search...');
        return;
      }

      if (import.meta.env.PROD) {
        try {
          const pagefind = await getPagefindInstance();
          const search = await pagefind.search(query);
          const pagefindResults = await Promise.all(
            search.results.slice(0, 6).map((result: any) => result.data())
          );

          if (requestId !== searchRequestId) return;

          if (pagefindResults.length === 0) {
            setMessage(modal.dataset.noResults || 'No results');
            return;
          }

          resultsEl.replaceChildren(
            ...pagefindResults.map((result: any) =>
              createResultLink(
                result.url,
                result.meta?.title || result.url,
                plainText(result.excerpt || '')
              )
            )
          );
          return;
        } catch {
          // Pagefind is unavailable (for example on an unindexed preview); use
          // the dev index below as a graceful fallback.
        }
      }

      if (searchData.length === 0 && !isFetchingDevIndex) {
        isFetchingDevIndex = true;
        try {
          const response = await fetch('/api/search-dev.json');
          if (!response.ok) throw new Error(`Search index responded ${response.status}`);
          searchData = await response.json();
        } catch {
          searchData = [];
        } finally {
          isFetchingDevIndex = false;
        }
      }

      if (requestId !== searchRequestId) return;

      const normalized = query.trim().toLowerCase();
      const filtered = searchData
        .filter((item) => item.locale === activeLocale)
        .filter(
          (item) =>
            item.title.toLowerCase().includes(normalized) ||
            item.description.toLowerCase().includes(normalized)
        )
        .slice(0, 6);

      if (filtered.length === 0) {
        setMessage(modal.dataset.noResults || 'No results');
        return;
      }

      resultsEl.replaceChildren(
        ...filtered.map((item) => createResultLink(item.url, item.title, item.description))
      );
    }

    searchInput.addEventListener('input', () => {
      const value = searchInput.value;
      if (searchTimeout) clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => performSearch(value), 150);
    });

    if (document.documentElement.dataset.searchShortcutsBound !== 'true') {
      document.documentElement.dataset.searchShortcutsBound = 'true';

      document.addEventListener('click', (event) => {
        if ((event.target as HTMLElement)?.closest('[data-open-search]')) {
          const current = getDialog();
          if (!current) return;
          current.showModal();
          requestAnimationFrame(() => {
            document.getElementById('search-input')?.focus();
          });
        }
      });

      window.addEventListener('keydown', (event) => {
        const current = getDialog();
        if (!current) return;

        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          if (current.open) {
            current.close();
          } else {
            current.showModal();
            requestAnimationFrame(() => {
              document.getElementById('search-input')?.focus();
            });
          }
        }
      });
    }
  }

  setupSearch();
  document.addEventListener('astro:page-load', setupSearch);
</script>
