---
import * as m from '@/paraglide/messages';
import Icon from '@/components/ui/Icon.astro';
import IconButton from '@/components/ui/IconButton.astro';
import Kbd from '@/components/ui/Kbd.astro';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<dialog
  id="search-dialog"
  data-search-modal
  data-lenis-prevent
  data-locale={locale}
  data-no-results={m.common_no_results({}, { locale })}
  data-placeholder={m.common_type_to_search({}, { locale })}
  data-results-count={m.common_search_results_count({ count: '{count}' }, { locale })}
  aria-labelledby="search-modal-title"
  class="m-auto w-[calc(100%-2rem)] max-w-xl overflow-hidden rounded-xl border border-border bg-surface p-0 text-fg shadow-2xl backdrop:bg-scrim backdrop:backdrop-blur-xs"
>
  <div class="flex max-h-[70vh] flex-col">
    <h2 id="search-modal-title" class="sr-only">
      {m.common_search_placeholder({}, { locale })}
    </h2>

    <div class="flex items-center gap-3 border-b border-border px-4 py-3">
      <Icon name="search" size={20} class="shrink-0 text-muted" />
      <input
        id="search-input"
        type="search"
        placeholder={m.common_search_placeholder({}, { locale })}
        class="w-full bg-transparent text-base text-fg placeholder:text-muted focus:outline-none"
        autocomplete="off"
        aria-label={m.common_search_placeholder({}, { locale })}
      />
      <IconButton
        id="search-close-btn"
        icon="close"
        size={18}
        variant="ghost"
        label={m.common_close({}, { locale })}
      />
    </div>

    <div
      id="search-status"
      class="sr-only"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></div>

    <div
      id="search-results"
      data-lenis-prevent
      class="flex min-h-30 flex-col gap-2 overflow-y-auto p-4"
    >
      <p class="py-6 text-center text-sm text-muted" id="search-placeholder-msg">
        {m.common_type_to_search({}, { locale })}
      </p>
    </div>

    <div class="flex items-center justify-between border-t border-border bg-bg/50 px-4 py-2 text-xs text-muted">
      <span class="inline-flex items-center gap-1.5">
        <Kbd as="kbd" variant="default" size="xs">ESC</Kbd>
        <span id="search-esc-hint">{m.common_press_esc({}, { locale })}</span>
      </span>
      <Kbd as="kbd" variant="default" size="xs">⌘K</Kbd>
    </div>
  </div>
</dialog>

<script>
  import { bindSearchWidget, type SearchWidgetController } from '@/libs/search/widget';

  const modalControllers = new WeakMap<HTMLDialogElement, SearchWidgetController>();

  function getDialog() {
    return document.querySelector<HTMLDialogElement>('[data-search-modal]');
  }

  function openSearchModal() {
    const current = getDialog();
    if (!current) return;
    current.showModal();
    requestAnimationFrame(() => {
      document.getElementById('search-input')?.focus();
    });
  }

  function setupSearch() {
    const dialog = getDialog();
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const closeBtn = document.getElementById('search-close-btn');
    const resultsContainer = document.getElementById('search-results');
    const statusElement = document.getElementById('search-status');

    if (!dialog || !input || !resultsContainer) return;
    if (dialog.dataset.bound === 'true') return;

    const modal: HTMLDialogElement = dialog;
    modal.dataset.bound = 'true';

    const widget = bindSearchWidget({
      root: modal,
      input,
      resultsContainer,
      statusElement,
      maxResults: 6,
      enableKeyboard: true,
      messageClass: 'py-6 text-center text-sm text-muted',
      linkClass:
        'block rounded-lg border border-transparent p-3 transition-colors hover:border-border hover:bg-surface-hover',
      excerptClass: 'mt-1 line-clamp-2 text-xs text-muted',
      onSelectResult: () => modal.close(),
    });
    modalControllers.set(modal, widget);

    closeBtn?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (event) => {
      if (event.target === modal) modal.close();
    });
    modal.addEventListener('close', () => widget.reset());
    modal.addEventListener('cancel', () => widget.reset());

    if (document.documentElement.dataset.searchShortcutsBound !== 'true') {
      document.documentElement.dataset.searchShortcutsBound = 'true';

      document.addEventListener('click', (event) => {
        if ((event.target as HTMLElement)?.closest('[data-open-search]')) {
          openSearchModal();
        }
      });

      window.addEventListener('keydown', (event) => {
        const current = getDialog();
        if (!current) return;

        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          if (current.open) {
            current.close();
          } else {
            openSearchModal();
          }
        }
      });
    }
  }

  setupSearch();
  document.addEventListener('astro:page-load', setupSearch);
</script>
