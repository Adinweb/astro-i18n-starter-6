---
import * as m from '@/paraglide/messages';
import Icon from '@/components/Icon.astro';
import IconButton from '@/components/IconButton.astro';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<dialog
  id="search-dialog"
  data-search-modal
  data-lenis-prevent
  data-locale={locale}
  data-no-results={m.common_no_results({}, { locale })}
  data-placeholder={m.common_type_to_search({}, { locale })}
  aria-labelledby="search-modal-title"
  class="m-auto w-[calc(100%-2rem)] max-w-xl overflow-hidden rounded-xl border border-border bg-surface p-0 text-fg shadow-2xl backdrop:bg-scrim backdrop:backdrop-blur-xs"
>
  <div class="flex max-h-[70vh] flex-col">
    <h2 id="search-modal-title" class="sr-only">
      {m.common_search_placeholder({}, { locale })}
    </h2>

    <div class="flex items-center gap-3 border-b border-border px-4 py-3">
      <Icon name="search" size={20} class="shrink-0 text-muted" />
      <input
        id="search-input"
        type="search"
        placeholder={m.common_search_placeholder({}, { locale })}
        class="w-full bg-transparent text-base text-fg placeholder:text-muted focus:outline-none"
        autocomplete="off"
        aria-label={m.common_search_placeholder({}, { locale })}
      />
      <IconButton
        id="search-close-btn"
        icon="close"
        size={18}
        variant="ghost"
        label={m.common_close({}, { locale })}
      />
    </div>

    <div
      id="search-results"
      data-lenis-prevent
      class="flex min-h-30 flex-col gap-2 overflow-y-auto p-4"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      <p class="py-6 text-center text-sm text-muted" id="search-placeholder-msg">
        {m.common_type_to_search({}, { locale })}
      </p>
    </div>

    <div class="flex items-center justify-between border-t border-border bg-bg/50 px-4 py-2 text-xs text-muted">
      <span>
        <kbd class="rounded border border-border bg-surface px-1.5 py-0.5">ESC</kbd>
        <span id="search-esc-hint">{m.common_press_esc({}, { locale })}</span>
      </span>
      <span><kbd class="rounded border border-border bg-surface px-1.5 py-0.5">⌘K</kbd></span>
    </div>
  </div>
</dialog>

<script>
  import { executeSearch } from '@/libs/search/client';

  let searchTimeout: ReturnType<typeof setTimeout> | null = null;
  let searchRequestId = 0;

  function getDialog() {
    return document.querySelector<HTMLDialogElement>('[data-search-modal]');
  }

  function getResults() {
    return document.getElementById('search-results');
  }

  let activeIndex = -1;

  function setMessage(text: string) {
    activeIndex = -1;
    const container = getResults();
    if (!container) return;
    container.replaceChildren();
    const message = document.createElement('p');
    message.className = 'py-6 text-center text-sm text-muted';
    message.textContent = text;
    container.append(message);
  }

  function getResultLinks(): HTMLAnchorElement[] {
    const container = getResults();
    return container
      ? [...container.querySelectorAll<HTMLAnchorElement>('a[data-search-result]')]
      : [];
  }

  function highlightResult(index: number) {
    const links = getResultLinks();
    if (links.length === 0) {
      activeIndex = -1;
      return;
    }
    const clamped = ((index % links.length) + links.length) % links.length;
    activeIndex = clamped;
    links.forEach((link, idx) => {
      const active = idx === clamped;
      link.dataset.active = active ? 'true' : 'false';
      link.classList.toggle('border-primary/50', active);
      link.classList.toggle('bg-surface-hover', active);
      link.classList.toggle('border-transparent', !active);
      if (active) link.scrollIntoView({ block: 'nearest' });
    });
  }

  function createResultLink(href: string, title: string, excerpt: string, index: number) {
    const link = document.createElement('a');
    link.href = href;
    link.dataset.searchResult = String(index);
    link.className =
      'block rounded-lg border border-transparent p-3 transition-colors hover:border-border hover:bg-surface-hover';

    const heading = document.createElement('div');
    heading.className = 'text-sm font-medium text-fg';
    heading.textContent = title;
    link.append(heading);

    if (excerpt) {
      const description = document.createElement('p');
      description.className = 'mt-1 line-clamp-2 text-xs text-muted';
      description.textContent = excerpt;
      link.append(description);
    }

    link.addEventListener('mouseenter', () => {
      highlightResult(index);
    });

    return link;
  }

  function resetSearch(dialog: HTMLDialogElement) {
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    if (input) input.value = '';
    setMessage(dialog.dataset.placeholder || 'Type to search...');
  }

  function setupSearch() {
    const dialog = getDialog();
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const closeBtn = document.getElementById('search-close-btn');
    const resultsContainer = getResults();

    if (!dialog || !input || !resultsContainer) return;
    if (dialog.dataset.bound === 'true') return;

    const modal: HTMLDialogElement = dialog;
    const searchInput: HTMLInputElement = input;
    const resultsEl: HTMLElement = resultsContainer;
    modal.dataset.bound = 'true';

    closeBtn?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (event) => {
      // The dialog element itself is only the backdrop area outside the panel.
      if (event.target === modal) modal.close();
    });
    modal.addEventListener('close', () => resetSearch(modal));
    modal.addEventListener('cancel', () => resetSearch(modal));

    resultsEl.addEventListener('click', (event) => {
      if ((event.target as HTMLElement)?.closest('a')) modal.close();
    });

    async function performSearch(query: string) {
      const activeLocale = modal.dataset.locale || 'en';
      const requestId = ++searchRequestId;

      if (!query.trim()) {
        setMessage(modal.dataset.placeholder || 'Type to search...');
        return;
      }

      const results = await executeSearch(query, activeLocale);
      if (requestId !== searchRequestId) return;

      if (results.length === 0) {
        setMessage(modal.dataset.noResults || 'No results');
        return;
      }

      resultsEl.replaceChildren(
        ...results.slice(0, 6).map((result, idx) =>
          createResultLink(result.url, result.title, result.excerpt, idx)
        )
      );
      highlightResult(0);
    }

    searchInput.addEventListener('input', () => {
      const value = searchInput.value;
      if (searchTimeout) clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => performSearch(value), 150);
    });

    searchInput.addEventListener('keydown', (event) => {
      const links = getResultLinks();
      if (links.length === 0) return;

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        highlightResult(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        highlightResult(activeIndex <= 0 ? links.length - 1 : activeIndex - 1);
      } else if (event.key === 'Enter' && activeIndex >= 0 && links[activeIndex]) {
        event.preventDefault();
        const targetLink = links[activeIndex];
        modal.close();
        targetLink.click();
      }
    });

    if (document.documentElement.dataset.searchShortcutsBound !== 'true') {
      document.documentElement.dataset.searchShortcutsBound = 'true';

      document.addEventListener('click', (event) => {
        if ((event.target as HTMLElement)?.closest('[data-open-search]')) {
          const current = getDialog();
          if (!current) return;
          current.showModal();
          requestAnimationFrame(() => {
            document.getElementById('search-input')?.focus();
          });
        }
      });

      window.addEventListener('keydown', (event) => {
        const current = getDialog();
        if (!current) return;

        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          if (current.open) {
            current.close();
          } else {
            current.showModal();
            requestAnimationFrame(() => {
              document.getElementById('search-input')?.focus();
            });
          }
        }
      });
    }
  }

  setupSearch();
  document.addEventListener('astro:page-load', setupSearch);
</script>
