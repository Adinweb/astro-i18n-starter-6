---
/**
 * Composable customer testimonial grid inspired by PrebuiltUI testimonial cards,
 * using OKLCH semantic tokens, CSS logical spacing, Tabler rating/quote icons,
 * optional optimized `<Image>` avatars, shared initials fallback, and ChronoTrig
 * staggered reveals. Accepts optional props with full localized defaults.
 */
import ResponsiveImage from '@/components/ui/ResponsiveImage.astro';
import PageSection from '@/components/PageSection.astro';
import Card from '@/components/ui/Card.astro';
import IconBox from '@/components/ui/IconBox.astro';
import RatingStars from '@/components/ui/RatingStars.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import type { Locale } from '@/i18n/locales';
import type { ContentImage } from '@/libs/content/media';
import { getInitials } from '@/libs/ui/initials';
import { resolveComponentLocale, resolveOptionalHeader } from '@/libs/ui/locale';
import * as m from '@/paraglide/messages';

export interface TestimonialItem {
  quote: string;
  author: string;
  role?: string;
  company?: string;
  rating?: number;
  avatar?: ContentImage;
  avatarAlt?: string;
}

interface Props {
  id?: string;
  eyebrow?: string | null;
  heading?: string | null;
  subheading?: string | null;
  items?: readonly TestimonialItem[];
  locale?: Locale | string;
  contained?: boolean;
  surface?: 'default' | 'surface' | 'subtle';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  id,
  eyebrow,
  heading,
  subheading,
  items,
  locale,
  contained = false,
  surface = 'surface',
  spacing = 'md',
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = items === undefined;

const resolvedEyebrow = resolveOptionalHeader(
  eyebrow,
  usingDefaults,
  m.block_testimonials_eyebrow({}, { locale: activeLocale })
);
const resolvedHeading = resolveOptionalHeader(
  heading,
  usingDefaults,
  m.block_testimonials_heading({}, { locale: activeLocale })
);
const resolvedSubheading = resolveOptionalHeader(
  subheading,
  usingDefaults,
  m.block_testimonials_subheading({}, { locale: activeLocale })
);

const resolvedItems: readonly TestimonialItem[] = items ?? [
  {
    quote: m.block_testimonials_1_quote({}, { locale: activeLocale }),
    author: m.block_testimonials_1_author({}, { locale: activeLocale }),
    role: m.block_testimonials_1_role({}, { locale: activeLocale }),
    rating: 5,
  },
  {
    quote: m.block_testimonials_2_quote({}, { locale: activeLocale }),
    author: m.block_testimonials_2_author({}, { locale: activeLocale }),
    role: m.block_testimonials_2_role({}, { locale: activeLocale }),
    rating: 5,
  },
  {
    quote: m.block_testimonials_3_quote({}, { locale: activeLocale }),
    author: m.block_testimonials_3_author({}, { locale: activeLocale }),
    role: m.block_testimonials_3_role({}, { locale: activeLocale }),
    rating: 5,
  },
];

const hasHeader = Boolean(resolvedEyebrow || resolvedHeading || resolvedSubheading);
const cardVariant = !contained && surface === 'surface' ? 'default' : 'surface';
const gridColsClass =
  resolvedItems.length <= 2 ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3';
---

<PageSection
  id={id}
  surface={contained ? 'default' : surface}
  spacing={contained ? 'none' : spacing}
  bleed={contained}
  class={contained ? 'not-prose my-10' : undefined}
>
  <SectionHeader
    eyebrow={resolvedEyebrow}
    heading={resolvedHeading}
    subheading={resolvedSubheading}
  />

  <div
    class:list={[
      'grid gap-6',
      hasHeader && 'mt-8',
      gridColsClass,
    ]}
    data-trig-stagger
    data-trig-stagger-mode="linear"
    data-trig-stagger-delay="0.06"
    data-trig-once="true"
  >
    {
      resolvedItems.map((item) => {
        const ratingValue =
          item.rating !== undefined ? Math.min(5, Math.max(1, Math.round(item.rating))) : null;
        const metaLine = [item.role, item.company].filter(Boolean).join(' · ');

        return (
          <div data-trig class="flex">
            <Card
              as="figure"
              variant={cardVariant}
              padding="lg"
              radius="2xl"
              hover
              class="flex w-full flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between gap-3">
                  {ratingValue !== null ? (
                    <RatingStars
                      rating={ratingValue}
                      size={16}
                      tone="warning"
                      locale={activeLocale}
                    />
                  ) : (
                    <span />
                  )}

                  <IconBox icon="quote" size="xs" radius="lg" tone="primary" iconSize={16} class="size-8" />
                </div>

                <blockquote class="mt-4 text-sm leading-relaxed text-fg sm:text-base">
                  {item.quote}
                </blockquote>
              </div>

              <figcaption class="mt-6 flex items-center gap-3 border-t border-border pt-4">
                {item.avatar ? (
                  <ResponsiveImage
                    src={item.avatar}
                    alt={item.avatarAlt ?? item.author}
                    widths={[80, 160]}
                    sizes="40px"
                    loading="lazy"
                    class="size-10 shrink-0 rounded-full border border-border object-cover"
                  />
                ) : (
                  <span
                    aria-hidden="true"
                    class="inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-primary/25 bg-primary/10 text-xs font-bold text-primary"
                  >
                    {getInitials(item.author)}
                  </span>
                )}

                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold text-fg">{item.author}</p>
                  {metaLine && <p class="truncate text-xs text-muted">{metaLine}</p>}
                </div>
              </figcaption>
            </Card>
          </div>
        );
      })
    }
  </div>
</PageSection>
