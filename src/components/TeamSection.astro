---
/**
 * Composable team / leadership grid inspired by PrebuiltUI team sections.
 * Supports optimized `<Image>` portraits or clean semantic initials frames,
 * localized typography, and RTL-safe social/profile links via `<Icon>`.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@/components/Icon.astro';
import PageSection from '@/components/PageSection.astro';

export interface TeamLink {
  label: string;
  href: string;
  icon?: string;
  external?: boolean;
}

export interface TeamMember {
  name: string;
  role: string;
  bio?: string;
  avatar?: ImageMetadata;
  avatarAlt?: string;
  links?: readonly TeamLink[];
}

interface Props {
  id?: string;
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  members: readonly TeamMember[];
  surface?: 'default' | 'surface' | 'subtle';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  id,
  eyebrow,
  heading,
  subheading,
  members,
  surface = 'default',
  spacing = 'md',
} = Astro.props;

const cardSurface = surface === 'surface' ? 'bg-bg' : 'bg-surface';
const gridColsClass =
  members.length <= 2
    ? 'sm:grid-cols-2'
    : members.length === 4 || members.length >= 8
      ? 'sm:grid-cols-2 lg:grid-cols-4'
      : 'sm:grid-cols-2 lg:grid-cols-3';

function getInitials(name: string): string {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return 'T';
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return `${parts[0].charAt(0)}${parts[parts.length - 1].charAt(0)}`.toUpperCase();
}
---

<PageSection id={id} surface={surface} spacing={spacing}>
  {
    (eyebrow || heading || subheading) && (
      <div class="max-w-2xl" data-trig>
        {eyebrow && <p class="section-kicker">{eyebrow}</p>}
        {heading && (
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-fg sm:text-3xl text-balance">
            {heading}
          </h2>
        )}
        {subheading && (
          <p class="mt-3 text-base leading-relaxed text-muted text-pretty">
            {subheading}
          </p>
        )}
      </div>
    )
  }

  <div
    class:list={[
      'grid gap-6',
      (eyebrow || heading || subheading) && 'mt-8',
      gridColsClass,
    ]}
    data-trig-stagger
    data-trig-stagger-delay="0.06"
  >
    {
      members.map((member) => (
        <article
          data-trig
          class:list={[
            'group flex flex-col overflow-hidden rounded-2xl border border-border transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md',
            cardSurface,
          ]}
        >
          {member.avatar ? (
            <div class="aspect-[4/3] w-full overflow-hidden border-b border-border bg-surface-hover/50">
              <Image
                src={member.avatar}
                alt={member.avatarAlt ?? member.name}
                widths={[400, 720]}
                sizes="(min-width: 1024px) 28vw, (min-width: 640px) 45vw, 94vw"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
              />
            </div>
          ) : (
            <div
              aria-hidden="true"
              class="flex aspect-[4/3] w-full items-center justify-center border-b border-border bg-linear-to-br rtl:bg-linear-to-bl from-primary/12 via-surface-hover/60 to-accent/12"
            >
              <div class="flex flex-col items-center gap-2 text-primary">
                <span class="inline-flex size-16 items-center justify-center rounded-2xl border border-primary/25 bg-surface text-lg font-extrabold tracking-tight text-primary shadow-xs">
                  {getInitials(member.name)}
                </span>
                <Icon name="users" size={16} class="text-muted" />
              </div>
            </div>
          )}

          <div class="flex flex-1 flex-col justify-between p-5 sm:p-6">
            <div>
              <h3 class="text-lg font-bold tracking-tight text-fg">{member.name}</h3>
              <p class="mt-0.5 text-xs font-semibold text-primary">{member.role}</p>
              {member.bio && (
                <p class="mt-3 text-sm leading-relaxed text-muted">{member.bio}</p>
              )}
            </div>

            {member.links && member.links.length > 0 && (
              <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-border pt-4 print:hidden">
                {member.links.map((link) => {
                  const isExternal = link.external ?? /^https?:\/\//i.test(link.href);
                  return (
                    <a
                      href={link.href}
                      target={isExternal ? '_blank' : undefined}
                      rel={isExternal ? 'noreferrer noopener' : undefined}
                      aria-label={link.label}
                      title={link.label}
                      class="ghost-control size-8 text-muted hover:text-primary"
                    >
                      <Icon name={link.icon ?? (isExternal ? 'external-link' : 'globe')} size={16} />
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</PageSection>
