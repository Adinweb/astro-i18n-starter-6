---
/**
 * SaaS Dashboard & Product Showcase Hero composed with shared UI primitives:
 * `<BackdropLayer>`, `<TopBanner>`, `<HeroPreviewNav>`, `<AnnouncementPill>`,
 * `<UiBadge>`, `<HeroHeadline>`, `<Button>`, `<AvatarGroup>`, `<StatTile>`, and
 * `<HeroParallaxLayer>`.
 */
import ResponsiveImage from '@/components/ui/ResponsiveImage.astro';
import AnnouncementPill from '@/components/ui/AnnouncementPill.astro';
import AvatarGroup, { type AvatarItem } from '@/components/ui/AvatarGroup.astro';
import BackdropLayer, { type BackdropVariant } from '@/components/ui/BackdropLayer.astro';
import Button from '@/components/ui/Button.astro';
import HeroHeadline from '@/components/ui/HeroHeadline.astro';
import HeroParallaxLayer, {
  type HeroParallaxOverlay,
  type HeroParallaxSpeed,
} from '@/components/ui/HeroParallaxLayer.astro';
import HeroPreviewNav, {
  type HeroPreviewNavLink,
  type HeroPreviewNavVariant,
} from '@/components/ui/HeroPreviewNav.astro';
import Icon from '@/components/ui/Icon.astro';
import StatTile from '@/components/ui/StatTile.astro';
import TopBanner from '@/components/ui/TopBanner.astro';
import UiBadge from '@/components/ui/UiBadge.astro';
import type { Locale } from '@/i18n/locales';
import type { ContentImage } from '@/libs/content/media';
import { getHomeHref, getPageUrl } from '@/libs/content/service';
import { resolveComponentLocale } from '@/libs/ui/locale';
import type { HeroCtaAction, HeroTopBanner } from '@/libs/ui/types';
import * as m from '@/paraglide/messages';

export interface DashboardStatItem {
  label: string;
  value: string;
  accent?: boolean;
}

export interface DashboardAnnouncement {
  badge?: string;
  label: string;
  href?: string;
  badgeVariant?: 'primary' | 'accent' | 'success' | 'neutral';
}

interface Props {
  id?: string;
  locale?: Locale | string;
  surface?: 'default' | 'hero' | 'surface' | 'subtle';
  backdrop?: BackdropVariant;
  framedRails?: 'none' | 'dashed' | 'solid';
  parallaxImage?: ContentImage | null;
  parallaxAlt?: string;
  parallaxSpeed?: HeroParallaxSpeed;
  parallaxOverlay?: HeroParallaxOverlay;
  topBanner?: HeroTopBanner | null;
  showPreviewNav?: boolean;
  previewNavVariant?: HeroPreviewNavVariant;
  previewBrand?: string;
  previewLinks?: readonly HeroPreviewNavLink[];
  previewCta?: HeroCtaAction | null;
  announcement?: DashboardAnnouncement | null;
  badge?: string | null;
  showAvatarGroup?: boolean;
  avatarItems?: readonly AvatarItem[];
  avatarCount?: number;
  avatarLabel?: string;
  avatarRating?: number | null;
  titleLead?: string;
  titleAccent?: string | null;
  description?: string | null;
  primaryCta?: HeroCtaAction | null;
  secondaryCta?: HeroCtaAction | null;
  primaryCtaHoverSwap?: boolean;
  metricsStrip?: readonly DashboardStatItem[] | null;
  frame?: 'window' | 'clean';
  cropBottom?: boolean;
  glowBehindShowcase?: boolean;
  windowTitle?: string;
  statusText?: string;
  stats?: readonly DashboardStatItem[];
  image?: ContentImage | null;
  imageAlt?: string;
  headingTag?: 'h1' | 'h2';
  compact?: boolean;
}

const {
  id,
  locale,
  surface = 'default',
  backdrop,
  framedRails = 'none',
  parallaxImage = null,
  parallaxAlt = '',
  parallaxSpeed = 'medium',
  parallaxOverlay = 'hero',
  topBanner = null,
  showPreviewNav = false,
  previewNavVariant = 'minimal',
  previewBrand,
  previewLinks,
  previewCta,
  announcement = null,
  badge,
  showAvatarGroup = false,
  avatarItems,
  avatarCount,
  avatarLabel,
  avatarRating = 5,
  titleLead,
  titleAccent,
  description,
  primaryCta,
  secondaryCta,
  primaryCtaHoverSwap = false,
  metricsStrip = null,
  frame = 'window',
  cropBottom = false,
  glowBehindShowcase = false,
  windowTitle,
  statusText,
  stats,
  image,
  imageAlt = '',
  headingTag = 'h1',
  compact = false,
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = titleLead === undefined;

const [featuresHref, pricingHref, homeHref] =
  usingDefaults && (primaryCta === undefined || secondaryCta === undefined)
    ? await Promise.all([
        getPageUrl('features', activeLocale),
        getPageUrl('pricing', activeLocale),
        getHomeHref(activeLocale),
      ])
    : [null, null, ''];

const resolvedBadge =
  badge === null
    ? undefined
    : badge ?? (!announcement && usingDefaults ? m.block_hero_dash_badge({}, { locale: activeLocale }) : undefined);
const resolvedTitleLead =
  titleLead ?? m.block_hero_dash_title_lead({}, { locale: activeLocale });
const resolvedTitleAccent =
  titleAccent === null
    ? undefined
    : titleAccent ??
      (usingDefaults ? m.block_hero_dash_title_accent({}, { locale: activeLocale }) : undefined);
const resolvedDescription =
  description === null
    ? undefined
    : description ??
      (usingDefaults ? m.block_hero_dash_desc({}, { locale: activeLocale }) : undefined);

const resolvedPrimaryCta =
  primaryCta === null
    ? undefined
    : primaryCta ??
      (usingDefaults
        ? {
            label: m.block_hero_primary_cta({}, { locale: activeLocale }),
            href: featuresHref ?? homeHref,
            icon: 'arrow-right',
          }
        : undefined);

const resolvedSecondaryCta =
  secondaryCta === null
    ? undefined
    : secondaryCta ??
      (usingDefaults
        ? {
            label: m.block_hero_secondary_cta({}, { locale: activeLocale }),
            href: pricingHref ?? homeHref,
          }
        : undefined);

const resolvedWindowTitle =
  windowTitle ?? m.block_hero_dash_window_title({}, { locale: activeLocale });
const resolvedStatusText =
  statusText ?? m.block_hero_dash_status({}, { locale: activeLocale });

const resolvedStats: readonly DashboardStatItem[] = stats ?? [
  {
    label: m.block_hero_dash_stat1_label({}, { locale: activeLocale }),
    value: m.block_hero_dash_stat1_value({}, { locale: activeLocale }),
    accent: true,
  },
  {
    label: m.block_hero_dash_stat2_label({}, { locale: activeLocale }),
    value: m.block_hero_dash_stat2_value({}, { locale: activeLocale }),
  },
  {
    label: m.block_hero_dash_stat3_label({}, { locale: activeLocale }),
    value: m.block_hero_dash_stat3_value({}, { locale: activeLocale }),
  },
];

const barHeights = ['42%', '68%', '56%', '84%', '62%', '94%', '76%', '88%'] as const;
const hasShowcaseSlot = Astro.slots.has('showcase');
const hasParallax = Boolean(parallaxImage);
const isHeroSurface = hasParallax || surface === 'hero';
const effectiveNavSurface = hasParallax ? 'hero' : surface;
const resolvedBackdrop = backdrop ?? (isHeroSurface ? 'glow' : 'none');
const statusChipLabel = 'SSG OK';
const rtlBadgeLabel = 'RTL / LTR';
---

<section
  id={id}
  class:list={[
    'hero-dash-band relative isolate overflow-hidden',
    compact
      ? showPreviewNav
        ? cropBottom
          ? 'rounded-3xl pt-8 pb-0 sm:pt-10'
          : 'rounded-3xl py-8 sm:py-12'
        : cropBottom
          ? 'rounded-3xl pt-10 pb-0 sm:pt-14'
          : 'rounded-3xl py-10 sm:py-14'
      : showPreviewNav
        ? cropBottom
          ? 'pt-10 pb-0 sm:pt-14'
          : 'pt-10 pb-16 sm:pt-14 sm:pb-24'
        : cropBottom
          ? 'pt-28 pb-0 sm:pt-36'
          : 'pt-28 pb-16 sm:pt-36 sm:pb-24',
    topBanner && 'pt-0!',
    id && 'scroll-mt-24',
    isHeroSurface
      ? 'bg-hero-base text-hero-fg print:bg-bg print:text-fg'
      : surface === 'surface'
        ? 'border border-border bg-surface text-fg'
        : surface === 'subtle'
          ? 'border border-border bg-surface/60 text-fg'
          : 'border-b border-border bg-bg text-fg',
  ]}
  data-hero-surface={isHeroSurface ? 'hero' : 'standard'}
>
  {
    parallaxImage && (
      <HeroParallaxLayer
        locale={activeLocale}
        image={parallaxImage}
        alt={parallaxAlt || resolvedTitleLead}
        speed={parallaxSpeed}
        overlay={parallaxOverlay}
        priority={!compact}
      />
    )
  }

  {
    Astro.slots.has('backdrop') ? (
      <slot name="backdrop" />
    ) : (
      <BackdropLayer backdrop={resolvedBackdrop} surface={isHeroSurface ? 'hero' : 'default'} />
    )
  }

  {
    topBanner && (
      <TopBanner
        badge={topBanner.badge}
        label={topBanner.label}
        href={topBanner.href}
        ctaLabel={topBanner.ctaLabel ?? resolvedPrimaryCta?.label}
        surface={isHeroSurface ? 'hero' : 'default'}
        locale={activeLocale}
        class="mb-8 print:hidden"
      />
    )
  }

  <div class="layout-container">
    <div
      class:list={[
        framedRails !== 'none' && 'mx-auto max-w-5xl border-s border-e px-5 pt-6 sm:px-10 sm:pt-8',
        framedRails !== 'none' && !cropBottom && 'pb-6 sm:pb-8',
        framedRails === 'dashed' && 'border-dashed',
        framedRails !== 'none' && (isHeroSurface ? 'border-hero-fg/15 print:border-border' : 'border-border'),
      ]}
    >
      {
        showPreviewNav && (
          <HeroPreviewNav
            locale={activeLocale}
            surface={effectiveNavSurface}
            variant={previewNavVariant}
            brand={previewBrand}
            links={previewLinks}
            cta={previewCta}
            compact={compact}
          />
        )
      }

      <div
        class="mx-auto max-w-3xl text-center"
        data-trig-stagger
        data-trig-stagger-mode="linear"
        data-trig-stagger-delay="0.05"
        data-trig-once="true"
      >
        {
          announcement && (
            <AnnouncementPill
              badge={announcement.badge}
              badgeVariant={announcement.badgeVariant}
              label={announcement.label}
              href={announcement.href}
              surface={isHeroSurface ? 'hero' : 'default'}
              align="center"
              locale={activeLocale}
              class="mb-5"
            />
          )
        }

        {
          resolvedBadge && (
            <div class="mb-4 flex justify-center">
              <UiBadge
                label={resolvedBadge}
                variant={isHeroSurface ? 'accent' : 'primary'}
                icon="layout-grid"
                class={isHeroSurface ? 'border-hero-fg/20 bg-hero-fg/10 text-hero-fg print:text-fg' : undefined}
              />
            </div>
          )
        }

        <HeroHeadline
          headingTag={headingTag}
          lead={resolvedTitleLead}
          accent={resolvedTitleAccent}
          surface={isHeroSurface ? 'hero' : 'default'}
        />

        {
          resolvedDescription && (
            <p
              class:list={[
                'mx-auto mt-5 max-w-2xl text-base leading-relaxed text-pretty sm:text-lg',
                isHeroSurface ? 'text-hero-fg/88 print:text-muted' : 'text-muted',
              ]}
            >
              {resolvedDescription}
            </p>
          )
        }

        {
          (resolvedPrimaryCta || resolvedSecondaryCta) && (
            <div class="mt-8 flex flex-wrap items-center justify-center gap-3 print:hidden">
              {resolvedPrimaryCta && (
                <Button
                  href={resolvedPrimaryCta.href}
                  variant={resolvedPrimaryCta.variant ?? 'primary'}
                  size="lg"
                  glow
                  icon={resolvedPrimaryCta.icon ?? 'arrow-right'}
                  external={resolvedPrimaryCta.external}
                >
                  {primaryCtaHoverSwap ? (
                    <span class="relative inline-flex h-[1.25em] overflow-hidden leading-[1.25]">
                      <span class="block transition-transform duration-300 group-hover:-translate-y-full">
                        {resolvedPrimaryCta.label}
                      </span>
                      <span
                        aria-hidden="true"
                        class="absolute inset-x-0 top-full block transition-transform duration-300 group-hover:-translate-y-full"
                      >
                        {resolvedPrimaryCta.label}
                      </span>
                    </span>
                  ) : (
                    resolvedPrimaryCta.label
                  )}
                </Button>
              )}
              {resolvedSecondaryCta && (
                <Button
                  href={resolvedSecondaryCta.href}
                  variant={resolvedSecondaryCta.variant ?? (isHeroSurface ? 'hero' : 'secondary')}
                  size="lg"
                  icon={resolvedSecondaryCta.icon}
                  external={resolvedSecondaryCta.external}
                >
                  {resolvedSecondaryCta.label}
                </Button>
              )}
            </div>
          )
        }

        {
          showAvatarGroup && (
            <div class="mt-6 flex justify-center">
              <div
                class:list={[
                  'inline-flex flex-wrap items-center rounded-full border px-4 py-1.5',
                  isHeroSurface
                    ? 'border-hero-fg/15 bg-hero-fg/10 text-hero-fg print:border-border print:bg-surface print:text-fg'
                    : 'border-border bg-surface text-fg shadow-xs',
                ]}
              >
                <AvatarGroup
                  locale={activeLocale}
                  items={avatarItems}
                  extraCount={avatarCount}
                  label={avatarLabel}
                  rating={avatarRating}
                  size="sm"
                />
              </div>
            </div>
          )
        }

        {
          metricsStrip && metricsStrip.length > 0 && (
            <div class="mx-auto mt-7 grid max-w-2xl grid-cols-3 gap-3">
              {metricsStrip.map((metric) => (
                <StatTile
                  label={metric.label}
                  value={metric.value}
                  accent={metric.accent}
                  variant={isHeroSurface ? 'hero' : 'card'}
                  align="center"
                  locale={activeLocale}
                />
              ))}
            </div>
          )
        }
      </div>

      <div
        class:list={[
          'relative mx-auto max-w-5xl trig-delay-150',
          compact ? 'mt-9 sm:mt-11' : 'mt-10 sm:mt-14',
        ]}
        data-trig
        data-trig-once="true"
      >
        {
          glowBehindShowcase && (
            <div
              aria-hidden="true"
              class="hero-glow-accent pointer-events-none absolute -top-10 inset-x-10 -z-10 h-32 rounded-full opacity-70 print:hidden"
            />
          )
        }

        <div
          class:list={[
            'overflow-hidden border shadow-floating',
            cropBottom ? 'rounded-t-2xl rounded-b-none border-b-0' : 'rounded-2xl',
            isHeroSurface
              ? 'border-hero-fg/20 bg-hero-base/85 text-hero-fg print:border-border print:bg-surface print:text-fg'
              : 'border-border bg-surface text-fg',
          ]}
        >
          {
            frame === 'window' && (
              <div
                class:list={[
                  'flex items-center justify-between gap-3 border-b px-4 py-3 sm:px-5',
                  isHeroSurface
                    ? 'border-hero-fg/15 bg-hero-fg/5 print:border-border print:bg-surface-hover/50'
                    : 'border-border bg-surface-hover/40',
                ]}
              >
                <div class="flex items-center gap-2" aria-hidden="true">
                  <span class="size-2.5 rounded-full bg-error/70"></span>
                  <span class="size-2.5 rounded-full bg-warning/70"></span>
                  <span class="size-2.5 rounded-full bg-success/70"></span>
                  <span
                    class:list={[
                      'ms-2 text-xs font-semibold',
                      isHeroSurface ? 'text-hero-fg/80 print:text-muted' : 'text-muted',
                    ]}
                  >
                    {resolvedWindowTitle}
                  </span>
                </div>
                <UiBadge label={statusChipLabel} variant="success" size="sm" icon="circle-check" />
              </div>
            )
          }

          {
            hasShowcaseSlot ? (
              <div class="p-4 sm:p-6">
                <slot name="showcase" />
              </div>
            ) : image ? (
              <ResponsiveImage
                src={image}
                alt={imageAlt || resolvedTitleLead}
                widths={[720, 1080, 1440]}
                sizes="(min-width: 1024px) 62rem, 94vw"
                class={[
                  'w-full object-cover',
                  cropBottom ? 'aspect-[16/8]' : 'aspect-[16/9]',
                ].join(' ')}
                loading={compact ? 'lazy' : 'eager'}
                fetchpriority={compact ? undefined : 'high'}
              />
            ) : (
              <div class:list={['p-4 sm:p-6', cropBottom && 'pb-2 sm:pb-3']}>
                <div class="grid gap-3 sm:grid-cols-3">
                  {resolvedStats.map((stat) => (
                    <StatTile
                      label={stat.label}
                      value={stat.value}
                      accent={stat.accent}
                      variant={isHeroSurface ? 'hero' : 'card'}
                      align="start"
                      locale={activeLocale}
                      class={!isHeroSurface ? 'bg-bg!' : undefined}
                    />
                  ))}
                </div>

                <div
                  class:list={[
                    'mt-4 rounded-xl border p-4 sm:p-5',
                    cropBottom && 'rounded-b-none border-b-0 pb-2 sm:pb-2',
                    isHeroSurface
                      ? 'border-hero-fg/15 bg-hero-fg/5 print:border-border print:bg-bg'
                      : 'border-border bg-bg',
                  ]}
                >
                  <div class="flex h-24 items-end gap-2 sm:h-32 sm:gap-3" aria-hidden="true">
                    {barHeights.map((height, idx) => (
                      <div
                        class:list={[
                          'flex-1 rounded-t-lg transition-opacity duration-200 hover:opacity-90',
                          idx % 2 === 0
                            ? 'bg-linear-to-t from-primary/60 to-primary'
                            : isHeroSurface
                              ? 'bg-linear-to-t from-accent/55 to-accent'
                              : 'bg-linear-to-t from-secondary/55 to-secondary',
                        ]}
                        style={`height: ${height};`}
                      />
                    ))}
                  </div>
                  {!cropBottom && (
                    <div
                      class:list={[
                        'mt-4 flex flex-wrap items-center justify-between gap-2 border-t pt-3 text-xs',
                        isHeroSurface
                          ? 'border-hero-fg/15 text-hero-fg/80 print:border-border print:text-muted'
                          : 'border-border text-muted',
                      ]}
                    >
                      <span class="inline-flex items-center gap-1.5 font-medium">
                        <Icon name="circle-check" size={15} class="shrink-0 text-success" />
                        <span>{resolvedStatusText}</span>
                      </span>
                      <span class="inline-flex items-center gap-1.5 tabular-nums">
                        <Icon name="globe" size={14} class="shrink-0" />
                        <span>{rtlBadgeLabel}</span>
                      </span>
                    </div>
                  )}
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
