---
/**
 * Developer CLI & Copy-Command Hero composed with shared UI primitives:
 * `<BackdropLayer>`, `<HeroPreviewNav>`, `<AvatarGroup>`, `<UiBadge>`,
 * `<HeroHeadline>`, `<CodeBlock>`, `<Button>`, `<Icon>`, and `<PartnerStrip>`.
 */
import type { ContentImage } from '@/libs/content/media';
import AvatarGroup from '@/components/ui/AvatarGroup.astro';
import BackdropLayer, { type BackdropVariant } from '@/components/ui/BackdropLayer.astro';
import Button from '@/components/ui/Button.astro';
import CodeBlock, { type CodeCommandTab } from '@/components/ui/CodeBlock.astro';
import HeroHeadline from '@/components/ui/HeroHeadline.astro';
import HeroParallaxLayer, {
  type HeroParallaxOverlay,
  type HeroParallaxSpeed,
} from '@/components/ui/HeroParallaxLayer.astro';
import HeroPreviewNav, {
  type HeroPreviewNavLink,
  type HeroPreviewNavVariant,
} from '@/components/ui/HeroPreviewNav.astro';
import Icon from '@/components/ui/Icon.astro';
import PartnerStrip from '@/components/ui/PartnerStrip.astro';
import UiBadge from '@/components/ui/UiBadge.astro';
import type { Locale } from '@/i18n/locales';
import { getHomeHref, getPageUrl } from '@/libs/content/service';
import { resolveComponentLocale } from '@/libs/ui/locale';
import type { HeroCtaAction, HeroPartnerPill } from '@/libs/ui/types';
import * as m from '@/paraglide/messages';

export type HeroCliCommand = CodeCommandTab;

interface Props {
  id?: string;
  locale?: Locale | string;
  surface?: 'default' | 'hero' | 'surface' | 'subtle';
  backdrop?: BackdropVariant;
  parallaxImage?: ContentImage | null;
  parallaxAlt?: string;
  parallaxSpeed?: HeroParallaxSpeed;
  parallaxOverlay?: HeroParallaxOverlay;
  showPreviewNav?: boolean;
  previewNavVariant?: HeroPreviewNavVariant;
  previewBrand?: string;
  previewLinks?: readonly HeroPreviewNavLink[];
  previewCta?: HeroCtaAction | null;
  eyebrow?: string | null;
  showAvatarStack?: boolean;
  titleLead?: string;
  titleAccent?: string | null;
  description?: string | null;
  commands?: readonly HeroCliCommand[];
  primaryCta?: HeroCtaAction | null;
  secondaryCta?: HeroCtaAction | null;
  metaItems?: readonly string[] | null;
  partnerLogos?: readonly HeroPartnerPill[] | null;
  headingTag?: 'h1' | 'h2';
  compact?: boolean;
}

const {
  id,
  locale,
  surface = 'default',
  backdrop,
  parallaxImage = null,
  parallaxAlt = '',
  parallaxSpeed = 'medium',
  parallaxOverlay = 'hero',
  showPreviewNav = false,
  previewNavVariant = 'minimal',
  previewBrand,
  previewLinks,
  previewCta,
  eyebrow,
  showAvatarStack = false,
  titleLead,
  titleAccent,
  description,
  commands,
  primaryCta,
  secondaryCta,
  metaItems,
  partnerLogos = null,
  headingTag = 'h1',
  compact = false,
} = Astro.props;

const activeLocale = resolveComponentLocale(locale, Astro.url.pathname);
const usingDefaults = titleLead === undefined;

const [featuresHref, componentsHref, homeHref] =
  usingDefaults && (primaryCta === undefined || secondaryCta === undefined)
    ? await Promise.all([
        getPageUrl('features', activeLocale),
        getPageUrl('components', activeLocale),
        getHomeHref(activeLocale),
      ])
    : [null, null, ''];

const resolvedEyebrow =
  eyebrow === null
    ? undefined
    : eyebrow ?? (usingDefaults ? m.block_hero_cli_eyebrow({}, { locale: activeLocale }) : undefined);
const resolvedTitleLead =
  titleLead ?? m.block_hero_cli_title_lead({}, { locale: activeLocale });
const resolvedTitleAccent =
  titleAccent === null
    ? undefined
    : titleAccent ??
      (usingDefaults ? m.block_hero_cli_title_accent({}, { locale: activeLocale }) : undefined);
const resolvedDescription =
  description === null
    ? undefined
    : description ??
      (usingDefaults ? m.block_hero_cli_desc({}, { locale: activeLocale }) : undefined);

const resolvedCommands: readonly HeroCliCommand[] = commands ?? [
  { label: 'npm', command: 'npm create astro@latest -- --template astro-i18n' },
  { label: 'pnpm', command: 'pnpm create astro --template astro-i18n' },
  { label: 'bun', command: 'bun create astro --template astro-i18n' },
];

const resolvedPrimaryCta =
  primaryCta === null
    ? undefined
    : primaryCta ??
      (usingDefaults
        ? {
            label: m.block_hero_cli_cta({}, { locale: activeLocale }),
            href: componentsHref ?? homeHref,
            icon: 'arrow-right',
          }
        : undefined);

const resolvedSecondaryCta =
  secondaryCta === null
    ? undefined
    : secondaryCta ??
      (usingDefaults
        ? {
            label: m.block_hero_primary_cta({}, { locale: activeLocale }),
            href: featuresHref ?? homeHref,
          }
        : undefined);

const resolvedMetaItems: readonly string[] | undefined =
  metaItems === null
    ? undefined
    : metaItems ??
      (usingDefaults
        ? [
            m.block_hero_cli_meta_1({}, { locale: activeLocale }),
            m.block_hero_cli_meta_2({}, { locale: activeLocale }),
            m.block_hero_cli_meta_3({}, { locale: activeLocale }),
          ]
        : undefined);

const copyAriaLabel = m.block_hero_cli_copy_aria({}, { locale: activeLocale });
const hasParallax = Boolean(parallaxImage);
const isHeroSurface = hasParallax || surface === 'hero';
const effectiveNavSurface = hasParallax ? 'hero' : surface;
const resolvedBackdrop = backdrop ?? (isHeroSurface ? 'glow' : 'none');
---

<section
  id={id}
  class:list={[
    'hero-cli-band relative isolate overflow-hidden',
    compact
      ? showPreviewNav
        ? 'rounded-3xl py-8 sm:py-12'
        : 'rounded-3xl py-10 sm:py-14'
      : showPreviewNav
        ? 'pt-10 pb-16 sm:pt-14 sm:pb-24'
        : 'pt-28 pb-16 sm:pt-36 sm:pb-24',
    id && 'scroll-mt-24',
    isHeroSurface
      ? 'bg-hero-base text-hero-fg print:bg-bg print:text-fg'
      : surface === 'surface'
        ? 'border border-border bg-surface text-fg'
        : surface === 'subtle'
          ? 'border border-border bg-surface/60 text-fg'
          : 'border-b border-border bg-bg text-fg',
  ]}
  data-hero-surface={isHeroSurface ? 'hero' : 'standard'}
>
  {
    parallaxImage && (
      <HeroParallaxLayer
        locale={activeLocale}
        image={parallaxImage}
        alt={parallaxAlt || resolvedTitleLead}
        speed={parallaxSpeed}
        overlay={parallaxOverlay}
        priority={!compact}
      />
    )
  }

  {
    Astro.slots.has('backdrop') ? (
      <slot name="backdrop" />
    ) : (
      <BackdropLayer backdrop={resolvedBackdrop} surface={isHeroSurface ? 'hero' : 'default'} />
    )
  }

  <div class="layout-container">
    {
      showPreviewNav && (
        <HeroPreviewNav
          locale={activeLocale}
          surface={effectiveNavSurface}
          variant={previewNavVariant}
          brand={previewBrand}
          links={previewLinks}
          cta={previewCta}
          compact={compact}
        />
      )
    }
    <div
      class="mx-auto max-w-3xl text-center"
      data-trig-stagger
      data-trig-stagger-mode="linear"
      data-trig-stagger-delay="0.05"
      data-trig-once="true"
    >
      {
        showAvatarStack && (
          <div class="mb-5 flex justify-center">
            <AvatarGroup locale={activeLocale} size="sm" />
          </div>
        )
      }

      {
        resolvedEyebrow && (
          <div class="mb-4 flex justify-center">
            <UiBadge
              label={resolvedEyebrow}
              variant={isHeroSurface ? 'accent' : 'primary'}
              icon="code"
              class={isHeroSurface ? 'border-hero-fg/20 bg-hero-fg/10 text-hero-fg print:text-fg' : undefined}
            />
          </div>
        )
      }

      <HeroHeadline
        headingTag={headingTag}
        lead={resolvedTitleLead}
        accent={resolvedTitleAccent}
        surface={isHeroSurface ? 'hero' : 'default'}
      />

      {
        resolvedDescription && (
          <p
            class:list={[
              'mx-auto mt-5 max-w-2xl text-base leading-relaxed text-pretty sm:text-lg',
              isHeroSurface ? 'text-hero-fg/88 print:text-muted' : 'text-muted',
            ]}
          >
            {resolvedDescription}
          </p>
        )
      }

      {
        resolvedCommands.length > 0 && (
          <CodeBlock
            commands={resolvedCommands}
            showPrompt
            surface={isHeroSurface ? 'hero' : 'default'}
            copyAriaLabel={copyAriaLabel}
            locale={activeLocale}
            class="mx-auto mt-8 max-w-xl"
          />
        )
      }

      {
        (resolvedPrimaryCta || resolvedSecondaryCta) && (
          <div class="mt-7 flex flex-wrap items-center justify-center gap-3 print:hidden">
            {resolvedPrimaryCta && (
              <Button
                href={resolvedPrimaryCta.href}
                variant="primary"
                size="lg"
                icon={resolvedPrimaryCta.icon ?? 'arrow-right'}
                external={resolvedPrimaryCta.external}
              >
                {resolvedPrimaryCta.label}
              </Button>
            )}
            {resolvedSecondaryCta && (
              <Button
                href={resolvedSecondaryCta.href}
                variant={isHeroSurface ? 'hero' : 'secondary'}
                size="lg"
                external={resolvedSecondaryCta.external}
              >
                {resolvedSecondaryCta.label}
              </Button>
            )}
          </div>
        )
      }

      {
        resolvedMetaItems && resolvedMetaItems.length > 0 && (
          <ul class="mt-7 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs font-medium">
            {resolvedMetaItems.map((meta) => (
              <li
                class:list={[
                  'inline-flex items-center gap-1.5',
                  isHeroSurface ? 'text-hero-fg/75 print:text-muted' : 'text-muted',
                ]}
              >
                <Icon
                  name="circle-check"
                  size={14}
                  class={isHeroSurface ? 'text-accent print:text-primary' : 'text-primary'}
                />
                <span>{meta}</span>
              </li>
            ))}
          </ul>
        )
      }

      {
        partnerLogos && partnerLogos.length > 0 && (
          <PartnerStrip
            items={partnerLogos}
            variant="logos"
            surface={isHeroSurface ? 'hero' : 'default'}
            class="mt-8"
          />
        )
      }
    </div>
  </div>
</section>
