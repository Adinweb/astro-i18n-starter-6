---
/**
 * Bespoke full-bleed landing page template (`template: "home"`) shared across
 * all locales (`src/content/pages/home/<locale>.mdx`).
 *
 * Demonstrates complete freedom from `<PageHero>` and narrow `.prose` wrappers:
 * renders the bespoke `HomeHero` band followed by full-width (`1280px`)
 * localized MDX sections.
 */
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageSection from '@/components/PageSection.astro';
import HomeHero from '@/components/HomeHero.astro';
import { formatNumber } from '@/i18n/format';
import { LOCALES, type Locale } from '@/i18n/locales';
import { getBlogIndexHref, getPageUrl } from '@/libs/content/service';
import { getContentType, getContentTypeIndexHref } from '@/libs/content/types';
import * as m from '@/paraglide/messages';

interface Props {
  entry: CollectionEntry<'pages'>;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
  url: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { entry, locale, alternates, url, schema } = Astro.props;
const { Content } = await render(entry);

// A disabled content type must not leave a dead CTA behind: the secondary
// button disappears with the section it points at.
const blogHref = getContentType('blog').enabled ? getBlogIndexHref(locale) : null;
const featuresHref =
  (await getPageUrl('features', locale)) ??
  blogHref ??
  getContentTypeIndexHref('pages', locale);
const formattedLocaleCount = formatNumber(LOCALES.length, locale);

const blueprintItems = [
  {
    key: 'i18n',
    icon: 'globe',
    title: m.home_spec_i18n_title({}, { locale }),
    description: m.home_spec_i18n_desc({ count: formattedLocaleCount }, { locale }),
  },
  {
    key: 'pages',
    icon: 'layers',
    title: m.home_spec_pages_title({}, { locale }),
    description: m.home_spec_pages_desc({}, { locale }),
  },
  {
    key: 'rtl',
    icon: 'shield',
    title: m.home_spec_rtl_title({}, { locale }),
    description: m.home_spec_rtl_desc({}, { locale }),
  },
] as const;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  schema={schema}
  locale={locale}
  url={url}
  alternates={alternates}
  flushTop
  canvas
>
  <HomeHero
    locale={locale}
    description={entry.data.description}
    primaryHref={featuresHref}
    secondaryHref={blogHref ?? undefined}
    highlights={blueprintItems}
  />

  <PageSection spacing="md">
    <div class="prose prose-wide">
      <Content />
    </div>
  </PageSection>
</BaseLayout>
