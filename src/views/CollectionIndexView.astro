---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Divider from '@/components/ui/Divider.astro';
import Icon from '@/components/ui/Icon.astro';
import PageHeader from '@/components/PageHeader.astro';
import UiBadge from '@/components/ui/UiBadge.astro';
import UiPagination from '@/components/ui/UiPagination.astro';
import {
  buildBreadcrumbSchema,
  getBreadcrumbs,
  getCollectionPageHref,
  getHomeHref,
} from '@/libs/content/service';
import { buildCollectionSearchHaystack } from '@/libs/content/collection-filters';
import { parseContentEntryId } from '@/libs/content/entries';
import { getCollectionCategoryLabel } from '@/libs/content/taxonomy';
import {
  getContentType,
  getContentTypeDescription,
  getContentTypeEntryHref,
  getContentTypeIndexHref,
  getContentTypeLabel,
  type ContentTypeKey,
} from '@/libs/content/types';
import { absoluteUrl, siteConfig } from '@/libs/config/app';
import { buildOgRouteKey, type SocialCardContext } from '@/libs/content/social';
import { formatNumber, formatYear } from '@/i18n/format';
import { getLocaleMeta, type Locale } from '@/i18n/locales';
import * as m from '@/paraglide/messages';

/**
 * Listing page of a content type declared in `content.types`.
 *
 * Supports interactive filtering by localized category, technology stack,
 * keyword search, URL query sync, and multi-page catalog pagination alongside
 * ChronoTrig stagger animations.
 */
interface Props {
  contentType: ContentTypeKey;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
  switcherAlternates?: Partial<Record<Locale, string>>;
  url: string;
  page: number;
  totalPages: number;
  perPage: number;
}

const {
  contentType,
  locale,
  alternates,
  switcherAlternates,
  url,
  page,
  totalPages,
  perPage,
} = Astro.props;

const type = getContentType(contentType);
const baseTitle = getContentTypeLabel(contentType, locale);
const description = getContentTypeDescription(contentType, locale);
const pageStatus = m.blog_pagination_status(
  { page: formatNumber(page, locale), totalPages: formatNumber(totalPages, locale) },
  { locale }
);
const title = page > 1 ? `${baseTitle} — ${pageStatus}` : baseTitle;

const breadcrumbs = getBreadcrumbs(url, locale, {
  home: m.nav_home({}, { locale }),
  homeHref: await getHomeHref(locale),
  blog: m.nav_blog({}, { locale }),
  section: { label: baseTitle, href: getCollectionPageHref(type.base, 1, locale) },
  current: page > 1 ? pageStatus : baseTitle,
});

const published = (await getCollection(contentType as 'projects')).filter((entry) => {
  if (entry.data.draft) return false;
  return parseContentEntryId(entry.id).locale === locale;
});

published.sort(
  (a, b) =>
    (b.data.year ?? 0) - (a.data.year ?? 0) ||
    a.data.title.localeCompare(b.data.title, locale)
);

const start = (page - 1) * perPage;
const pageEntries = published.slice(start, start + perPage);

// Collect filter facets across the entire locale collection so multi-page
// paginated collections keep identical filter options on every page.
const categories = [...new Set(published.flatMap((entry) => entry.data.categories ?? []))].sort(
  (a, b) => a.localeCompare(b, locale)
);
const stacks = [...new Set(published.flatMap((entry) => entry.data.stack ?? []))].sort((a, b) =>
  a.localeCompare(b, locale)
);
const showFilters = published.length > 1 || categories.length > 0 || stacks.length > 0;
const indexHref = getContentTypeIndexHref(contentType, locale);

const pageHref = (target: number) => getCollectionPageHref(type.base, target, locale);
const previousHref = page > 1 ? pageHref(page - 1) : undefined;
const nextHref = page < totalPages ? pageHref(page + 1) : undefined;
const meta = getLocaleMeta(locale);

const indexSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: absoluteUrl(url),
    inLanguage: meta.htmlLang,
    isPartOf: {
      '@type': 'WebSite',
      name: siteConfig.name,
      url: absoluteUrl(breadcrumbs[0].href),
    },
  },
  buildBreadcrumbSchema(breadcrumbs, absoluteUrl),
];
const ogContext: SocialCardContext = {
  routeKey: buildOgRouteKey('collection-index', { contentType, page, locale }),
  title,
  subtitle: description,
  kicker: siteConfig.name,
  locale,
};

const countTemplate = m.collection_showing_count({ visible: '__V__', total: '__T__' }, { locale });
---

<BaseLayout
  title={title}
  description={description}
  ogContext={ogContext}
  schema={indexSchema}
  locale={locale}
  url={url}
  alternates={alternates}
  switcherAlternates={switcherAlternates}
  prevUrl={previousHref}
  nextUrl={nextHref}
>
  <PageHeader title={baseTitle} description={description} locale={locale} breadcrumbs={breadcrumbs} />

  {
    pageEntries.length === 0 ? (
      <p class="mt-10 text-sm text-muted">{m.content_empty({}, { locale })}</p>
    ) : (
      <div
        data-collection-root
        data-content-type={contentType}
        data-locale={locale}
        data-total={String(pageEntries.length)}
        data-total-pages={String(totalPages)}
        data-per-page={String(perPage)}
        data-base-href={indexHref}
        data-current-url={url}
        data-count-template={countTemplate}
        data-page-status-template={m.blog_pagination_status(
          { page: '{page}', totalPages: '{totalPages}' },
          { locale }
        )}
        data-page-label-template={m.blog_pagination_page(
          { page: '{page}' },
          { locale }
        )}
        data-prev-label={m.blog_pagination_previous({}, { locale })}
        data-next-label={m.blog_pagination_next({}, { locale })}
        data-pager-aria-label={m.blog_pagination_label({}, { locale })}
      >
        {showFilters && (
          <div class="mt-8 space-y-4 rounded-2xl border border-border bg-surface/70 p-4 sm:p-5" data-pagefind-ignore>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div class="relative flex-1 sm:max-w-sm">
                <Icon
                  name="search"
                  size={16}
                  class="pointer-events-none absolute start-3 top-1/2 -translate-y-1/2 text-muted"
                />
                <input
                  type="search"
                  data-collection-search
                  aria-label={m.collection_search_label({}, { locale })}
                  placeholder={m.collection_search_placeholder({}, { locale })}
                  class="w-full rounded-xl border border-border bg-bg py-2 ps-9 pe-3 text-sm text-fg placeholder:text-muted focus:border-primary focus:outline-none"
                />
              </div>

              <div class="flex items-center gap-3 text-xs text-muted">
                <span role="status" aria-live="polite" data-collection-count>
                  {m.collection_showing_count(
                    {
                      visible: formatNumber(pageEntries.length, locale),
                      total: formatNumber(pageEntries.length, locale),
                    },
                    { locale }
                  )}
                </span>
                <button
                  type="button"
                  data-collection-clear
                  hidden
                  class="inline-flex items-center gap-1 font-semibold text-primary hover:underline cursor-pointer"
                >
                  <Icon name="close" size={12} />
                  <span>{m.collection_filter_clear({}, { locale })}</span>
                </button>
              </div>
            </div>

            {(categories.length > 0 || stacks.length > 0) && <Divider locale={locale} />}

            {categories.length > 0 && (
              <div class="flex flex-wrap items-center gap-2">
                <span class="me-1 inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-muted rtl:tracking-normal">
                  <Icon name="filter" size={13} />
                  <span>{m.collection_filter_category({}, { locale })}</span>
                </span>
                <button
                  type="button"
                  data-collection-category=""
                  aria-pressed="true"
                  class="chip cursor-pointer px-3 py-1.5 text-xs"
                >
                  {m.collection_filter_all({}, { locale })}
                </button>
                {categories.map((cat) => (
                  <button
                    type="button"
                    data-collection-category={cat}
                    aria-pressed="false"
                    class="chip cursor-pointer px-3 py-1.5 text-xs"
                  >
                    {getCollectionCategoryLabel(contentType, cat, locale)}
                  </button>
                ))}
              </div>
            )}

            {categories.length > 0 && stacks.length > 0 && <Divider locale={locale} />}

            {stacks.length > 0 && (
              <div class="flex flex-wrap items-center gap-2">
                <span class="me-1 inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-wider text-muted rtl:tracking-normal">
                  <Icon name="tag" size={13} />
                  <span>{m.collection_filter_stack({}, { locale })}</span>
                </span>
                <button
                  type="button"
                  data-collection-stack=""
                  aria-pressed="true"
                  class="chip cursor-pointer px-3 py-1.5 text-xs"
                >
                  {m.collection_filter_all({}, { locale })}
                </button>
                {stacks.map((tech) => (
                  <button
                    type="button"
                    data-collection-stack={tech}
                    aria-pressed="false"
                    class="chip cursor-pointer px-3 py-1.5 text-xs"
                  >
                    {tech}
                  </button>
                ))}
              </div>
            )}
          </div>
        )}

        <ul
          data-collection-grid
          class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
          data-trig-stagger
          data-trig-stagger-delay="0.06"
          data-trig-root-margin="0px"
          data-trig-once="true"
        >
          {pageEntries.map((entry) => {
            const href = getContentTypeEntryHref(contentType, entry.data.slug, locale);
            const entryCategories = entry.data.categories ?? [];
            const entryStack = entry.data.stack ?? [];
            const categoryLabels = entryCategories.map((cat) =>
              getCollectionCategoryLabel(contentType, cat, locale)
            );
            const searchHaystack = buildCollectionSearchHaystack([
              entry.data.title,
              entry.data.description,
              entry.data.client,
              entry.data.year,
              ...entryCategories,
              ...categoryLabels,
              ...entryStack,
            ]);

            return (
              <li
                data-trig
                data-trig-once="true"
                data-collection-card
                data-categories={JSON.stringify(entryCategories)}
                data-stack={JSON.stringify(entryStack)}
                data-search={searchHaystack}
              >
                <a
                  href={href}
                  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface transition-colors hover:border-primary/50 hover:bg-surface-hover"
                >
                  {entry.data.image && (
                    <div class="aspect-video overflow-hidden bg-surface-hover">
                      <Image
                        src={entry.data.image}
                        alt=""
                        widths={[400, 640, 900]}
                        sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      />
                    </div>
                  )}
                  <div class="flex flex-1 flex-col gap-2 p-5">
                    <h2 class="text-lg font-semibold tracking-tight text-fg transition-colors group-hover:text-primary">
                      {entry.data.title}
                    </h2>
                    {entry.data.description && (
                      <p class="line-clamp-3 text-sm leading-relaxed text-muted">
                        {entry.data.description}
                      </p>
                    )}
                    {entryStack.length > 0 && (
                      <div class="mt-2 flex flex-wrap items-center gap-1.5">
                        {entryStack.slice(0, 3).map((tech) => (
                          <UiBadge label={tech} variant="neutral" size="sm" locale={locale} class="font-medium" />
                        ))}
                        {entryStack.length > 3 && (
                          <UiBadge
                            label={`+${formatNumber(entryStack.length - 3, locale)}`}
                            variant="neutral"
                            size="sm"
                            locale={locale}
                            class="font-medium"
                          />
                        )}
                      </div>
                    )}
                    {(entry.data.client || entry.data.year) && (
                      <p class="mt-auto pt-3 text-xs text-muted">
                        {[
                          entry.data.client,
                          entry.data.year ? formatYear(entry.data.year, locale) : null,
                        ]
                          .filter(Boolean)
                          .join(' · ')}
                      </p>
                    )}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>

        <p data-collection-empty hidden class="mt-10 text-center text-sm text-muted">
          {m.collection_filter_empty({}, { locale })}
        </p>

        {
          totalPages > 1 && (
            <div class="mt-12 border-t border-border pt-8" data-collection-pager-wrap data-pagefind-ignore>
              <p class="mb-3 text-center text-xs text-muted" data-collection-page-status>
                {pageStatus}
              </p>
              <UiPagination
                locale={locale}
                variant="compact"
                currentPage={page}
                totalPages={totalPages}
                hrefBuilder={pageHref}
                interactive={false}
                pageLinkAttrs
                class="justify-center"
              />
            </div>
          )
        }
      </div>
    )
  }

  <template data-icon-template="chevron-left">
    <Icon name="chevron-left" size={16} />
  </template>
  <template data-icon-template="chevron-right">
    <Icon name="chevron-right" size={16} />
  </template>
</BaseLayout>

<script>
  import { formatNumber } from '@/i18n/format';
  import {
    buildCollectionFilterQuery,
    hasActiveCollectionFilters,
    matchesCollectionFilters,
    parseCollectionFilterPage,
    parseCollectionFilters,
    type CollectionFilterState,
    type SerializedCollectionEntry,
  } from '@/libs/content/collection-filters';
  import { paginate } from '@/libs/content/pagination';
  import { renderDynamicPagination } from '@/libs/ui/pagination-dom';
  import { getLenis } from '@/scripts/lenis';
  import { replayStaggerGrid } from '@/scripts/chronotrig';

  const catalogCache = new Map<string, Promise<SerializedCollectionEntry[]>>();

  function fetchCollectionCatalog(
    contentType: string,
    locale: string
  ): Promise<SerializedCollectionEntry[]> {
    const cacheKey = `${contentType}:${locale}`;
    const existing = catalogCache.get(cacheKey);
    if (existing) return existing;

    const request = fetch(
      `/api/collections/${encodeURIComponent(contentType)}/${encodeURIComponent(locale)}.json`
    )
      .then((res) => {
        if (!res.ok) throw new Error(`Catalog HTTP ${res.status}`);
        return res.json() as Promise<SerializedCollectionEntry[]>;
      })
      .catch((error) => {
        catalogCache.delete(cacheKey);
        throw error;
      });

    catalogCache.set(cacheKey, request);
    return request;
  }

  function createDynamicCollectionCard(entry: SerializedCollectionEntry): HTMLLIElement {
    const li = document.createElement('li');
    li.dataset.trig = '';
    li.dataset.trigOnce = 'true';
    li.dataset.dynamicCollectionCard = 'true';

    const link = document.createElement('a');
    link.href = entry.href;
    link.className =
      'group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface transition-colors hover:border-primary/50 hover:bg-surface-hover';

    if (entry.coverSrc) {
      const media = document.createElement('div');
      media.className = 'aspect-video overflow-hidden bg-surface-hover';
      const img = document.createElement('img');
      img.src = entry.coverSrc;
      img.alt = '';
      if (entry.coverWidth) img.width = entry.coverWidth;
      if (entry.coverHeight) img.height = entry.coverHeight;
      img.loading = 'lazy';
      img.decoding = 'async';
      img.className =
        'h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]';
      media.append(img);
      link.append(media);
    }

    const body = document.createElement('div');
    body.className = 'flex flex-1 flex-col gap-2 p-5';

    const h2 = document.createElement('h2');
    h2.className =
      'text-lg font-semibold tracking-tight text-fg transition-colors group-hover:text-primary';
    h2.textContent = entry.title;
    body.append(h2);

    if (entry.description) {
      const desc = document.createElement('p');
      desc.className = 'line-clamp-3 text-sm leading-relaxed text-muted';
      desc.textContent = entry.description;
      body.append(desc);
    }

    if (entry.stack.length > 0) {
      const stackWrap = document.createElement('div');
      stackWrap.className = 'mt-2 flex flex-wrap items-center gap-1.5';
      const badgeClass =
        'inline-flex items-center rounded-full border border-border bg-surface px-2.5 py-0.5 text-[11px] font-medium text-muted';
      for (const tech of entry.stack.slice(0, 3)) {
        const span = document.createElement('span');
        span.className = badgeClass;
        span.textContent = tech;
        stackWrap.append(span);
      }
      if (entry.stack.length > 3) {
        const more = document.createElement('span');
        more.className = badgeClass;
        more.textContent = `+${formatNumber(entry.stack.length - 3, entry.locale)}`;
        stackWrap.append(more);
      }
      body.append(stackWrap);
    }

    const metaParts = [entry.client, entry.formattedYear].filter(Boolean);
    if (metaParts.length > 0) {
      const meta = document.createElement('p');
      meta.className = 'mt-auto pt-3 text-xs text-muted';
      meta.textContent = metaParts.join(' · ');
      body.append(meta);
    }

    link.append(body);
    li.append(link);
    return li;
  }

  function bindCollectionFilters() {
    document.querySelectorAll<HTMLElement>('[data-collection-root]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const abortController = new AbortController();
      document.addEventListener(
        'astro:before-swap',
        () => abortController.abort(),
        { once: true }
      );

      const contentType = root.dataset.contentType || 'projects';
      const locale = root.dataset.locale || document.documentElement.lang || 'en';
      const total = Number(root.dataset.total || '0');
      const totalPages = Number(root.dataset.totalPages || '1');
      const perPage = Math.max(1, Number(root.dataset.perPage || '6'));
      const baseHref = root.dataset.baseHref || window.location.pathname;
      const currentUrl = root.dataset.currentUrl || window.location.pathname;
      const countTemplate = root.dataset.countTemplate || '__V__ / __T__';
      const pageStatusTemplate = root.dataset.pageStatusTemplate ?? '';
      const pageLabelTemplate = root.dataset.pageLabelTemplate ?? '';
      const prevLabel = root.dataset.prevLabel ?? 'Previous';
      const nextLabel = root.dataset.nextLabel ?? 'Next';
      const pagerAriaLabel = root.dataset.pagerAriaLabel ?? 'Pagination';

      const searchInput = root.querySelector<HTMLInputElement>('[data-collection-search]');
      const countEl = root.querySelector<HTMLElement>('[data-collection-count]');
      const clearBtn = root.querySelector<HTMLButtonElement>('[data-collection-clear]');
      const emptyEl = root.querySelector<HTMLElement>('[data-collection-empty]');
      const grid = root.querySelector<HTMLElement>('[data-collection-grid]');
      const pagerWrap = root.querySelector<HTMLElement>('[data-collection-pager-wrap]');
      const serverPagerHtml = pagerWrap?.innerHTML ?? '';
      const cards = [...root.querySelectorAll<HTMLElement>('[data-collection-card]')];
      const catButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-collection-category]')];
      const stackButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-collection-stack]')];

      const initialState = parseCollectionFilters(window.location.search);
      let activeCategory = initialState.category;
      const activeStacks = new Set<string>();
      initialState.stacks.forEach((item) => activeStacks.add(item));
      let query = initialState.query;
      let filterPage = parseCollectionFilterPage(window.location.search);
      let usingDynamicPager = false;
      let renderToken = 0;

      if (searchInput && query) searchInput.value = query;

      const parseList = (raw: string | undefined): string[] => {
        if (!raw) return [];
        try {
          const parsed = JSON.parse(raw);
          return Array.isArray(parsed) ? parsed : [];
        } catch {
          return [];
        }
      };

      const syncChipStyles = (buttons: HTMLButtonElement[], current: string, attrKey: string) => {
        buttons.forEach((btn) => {
          const val = (btn.getAttribute(attrKey) ?? '').trim();
          const active = val === current;
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
      };

      const syncStackChipStyles = () => {
        stackButtons.forEach((btn) => {
          const val = (btn.dataset.collectionStack ?? '').trim();
          const active = val === '' ? activeStacks.size === 0 : activeStacks.has(val);
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
      };

      const currentState = (): CollectionFilterState => ({
        category: activeCategory,
        stacks: [...activeStacks],
        query,
      });

      const clearDynamicCards = () => {
        grid?.querySelectorAll('[data-dynamic-collection-card]').forEach((el) => el.remove());
      };

      const restoreServerPager = () => {
        if (!pagerWrap) return;
        if (usingDynamicPager) {
          pagerWrap.innerHTML = serverPagerHtml;
          usingDynamicPager = false;
        }
        pagerWrap.hidden = totalPages <= 1;
      };

      const applyFilters = async (options: { updateUrl?: boolean; replay?: boolean } = {}) => {
        const { updateUrl = true, replay = true } = options;
        const token = ++renderToken;
        const state = currentState();
        const hasFilter = hasActiveCollectionFilters(state);

        if (totalPages > 1 && hasFilter && grid) {
          try {
            const entries = await fetchCollectionCatalog(contentType, locale);
            if (token !== renderToken) return;

            const matching = entries.filter((entry) => matchesCollectionFilters(entry, state));
            const slice = paginate(matching, filterPage, perPage);
            filterPage = slice.page;

            if (updateUrl) {
              window.history.replaceState(
                window.history.state,
                '',
                `${baseHref}${buildCollectionFilterQuery(state, filterPage)}`
              );
            }

            cards.forEach((card) => {
              card.hidden = true;
              card.classList.add('hidden');
            });
            clearDynamicCards();
            grid.append(...slice.items.map((entry) => createDynamicCollectionCard(entry)));

            if (pagerWrap) {
              usingDynamicPager = renderDynamicPagination({
                container: pagerWrap,
                locale,
                currentPage: slice.page,
                totalPages: slice.totalPages,
                makePageHref: (targetPage) =>
                  `${baseHref}${buildCollectionFilterQuery(state, targetPage)}`,
                pageStatusTemplate,
                pageLabelTemplate,
                prevLabel,
                nextLabel,
                pagerAriaLabel,
                statusDataKey: 'collectionPageStatus',
                navDataKey: 'collectionPagination',
              });
            }

            if (countEl) {
              countEl.textContent = countTemplate
                .replace('__V__', formatNumber(matching.length, locale))
                .replace('__T__', formatNumber(entries.length, locale));
            }
            if (clearBtn) clearBtn.hidden = !hasFilter;
            if (emptyEl) emptyEl.hidden = matching.length > 0;
            if (replay) replayStaggerGrid(grid);
            return;
          } catch {
            if (token !== renderToken) return;
          }
        }

        clearDynamicCards();
        restoreServerPager();

        const filterQuery = buildCollectionFilterQuery(state);
        root.querySelectorAll<HTMLAnchorElement>('[data-page-link]').forEach((link) => {
          const pageBase = link.dataset.pageHref;
          if (pageBase) link.setAttribute('href', `${pageBase}${filterQuery}`);
        });

        if (updateUrl) {
          const targetPath = hasFilter ? `${baseHref}${filterQuery}` : currentUrl;
          window.history.replaceState(window.history.state, '', targetPath);
        }

        let visibleCount = 0;
        let visibilityChanged = false;

        cards.forEach((card) => {
          const entry = {
            categories: parseList(card.dataset.categories),
            stack: parseList(card.dataset.stack),
            searchHaystack: card.dataset.search || '',
          };
          const show = matchesCollectionFilters(entry, state);
          const nextHidden = !show;

          if (card.hidden !== nextHidden) visibilityChanged = true;
          card.hidden = nextHidden;
          card.classList.toggle('hidden', nextHidden);
          if (show) visibleCount += 1;
        });

        if (countEl) {
          countEl.textContent = countTemplate
            .replace('__V__', formatNumber(visibleCount, locale))
            .replace('__T__', formatNumber(total, locale));
        }
        if (clearBtn) clearBtn.hidden = !hasFilter;
        if (emptyEl) emptyEl.hidden = visibleCount > 0;
        if (grid && visibilityChanged) {
          replayStaggerGrid(grid);
        }
      };

      catButtons.forEach((btn) => {
        btn.addEventListener(
          'click',
          () => {
            const nextCategory = (btn.dataset.collectionCategory ?? '').trim();
            if (nextCategory === activeCategory) return;
            activeCategory = nextCategory;
            filterPage = 1;
            syncChipStyles(catButtons, activeCategory, 'data-collection-category');
            void applyFilters({ updateUrl: true });
          },
          { signal: abortController.signal }
        );
      });

      stackButtons.forEach((btn) => {
        btn.addEventListener(
          'click',
          () => {
            const val = (btn.dataset.collectionStack ?? '').trim();
            if (val === '') {
              if (activeStacks.size === 0) return;
              activeStacks.clear();
            } else if (activeStacks.has(val)) {
              activeStacks.delete(val);
            } else {
              activeStacks.add(val);
            }
            filterPage = 1;
            syncStackChipStyles();
            void applyFilters({ updateUrl: true });
          },
          { signal: abortController.signal }
        );
      });

      searchInput?.addEventListener(
        'input',
        () => {
          query = searchInput.value;
          filterPage = 1;
          void applyFilters({ updateUrl: true });
        },
        { signal: abortController.signal }
      );

      clearBtn?.addEventListener(
        'click',
        () => {
          activeCategory = '';
          activeStacks.clear();
          query = '';
          filterPage = 1;
          if (searchInput) searchInput.value = '';
          syncChipStyles(catButtons, '', 'data-collection-category');
          syncStackChipStyles();
          void applyFilters({ updateUrl: true });
        },
        { signal: abortController.signal }
      );

      pagerWrap?.addEventListener(
        'click',
        (event) => {
          const target = (event.target as HTMLElement | null)?.closest<HTMLAnchorElement>(
            '[data-dynamic-page]'
          );
          if (!target) return;

          event.preventDefault();
          const nextPage = Number(target.dataset.dynamicPage);
          if (!Number.isInteger(nextPage) || nextPage < 1 || nextPage === filterPage) return;

          filterPage = nextPage;
          void applyFilters({ updateUrl: true });
          if (grid) {
            const headerOffset = document.querySelector('header.fixed') ? -96 : 0;
            const lenis = getLenis();
            if (lenis) {
              lenis.scrollTo(grid, { offset: headerOffset, duration: 0.9 });
            } else {
              const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              const top = grid.getBoundingClientRect().top + window.scrollY + headerOffset;
              window.scrollTo({
                top: Math.max(0, top),
                behavior: reducedMotion ? 'auto' : 'smooth',
              });
            }
          }
        },
        { signal: abortController.signal }
      );

      document.addEventListener(
        'collection:filters-restore',
        () => {
          const restored = parseCollectionFilters(window.location.search);
          activeCategory = restored.category;
          activeStacks.clear();
          restored.stacks.forEach((item) => activeStacks.add(item));
          query = restored.query;
          filterPage = parseCollectionFilterPage(window.location.search);
          if (searchInput) searchInput.value = query;
          syncChipStyles(catButtons, activeCategory, 'data-collection-category');
          syncStackChipStyles();
          void applyFilters({ updateUrl: false, replay: true });
        },
        { signal: abortController.signal }
      );

      syncChipStyles(catButtons, activeCategory, 'data-collection-category');
      syncStackChipStyles();
      if (hasActiveCollectionFilters(currentState())) {
        void applyFilters({ updateUrl: false, replay: false });
      }
    });
  }

  if (document.documentElement.dataset.collectionFilterBound !== 'true') {
    document.documentElement.dataset.collectionFilterBound = 'true';
    window.addEventListener('popstate', () => {
      document.dispatchEvent(new CustomEvent('collection:filters-restore'));
    });
    document.addEventListener('astro:page-load', bindCollectionFilters);
  }
  bindCollectionFilters();
</script>
