---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CollectionBrowser from '@/components/CollectionBrowser.astro';
import PageHeader from '@/components/PageHeader.astro';
import {
  buildBreadcrumbSchema,
  getBreadcrumbs,
  getCollectionPageHref,
  getHomeHref,
} from '@/libs/content/service';
import {
  getContentType,
  getContentTypeDescription,
  getContentTypeIndexHref,
  getContentTypeLabel,
  type ContentTypeKey,
} from '@/libs/content/types';
import { absoluteUrl, siteConfig } from '@/libs/config/app';
import { buildOgRouteKey, type SocialCardContext } from '@/libs/content/social';
import { formatNumber } from '@/i18n/format';
import { getLocaleMeta, type Locale } from '@/i18n/locales';
import * as m from '@/paraglide/messages';

/**
 * Listing page of a content type declared in `content.types`.
 *
 * Delegates rendering of the schema-driven filter form, card grid, and
 * pagination to `<CollectionBrowser />`.
 */
interface Props {
  contentType: ContentTypeKey;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
  switcherAlternates?: Partial<Record<Locale, string>>;
  url: string;
  page: number;
  totalPages: number;
  perPage: number;
}

const {
  contentType,
  locale,
  alternates,
  switcherAlternates,
  url,
  page,
  totalPages,
  perPage,
} = Astro.props;

const type = getContentType(contentType);
const baseTitle = getContentTypeLabel(contentType, locale);
const description = getContentTypeDescription(contentType, locale);
const pageStatus = m.blog_pagination_status(
  { page: formatNumber(page, locale), totalPages: formatNumber(totalPages, locale) },
  { locale }
);
const title = page > 1 ? `${baseTitle} — ${pageStatus}` : baseTitle;

const breadcrumbs = getBreadcrumbs(url, locale, {
  home: m.nav_home({}, { locale }),
  homeHref: await getHomeHref(locale),
  blog: m.nav_blog({}, { locale }),
  section: { label: baseTitle, href: getCollectionPageHref(type.base, 1, locale) },
  current: page > 1 ? pageStatus : baseTitle,
});

const indexHref = getContentTypeIndexHref(contentType, locale);
const pageHref = (target: number) => getCollectionPageHref(type.base, target, locale);
const previousHref = page > 1 ? pageHref(page - 1) : undefined;
const nextHref = page < totalPages ? pageHref(page + 1) : undefined;
const meta = getLocaleMeta(locale);

const indexSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: absoluteUrl(url),
    inLanguage: meta.htmlLang,
    isPartOf: {
      '@type': 'WebSite',
      name: siteConfig.name,
      url: absoluteUrl(breadcrumbs[0].href),
    },
  },
  buildBreadcrumbSchema(breadcrumbs, absoluteUrl),
];
const ogContext: SocialCardContext = {
  routeKey: buildOgRouteKey('collection-index', { contentType, page, locale }),
  title,
  subtitle: description,
  kicker: siteConfig.name,
  locale,
};
---

<BaseLayout
  title={title}
  description={description}
  ogContext={ogContext}
  schema={indexSchema}
  locale={locale}
  url={url}
  alternates={alternates}
  switcherAlternates={switcherAlternates}
  prevUrl={previousHref}
  nextUrl={nextHref}
>
  <PageHeader title={baseTitle} description={description} locale={locale} breadcrumbs={breadcrumbs} />

  <CollectionBrowser
    collection={contentType}
    locale={locale}
    page={page}
    totalPages={totalPages}
    perPage={perPage}
    baseHref={indexHref}
    currentUrl={url}
    syncUrl={true}
  />
</BaseLayout>
