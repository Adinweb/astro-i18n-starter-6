---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import HeroCopy from '@/components/HeroCopy.astro';
import Reveal from '@/components/Reveal.astro';
import { getLocaleMeta, type Locale } from '@/i18n/locales';
import { absoluteUrl, siteConfig } from '@/libs/config/app';
import { buildBreadcrumbSchema, getBreadcrumbs } from '@/libs/content/service';
import * as m from '@/paraglide/messages';

interface Props {
  entry: CollectionEntry<'pages'>;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
  url: string;
}

const { entry, locale, alternates, url } = Astro.props;
const { Content } = await render(entry);

const breadcrumbs = getBreadcrumbs(url, locale, {
  home: m.nav_home({}, { locale }),
  blog: m.nav_blog({}, { locale }),
  current: entry.data.title,
});

const meta = getLocaleMeta(locale);
const pageSchema =
  breadcrumbs.length > 1
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'WebPage',
          name: entry.data.title,
          description: entry.data.description ?? m.site_description({}, { locale }),
          url: absoluteUrl(url),
          inLanguage: meta.htmlLang,
          isPartOf: {
            '@type': 'WebSite',
            name: siteConfig.name,
            url: absoluteUrl(breadcrumbs[0].href),
          },
        },
        buildBreadcrumbSchema(breadcrumbs, absoluteUrl),
      ]
    : undefined;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  schema={pageSchema}
  locale={locale}
  url={url}
  alternates={alternates}
  hero
>
  <PageHero slot="hero" image={entry.data.image}>
    <HeroCopy title={entry.data.title} description={entry.data.description} />
  </PageHero>

  <Reveal as="article" direction="up" delay={100} class="prose">
    <Content />
  </Reveal>
</BaseLayout>

