---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PageHero from '@/components/PageHero.astro';
import HeroCopy from '@/components/HeroCopy.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getLocaleMeta, type Locale } from '@/i18n/locales';
import { absoluteUrl, siteConfig } from '@/libs/config/app';
import { parseContentEntryId } from '@/libs/content/entries';
import { buildBreadcrumbSchema, getBreadcrumbs, getHomeHref } from '@/libs/content/service';
import { buildOgRouteKey, type SocialCardContext } from '@/libs/content/social';
import HomePageTemplate from '@/views/pages/HomePageTemplate.astro';
import { CLIENT_PAGE_TEMPLATES } from '@client/templates/index';
import * as m from '@/paraglide/messages';

const PAGE_TEMPLATES: Record<string, any> = {
  home: HomePageTemplate,
  ...CLIENT_PAGE_TEMPLATES,
};

interface Props {
  entry: CollectionEntry<'pages'>;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
  url: string;
}

const { entry, locale, alternates, url } = Astro.props;
const CustomTemplate = entry.data.template
  ? PAGE_TEMPLATES[entry.data.template]
  : undefined;

const { Content } = CustomTemplate ? { Content: null } : await render(entry);

const breadcrumbs = getBreadcrumbs(url, locale, {
  home: m.nav_home({}, { locale }),
  homeHref: await getHomeHref(locale),
  blog: m.nav_blog({}, { locale }),
  current: entry.data.title,
});

const meta = getLocaleMeta(locale);
const pageSchema =
  breadcrumbs.length > 1
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'WebPage',
          name: entry.data.title,
          description: entry.data.description ?? m.site_description({}, { locale }),
          url: absoluteUrl(url),
          inLanguage: meta.htmlLang,
          isPartOf: {
            '@type': 'WebSite',
            name: siteConfig.name,
            url: absoluteUrl(breadcrumbs[0].href),
          },
        },
        buildBreadcrumbSchema(breadcrumbs, absoluteUrl),
      ]
    : undefined;

const { group } = parseContentEntryId(entry.id);
const ogContext: SocialCardContext = {
  routeKey: buildOgRouteKey('page', { group, locale }),
  title: entry.data.title,
  subtitle: entry.data.description,
  kicker: siteConfig.name,
  locale,
};

const rawHero = entry.data.hero;
const heroMode = rawHero === true ? 'default' : rawHero === false ? 'none' : rawHero;
const containerMode = entry.data.container;
const isDefaultHero = heroMode === 'default';
const isMinimalHero = heroMode === 'minimal';
const isCanvas = containerMode === 'canvas';
---

{
  CustomTemplate ? (
    <CustomTemplate
      entry={entry}
      locale={locale}
      alternates={alternates}
      url={url}
      schema={pageSchema}
      ogContext={ogContext}
    />
  ) : (
    <BaseLayout
      title={entry.data.title}
      description={entry.data.description}
      image={entry.data.image}
      ogContext={ogContext}
      schema={pageSchema}
      locale={locale}
      url={url}
      alternates={alternates}
      hero={isDefaultHero}
      flushTop={!isDefaultHero && entry.data.flushTop}
      canvas={isCanvas}
    >
      {isDefaultHero && (
        <PageHero slot="hero" image={entry.data.image}>
          <HeroCopy title={entry.data.title} description={entry.data.description}>
            {breadcrumbs.length > 1 && (
              <Breadcrumbs
                slot="prelude"
                items={breadcrumbs}
                locale={locale}
                separator="chevron"
                showHomeIcon={true}
                surface="hero"
                size="xs"
                truncateLast
              />
            )}
          </HeroCopy>
        </PageHero>
      )}

      {isCanvas ? (
        <>
          {isMinimalHero && (
            <div class="layout-container pt-2">
              <PageHeader
                title={entry.data.title}
                description={entry.data.description}
                locale={locale}
                breadcrumbs={breadcrumbs}
              />
            </div>
          )}
          {Content && <Content />}
        </>
      ) : (
        <>
          {isMinimalHero && (
            <PageHeader
              title={entry.data.title}
              description={entry.data.description}
              locale={locale}
              breadcrumbs={breadcrumbs}
            />
          )}
          {containerMode === 'contained' ? (
            <div class:list={['prose prose-wide', isMinimalHero && 'pt-8 sm:pt-10']}>
              {Content && <Content />}
            </div>
          ) : (
            <article class:list={['prose w-full max-w-5xl', isMinimalHero && 'pt-8 sm:pt-10']}>
              {Content && <Content />}
            </article>
          )}
        </>
      )}
    </BaseLayout>
  )
}
