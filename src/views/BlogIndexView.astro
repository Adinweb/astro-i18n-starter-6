---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import HeroCopy from '@/components/HeroCopy.astro';
import PostCard from '@/components/PostCard.astro';
import Icon from '@/components/Icon.astro';
import Reveal from '@/components/Reveal.astro';
import {
  buildBreadcrumbSchema,
  getBreadcrumbs,
  getBlogIndexHref,
  getBlogPageHref,
  getBlogPostHref,
} from '@/libs/content/service';
import {
  buildBlogFilterQuery,
  collectTaxonomyKeys,
  type BlogFilters,
} from '@/libs/content/blog';
import { getSortedLocaleEntries } from '@/libs/content/entries';
import { buildPageWindow, PAGE_GAP, paginate } from '@/libs/content/pagination';
import { getCategoryLabel, getTagLabel } from '@/libs/content/taxonomy';
import { absoluteUrl, siteConfig } from '@/libs/config/app';
import { getLocaleMeta, type Locale } from '@/i18n/locales';
import { formatNumber } from '@/i18n/format';
import * as m from '@/paraglide/messages';

interface Props {
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
  url: string;
  /** 1-based number of the page this route serves. */
  page: number;
  /** How many pages the locale's blog index has. */
  totalPages: number;
  /** How many posts a page holds. */
  perPage: number;
}

const { locale, alternates, url, page, totalPages, perPage } = Astro.props;

const posts = getSortedLocaleEntries(await getCollection('blog'), locale);

// The taxonomy chips are built from the whole collection, so every page of
// the index offers the same filters.
const taxonomy = posts.map((post) => post.data);
const categories = collectTaxonomyKeys(taxonomy, 'categories');
const tags = collectTaxonomyKeys(taxonomy, 'tags');
const blogHref = getBlogIndexHref(locale);

// Only the posts of the current page are rendered; the pager links to the
// rest of the collection.
const { items: pagePosts } = paginate(posts, page, perPage);

const filterHref = (filters: BlogFilters) => `${blogHref}${buildBlogFilterQuery(filters)}`;
const formattedPageCount = formatNumber(pagePosts.length, locale);
const totalLabel = m.blog_filter_showing_page(
  { visible: formattedPageCount, total: formattedPageCount },
  { locale }
);

const pageHref = (target: number) => getBlogPageHref(target, locale);
const previousHref = page > 1 ? pageHref(page - 1) : undefined;
const nextHref = page < totalPages ? pageHref(page + 1) : undefined;
const pageWindow = buildPageWindow(page, totalPages);

const pageStatus = m.blog_pagination_status(
  { page: formatNumber(page, locale), totalPages: formatNumber(totalPages, locale) },
  { locale }
);
// Only the deeper pages need a distinct document title; page one keeps the
// plain name of the blog.
const pageTitle = page > 1 ? `${m.nav_blog({}, { locale })} — ${pageStatus}` : m.nav_blog({}, { locale });
const indexDescription = m.blog_index_description({}, { locale });
const breadcrumbs = getBreadcrumbs(blogHref, locale, {
  home: m.nav_home({}, { locale }),
  blog: m.nav_blog({}, { locale }),
});
const meta = getLocaleMeta(locale);
const indexSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: pageTitle,
    description: indexDescription,
    url: absoluteUrl(url),
    inLanguage: meta.htmlLang,
    isPartOf: {
      '@type': 'WebSite',
      name: siteConfig.name,
      url: absoluteUrl(breadcrumbs[0].href),
    },
  },
  buildBreadcrumbSchema(breadcrumbs, absoluteUrl),
];
---

<BaseLayout
  title={pageTitle}
  description={indexDescription}
  schema={indexSchema}
  locale={locale}
  url={url}
  alternates={alternates}
  prevUrl={previousHref}
  nextUrl={nextHref}
  hero
>
  <PageHero slot="hero">
    <HeroCopy title={m.nav_blog({}, { locale })} description={m.blog_index_description({}, { locale })} />
  </PageHero>

  <div class="space-y-8">
    {
      posts.length === 0 ? (
        <p class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center text-sm text-muted">
          {m.blog_empty({}, { locale })}
        </p>
      ) : (
        <div class="space-y-8">
          <section
            class="reveal space-y-4 rounded-2xl border border-border bg-surface/70 p-4 sm:p-5"
            data-reveal="up"
            data-blog-filter
            hidden
            data-locale={locale}
            data-total-pages={String(totalPages)}
            data-base-href={url}
            data-showing-template={m.blog_filter_showing_page(
              { visible: '{visible}', total: '{total}' },
              { locale }
            )}
            data-showing-all-template={m.blog_filter_showing_all(
              { visible: '{visible}', total: '{total}' },
              { locale }
            )}
          >
            <nav class="flex flex-wrap items-center gap-2" aria-label={m.blog_filter_by_category({}, { locale })}>
              <span class="me-1 text-[11px] font-semibold uppercase tracking-wider text-muted">
                {m.blog_categories({}, { locale })}
              </span>
              <a
                href={blogHref}
                data-filter-chip
                data-filter-category=""
                class="chip px-3 py-1.5 text-xs"
              >
                {m.blog_all_posts({}, { locale })}
              </a>
              {
                categories.map((category) => (
                  <a
                    href={filterHref({ category, tags: [] })}
                    data-filter-chip
                    data-filter-category={category}
                    class="chip px-3 py-1.5 text-xs"
                  >
                    {getCategoryLabel(category, locale)}
                  </a>
                ))
              }
            </nav>

            <div class="h-px bg-border"></div>

            <div class="flex flex-wrap items-center gap-2" role="group" aria-label={m.blog_filter_by_tag({}, { locale })}>
              <span class="me-1 text-[11px] font-semibold uppercase tracking-wider text-muted">
                {m.blog_tags({}, { locale })}
              </span>
              {
                tags.map((tag) => (
                  <a
                    href={filterHref({ category: null, tags: [tag] })}
                    data-filter-chip
                    data-filter-tag={tag}
                    class="chip px-3 py-1.5 text-xs"
                  >
                    <span class="me-1 text-muted/70" aria-hidden="true" dir="ltr">#</span>
                    {getTagLabel(tag, locale)}
                  </a>
                ))
              }
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 text-xs text-muted">
              <p role="status" aria-live="polite" data-blog-status>{totalLabel}</p>
              <a
                href={blogHref}
                data-blog-clear
                class="font-medium text-primary hover:underline"
                hidden
              >
                {m.blog_filter_clear({}, { locale })}
              </a>
            </div>
          </section>

          <p
            class="rounded-2xl border border-dashed border-border bg-surface p-10 text-center text-sm text-muted"
            data-blog-empty
            hidden
          >
            {m.blog_filter_empty({}, { locale })}
          </p>

          <div class="reveal-stagger grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-blog-grid data-pagefind-ignore>
            {
              pagePosts.map((post, index) => (
                <PostCard
                  post={post}
                  locale={locale}
                  href={getBlogPostHref(post.data.slug, locale)}
                  priority={index === 0}
                />
              ))
            }
          </div>

          {
            totalPages > 1 && (
              <Reveal direction="up" class="mt-10 space-y-3" data-blog-pager-wrap>
                <p class="text-center text-xs text-muted" data-blog-page-status>
                  {pageStatus}
                </p>
                <nav
                  class="flex flex-wrap items-center justify-center gap-1.5"
                  aria-label={m.blog_pagination_label({}, { locale })}
                  data-blog-pagination
                >
                  {previousHref && (
                    <a
                      href={previousHref}
                      rel="prev"
                      data-page-link="previous"
                      data-page-href={previousHref}
                      class="btn-secondary gap-1.5 px-4 py-2 text-xs"
                    >
                      <Icon name="chevron-left" size={16} class="shrink-0 rtl:rotate-180" />
                      {m.blog_pagination_previous({}, { locale })}
                    </a>
                  )}

                  {pageWindow.map((entry) =>
                    entry === PAGE_GAP ? (
                      <span class="px-1 text-xs text-muted" aria-hidden="true">
                        …
                      </span>
                    ) : (
                      <a
                        href={pageHref(entry)}
                        data-page-link="page"
                        data-page-href={pageHref(entry)}
                        aria-label={m.blog_pagination_page({ page: formatNumber(entry, locale) }, { locale })}
                        aria-current={entry === page ? 'page' : undefined}
                        class="chip h-9 min-w-9 justify-center px-3 text-xs"
                      >
                        {formatNumber(entry, locale)}
                      </a>
                    )
                  )}

                  {nextHref && (
                    <a
                      href={nextHref}
                      rel="next"
                      data-page-link="next"
                      data-page-href={nextHref}
                      class="btn-secondary gap-1.5 px-4 py-2 text-xs"
                    >
                      {m.blog_pagination_next({}, { locale })}
                      <Icon
                        name="chevron-left"
                        size={16}
                        class="shrink-0 rotate-180 rtl:rotate-0"
                      />
                    </a>
                  )}
                </nav>
              </Reveal>
            )
          }
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  /* Card layout uses `flex`, so enforce the hidden state explicitly. */
  [data-post-card][hidden] {
    display: none !important;
  }
</style>

<script>
  import { formatNumber } from '@/i18n/format';
  import { initReveals } from '@/scripts/reveal';
  import {
    NO_FILTERS,
    buildBlogFilterQuery,
    hasActiveFilters,
    matchesBlogFilters,
    parseBlogFilters,
    toggleBlogTag,
    type BlogFilters,
    type BlogTaxonomy,
    type SerializedBlogPost,
  } from '@/libs/content/blog';

  let catalogPromise: Promise<SerializedBlogPost[]> | null = null;

  function fetchBlogCatalog(): Promise<SerializedBlogPost[]> {
    if (!catalogPromise) {
      catalogPromise = fetch('/api/blog-posts.json')
        .then((res) => {
          if (!res.ok) throw new Error(`Catalog HTTP ${res.status}`);
          return res.json() as Promise<SerializedBlogPost[]>;
        })
        .catch((error) => {
          catalogPromise = null;
          throw error;
        });
    }
    return catalogPromise;
  }

  function createDynamicPostCard(post: SerializedBlogPost): HTMLElement {
    const article = document.createElement('article');
    article.className =
      'reveal group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-xs transition duration-200 hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-lg focus-within:border-primary/60 focus-within:ring-2 focus-within:ring-primary/30';
    article.dataset.reveal = 'up';
    article.dataset.dynamicPostCard = 'true';

    const media = document.createElement('div');
    media.className =
      'relative aspect-[16/9] overflow-hidden bg-linear-to-br from-primary/20 via-surface-hover to-accent/15';

    if (post.coverSrc) {
      const img = document.createElement('img');
      img.src = post.coverSrc;
      img.alt = '';
      if (post.coverWidth) img.width = post.coverWidth;
      if (post.coverHeight) img.height = post.coverHeight;
      img.loading = 'lazy';
      img.decoding = 'async';
      img.className =
        'h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]';
      media.append(img);
    } else {
      const placeholder = document.createElement('div');
      placeholder.className = 'flex h-full items-center justify-center text-primary/40';
      const svgNs = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(svgNs, 'svg');
      svg.setAttribute('width', '44');
      svg.setAttribute('height', '44');
      svg.setAttribute('aria-hidden', 'true');
      const use = document.createElementNS(svgNs, 'use');
      use.setAttribute('href', '/icons.svg#globe');
      svg.append(use);
      placeholder.append(svg);
      media.append(placeholder);
    }

    if (post.categoryLabel) {
      const badge = document.createElement('span');
      badge.className = 'hero-badge absolute bottom-3 start-3';
      badge.textContent = post.categoryLabel;
      media.append(badge);
    }

    const content = document.createElement('div');
    content.className = 'flex flex-1 flex-col gap-2.5 p-5';

    const heading = document.createElement('h2');
    heading.className = 'line-clamp-2 text-lg font-bold leading-snug tracking-tight text-fg';
    const link = document.createElement('a');
    link.href = post.href;
    link.className =
      'transition-colors after:absolute after:inset-0 hover:text-primary focus-visible:outline-none';
    link.textContent = post.title;
    heading.append(link);
    content.append(heading);

    if (post.description) {
      const desc = document.createElement('p');
      desc.className = 'line-clamp-2 text-sm leading-relaxed text-muted';
      desc.textContent = post.description;
      content.append(desc);
    }

    if (post.tagLabels.length > 0) {
      const tagList = document.createElement('ul');
      tagList.className = 'flex flex-wrap items-center gap-1.5 text-[11px] text-muted';
      for (const label of post.tagLabels) {
        const li = document.createElement('li');
        li.className = 'chip px-2 py-0.5 text-[11px]';
        li.textContent = label;
        tagList.append(li);
      }
      if (post.hiddenTagCount > 0) {
        const more = document.createElement('li');
        more.className = 'chip px-2 py-0.5 text-[11px]';
        more.textContent = `+${formatNumber(post.hiddenTagCount, post.locale)}`;
        tagList.append(more);
      }
      content.append(tagList);
    }

    const footer = document.createElement('div');
    footer.className = 'mt-auto flex flex-wrap items-center gap-x-2 gap-y-1 pt-2 text-xs text-muted';
    const time = document.createElement('time');
    time.dateTime = post.publishedIso;
    time.textContent = post.formattedDate;
    const dot = document.createElement('span');
    dot.setAttribute('aria-hidden', 'true');
    dot.textContent = '·';
    const readTime = document.createElement('span');
    readTime.textContent = post.readingTimeLabel;
    footer.append(time, dot, readTime);
    content.append(footer);

    article.append(media, content);
    return article;
  }

  function setupBlogFilters() {
    const root = document.querySelector<HTMLElement>('[data-blog-filter]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    root.hidden = false;
    initReveals();

    const cards = [...document.querySelectorAll<HTMLElement>('[data-post-card]')].map((element) => ({
      element,
      taxonomy: {
        categories: (element.dataset.categories ?? '').split(' ').filter(Boolean),
        tags: (element.dataset.tags ?? '').split(' ').filter(Boolean),
      } satisfies BlogTaxonomy,
    }));

    const grid = document.querySelector<HTMLElement>('[data-blog-grid]');
    const pagerWrap = document.querySelector<HTMLElement>('[data-blog-pager-wrap]');
    const status = root.querySelector<HTMLElement>('[data-blog-status]');
    const empty = document.querySelector<HTMLElement>('[data-blog-empty]');
    const clear = root.querySelector<HTMLAnchorElement>('[data-blog-clear]');
    const categoryChips = [...root.querySelectorAll<HTMLAnchorElement>('[data-filter-category]')];
    const tagChips = [...root.querySelectorAll<HTMLAnchorElement>('[data-filter-tag]')];
    const pageLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-page-link]')];
    const pageTemplate = root.dataset.showingTemplate ?? '';
    const allTemplate = root.dataset.showingAllTemplate ?? pageTemplate;
    const baseHref = root.dataset.baseHref ?? window.location.pathname;
    const locale = root.dataset.locale ?? 'en';
    const totalPages = Number(root.dataset.totalPages ?? '1');

    let filters: BlogFilters = parseBlogFilters(window.location.search);
    let renderToken = 0;

    const setActive = (element: HTMLElement, active: boolean) => {
      if (active) element.setAttribute('aria-current', 'true');
      else element.removeAttribute('aria-current');
    };

    const clearDynamicCards = () => {
      grid?.querySelectorAll('[data-dynamic-post-card]').forEach((el) => el.remove());
    };

    const render = async (updateUrl = true) => {
      const token = ++renderToken;
      const active = hasActiveFilters(filters);

      for (const chip of categoryChips) {
        const isAllChip = chip.dataset.filterCategory === '';
        setActive(
          chip,
          isAllChip ? !active : chip.dataset.filterCategory === filters.category
        );
      }
      for (const chip of tagChips) {
        setActive(chip, filters.tags.includes(chip.dataset.filterTag ?? ''));
      }

      if (clear) clear.hidden = !active;

      const query = buildBlogFilterQuery(filters);
      for (const link of pageLinks) {
        const pageBase = link.dataset.pageHref;
        if (pageBase) link.setAttribute('href', `${pageBase}${query}`);
      }

      if (updateUrl) {
        // Preserve Astro's router state: replacing it with `null` breaks the
        // ClientRouter's history handling when navigating back to this page.
        window.history.replaceState(
          window.history.state,
          '',
          `${baseHref}${query}`
        );
      }

      // Multi-page blog with active filters: search the full collection across all pages.
      if (active && totalPages > 1 && grid) {
        try {
          const catalog = await fetchBlogCatalog();
          if (token !== renderToken) return;

          const localePosts = catalog.filter((post) => post.locale === locale);
          const matching = localePosts.filter((post) => matchesBlogFilters(post, filters));

          for (const card of cards) card.element.hidden = true;
          if (pagerWrap) pagerWrap.hidden = true;

          clearDynamicCards();
          grid.append(...matching.map((post) => createDynamicPostCard(post)));
          initReveals();

          if (status) {
            status.textContent = allTemplate
              .replace('{visible}', formatNumber(matching.length, locale))
              .replace('{total}', formatNumber(localePosts.length, locale));
          }
          if (empty) empty.hidden = matching.length !== 0;
          return;
        } catch {
          // Graceful fallback: filter the server-rendered cards on the current page.
          if (token !== renderToken) return;
        }
      }

      clearDynamicCards();
      if (pagerWrap) pagerWrap.hidden = false;

      let visible = 0;
      for (const card of cards) {
        const matches = matchesBlogFilters(card.taxonomy, filters);
        card.element.hidden = !matches;
        if (matches) visible += 1;
      }

      const statusTemplate = active ? allTemplate : pageTemplate;
      if (status) {
        status.textContent = statusTemplate
          .replace('{visible}', formatNumber(visible, locale))
          .replace('{total}', formatNumber(cards.length, locale));
      }
      if (empty) empty.hidden = visible !== 0;
    };

    root.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement | null)?.closest<HTMLAnchorElement>(
        '[data-filter-chip], [data-blog-clear]'
      );
      if (!target) return;

      event.preventDefault();

      if (target.hasAttribute('data-blog-clear')) {
        filters = NO_FILTERS;
      } else if (target.dataset.filterCategory !== undefined) {
        const category = target.dataset.filterCategory || null;
        filters = category === null ? NO_FILTERS : { category, tags: filters.tags };
      } else if (target.dataset.filterTag) {
        filters = toggleBlogTag(filters, target.dataset.filterTag);
      }

      void render();
    });

    document.addEventListener('blog:filters-restore', () => {
      filters = parseBlogFilters(window.location.search);
      void render(false);
    });

    void render(false);
  }

  if (document.documentElement.dataset.blogFilterHistoryBound !== 'true') {
    document.documentElement.dataset.blogFilterHistoryBound = 'true';
    window.addEventListener('popstate', () => {
      document.dispatchEvent(new CustomEvent('blog:filters-restore'));
    });
  }

  setupBlogFilters();
  document.addEventListener('astro:page-load', setupBlogFilters);
</script>
