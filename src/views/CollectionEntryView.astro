---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import PageHero from '@/components/PageHero.astro';
import HeroCopy from '@/components/HeroCopy.astro';
import Icon from '@/components/ui/Icon.astro';
import UiBadge from '@/components/ui/UiBadge.astro';
import {
  buildBreadcrumbSchema,
  getBreadcrumbs,
  getHomeHref,
  type GenericCollectionEntry,
} from '@/libs/content/service';
import {
  getContentType,
  getContentTypeFieldLabel,
  getContentTypeIndexHref,
  getContentTypeLabel,
  getContentTypeOptionLabel,
  type ContentTypeKey,
} from '@/libs/content/types';
import { formatEntryFieldForDisplay } from '@/libs/content/collection-catalog';
import { parseContentEntryId } from '@/libs/content/entries';
import { getCollectionCategoryLabel } from '@/libs/content/taxonomy';
import { buildOgRouteKey, getSocialCard, type SocialCardContext } from '@/libs/content/social';
import { absoluteUrl, siteConfig } from '@/libs/config/app';
import { formatYear } from '@/i18n/format';
import { getLocaleMeta, type Locale } from '@/i18n/locales';
import * as m from '@/paraglide/messages';

/**
 * Entry page of a content type declared in `content.types`.
 *
 * Shared by every non-blog collection: hero, prose body, schema-driven entry meta,
 * and navigation back to the collection index.
 */
interface Props {
  contentType: ContentTypeKey;
  entry: GenericCollectionEntry;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
  url: string;
}

const { contentType, entry, locale, alternates, url } = Astro.props;
const { Content } = await render(entry as CollectionEntry<'projects'>);
const rawData = entry.data as Record<string, unknown>;
const { title, description, image, client, year, link, stack = [], categories = [] } = entry.data;

const typeConfig = getContentType(contentType);
const typeLabel = getContentTypeLabel(contentType, locale);
const indexHref = getContentTypeIndexHref(contentType, locale);

const breadcrumbs = getBreadcrumbs(url, locale, {
  home: m.nav_home({}, { locale }),
  homeHref: await getHomeHref(locale),
  blog: m.nav_blog({}, { locale }),
  section: { label: typeLabel, href: indexHref },
  current: title,
});

const { group } = parseContentEntryId(entry.id);
const ogContext: SocialCardContext = {
  routeKey: buildOgRouteKey('collection-entry', { contentType, group, locale }),
  title,
  subtitle: description,
  kicker: typeLabel,
  locale,
};

const canonicalUrl = absoluteUrl(url);
const socialImage = await getSocialCard(image, ogContext);
const socialImageUrl = socialImage.url;
const meta = getLocaleMeta(locale);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: title,
    description: description ?? m.site_description({}, { locale }),
    image: socialImageUrl,
    url: canonicalUrl,
    inLanguage: meta.htmlLang,
    ...(year ? { dateCreated: `${year}-01-01` } : {}),
    creator: {
      '@type': 'Organization',
      name: siteConfig.name,
      url: absoluteUrl(breadcrumbs[0].href),
    },
  },
  buildBreadcrumbSchema(breadcrumbs, absoluteUrl),
];

const metaItems: { label: string; value: string }[] = [];
if (client) metaItems.push({ label: `${m.projects_client({}, { locale })}`, value: client });
if (year) metaItems.push({ label: `${m.projects_year({}, { locale })}`, value: formatYear(year, locale) });

const handledFields = new Set(['categories', 'tags', 'stack', 'client', 'year', 'link', 'image']);
const extraBadgeGroups: { label: string; items: string[] }[] = [];
let extraLink = link;

for (const field of typeConfig.fields) {
  if (handledFields.has(field.name)) continue;
  if (field.showOnEntry === false) continue;

  const rawVal = rawData[field.name];
  if (rawVal === undefined || rawVal === null || rawVal === '') continue;

  if (field.type === 'url' && !extraLink && typeof rawVal === 'string') {
    extraLink = rawVal;
    continue;
  }

  const label = getContentTypeFieldLabel(contentType, field, locale);

  if (Array.isArray(rawVal) && rawVal.length > 0) {
    extraBadgeGroups.push({
      label,
      items: rawVal.map((item) => getContentTypeOptionLabel(contentType, field, String(item), locale)),
    });
    continue;
  }

  const formatted = formatEntryFieldForDisplay(contentType, field.name, rawVal, typeConfig, locale);
  if (formatted) {
    metaItems.push({ label, value: formatted });
  }
}
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  ogContext={ogContext}
  type="article"
  schema={schema}
  locale={locale}
  url={url}
  alternates={alternates}
  hero
>
  <PageHero slot="hero" image={image} persistKey={image ? `${contentType}:${group}` : 'default'}>
    <HeroCopy title={title} description={description} size="post">
      <Fragment slot="prelude">
        <Breadcrumbs
          items={breadcrumbs}
          locale={locale}
          separator="chevron"
          showHomeIcon={true}
          surface="hero"
          size="xs"
          truncateLast
        />
      </Fragment>
    </HeroCopy>
  </PageHero>

  <article class="w-full max-w-5xl">
    {
      (metaItems.length > 0 || categories.length > 0 || stack.length > 0 || extraBadgeGroups.length > 0 || extraLink) && (
        <div class="mb-8 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3 border-b border-border pb-6 text-sm">
          {(metaItems.length > 0 || categories.length > 0 || stack.length > 0 || extraBadgeGroups.length > 0) && (
            <dl class="flex flex-wrap items-baseline gap-x-8 gap-y-3">
              {metaItems.map((item) => (
                <div class="flex items-baseline gap-2">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-muted rtl:tracking-normal">
                    {item.label}
                  </dt>
                  <dd class="text-fg">{item.value}</dd>
                </div>
              ))}
              {categories.length > 0 && (
                <div class="flex flex-wrap items-baseline gap-2">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-muted rtl:tracking-normal">
                    {m.collection_filter_category({}, { locale })}
                  </dt>
                  <dd class="flex flex-wrap items-center gap-1.5">
                    {categories.map((cat) => (
                      <UiBadge
                        label={getCollectionCategoryLabel(contentType, String(cat), locale)}
                        variant="primary"
                        size="sm"
                        locale={locale}
                        class="font-medium"
                      />
                    ))}
                  </dd>
                </div>
              )}
              {stack.length > 0 && (
                <div class="flex flex-wrap items-baseline gap-2">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-muted rtl:tracking-normal">
                    {m.projects_stack({}, { locale })}
                  </dt>
                  <dd class="flex flex-wrap items-center gap-1.5">
                    {stack.map((item) => (
                      <UiBadge label={item} variant="neutral" size="sm" locale={locale} class="font-medium" />
                    ))}
                  </dd>
                </div>
              )}
              {extraBadgeGroups.map((groupItem) => (
                <div class="flex flex-wrap items-baseline gap-2">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-muted rtl:tracking-normal">
                    {groupItem.label}
                  </dt>
                  <dd class="flex flex-wrap items-center gap-1.5">
                    {groupItem.items.map((badgeLabel) => (
                      <UiBadge label={badgeLabel} variant="neutral" size="sm" locale={locale} class="font-medium" />
                    ))}
                  </dd>
                </div>
              ))}
            </dl>
          )}
          {extraLink && (
            <a
              href={extraLink}
              rel="noopener noreferrer"
              target="_blank"
              class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
            >
              {m.projects_visit({}, { locale })}
              <Icon name="arrow-right" size={14} class="rtl:rotate-180" />
            </a>
          )}
        </div>
      )
    }

    <div class="prose max-w-none">
      <Content />
    </div>

    <footer class="mt-10 border-t border-border pt-6">
      <a
        href={indexHref}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
      >
        <Icon name="arrow-right" size={15} class="rotate-180 rtl:rotate-0" />
        <span>{m.projects_back({}, { locale })}</span>
      </a>
    </footer>
  </article>
</BaseLayout>
