---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBreadcrumbs, getBlogIndexHref } from '@/libs/content/service';
import { siteConfig } from '@/libs/config/site';
import type { Locale } from '@/i18n/config';
import * as m from '@/paraglide/messages';

interface Props {
  entry: CollectionEntry<'blog'>;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
  url: string;
}

const { entry, locale, alternates, url } = Astro.props;
const { Content } = await render(entry);

const breadcrumbs = getBreadcrumbs(url, locale, {
  home: m.nav_home({}, { locale }),
  blog: m.nav_blog({}, { locale }),
  current: entry.data.title,
});
const blogIndexHref = getBlogIndexHref(locale);

const formattedDate = entry.data.publishedAt.toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const canonicalUrl = new URL(url, siteConfig.url).href;
const imageUrl = entry.data.image
  ? new URL(entry.data.image, siteConfig.url).href
  : new URL(siteConfig.ogImage, siteConfig.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  image: imageUrl,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: (entry.data.updatedAt ?? entry.data.publishedAt).toISOString(),
  inLanguage: locale,
  mainEntityOfPage: canonicalUrl,
  author: {
    '@type': entry.data.author ? 'Person' : 'Organization',
    name: entry.data.author ?? siteConfig.name,
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.url,
  },
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  type="article"
  publishedTime={entry.data.publishedAt.toISOString()}
  schema={schema}
  locale={locale}
  url={url}
  alternates={alternates}
>
  <nav aria-label={m.common_breadcrumbs({}, { locale })} class="mb-6">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-muted">
      {
        breadcrumbs.map((crumb, idx) => (
          <li class="flex items-center gap-2">
            {idx > 0 && <span>/</span>}
            {idx === breadcrumbs.length - 1 ? (
              <span class="text-fg font-medium truncate max-w-xs">{crumb.label}</span>
            ) : (
              <a href={crumb.href} class="hover:text-primary transition-colors">
                {crumb.label}
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </nav>

  <article class="max-w-3xl">
    <header class="border-b border-border pb-6 mb-8">
      <div class="text-xs text-muted mb-2">
        <span>{m.common_published_on({}, { locale })} </span>
        <time datetime={entry.data.publishedAt.toISOString()}>{formattedDate}</time>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-fg">
        {entry.data.title}
      </h1>
      {entry.data.description && (
        <p class="text-base text-muted mt-3">{entry.data.description}</p>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="mt-12 pt-6 border-t border-border">
      <a
        href={blogIndexHref}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
      >
        <span class="inline-block rtl:rotate-180">←</span> {m.common_back_to_blog({}, { locale })}
      </a>
    </footer>
  </article>
</BaseLayout>
