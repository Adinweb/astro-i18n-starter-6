---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBreadcrumbs, getBlogIndexHref } from '@/libs/content/service';
import { buildBlogFilterQuery, getReadingTime } from '@/libs/content/blog';
import { getCategoryLabel, getTagLabel } from '@/libs/content/taxonomy';
import { siteConfig } from '@/libs/config/site';
import type { Locale } from '@/i18n/config';
import * as m from '@/paraglide/messages';

interface Props {
  entry: CollectionEntry<'blog'>;
  locale: Locale;
  alternates: Partial<Record<Locale, string>>;
  url: string;
}

const { entry, locale, alternates, url } = Astro.props;
const { Content } = await render(entry);
const { title, description, image, categories, tags, author, publishedAt, updatedAt } = entry.data;

const breadcrumbs = getBreadcrumbs(url, locale, {
  home: m.nav_home({}, { locale }),
  blog: m.nav_blog({}, { locale }),
  current: title,
});
const blogIndexHref = getBlogIndexHref(locale);
const categoryHref = (category: string) =>
  `${blogIndexHref}${buildBlogFilterQuery({ category, tags: [] })}`;
const tagHref = (tag: string) => `${blogIndexHref}${buildBlogFilterQuery({ category: null, tags: [tag] })}`;

const formattedDate = publishedAt.toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const readingTime = getReadingTime(entry.body);

const canonicalUrl = new URL(url, siteConfig.url).href;
const imageUrl = image
  ? new URL(image, siteConfig.url).href
  : new URL(siteConfig.ogImage, siteConfig.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: imageUrl,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  inLanguage: locale,
  articleSection: categories.map((category) => getCategoryLabel(category, locale)),
  keywords: tags.map((tag) => getTagLabel(tag, locale)),
  mainEntityOfPage: canonicalUrl,
  author: {
    '@type': author ? 'Person' : 'Organization',
    name: author ?? siteConfig.name,
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.url,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime={publishedAt.toISOString()}
  schema={schema}
  locale={locale}
  url={url}
  alternates={alternates}
>
  <nav aria-label={m.common_breadcrumbs({}, { locale })} class="mb-6">
    <ol class="flex flex-wrap items-center gap-2 text-xs text-muted">
      {
        breadcrumbs.map((crumb, idx) => (
          <li class="flex items-center gap-2">
            {idx > 0 && <span>/</span>}
            {idx === breadcrumbs.length - 1 ? (
              <span class="max-w-xs truncate font-medium text-fg">{crumb.label}</span>
            ) : (
              <a href={crumb.href} class="transition-colors hover:text-primary">
                {crumb.label}
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </nav>

  <article class="max-w-3xl">
    {
      image && (
        <div class="mb-8 overflow-hidden rounded-2xl border border-border bg-surface-hover">
          <img
            src={image}
            alt={title}
            width="1200"
            height="675"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
            class="aspect-[16/9] w-full object-cover"
          />
        </div>
      )
    }

    <header class="mb-8 border-b border-border pb-6">
      {
        categories.length > 0 && (
          <ul class="mb-3 flex flex-wrap items-center gap-2">
            {categories.map((category) => (
              <li>
                <a
                  href={categoryHref(category)}
                  class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-primary transition-colors hover:bg-primary/15"
                >
                  {getCategoryLabel(category, locale)}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <h1 class="text-3xl font-extrabold tracking-tight text-fg md:text-4xl">{title}</h1>

      {description && <p class="mt-3 text-base leading-relaxed text-muted">{description}</p>}

      <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
        <span>{m.common_published_on({}, { locale })}</span>
        <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
        <span aria-hidden="true">·</span>
        <span>{m.blog_read_time({ count: readingTime }, { locale })}</span>
        {
          author && (
            <>
              <span aria-hidden="true">·</span>
              <span>{author}</span>
            </>
          )
        }
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <div class="mt-10 flex flex-wrap items-center gap-2 border-t border-border pt-5">
          <span class="me-1 text-[11px] font-semibold uppercase tracking-wider text-muted">
            {m.blog_tags({}, { locale })}
          </span>
          {tags.map((tag) => (
            <a
              href={tagHref(tag)}
              class="inline-flex items-center rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-muted transition-colors hover:border-primary/50 hover:text-fg"
            >
              <span class="me-1 text-muted/70" aria-hidden="true" dir="ltr">
                #
              </span>
              {getTagLabel(tag, locale)}
            </a>
          ))}
        </div>
      )
    }

    <footer class="mt-10 border-t border-border pt-6">
      <a
        href={blogIndexHref}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
      >
        <span class="inline-block rtl:rotate-180">←</span> {m.common_back_to_blog({}, { locale })}
      </a>
    </footer>
  </article>
</BaseLayout>
