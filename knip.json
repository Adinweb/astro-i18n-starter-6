{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/pages/**/*.{astro,ts}",
    "src/content/**/*.mdx",
    "scripts/**/*.mjs",
    "src/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{astro,ts,tsx,js,mdx,css}",
    "scripts/**/*.mjs"
  ],
  "ignore": [
    "src/test/**"
  ],
  "ignoreDependencies": [
    "@inlang/plugin-message-format",
    "@inlang/plugin-m-function-matcher"
  ]
}
