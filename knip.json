{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/pages/**/*.{astro,ts}",
    "src/content/**/*.mdx",
    "client/**/*.{astro,ts}",
    "src/components/{HomeHero,SectionHeader,ComponentDoc,UiBadge,UiAlert,AvatarGroup,Breadcrumbs,UiPagination,UiModal,UiTooltip,UiProgress,UiSwitch,UiCheckbox,UiInput,UiDropdown,SocialLinks,HeroPreviewNav,HeroParallaxLayer,LandingHeroSplit,HeroCenteredEditorial,HeroDashboardShowcase,HeroCommandCli,HeroInteractivePrompt,HeroProofMarquee,BentoCapabilities,BentoGrid,ParallaxSection,ProofStatsRow,FaqAccordion,CtaBanner,PricingSection,TestimonialGrid,TestimonialMarquee,TeamSection,PartnerLogos,NewsletterBanner,PromoBanner,AboutSplitSection,ProcessSteps,FeatureTabsSection,SwipeableTabs,ComparisonTable,FeatureCardGrid,ImageGallerySection,LatestPostsSection,ContactSplitSection,CarouselSection,ProductShowcaseGrid,AuthFormCard}.astro",
    "scripts/**/*.mjs",
    "src/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{astro,ts,tsx,js,mdx,css}",
    "client/**/*.{astro,ts,tsx,js,mdx,css}",
    "scripts/**/*.mjs"
  ],
  "ignore": [
    "src/test/**"
  ],
  "ignoreDependencies": [
    "@inlang/paraglide-js",
    "@inlang/plugin-message-format",
    "@inlang/plugin-m-function-matcher"
  ]
}
